@page "/Account/Register"
@attribute [ExcludeFromInteractiveRouting]

@using CrewService.BlazorUI.Models.Account
@using CrewService.BlazorUI.Clients
@using CrewService.BlazorUI.Components.Account.Shared

@inject ILogger<Register> Logger
@inject IdentityRedirectManager RedirectManager
@inject AuthClient AuthService


<PageTitle>Register</PageTitle>

<h1>Register</h1>

<div class="row">
    <div class="col-md-4">
        <StatusMessage Message="@errorMessage" />
        <EditForm Model="Input!" asp-route-returnUrl="@ReturnUrl" method="post" OnValidSubmit="RegisterUser" FormName="register">
            <DataAnnotationsValidator />
            <hr />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="form-floating mb-3">
                <InputText id="invitation-token" @bind-Value="Input!.InvitationToken" class="form-control" aria-required="true" placeholder="Paste your invitation token" />
                <label for="invitation-token">Invitation Token</label>
                <ValidationMessage For="() => Input!.InvitationToken" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText id="password" type="password" @bind-Value="Input!.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                <label for="password">Password</label>
                <ValidationMessage For="() => Input!.Password" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText id="confirm-password" type="password" @bind-Value="Input!.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                <label for="confirm-password">Confirm Password</label>
                <ValidationMessage For="() => Input!.ConfirmPassword" class="text-danger" />
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Register</button>
        </EditForm>
    </div>
</div>

@code {
    private string? errorMessage;

    [SupplyParameterFromForm]
    private RegisterInputModel? Input { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override void OnInitialized() => Input ??= new();

    public async Task RegisterUser()
    {
        var result = await AuthService.RegisterUserAsync(Input!);

        if (!result.Success)
        {
            errorMessage = $"Error: {string.Join(", ", result.Message)}";
            return;
        }

        Logger.LogInformation("User created a new account.");
        RedirectManager.RedirectTo(ReturnUrl);
    }
}
