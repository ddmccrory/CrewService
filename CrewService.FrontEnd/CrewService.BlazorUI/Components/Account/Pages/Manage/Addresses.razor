@page "/Account/Manage/Addresses"
@rendermode InteractiveServer
@inherits AppComponentBase

@using CrewService.BlazorUI.Clients
@using CrewService.BlazorUI.Models
@using CrewService.BlazorUI.Services
@using CrewService.Presentation

@inject AddressTypeClient AddressTypeClient
@inject EmployeeProfileService ProfileService

<PageTitle>Addresses</PageTitle>

<p><em>Redirecting...</em></p>

<h3>Addresses</h3>

<div class="d-flex justify-content-between align-items-center mb-3">
    <button class="btn btn-primary" @onclick="OpenCreateModal">
        <span class="bi bi-plus-circle"></span> Add Address
    </button>
</div>

<Modal Visible="showSaveModal" Title="@(editCtrlNbr > 0 ? "Edit Address" : "Add Address")"
       Icon="@(editCtrlNbr > 0 ? "bi bi-pencil" : "bi bi-plus-circle")"
       OnClose="CloseSaveModal" Size="lg">
    <BodyContent>
        <EditForm Model="saveModel" OnValidSubmit="OnSave" id="save-address-form">
            <DataAnnotationsValidator />
            <div class="row g-2">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Type</label>
                    <SelectInput TItem="AddressTypeResponse" TValue="long"
                                 Items="addressTypes"
                                 ValueSelector="t => t.CtrlNbr"
                                 TextSelector="t => t.Name"
                                 @bind-Value="saveModel.AddressTypeCtrlNbr"
                                 Placeholder="-- Select Type --"
                                 class="form-select"
                                 disabled="@(editCtrlNbr > 0)" />
                    <ValidationMessage For="() => saveModel.AddressTypeCtrlNbr" class="text-danger" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Address 1</label>
                    <InputText @bind-Value="saveModel.Address1" class="form-control" placeholder="Address 1" />
                    <ValidationMessage For="() => saveModel.Address1" class="text-danger" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Address 2</label>
                    <InputText @bind-Value="saveModel.Address2" class="form-control" placeholder="Address 2" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">City</label>
                    <InputText @bind-Value="saveModel.City" class="form-control" placeholder="City" />
                    <ValidationMessage For="() => saveModel.City" class="text-danger" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">State</label>
                    <InputText @bind-Value="saveModel.State" class="form-control" placeholder="State" />
                    <ValidationMessage For="() => saveModel.State" class="text-danger" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Zip Code</label>
                    <InputText @bind-Value="saveModel.ZipCode" class="form-control" placeholder="Zip Code" />
                    <ValidationMessage For="() => saveModel.ZipCode" class="text-danger" />
                </div>
            </div>
        </EditForm>
    </BodyContent>
    <Footer>
        <button type="button" class="btn btn-outline-secondary" @onclick="CloseSaveModal">Cancel</button>
        <button type="submit" form="save-address-form" class="btn btn-primary">
            <span class="bi bi-check-circle me-1"></span> @(editCtrlNbr > 0 ? "Update" : "Add")
        </button>
    </Footer>
</Modal>

<Modal Visible="showDeleteModal" Title="Confirm Delete" Icon="bi bi-exclamation-triangle"
       OnClose="() => showDeleteModal = false" Size="sm">
    <BodyContent>
        <p>Are you sure you want to delete <strong>@deleteAddressLabel</strong>?</p>
    </BodyContent>
    <Footer>
        <button type="button" class="btn btn-outline-secondary" @onclick="() => showDeleteModal = false">Cancel</button>
        <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">
            <span class="bi bi-trash me-1"></span> Delete
        </button>
    </Footer>
</Modal>

<SuccessAlert @bind-Message="successMessage" />

@if (errorMessage is not null)
{
    <div class="alert alert-danger alert-dismissible" role="alert">
        @errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
    </div>
}

@if (employee is null)
{
    <p><em>Loading...</em></p>
}
else if (employee.Addresses.Count == 0)
{
    <p class="text-muted">No addresses on file.</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Type</th>
                <th>Address 1</th>
                <th>Address 2</th>
                <th>City</th>
                <th>State</th>
                <th>Zip</th>
                <th style="width: 180px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var addr in employee.Addresses)
            {
                <tr>
                    <td>@(addressTypes.FirstOrDefault(t => t.CtrlNbr == addr.AddressTypeCtrlNbr)?.Name)</td>
                    <td>@addr.Address1</td>
                    <td>@addr.Address2</td>
                    <td>@addr.City</td>
                    <td>@addr.State</td>
                    <td>@addr.ZipCode</td>
                    <td>
                        <div class="d-flex gap-1">
                            <button class="btn btn-sm btn-outline-primary flex-fill" @onclick="() => OpenEditModal(addr)">
                                <span class="bi bi-pencil"></span> Edit
                            </button>
                            <button class="btn btn-sm btn-outline-danger flex-fill" @onclick="() => OpenDeleteModal(addr)">
                                <span class="bi bi-trash"></span> Delete
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private GetEmployeeResponse? employee => CurrentUser.Employee;
    private List<AddressTypeResponse> addressTypes = [];

    private bool showSaveModal;
    private long editCtrlNbr;
    private AddressInputModel saveModel = new();

    private bool showDeleteModal;
    private long deleteCtrlNbr;
    private string deleteAddressLabel = "";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        if (CurrentUser.Employee is not null)
        {
            NavigationManager.NavigateTo($"/employees/{CurrentUser.Employee.CtrlNbr}?tab=profile");
            return;
        }

        NavigationManager.NavigateTo("/Account/Manage");
        return;
    }

    private async Task ReloadEmployee() => await CurrentUser.ReloadEmployeeAsync();

    private void OpenCreateModal()
    {
        editCtrlNbr = 0;
        saveModel = new();
        showSaveModal = true;
    }

    private void OpenEditModal(AddressResponse addr)
    {
        editCtrlNbr = addr.CtrlNbr;
        saveModel = EmployeeProfileService.CreateAddressModel(addr);
        showSaveModal = true;
    }

    private void CloseSaveModal()
    {
        showSaveModal = false;
        editCtrlNbr = 0;
        saveModel = new();
    }

    private void OpenDeleteModal(AddressResponse addr)
    {
        deleteCtrlNbr = addr.CtrlNbr;
        deleteAddressLabel = $"{addr.Address1}, {addr.City}";
        showDeleteModal = true;
    }

    private async Task OnSave()
    {
        if (employee is null) return;

        try
        {
            errorMessage = null;
            successMessage = null;

            successMessage = await ProfileService.SaveAddressAsync(employee.CtrlNbr, editCtrlNbr, saveModel);

            CloseSaveModal();
            await ReloadEmployee();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save address: {ex.Message}";
        }
    }

    private async Task ConfirmDelete()
    {
        if (employee is null) return;

        try
        {
            errorMessage = null;
            successMessage = null;

            await ProfileService.DeleteAddressAsync(employee.CtrlNbr, deleteCtrlNbr);
            successMessage = "Address removed.";
            showDeleteModal = false;
            await ReloadEmployee();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to delete address: {ex.Message}";
            showDeleteModal = false;
        }
    }
}
