@page "/Account/Manage/PhoneNumbers"
@rendermode InteractiveServer
@inherits AppComponentBase

@using System.ComponentModel.DataAnnotations
@using CrewService.BlazorUI.Clients
@using CrewService.Presentation

@inject EmployeeClient EmployeeClient
@inject PhoneNumberTypeClient PhoneNumberTypeClient

<PageTitle>Phone Numbers</PageTitle>

<h3>Phone Numbers</h3>

<div class="d-flex justify-content-between align-items-center mb-3">
    <button class="btn btn-primary" @onclick="OpenCreateModal">
        <span class="bi bi-plus-circle"></span> Add Phone Number
    </button>
</div>

<Modal Visible="showSaveModal" Title="@(editCtrlNbr > 0 ? "Edit Phone Number" : "Add Phone Number")"
       Icon="@(editCtrlNbr > 0 ? "bi bi-pencil" : "bi bi-plus-circle")"
       OnClose="CloseSaveModal">
    <BodyContent>
        <EditForm Model="saveModel" OnValidSubmit="OnSave" id="save-phone-form">
            <DataAnnotationsValidator />
            <div class="row g-2">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Type</label>
                    <InputSelect @bind-Value="saveModel.PhoneTypeCtrlNbr" class="form-select" disabled="@(editCtrlNbr > 0)">
                        <option value="0">-- Select Type --</option>
                        @foreach (var t in phoneTypes)
                        {
                            <option value="@t.CtrlNbr">@t.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => saveModel.PhoneTypeCtrlNbr" class="text-danger" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Phone Number</label>
                    <InputText @bind-Value="saveModel.Number" class="form-control" placeholder="Phone Number" />
                    <ValidationMessage For="() => saveModel.Number" class="text-danger" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Calling Order</label>
                    <InputNumber @bind-Value="saveModel.CallingOrder" class="form-control" placeholder="Order" />
                </div>
                <div class="col-md-6 d-flex align-items-end pb-2">
                    <div class="form-check form-switch form-check-reverse">
                        <InputCheckbox @bind-Value="saveModel.DialOne" class="form-check-input" />
                        <label class="form-check-label">Dial One</label>
                    </div>
                </div>
            </div>
        </EditForm>
    </BodyContent>
    <Footer>
        <button type="button" class="btn btn-outline-secondary" @onclick="CloseSaveModal">Cancel</button>
        <button type="submit" form="save-phone-form" class="btn btn-primary">
            <span class="bi bi-check-circle me-1"></span> @(editCtrlNbr > 0 ? "Update" : "Add")
        </button>
    </Footer>
</Modal>

<ConfirmDeleteModal Visible="showDeleteModal" ItemName="@deletePhoneLabel"
                    OnConfirm="ConfirmDelete" OnCancel="() => showDeleteModal = false" />

@if (successMessage is not null)
{
    <div class="alert alert-success alert-dismissible" role="alert">
        @successMessage
        <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
    </div>
}

@if (errorMessage is not null)
{
    <div class="alert alert-danger alert-dismissible" role="alert">
        @errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
    </div>
}

@if (employee is null)
{
    <p><em>Loading...</em></p>
}
else if (employee.PhoneNumbers.Count == 0)
{
    <p class="text-muted">No phone numbers on file.</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Type</th>
                <th>Number</th>
                <th>Calling Order</th>
                <th>Dial One</th>
                <th style="width: 180px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var phone in employee.PhoneNumbers)
            {
                <tr>
                    <td>@(phoneTypes.FirstOrDefault(t => t.CtrlNbr == phone.PhoneTypeCtrlNbr)?.Name)</td>
                    <td>@phone.Number</td>
                    <td>@phone.CallingOrder</td>
                    <td>@(phone.DialOne ? "Yes" : "No")</td>
                    <td>
                        <div class="d-flex gap-1">
                            <button class="btn btn-sm btn-outline-primary flex-fill" @onclick="() => OpenEditModal(phone)">
                                <span class="bi bi-pencil"></span> Edit
                            </button>
                            <button class="btn btn-sm btn-outline-danger flex-fill" @onclick="() => OpenDeleteModal(phone)">
                                <span class="bi bi-trash"></span> Delete
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private GetEmployeeResponse? employee => CurrentUser.Employee;
    private List<PhoneNumberTypeResponse> phoneTypes = [];

    private bool showSaveModal;
    private long editCtrlNbr;
    private PhoneInputModel saveModel = new();

    private bool showDeleteModal;
    private long deleteCtrlNbr;
    private string deletePhoneLabel = "";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        if (CurrentUser.IsEmployee)
        {
            try
            {
                var typesResponse = await PhoneNumberTypeClient.GetAllAsync(employee!.ClientCtrlNbr);
                phoneTypes = [.. typesResponse.PhoneNumberTypeList];
            }
            catch
            {
            }
        }
    }

    private async Task ReloadEmployee() => await CurrentUser.ReloadEmployeeAsync();

    private void OpenCreateModal()
    {
        editCtrlNbr = 0;
        saveModel = new();
        showSaveModal = true;
    }

    private void OpenEditModal(PhoneNumberResponse phone)
    {
        editCtrlNbr = phone.CtrlNbr;
        saveModel = new()
        {
            PhoneTypeCtrlNbr = phone.PhoneTypeCtrlNbr,
            Number = phone.Number,
            CallingOrder = phone.CallingOrder,
            DialOne = phone.DialOne
        };
        showSaveModal = true;
    }

    private void CloseSaveModal()
    {
        showSaveModal = false;
        editCtrlNbr = 0;
        saveModel = new();
    }

    private void OpenDeleteModal(PhoneNumberResponse phone)
    {
        deleteCtrlNbr = phone.CtrlNbr;
        deletePhoneLabel = phone.Number;
        showDeleteModal = true;
    }

    private async Task OnSave()
    {
        if (employee is null) return;

        try
        {
            errorMessage = null;
            successMessage = null;

            if (editCtrlNbr > 0)
            {
                await EmployeeClient.UpdatePhoneNumberAsync(new UpdatePhoneNumberRequest
                {
                    EmployeeCtrlNbr = employee.CtrlNbr,
                    CtrlNbr = editCtrlNbr,
                    Number = saveModel.Number ?? string.Empty,
                    CallingOrder = saveModel.CallingOrder,
                    DialOne = saveModel.DialOne
                });
                successMessage = "Phone number updated.";
            }
            else
            {
                await EmployeeClient.AddPhoneNumberAsync(new AddPhoneNumberRequest
                {
                    EmployeeCtrlNbr = employee.CtrlNbr,
                    PhoneTypeCtrlNbr = saveModel.PhoneTypeCtrlNbr,
                    Number = saveModel.Number ?? string.Empty,
                    CallingOrder = saveModel.CallingOrder,
                    DialOne = saveModel.DialOne
                });
                successMessage = "Phone number added.";
            }

            CloseSaveModal();
            await ReloadEmployee();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save phone number: {ex.Message}";
        }
    }

    private async Task ConfirmDelete()
    {
        if (employee is null) return;

        try
        {
            errorMessage = null;
            successMessage = null;

            await EmployeeClient.DeletePhoneNumberAsync(employee.CtrlNbr, deleteCtrlNbr);
            successMessage = "Phone number removed.";
            showDeleteModal = false;
            await ReloadEmployee();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to delete phone number: {ex.Message}";
            showDeleteModal = false;
        }
    }

    private sealed class PhoneInputModel
    {
        [Required, Display(Name = "Phone Number")]
        public string? Number { get; set; }

        [Display(Name = "Calling Order")]
        public int CallingOrder { get; set; } = 1;

        [Display(Name = "Dial One")]
        public bool DialOne { get; set; }

        [Range(1, long.MaxValue, ErrorMessage = "Please select a phone type.")]
        public long PhoneTypeCtrlNbr { get; set; }
    }
}
