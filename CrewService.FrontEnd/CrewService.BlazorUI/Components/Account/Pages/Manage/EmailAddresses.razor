@page "/Account/Manage/EmailAddresses"
@rendermode InteractiveServer
@inherits AppComponentBase

@using System.ComponentModel.DataAnnotations
@using CrewService.BlazorUI.Clients
@using CrewService.Presentation

@inject EmployeeClient EmployeeClient
@inject EmailAddressTypeClient EmailAddressTypeClient

<PageTitle>Email Addresses</PageTitle>

<h3>Email Addresses</h3>

<div class="d-flex justify-content-between align-items-center mb-3">
    <button class="btn btn-primary" @onclick="OpenCreateModal">
        <span class="bi bi-plus-circle"></span> Add Email Address
    </button>
</div>

<Modal Visible="showSaveModal" Title="@(editCtrlNbr > 0 ? "Edit Email Address" : "Add Email Address")"
       Icon="@(editCtrlNbr > 0 ? "bi bi-pencil" : "bi bi-plus-circle")"
       OnClose="CloseSaveModal">
    <BodyContent>
        <EditForm Model="saveModel" OnValidSubmit="OnSave" id="save-email-form">
            <DataAnnotationsValidator />
            <div class="row g-2">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Type</label>
                    <InputSelect @bind-Value="saveModel.EmailTypeCtrlNbr" class="form-select" disabled="@(editCtrlNbr > 0)">
                        <option value="0">-- Select Type --</option>
                        @foreach (var t in emailTypes)
                        {
                            <option value="@t.CtrlNbr">@t.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => saveModel.EmailTypeCtrlNbr" class="text-danger" />
                </div>
                <div class="col-md-8">
                    <label class="form-label fw-semibold">Email Address</label>
                    <InputText @bind-Value="saveModel.Email" class="form-control" placeholder="Email Address" />
                    <ValidationMessage For="() => saveModel.Email" class="text-danger" />
                </div>
            </div>
        </EditForm>
    </BodyContent>
    <Footer>
        <button type="button" class="btn btn-outline-secondary" @onclick="CloseSaveModal">Cancel</button>
        <button type="submit" form="save-email-form" class="btn btn-primary">
            <span class="bi bi-check-circle me-1"></span> @(editCtrlNbr > 0 ? "Update" : "Add")
        </button>
    </Footer>
</Modal>

<Modal Visible="showDeleteModal" Title="Confirm Delete" Icon="bi bi-exclamation-triangle"
       OnClose="() => showDeleteModal = false" Size="sm">
    <BodyContent>
        <p>Are you sure you want to delete <strong>@deleteEmailLabel</strong>?</p>
    </BodyContent>
    <Footer>
        <button type="button" class="btn btn-outline-secondary" @onclick="() => showDeleteModal = false">Cancel</button>
        <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">
            <span class="bi bi-trash me-1"></span> Delete
        </button>
    </Footer>
</Modal>

@if (successMessage is not null)
{
    <div class="alert alert-success alert-dismissible" role="alert">
        @successMessage
        <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
    </div>
}

@if (errorMessage is not null)
{
    <div class="alert alert-danger alert-dismissible" role="alert">
        @errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
    </div>
}

@if (employee is null)
{
    <p><em>Loading...</em></p>
}
else if (employee.EmailAddresses.Count == 0)
{
    <p class="text-muted">No email addresses on file.</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Type</th>
                <th>Email</th>
                <th style="width: 180px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var email in employee.EmailAddresses)
            {
                <tr>
                    <td>@(emailTypes.FirstOrDefault(t => t.CtrlNbr == email.EmailTypeCtrlNbr)?.Name)</td>
                    <td>@email.Email</td>
                    <td>
                        <div class="d-flex gap-1">
                            <button class="btn btn-sm btn-outline-primary flex-fill" @onclick="() => OpenEditModal(email)">
                                <span class="bi bi-pencil"></span> Edit
                            </button>
                            <button class="btn btn-sm btn-outline-danger flex-fill" @onclick="() => OpenDeleteModal(email)">
                                <span class="bi bi-trash"></span> Delete
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private GetEmployeeResponse? employee => CurrentUser.Employee;
    private List<EmailAddressTypeResponse> emailTypes = [];

    private bool showSaveModal;
    private long editCtrlNbr;
    private EmailInputModel saveModel = new();

    private bool showDeleteModal;
    private long deleteCtrlNbr;
    private string deleteEmailLabel = "";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        if (CurrentUser.IsEmployee)
        {
            try
            {
                var typesResponse = await EmailAddressTypeClient.GetAllAsync(employee!.ClientCtrlNbr);
                emailTypes = [.. typesResponse.EmaiAddressTypeList];
            }
            catch
            {
            }
        }
    }

    private async Task ReloadEmployee() => await CurrentUser.ReloadEmployeeAsync();

    private void OpenCreateModal()
    {
        editCtrlNbr = 0;
        saveModel = new();
        showSaveModal = true;
    }

    private void OpenEditModal(EmailAddressResponse email)
    {
        editCtrlNbr = email.CtrlNbr;
        saveModel = new()
        {
            EmailTypeCtrlNbr = email.EmailTypeCtrlNbr,
            Email = email.Email
        };
        showSaveModal = true;
    }

    private void CloseSaveModal()
    {
        showSaveModal = false;
        editCtrlNbr = 0;
        saveModel = new();
    }

    private void OpenDeleteModal(EmailAddressResponse email)
    {
        deleteCtrlNbr = email.CtrlNbr;
        deleteEmailLabel = email.Email;
        showDeleteModal = true;
    }

    private async Task OnSave()
    {
        if (employee is null) return;

        try
        {
            errorMessage = null;
            successMessage = null;

            if (editCtrlNbr > 0)
            {
                await EmployeeClient.UpdateEmailAddressAsync(new UpdateEmailAddressRequest
                {
                    EmployeeCtrlNbr = employee.CtrlNbr,
                    CtrlNbr = editCtrlNbr,
                    Email = saveModel.Email ?? string.Empty
                });
                successMessage = "Email address updated.";
            }
            else
            {
                await EmployeeClient.AddEmailAddressAsync(new AddEmailAddressRequest
                {
                    EmployeeCtrlNbr = employee.CtrlNbr,
                    EmailTypeCtrlNbr = saveModel.EmailTypeCtrlNbr,
                    Email = saveModel.Email ?? string.Empty
                });
                successMessage = "Email address added.";
            }

            CloseSaveModal();
            await ReloadEmployee();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save email address: {ex.Message}";
        }
    }

    private async Task ConfirmDelete()
    {
        if (employee is null) return;

        try
        {
            errorMessage = null;
            successMessage = null;

            await EmployeeClient.DeleteEmailAddressAsync(employee.CtrlNbr, deleteCtrlNbr);
            successMessage = "Email address removed.";
            showDeleteModal = false;
            await ReloadEmployee();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to delete email address: {ex.Message}";
            showDeleteModal = false;
        }
    }

    private sealed class EmailInputModel
    {
        [Required, EmailAddress, Display(Name = "Email Address")]
        public string? Email { get; set; }

        [Range(1, long.MaxValue, ErrorMessage = "Please select an email type.")]
        public long EmailTypeCtrlNbr { get; set; }
    }
}
