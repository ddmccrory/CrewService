@page "/employees/qualifications"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using CrewService.BlazorUI.Clients
@using CrewService.Presentation

@inherits AppComponentBase

@attribute [Authorize]

@inject QualificationsClient QualificationsClient
@inject EmployeeClient EmployeeClient

<PageTitle>Qualifications</PageTitle>

<h1>Qualifications</h1>

@if (!HasParent)
{
    <div class="alert alert-warning">
        <span class="bi bi-exclamation-triangle"></span>
        Please select a parent in the context switcher to manage qualifications.
    </div>
}
else
{
    <p class="text-muted mb-3">Managing qualifications for <strong>@SelectedParentName</strong></p>

    <Modal Visible="showCreateTypeModal"
           Title="Create Qualification Type"
           Icon="bi bi-plus-circle"
           OnClose="CloseCreateTypeModal">
        <BodyContent>
            <EditForm Model="createTypeModel" OnValidSubmit="CreateQualificationType" id="create-qualification-type-form">
                <DataAnnotationsValidator />

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Code</label>
                        <InputText @bind-Value="createTypeModel.Code" class="form-control" placeholder="FOREMAN" />
                    </div>
                    <div class="col-md-8">
                        <label class="form-label fw-semibold">Name</label>
                        <InputText @bind-Value="createTypeModel.Name" class="form-control" placeholder="Foreman Qualification" />
                    </div>
                    <div class="col-md-12">
                        <label class="form-label fw-semibold">Description</label>
                        <InputText @bind-Value="createTypeModel.Description" class="form-control" placeholder="Optional description" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Evaluation Strategy</label>
                        <SelectInput TItem="string" TValue="string"
                                     @bind-Value="createTypeModel.EvaluationStrategy"
                                     Items="evaluationStrategies"
                                     ValueSelector="@(s => s)"
                                     TextSelector="@(s => s)"
                                     Placeholder="-- Select Strategy --"
                                     class="form-select" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Expiration Months</label>
                        <InputNumber @bind-Value="createTypeModel.ExpirationMonths" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Grace Days</label>
                        <InputNumber @bind-Value="createTypeModel.GraceDays" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Renewal Lead Days</label>
                        <InputNumber @bind-Value="createTypeModel.RenewalLeadDays" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <div class="form-check form-switch mt-4">
                            <InputCheckbox @bind-Value="createTypeModel.CalendarYearExpiry" class="form-check-input" />
                            <label class="form-check-label">Calendar Year Expiry</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check form-switch mt-4">
                            <InputCheckbox @bind-Value="createTypeModel.IsBlocking" class="form-check-input" />
                            <label class="form-check-label">Blocking Qualification</label>
                        </div>
                    </div>
                </div>
            </EditForm>
        </BodyContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="CloseCreateTypeModal">Cancel</button>
            <button type="submit" form="create-qualification-type-form" class="btn btn-primary" disabled="@isSaving">
                <span class="bi bi-check2-circle me-1"></span> Save
            </button>
        </Footer>
    </Modal>

    <Modal Visible="showGrantModal"
           Title="Grant Employee Qualification"
           Icon="bi bi-award"
           OnClose="CloseGrantModal">
        <BodyContent>
            <EditForm Model="grantModel" OnValidSubmit="GrantQualification" id="grant-qualification-form">
                <DataAnnotationsValidator />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Employee</label>
                        <SelectInput TItem="EmployeeOption" TValue="long"
                                     @bind-Value="grantModel.EmployeeCtrlNbr"
                                     Items="employeeOptions"
                                     ValueSelector="@(e => e.CtrlNbr)"
                                     TextSelector="@(e => e.Display)"
                                     Placeholder="-- Select Employee --"
                                     class="form-select" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Qualification Type</label>
                        <SelectInput TItem="QualificationTypeResponse" TValue="long"
                                     @bind-Value="grantModel.QualificationTypeCtrlNbr"
                                     Items="qualificationTypes"
                                     ValueSelector="@(q => q.CtrlNbr)"
                                     TextSelector="@(q => $"{q.Code.ToUpperInvariant()} - {q.Name}")"
                                     Placeholder="-- Select Qualification --"
                                     class="form-select" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Status</label>
                        <SelectInput TItem="string" TValue="string"
                                     @bind-Value="grantModel.Status"
                                     Items="grantStatuses"
                                     ValueSelector="@(s => s)"
                                     TextSelector="@(s => s)"
                                     Placeholder="-- Select Status --"
                                     class="form-select" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Expires At (optional)</label>
                        <InputDate @bind-Value="grantModel.ExpiresAtUtc" class="form-control" />
                    </div>
                    <div class="col-md-12">
                        <label class="form-label fw-semibold">Evidence</label>
                        <InputText @bind-Value="grantModel.EvidenceValue" class="form-control" placeholder="Manual completion detail" />
                    </div>
                </div>
            </EditForm>
        </BodyContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="CloseGrantModal">Cancel</button>
            <button type="submit" form="grant-qualification-form" class="btn btn-primary" disabled="@isSaving">
                <span class="bi bi-award me-1"></span> Grant
            </button>
        </Footer>
    </Modal>

    <SuccessAlert @bind-Message="successMessage" />

    @if (errorMessage is not null)
    {
        <div class="alert alert-danger alert-dismissible" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <DataTable TItem="QualificationTypeResponse"
               Items="qualificationTypes"
               Columns="qualificationTypeColumns"
               SearchFilter="@((q, term) => q.Code.Contains(term, StringComparison.OrdinalIgnoreCase) || q.Name.Contains(term, StringComparison.OrdinalIgnoreCase))"
               SearchPlaceholder="Search by code or name..."
               EmptyMessage="No qualification types found."
               DefaultSortColumn="Code">
        <ToolbarContent>
            <div class="d-flex gap-2">
                @if (!IsFeatureReadOnly)
                {
                    <button class="btn btn-primary" @onclick="OpenCreateTypeModal">
                        <span class="bi bi-plus-circle"></span> Create Type
                    </button>
                    <button class="btn btn-outline-primary" @onclick="OpenGrantModal">
                        <span class="bi bi-award"></span> Grant Qualification
                    </button>
                }
                <button class="btn btn-outline-secondary" @onclick="RefreshAll">
                    <span class="bi bi-arrow-repeat"></span> Refresh
                </button>
            </div>
        </ToolbarContent>
        <RowContent Context="q">
            <td>@q.Code.ToUpperInvariant()</td>
            <td>@q.Name</td>
            <td>@q.EvaluationStrategy</td>
            <td>@(q.IsBlocking ? "Yes" : "No")</td>
            <td>@(q.IsActive ? "Active" : "Inactive")</td>
            <td>
                @if (!IsFeatureReadOnly)
                {
                    <button class="btn btn-sm @(q.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                            @onclick="() => ToggleActive(q)">
                        <span class="bi @(q.IsActive ? "bi-pause-circle" : "bi-play-circle")"></span>
                        @(q.IsActive ? "Deactivate" : "Activate")
                    </button>
                }
            </td>
        </RowContent>
    </DataTable>

    <div class="card mt-3">
        <div class="card-body">
            <h5 class="card-title">Employee Qualification Dashboard</h5>
            <div class="row g-2 align-items-end mb-3">
                <div class="col-md-8">
                    <label class="form-label fw-semibold">Employee</label>
                    <FilterSelect TItem="EmployeeOption" TValue="long"
                                  Value="selectedEmployeeCtrlNbr"
                                  ValueChanged="OnEmployeeChanged"
                                  Items="employeeOptions"
                                  ValueSelector="@(e => e.CtrlNbr)"
                                  TextSelector="@(e => e.Display)"
                                  Placeholder="-- Select Employee --"
                                  class="form-select" />
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button class="btn btn-outline-secondary flex-fill" @onclick="LoadSelectedEmployeeQualifications">
                        <span class="bi bi-search"></span> Load
                    </button>
                </div>
            </div>

            <DataTable TItem="EmployeeQualificationResponse"
                       Items="employeeQualifications"
                       Columns="employeeQualificationColumns"
                       SearchFilter="@((q, term) => ResolveQualificationCode(q.QualificationTypeCtrlNbr).Contains(term, StringComparison.OrdinalIgnoreCase) || q.Status.Contains(term, StringComparison.OrdinalIgnoreCase))"
                       SearchPlaceholder="Search by code or status..."
                       EmptyMessage="No employee qualifications found."
                       DefaultSortColumn="Code">
                <RowContent Context="eq">
                    <td>@ResolveQualificationCode(eq.QualificationTypeCtrlNbr)</td>
                    <td>@eq.Status</td>
                    <td>@FormatDate(eq.AchievedAtUtc?.ToDateTime().ToString("o"))</td>
                    <td>@(eq.ExpiresAtUtc is null ? "—" : FormatDate(eq.ExpiresAtUtc.ToDateTime().ToString("o")))</td>
                </RowContent>
            </DataTable>
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-body">
            <h5 class="card-title">Eligibility Check</h5>
            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Employee CtrlNbr</label>
                    <InputNumber @bind-Value="eligibilityEmployeeCtrlNbr" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Position Slot CtrlNbr</label>
                    <InputNumber @bind-Value="eligibilityPositionSlotCtrlNbr" class="form-control" />
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button class="btn btn-outline-primary flex-fill" @onclick="RunEligibilityCheck">
                        <span class="bi bi-clipboard-check"></span> Check
                    </button>
                </div>
            </div>

            @if (eligibilityResult is not null)
            {
                <div class="mt-3">
                    <span class="badge @(eligibilityResult.IsEligible ? "bg-success" : "bg-danger")">
                        @(eligibilityResult.IsEligible ? "Eligible" : "Not Eligible")
                    </span>

                    @if (!eligibilityResult.IsEligible && eligibilityResult.BlockingReasons.Count > 0)
                    {
                        <ul class="mt-2 mb-0">
                            @foreach (var reason in eligibilityResult.BlockingReasons)
                            {
                                <li><strong>@reason.RuleCode</strong>: @reason.Description</li>
                            }
                        </ul>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    protected override string? FeatureKey => "employees/qualifications";

    private readonly IReadOnlyList<string> evaluationStrategies = ["Manual", "TimeFromEvent", "ActivityCount", "TimeInRole", "QualificationHeld", "FraCertification"];
    private readonly IReadOnlyList<string> grantStatuses = ["Active", "Pending"];

    private IReadOnlyList<QualificationTypeResponse> qualificationTypes = [];
    private IReadOnlyList<EmployeeOption> employeeOptions = [];
    private IReadOnlyList<EmployeeQualificationResponse> employeeQualifications = [];

    private long selectedEmployeeCtrlNbr;
    private bool showCreateTypeModal;
    private bool showGrantModal;

    private CreateQualificationTypeModel createTypeModel = new();
    private GrantQualificationModel grantModel = new();

    private long? eligibilityEmployeeCtrlNbr;
    private long? eligibilityPositionSlotCtrlNbr;
    private CheckEligibilityResponse? eligibilityResult;

    private static readonly IReadOnlyList<DataTableColumn<QualificationTypeResponse>> qualificationTypeColumns =
    [
        new("Code", q => q.Code.ToUpperInvariant()),
        new("Name", q => q.Name),
        new("Strategy", q => q.EvaluationStrategy),
        new("Blocking", q => q.IsBlocking ? "Yes" : "No"),
        new("Status", q => q.IsActive ? "Active" : "Inactive"),
        DataTableColumn<QualificationTypeResponse>.Actions()
    ];

    private static readonly IReadOnlyList<DataTableColumn<EmployeeQualificationResponse>> employeeQualificationColumns =
    [
        new("Code", q => q.QualificationTypeCtrlNbr.ToString()),
        new("Status", q => q.Status),
        new("Achieved", q => q.AchievedAtUtc?.ToDateTime().ToString("yyyy-MM-dd") ?? ""),
        new("Expires", q => q.ExpiresAtUtc is null ? "" : q.ExpiresAtUtc.ToDateTime().ToString("yyyy-MM-dd"))
    ];

    protected override async Task LoadDataAsync()
    {
        if (!HasParent)
            return;

        await LoadEmployees();
        await LoadQualificationTypes();
        await InitializeEmployeeContext();
        await LoadSelectedEmployeeQualifications();
    }

    protected override async Task OnAppContextChangedAsync()
    {
        if (!HasParent)
        {
            qualificationTypes = [];
            employeeOptions = [];
            employeeQualifications = [];
            eligibilityResult = null;
            selectedEmployeeCtrlNbr = 0;
            return;
        }

        await LoadEmployees();
        await LoadQualificationTypes();
        await InitializeEmployeeContext();
        await LoadSelectedEmployeeQualifications();
    }

    private async Task RefreshAll()
    {
        await LoadQualificationTypes();
        await LoadSelectedEmployeeQualifications();
    }

    private async Task LoadEmployees()
    {
        var response = await EmployeeClient.GetAllAsync(SelectedParentCtrlNbr!.Value);
        employeeOptions = response.Employees
            .Select(e => new EmployeeOption(e.CtrlNbr, $"{e.EmployeeNumber} - {e.FullNameLnf}"))
            .OrderBy(e => e.Display)
            .ToList();
    }

    private async Task LoadQualificationTypes()
    {
        var response = await QualificationsClient.GetQualificationTypesAsync(SelectedParentCtrlNbr!.Value);
        qualificationTypes = response.QualificationTypes
            .OrderBy(q => q.Code, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private async Task InitializeEmployeeContext()
    {
        if (selectedEmployeeCtrlNbr > 0)
            return;

        if (!CurrentUser.IsAdmin && CurrentUser.Employee is not null)
        {
            selectedEmployeeCtrlNbr = CurrentUser.Employee.CtrlNbr;
        }
        else if (employeeOptions.Count == 1)
        {
            selectedEmployeeCtrlNbr = employeeOptions[0].CtrlNbr;
        }

        grantModel.EmployeeCtrlNbr = selectedEmployeeCtrlNbr;
        eligibilityEmployeeCtrlNbr = selectedEmployeeCtrlNbr > 0 ? selectedEmployeeCtrlNbr : null;
        await Task.CompletedTask;
    }

    private async Task OnEmployeeChanged(long value)
    {
        selectedEmployeeCtrlNbr = value;
        grantModel.EmployeeCtrlNbr = value;
        eligibilityEmployeeCtrlNbr = value > 0 ? value : null;
        await LoadSelectedEmployeeQualifications();
    }

    private async Task LoadSelectedEmployeeQualifications()
    {
        if (selectedEmployeeCtrlNbr <= 0)
        {
            employeeQualifications = [];
            return;
        }

        var response = await QualificationsClient.GetEmployeeQualificationsAsync(selectedEmployeeCtrlNbr);
        employeeQualifications = response.Qualifications
            .OrderByDescending(q => q.AchievedAtUtc?.ToDateTime())
            .ToList();
    }

    private string ResolveQualificationCode(long qualificationTypeCtrlNbr)
    {
        var type = qualificationTypes.FirstOrDefault(q => q.CtrlNbr == qualificationTypeCtrlNbr);
        return type is null ? qualificationTypeCtrlNbr.ToString() : type.Code.ToUpperInvariant();
    }

    private void OpenCreateTypeModal()
    {
        createTypeModel = new CreateQualificationTypeModel
        {
            EvaluationStrategy = "Manual"
        };
        showCreateTypeModal = true;
    }

    private void CloseCreateTypeModal() => showCreateTypeModal = false;

    private async Task CreateQualificationType()
    {
        try
        {
            isSaving = true;
            errorMessage = null;

            var request = new CreateQualificationTypeRequest
            {
                ParentCtrlNbr = SelectedParentCtrlNbr!.Value,
                Code = (createTypeModel.Code ?? string.Empty).ToUpperInvariant(),
                Name = createTypeModel.Name ?? string.Empty,
                Description = createTypeModel.Description ?? string.Empty,
                EvaluationStrategy = createTypeModel.EvaluationStrategy ?? "Manual",
                ExpirationMonths = createTypeModel.ExpirationMonths ?? 0,
                CalendarYearExpiry = createTypeModel.CalendarYearExpiry,
                GraceDays = createTypeModel.GraceDays,
                RenewalLeadDays = createTypeModel.RenewalLeadDays,
                IsBlocking = createTypeModel.IsBlocking
            };

            await QualificationsClient.CreateQualificationTypeAsync(request);

            showCreateTypeModal = false;
            successMessage = "Qualification type created.";
            await LoadQualificationTypes();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to create qualification type: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void OpenGrantModal()
    {
        grantModel = new GrantQualificationModel
        {
            EmployeeCtrlNbr = selectedEmployeeCtrlNbr,
            Status = "Active",
            GrantedBy = CurrentUser.Username ?? "SYSTEM"
        };
        showGrantModal = true;
    }

    private void CloseGrantModal() => showGrantModal = false;

    private async Task GrantQualification()
    {
        try
        {
            isSaving = true;
            errorMessage = null;

            var request = new GrantEmployeeQualificationRequest
            {
                EmployeeCtrlNbr = grantModel.EmployeeCtrlNbr,
                QualificationTypeCtrlNbr = grantModel.QualificationTypeCtrlNbr,
                GrantedBy = string.IsNullOrWhiteSpace(grantModel.GrantedBy) ? "SYSTEM" : grantModel.GrantedBy,
                Status = string.IsNullOrWhiteSpace(grantModel.Status) ? "Active" : grantModel.Status,
                EvidenceValue = grantModel.EvidenceValue ?? string.Empty
            };

            if (grantModel.ExpiresAtUtc.HasValue)
            {
                request.ExpiresAtUtc = Google.Protobuf.WellKnownTypes.Timestamp.FromDateTime(
                    DateTime.SpecifyKind(grantModel.ExpiresAtUtc.Value, DateTimeKind.Utc));
            }

            await QualificationsClient.GrantEmployeeQualificationAsync(request);
            showGrantModal = false;
            successMessage = "Qualification granted.";
            await LoadSelectedEmployeeQualifications();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to grant qualification: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ToggleActive(QualificationTypeResponse qualificationType)
    {
        try
        {
            errorMessage = null;
            await QualificationsClient.SetQualificationTypeActiveAsync(qualificationType.CtrlNbr, !qualificationType.IsActive);
            await LoadQualificationTypes();
            successMessage = qualificationType.IsActive
                ? "Qualification type deactivated."
                : "Qualification type activated.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to update qualification type: {ex.Message}";
        }
    }

    private async Task RunEligibilityCheck()
    {
        try
        {
            errorMessage = null;
            eligibilityResult = null;

            if (!eligibilityEmployeeCtrlNbr.HasValue || !eligibilityPositionSlotCtrlNbr.HasValue)
            {
                errorMessage = "Employee and position slot are required for eligibility check.";
                return;
            }

            eligibilityResult = await QualificationsClient.CheckEligibilityAsync(
                eligibilityEmployeeCtrlNbr.Value,
                eligibilityPositionSlotCtrlNbr.Value);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to check eligibility: {ex.Message}";
        }
    }

    private sealed record EmployeeOption(long CtrlNbr, string Display);

    private sealed class CreateQualificationTypeModel
    {
        public string? Code { get; set; }
        public string? Name { get; set; }
        public string? Description { get; set; }
        public string? EvaluationStrategy { get; set; }
        public int? ExpirationMonths { get; set; }
        public bool CalendarYearExpiry { get; set; }
        public int GraceDays { get; set; }
        public int RenewalLeadDays { get; set; }
        public bool IsBlocking { get; set; }
    }

    private sealed class GrantQualificationModel
    {
        public long EmployeeCtrlNbr { get; set; }
        public long QualificationTypeCtrlNbr { get; set; }
        public string? Status { get; set; }
        public string? GrantedBy { get; set; }
        public DateTime? ExpiresAtUtc { get; set; }
        public string? EvidenceValue { get; set; }
    }
}
