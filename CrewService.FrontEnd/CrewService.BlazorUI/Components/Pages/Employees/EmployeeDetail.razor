            workProfile = profileTask.Result;
            openOnDutyRecords = [.. openOnDutyTask.Result.Records];
            openBulletinCountsByCraft.Clear();
            foreach (var craftGroup in activeBulletinsTask.Result.Bulletins.GroupBy(b => b.CraftCtrlNbr))
                openBulletinCountsByCraft[craftGroup.Key] = craftGroup.Count();
            workTabLoaded = true;
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load work information: {ex.Message}";
        }
        finally
        {
            workTabLoading = false;
        }
    }

