                return;
            }

            var clientCtrlNbr = SelectedParentCtrlNbr.Value;

            var empTask = EmployeeClient.GetByCtrlNbrAsync(CtrlNbr);
            var addrTask = AddressTypeClient.GetAllAsync(clientCtrlNbr);
            var phoneTask = PhoneNumberTypeClient.GetAllAsync(clientCtrlNbr);
            var emailTask = EmailAddressTypeClient.GetAllAsync(clientCtrlNbr);
            var qualTypesTask = QualificationsClient.GetQualificationTypesAsync(clientCtrlNbr);
            var qualTask = QualificationsClient.GetEmployeeQualificationsAsync(CtrlNbr);
            await Task.WhenAll(empTask, addrTask, phoneTask, emailTask, qualTypesTask, qualTask);

            employee = empTask.Result;
            addressTypes = [.. addrTask.Result.AddressTypeList];
            phoneTypes = [.. phoneTask.Result.PhoneNumberTypeList];
            emailTypes = [.. emailTask.Result.EmaiAddressTypeList];
            qualificationTypes = [.. qualTypesTask.Result.QualificationTypes];
            employeeQualifications = [.. qualTask.Result.Qualifications.OrderByDescending(q => q.AchievedAtUtc?.ToDateTime())];
