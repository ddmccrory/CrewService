    private async Task LoadWorkTabAsync()
    {
        if (workTabLoading) return;
        workTabLoading = true;
        try
        {
            errorMessage = null;
            var profileTask = EmployeeClient.GetWorkProfileAsync(
                CtrlNbr,
                SelectedParentCtrlNbr ?? 0,
                SelectedRailroadCtrlNbr ?? 0);
            var openOnDutyTask = EmployeeClient.GetOpenOnDutyRecordsAsync(CtrlNbr);
            var activeBulletinsTask = BulletinsClient.GetActiveBulletinsAsync(
                SelectedRailroadCtrlNbr ?? 0,
