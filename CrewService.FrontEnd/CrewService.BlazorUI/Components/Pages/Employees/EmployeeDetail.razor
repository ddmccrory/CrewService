@page "/employees/{CtrlNbr:long}"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using CrewService.BlazorUI.Clients
@using CrewService.BlazorUI.Models
@using CrewService.BlazorUI.Services
@using CrewService.Presentation

@inherits AppComponentBase

@attribute [Authorize]

@inject EmployeeClient EmployeeClient
@inject AddressTypeClient AddressTypeClient
@inject PhoneNumberTypeClient PhoneNumberTypeClient
@inject EmailAddressTypeClient EmailAddressTypeClient
@inject EmployeeProfileService ProfileService
@inject QualificationsClient QualificationsClient
@inject PoliciesClient PoliciesClient
@inject NotificationsClient NotificationsClient
@inject BulletinsClient BulletinsClient
@inject AccountClient AccountClient
@inject AppThemeService AppThemeService
@inject IJSRuntime JSRuntime
@inject NavigationManager Nav

<PageTitle>Employee Detail</PageTitle>

@if (employee is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <BackNavButton Text="Employees" OnClick="@(() => Nav.NavigateTo("/employees"))" />

    <h1>@employee.FullNameLnf</h1>
    <p class="text-muted mb-1">
        <span class="badge bg-secondary">@employee.EmployeeNumber</span>
        @if (!string.IsNullOrEmpty(workProfile?.Role))
        {
            <span class="badge bg-primary ms-2">@workProfile.Role</span>
        }
        @if (!string.IsNullOrEmpty(workProfile?.EmploymentStatus))
        {
            <span class="badge bg-light text-dark border ms-1">@workProfile.EmploymentStatus</span>
        }
    </p>

    <SuccessAlert @bind-Message="successMessage" Class="mt-2" />

    @if (errorMessage is not null)
    {
        <div class="alert alert-danger alert-dismissible mt-2" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <hr />

    <TabPanel Tabs="tabs" ActiveTab="activeTab" ActiveTabChanged="OnTabChangedAsync" />

    @* ── Profile Tab ── *@
    @if (activeTab == "profile")
    {
        <ul class="nav nav-pills mb-3 mt-3">
            @foreach (var section in profileSections)
            {
                <li class="nav-item">
                    <button type="button"
                            class="nav-link @(section.Id == activeProfileSection ? "active" : string.Empty)"
                            @onclick="() => OnProfileSectionChangedAsync(section.Id)">
                        @section.Label
                    </button>
                </li>
            }
        </ul>

        @if (activeProfileSection == "profile")
        {
            <div class="row g-3 mt-1">
                <div class="col-lg-6">
                    <h5>Profile</h5>
                    <div class="form-floating mb-3">
                        <input type="text" value="@employee.EmployeeNumber" class="form-control" disabled />
                        <label>Employee Number</label>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Social Security Number</label>
                        <div class="input-group">
                            <input type="text" value="@ssnDisplay" class="form-control" disabled />
                            @if (!showFullSsn)
                            {
                                <button type="button" class="btn btn-outline-secondary" @onclick="OnShowSsn">Show</button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-outline-secondary" @onclick="OnHideSsn">Hide</button>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <h5 class="text-white-50">&nbsp;</h5>
                    <div class="form-floating mb-3">
                        <input type="text" value="@(employee.BirthDate?.ToDateTime().ToString("MM/dd/yyyy"))" class="form-control" disabled />
                        <label>Birth Date</label>
                    </div>

                    <div class="form-floating mb-3">
                        <input type="text" value="@(employee.EmploymentDate?.ToDateTime().ToString("MM/dd/yyyy"))" class="form-control" disabled />
                        <label>Hire Date</label>
                    </div>
                </div>
            </div>

            <hr />

            <EditForm Model="profileModel" OnValidSubmit="OnSaveProfileAsync">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" role="alert" />

                <div class="row g-3">
                    <div class="col-lg-6">
                        <div class="form-floating mb-3">
                            <input type="text" value="@CurrentUser.Username" id="profile-username" class="form-control" placeholder="Username" disabled />
                            <label for="profile-username" class="form-label">Username</label>
                        </div>

                        <div class="form-floating mb-3">
                            <InputText @bind-Value="profileModel.FirstName" id="profile-first-name" class="form-control" placeholder="Enter first name" disabled="@isProfileReadOnly" />
                            <label for="profile-first-name" class="form-label">First Name</label>
                            <ValidationMessage For="() => profileModel.FirstName" class="text-danger" />
                        </div>

                        <div class="form-floating mb-3">
                            <InputText @bind-Value="profileModel.MiddleName" id="profile-middle-name" class="form-control" placeholder="Enter middle name" disabled="@isProfileReadOnly" />
                            <label for="profile-middle-name" class="form-label">Middle Name</label>
                            <ValidationMessage For="() => profileModel.MiddleName" class="text-danger" />
                        </div>

                        <div class="form-floating mb-3">
                            <InputText @bind-Value="profileModel.LastName" id="profile-last-name" class="form-control" placeholder="Enter last name" disabled="@isProfileReadOnly" />
                            <label for="profile-last-name" class="form-label">Last Name</label>
                            <ValidationMessage For="() => profileModel.LastName" class="text-danger" />
                        </div>

                        <div class="form-floating mb-3">
                            <InputText @bind-Value="profileModel.DriversLicenseNumber" class="form-control" placeholder="Driver's License" disabled="@isProfileReadOnly" />
                            <label>Driver's License</label>
                        </div>

                        <div class="form-floating mb-3">
                            <InputText @bind-Value="profileModel.IssuingState" class="form-control" placeholder="Issuing State" disabled="@isProfileReadOnly" />
                            <label>Issuing State</label>
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Gender</label>
                            <SelectInput TItem="string" TValue="string"
                                         Items="genderOptions"
                                         ValueSelector="v => v"
                                         TextSelector="v => v"
                                         @bind-Value="profileModel.Gender"
                                         Placeholder="-- Select --"
                                         class="form-select"
                                         disabled="@isProfileReadOnly" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Race</label>
                            <SelectInput TItem="RaceOption" TValue="string"
                                         Items="raceOptions"
                                         ValueSelector="v => v.Value"
                                         TextSelector="v => v.Label"
                                         @bind-Value="profileModel.Race"
                                         Placeholder="-- Select --"
                                         class="form-select"
                                         disabled="@isProfileReadOnly" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Marital Status</label>
                            <SelectInput TItem="string" TValue="string"
                                         Items="maritalStatusOptions"
                                         ValueSelector="v => v"
                                         TextSelector="v => v"
                                         @bind-Value="profileModel.MaritalStatus"
                                         Placeholder="-- Select --"
                                         class="form-select"
                                         disabled="@isProfileReadOnly" />
                        </div>

                        <div class="form-check form-switch form-check-reverse mb-3">
                            <InputCheckbox @bind-Value="profileModel.CallForOvertime" class="form-check-input" disabled="@isProfileReadOnly" />
                            <label class="form-check-label">Call for Overtime</label>
                        </div>

                        @if (CurrentUser.IsAdmin)
                        {
                            <div class="form-check form-switch form-check-reverse mb-3">
                                <InputCheckbox @bind-Value="profileModel.AllowFmlaMarkOff" class="form-check-input" disabled="@isProfileReadOnly" />
                                <label class="form-check-label">Allow FMLA Mark Off</label>
                            </div>
                            <div class="form-check form-switch form-check-reverse mb-3">
                                <InputCheckbox @bind-Value="profileModel.ProcessPayroll" class="form-check-input" disabled="@isProfileReadOnly" />
                                <label class="form-check-label">Process Payroll</label>
                            </div>
                            <div class="form-check form-switch form-check-reverse mb-3">
                                <InputCheckbox @bind-Value="profileModel.TieUpOffProperty" class="form-check-input" disabled="@isProfileReadOnly" />
                                <label class="form-check-label">Tie Up Off Property</label>
                            </div>
                        }
                    </div>
                </div>

                @if (!isProfileReadOnly)
                {
                    <div class="d-flex gap-2 justify-content-end mt-2">
                        <button type="button" class="btn btn-outline-secondary" @onclick="OnCancelProfileChanges" disabled="@isSaving">Cancel</button>
                        <button type="submit" class="btn btn-primary" disabled="@isSaving">
                            <span class="bi bi-check-circle me-1"></span> Save
                        </button>
                    </div>
                }
            </EditForm>
        }
    }

    @* ── User Settings Tab ── *@
    @if (activeTab == "usersettings")
    {
        <div class="mt-3">
            <h5>User Settings</h5>

            @if (!IsOwnRecord)
            {
                <p class="text-muted mb-0">User settings are only available when viewing your own employee record.</p>
            }
            else
            {
                <ul class="nav nav-pills mb-3 mt-3">
                    @foreach (var section in userSettingsSections)
                    {
                        <li class="nav-item">
                            <button type="button"
                                    class="nav-link @(section.Id == activeUserSettingsSection ? "active" : string.Empty)"
                                    @onclick="() => OnUserSettingsSectionChangedAsync(section.Id)">
                                @section.Label
                            </button>
                        </li>
                    }
                </ul>

                @if (activeUserSettingsSection == "settings")
                {
                    <p class="text-muted">Additional user settings will appear here.</p>
                }
                else if (activeUserSettingsSection == "theme")
                {
                    <UserSettingsBase />
                }
            }

        </div>
    }

    @* ── Work & Staffing Tab ── *@
    @if (activeTab == "work")
    {
        @if (workTabLoading)
        {
            <div class="d-flex align-items-center gap-2 mt-3">
                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                <span>Loading work information...</span>
            </div>
        }
        else
        {
            @* ── Seniority / Roster section ── *@
            <h5 class="mt-3">Seniority &amp; Roster</h5>

            @if ((workProfile?.SeniorityEntries.Count ?? 0) == 0)
            {
                <p class="text-muted">This employee has no seniority roster entries.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Roster</th>
                                <th>Seniority Date</th>
                                <th>Rank</th>
                                <th>Status</th>
                                <th>Current Position</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in workProfile!.SeniorityEntries.OrderBy(e => e.RosterDate))
                            {
                                <tr>
                                    <td class="fw-semibold">@entry.RosterName</td>
                                    <td>@(string.IsNullOrEmpty(entry.RosterDate) ? "—" : FormatDate(entry.RosterDate))</td>
                                    <td>@entry.Rank</td>
                                    <td>
                                        <span class="badge @GetSeniorityStateBadge(entry.SeniorityStateName)">
                                            @entry.SeniorityStateName
                                        </span>
                                    </td>
                                    <td>
                                        @(string.IsNullOrEmpty(entry.PositionName) ? "—" : entry.PositionName)
                                        @if (!string.IsNullOrEmpty(entry.PositionName))
                                        {
                                            <br /><small class="text-muted">@entry.DaysOnCurrentPosition day@(entry.DaysOnCurrentPosition == 1 ? "" : "s") on position</small>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex gap-1 flex-nowrap">
                                            <a class="btn btn-sm btn-outline-primary"
                                               href="/staffing/bulletins?craft=@entry.CraftCtrlNbr&employee=@CtrlNbr&canbid=@(workProfile?.CanBidOnBulletins ?? true)">
                                                <span class="bi bi-clipboard-check me-1"></span>Bulletins
                                                 @if (openBulletinCountsByCraft.TryGetValue(entry.CraftCtrlNbr, out var openBulletinCount) && openBulletinCount > 0)
                                                {
                                                     <span class="badge bg-secondary ms-1">@openBulletinCount</span>
                                                }
                                            </a>
                                            <a class="btn btn-sm btn-outline-secondary"
                                               href="/employees/seniority?roster=@entry.RosterCtrlNbr&craft=@entry.CraftCtrlNbr&employee=@CtrlNbr">
                                                <span class="bi bi-list-ol me-1"></span>Seniority List
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <hr />

            @* ── Seniority Moves section ── *@
            <h5>Seniority Moves</h5>

            @if ((workProfile?.Moves.Count ?? 0) == 0)
            {
                <p class="text-muted">No seniority moves on record for this employee.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Move Type</th>
                                <th>Moving To</th>
                                <th>Requested</th>
                                <th>Effective</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var move in workProfile!.Moves.OrderByDescending(m => m.RequestedLocal))
                            {
                                <tr>
                                    <td>@move.MoveType</td>
                                    <td>@(string.IsNullOrEmpty(move.TargetPositionName) ? "—" : move.TargetPositionName)</td>
                                    <td>@FormatDisplayLocal(move.RequestedLocal)</td>
                                    <td>@FormatDisplayLocal(move.EffectiveLocal)</td>
                                    <td>
                                        <span class="badge @GetMoveBadgeClass(move.Status)">@move.Status</span>
                                    </td>
                                    <td>
                                        <div class="d-flex gap-1 flex-nowrap">
                                            @* Cancel is available to staff with write access (admins) OR the
                                               employee viewing their own record. CanCancel encodes the
                                               status/cancel-window policy server-side. *@
                                            @if ((!IsFeatureReadOnly || IsOwnRecord) && move.CanCancel)
                                            {
                                                <button class="btn btn-sm btn-outline-warning"
                                                        @onclick="() => OpenWorkCancelModal(move)">
                                                    <span class="bi bi-slash-circle"></span> Cancel
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @* ── Open Bulletin Bids section ── *@
            <hr />
            <h5>Open Bulletin Bids</h5>

            @if ((workProfile?.Bids.Count ?? 0) == 0)
            {
                <p class="text-muted">No bulletin bids on record for this employee.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Position</th>
                                <th>Priority</th>
                                <th>Submitted</th>
                                <th>Window Closes</th>
                                <th>Effective</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var bid in workProfile!.Bids.OrderBy(b => b.Priority))
                            {
                                <tr>
                                    <td>@(string.IsNullOrEmpty(bid.PositionName) ? "—" : bid.PositionName)</td>
                                    <td>@bid.Priority</td>
                                    <td>@FormatDate(bid.SubmittedUtc)</td>
                                    <td>@FormatDisplayLocal(bid.BidWindowClosesLocal)</td>
                                    <td>@FormatDisplayLocal(bid.EffectiveLocal)</td>
                                    <td>
                                        <span class="badge @GetBidStatusBadge(bid.Status)">@bid.Status</span>
                                    </td>
                                    <td>
                                        <div class="d-flex gap-1 flex-nowrap">
                                            @* Withdraw is available to staff with write access OR the
                                               employee viewing their own record, mirroring Cancel Move.
                                               Only "Submitted" bids are surfaced, so all are withdrawable. *@
                                            @if ((!IsFeatureReadOnly || IsOwnRecord) && bid.Status == "Submitted")
                                            {
                                                <button class="btn btn-sm btn-outline-danger"
                                                        @onclick="() => OpenWithdrawBidModal(bid)">
                                                    <span class="bi bi-x-circle"></span> Withdraw
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @* ── Open On-Duty Records section ── *@
            <hr />
            <h5>Open On-Duty Records</h5>

            @if (openOnDutyRecords.Count == 0)
            {
                <p class="text-muted">This employee has no open on-duty records.</p>
            }
            else
            {
                @RenderOnDutyTable(openOnDutyRecords, isHistory: false)
            }
        }
    }

    @* ── Cancel Move Modal (Work tab) ── *@
    <Modal Visible="showWorkCancelModal"
           Title="Cancel Seniority Move"
           Icon="bi bi-slash-circle"
           OnClose="() => showWorkCancelModal = false">
        <BodyContent>
            <p>Cancel this seniority move for <strong>@employee?.FullNameLnf</strong>?</p>
            <div class="mb-3">
                <label class="form-label fw-semibold">Reason <span class="text-danger">*</span></label>
                <textarea class="form-control" rows="3" @bind="workActionReason" placeholder="Reason for cancellation..."></textarea>
            </div>
        </BodyContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="() => showWorkCancelModal = false">Cancel</button>
            <button type="button" class="btn btn-warning" @onclick="ConfirmWorkCancel"
                    disabled="@(isSaving || string.IsNullOrWhiteSpace(workActionReason))">
                <span class="bi bi-slash-circle me-1"></span> Cancel Move
            </button>
        </Footer>
    </Modal>

    @* ── Withdraw Bid Modal (Work tab) ── *@
    <Modal Visible="showWithdrawBidModal"
           Title="Withdraw Bulletin Bid"
           Icon="bi bi-x-circle"
           OnClose="() => showWithdrawBidModal = false"
           StaticBackdrop="true">
        <BodyContent>
            <p>
                Withdraw <strong>@employee?.FullNameLnf</strong>'s bid
                @if (!string.IsNullOrEmpty(withdrawBidPositionName))
                {
                    <text>for <strong>@withdrawBidPositionName</strong></text>
                }?
            </p>
            <div class="alert alert-warning mb-0">
                <span class="bi bi-exclamation-triangle me-1"></span>
                Once withdrawn, the bid is removed from consideration and cannot be restored. A new bid
                would need to be submitted while the bid window is still open.
            </div>
        </BodyContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="() => showWithdrawBidModal = false">Keep Bid</button>
            <button type="button" class="btn btn-danger" @onclick="ConfirmWithdrawBid" disabled="@isSaving">
                @if (isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                <span class="bi bi-x-circle me-1"></span> Withdraw Bid
            </button>
        </Footer>
    </Modal>

    @* ── Profile: Addresses section ── *@
    @if (activeTab == "profile" && activeProfileSection == "addresses")
    {
        <hr />
        <h5>Addresses</h5>

        <Modal Visible="showAddrModal" Title="@(editAddrCtrlNbr > 0 ? "Edit Address" : "Add Address")"
               Icon="@(editAddrCtrlNbr > 0 ? "bi bi-pencil" : "bi bi-plus-circle")"
               OnClose="CloseAddrModal" Size="lg">
            <BodyContent>
                <EditForm Model="addrModel" OnValidSubmit="OnSaveAddr" id="save-addr-form">
                    <DataAnnotationsValidator />
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Type</label>
                            <SelectInput TItem="AddressTypeResponse" TValue="long"
                                         Items="addressTypes"
                                         ValueSelector="t => t.CtrlNbr"
                                         TextSelector="t => t.Name"
                                         @bind-Value="addrModel.AddressTypeCtrlNbr"
                                         Placeholder="-- Select Type --"
                                         class="form-select"
                                         disabled="@(editAddrCtrlNbr > 0)" />
                            <ValidationMessage For="() => addrModel.AddressTypeCtrlNbr" class="text-danger" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Address 1</label>
                            <InputText @bind-Value="addrModel.Address1" class="form-control" placeholder="Address 1" />
                            <ValidationMessage For="() => addrModel.Address1" class="text-danger" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Address 2</label>
                            <InputText @bind-Value="addrModel.Address2" class="form-control" placeholder="Address 2" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">City</label>
                            <InputText @bind-Value="addrModel.City" class="form-control" placeholder="City" />
                            <ValidationMessage For="() => addrModel.City" class="text-danger" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">State</label>
                            <InputText @bind-Value="addrModel.State" class="form-control" placeholder="State" />
                            <ValidationMessage For="() => addrModel.State" class="text-danger" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Zip Code</label>
                            <InputText @bind-Value="addrModel.ZipCode" class="form-control" placeholder="Zip Code" />
                            <ValidationMessage For="() => addrModel.ZipCode" class="text-danger" />
                        </div>
                    </div>
                </EditForm>
            </BodyContent>
            <Footer>
                <button type="button" class="btn btn-outline-secondary" @onclick="CloseAddrModal">Cancel</button>
                <button type="submit" form="save-addr-form" class="btn btn-primary" disabled="@isSaving">
                    <span class="bi bi-check-circle me-1"></span> @(editAddrCtrlNbr > 0 ? "Update" : "Add")
                </button>
            </Footer>
        </Modal>

        <ConfirmModal Visible="showAddrDeleteModal" ItemName="@deleteAddrLabel" IsSaving="isSaving"
                      OnConfirm="ConfirmDeleteAddr" OnCancel="() => showAddrDeleteModal = false" />

        <div class="d-flex justify-content-between align-items-center mb-3 mt-3">
            @if (!IsFeatureReadOnly)
            {
                <button class="btn btn-primary" @onclick="OpenCreateAddrModal">
                    <span class="bi bi-plus-circle"></span> Add Address
                </button>
            }
        </div>

        @if (employee.Addresses.Count == 0)
        {
            <p class="text-muted">No addresses on file.</p>
        }
        else
        {
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Type</th><th>Address 1</th><th>Address 2</th><th>City</th><th>State</th><th>Zip</th><th style="width:180px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var addr in employee.Addresses)
                    {
                        <tr>
                            <td>@(addressTypes.FirstOrDefault(t => t.CtrlNbr == addr.AddressTypeCtrlNbr)?.Name)</td>
                            <td>@addr.Address1</td>
                            <td>@addr.Address2</td>
                            <td>@addr.City</td>
                            <td>@addr.State</td>
                            <td>@addr.ZipCode</td>
                            <td>
                                @if (!IsFeatureReadOnly)
                                {
                                    <div class="d-flex gap-1">
                                        <button class="btn btn-sm btn-outline-primary flex-fill" @onclick="() => OpenEditAddrModal(addr)">
                                            <span class="bi bi-pencil"></span> Edit
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger flex-fill" @onclick="() => OpenDeleteAddrModal(addr)">
                                            <span class="bi bi-trash"></span> Delete
                                        </button>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }

    @* ── Profile: Email Addresses section ── *@
    @if (activeTab == "profile" && activeProfileSection == "emails")
    {
        <hr />
        <h5>Email Addresses</h5>

        <Modal Visible="showEmailModal" Title="@(editEmailCtrlNbr > 0 ? "Edit Email Address" : "Add Email Address")"
               Icon="@(editEmailCtrlNbr > 0 ? "bi bi-pencil" : "bi bi-plus-circle")"
               OnClose="CloseEmailModal">
            <BodyContent>
                <EditForm Model="emailModel" OnValidSubmit="OnSaveEmail" id="save-email-form">
                    <DataAnnotationsValidator />
                    <div class="row g-2">
