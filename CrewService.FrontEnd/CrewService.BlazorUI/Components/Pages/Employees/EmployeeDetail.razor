        "ExpiringSoon"=> "text-bg-warning",
        "Renew"       => "text-bg-warning",
        "Expired"     => "text-bg-danger",
        "Revoked"     => "text-bg-dark",
        "Suspended"   => "text-bg-secondary",
        "Pending"     => "text-bg-info",
        _             => "text-bg-secondary"
    };

    private void OpenRevokeModal(EmployeeQualificationResponse eq)
    {
        revokeQualCtrlNbr = eq.CtrlNbr;
        revokeQualLabel = ResolveQualCode(eq.QualificationTypeCtrlNbr);
        showRevokeModal = true;
    }

    private async Task GrantQualification()
    {
        if (employee is null) return;
        try
        {
            isSaving = true; errorMessage = null;
            var request = new GrantEmployeeQualificationRequest
            {
                EmployeeCtrlNbr = employee.CtrlNbr,
                QualificationTypeCtrlNbr = grantModel.QualificationTypeCtrlNbr,
                GrantedBy = string.IsNullOrWhiteSpace(grantModel.GrantedBy) ? "SYSTEM" : grantModel.GrantedBy,
                Status = string.IsNullOrWhiteSpace(grantModel.Status) ? "Active" : grantModel.Status,
                EvidenceValue = grantModel.EvidenceValue ?? string.Empty
            };
            if (grantModel.ExpiresAtUtc.HasValue)
                request.ExpiresAtUtc = Google.Protobuf.WellKnownTypes.Timestamp.FromDateTime(
                    DateTime.SpecifyKind(grantModel.ExpiresAtUtc.Value, DateTimeKind.Utc));
            await QualificationsClient.GrantEmployeeQualificationAsync(request);
            CloseGrantModal();
            successMessage = "Qualification granted.";
            var qualTask = QualificationsClient.GetEmployeeQualificationsAsync(employee.CtrlNbr);
            await qualTask;
            employeeQualifications = [.. qualTask.Result.Qualifications.OrderByDescending(q => q.AchievedAtUtc?.ToDateTime())];
        }
        catch (Exception ex) { errorMessage = $"Failed to grant qualification: {ex.Message}"; }
        finally { isSaving = false; }
    }

    private async Task ConfirmRevokeQual()
    {
        try
        {
            isSaving = true; errorMessage = null;
            await QualificationsClient.RevokeEmployeeQualificationAsync(revokeQualCtrlNbr, "Manually revoked");
            showRevokeModal = false;
            successMessage = "Qualification revoked.";
            if (employee is not null)
            {
                var r = await QualificationsClient.GetEmployeeQualificationsAsync(employee.CtrlNbr);
                employeeQualifications = [.. r.Qualifications.OrderByDescending(q => q.AchievedAtUtc?.ToDateTime())];
            }
        }
        catch (Exception ex) { errorMessage = $"Failed to revoke qualification: {ex.Message}"; showRevokeModal = false; }
        finally { isSaving = false; }
    }

    private async Task ConfirmSuspendQual()
    {
        if (employee is null) return;
        try
        {
            isSaving = true; errorMessage = null;
            await QualificationsClient.SuspendComputedQualificationAsync(
                employee.CtrlNbr,
                suspendQualTypeCtrlNbr,
                suspendModel.SuspendedBy ?? CurrentUser.Username ?? "SYSTEM",
                suspendModel.Reason ?? string.Empty,
                suspendModel.SuspendedAtUtc.HasValue ? suspendModel.SuspendedAtUtc.Value.ToUniversalTime() : (DateTime?)null,
                suspendModel.AutoReinstateAtUtc.HasValue ? suspendModel.AutoReinstateAtUtc.Value.ToUniversalTime() : (DateTime?)null);
            CloseSuspendModal();
            successMessage = "Qualification suspended.";
            var r = await QualificationsClient.GetEmployeeQualificationsAsync(employee.CtrlNbr);
            employeeQualifications = [.. r.Qualifications.OrderByDescending(q => q.AchievedAtUtc?.ToDateTime())];
        }
        catch (Exception ex) { errorMessage = $"Failed to suspend qualification: {ex.Message}"; }
        finally { isSaving = false; }
    }

    private async Task ConfirmLiftSuspension()
    {
        if (employee is null) return;
        try
        {
            isSaving = true; errorMessage = null;
            await QualificationsClient.LiftQualificationSuspensionAsync(
                liftSuspensionCtrlNbr,
                liftModel.ReinstatedBy ?? CurrentUser.Username ?? "SYSTEM",
                liftModel.Note);
            CloseLiftModal();
            successMessage = "Suspension lifted.";
            var r = await QualificationsClient.GetEmployeeQualificationsAsync(employee.CtrlNbr);
            employeeQualifications = [.. r.Qualifications.OrderByDescending(q => q.AchievedAtUtc?.ToDateTime())];
        }
        catch (Exception ex) { errorMessage = $"Failed to lift suspension: {ex.Message}"; }
        finally { isSaving = false; }
    }

    private List<EmployeeQualificationResponse> GetRailroadQualifications()
    {
        var fraTypeCtrlNbrs = qualificationTypes
            .Where(q => string.Equals(q.EvaluationStrategy, "FraCertification", StringComparison.Ordinal))
            .Select(q => q.CtrlNbr)
            .ToHashSet();
        return employeeQualifications.Where(q => !fraTypeCtrlNbrs.Contains(q.QualificationTypeCtrlNbr)).ToList();
    }

    private sealed class GrantQualificationModel
    {
        public long QualificationTypeCtrlNbr { get; set; }
        public string? Status { get; set; }
        public string? GrantedBy { get; set; }
        public DateTime? ExpiresAtUtc { get; set; }
        public string? EvidenceValue { get; set; }
    }

    private sealed class SuspendQualificationModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Reason is required.")]
        public string? Reason { get; set; }
        public string? SuspendedBy { get; set; }
        public DateTime? SuspendedAtUtc { get; set; }
        public DateTime? AutoReinstateAtUtc { get; set; }
    }

    private sealed class LiftSuspensionModel
    {
        public string? Note { get; set; }
        public string? ReinstatedBy { get; set; }
    }
}
