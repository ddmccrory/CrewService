    private void ApplyRequestedTabFromQuery()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        // No tab in the URL => fresh entry, default to Work & Staffing.
        if (!query.TryGetValue("tab", out var tabValues))
        {
            activeTab = "work";
            return;
        }

        var requestedTab = tabValues.ToString().Trim().ToLowerInvariant();
        activeTab = tabs.Any(t => t.Id.Equals(requestedTab, StringComparison.OrdinalIgnoreCase))
            ? requestedTab
            : "work";
    }

    private void ApplyRequestedSubSectionsFromQuery()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (!query.TryGetValue("section", out var sectionValues))
        {
            activeProfileSection = "profile";
        }
        else
        {
            var requestedSection = sectionValues.ToString().Trim().ToLowerInvariant();
            if (profileSections.Any(s => s.Id.Equals(requestedSection, StringComparison.OrdinalIgnoreCase)))
            {
                activeProfileSection = requestedSection;
            }
        }

        if (!query.TryGetValue("settings", out var settingsValues))
        {
            activeUserSettingsSection = "settings";
        }
        else
        {
            var requestedSettingsSection = settingsValues.ToString().Trim().ToLowerInvariant();
            if (userSettingsSections.Any(s => s.Id.Equals(requestedSettingsSection, StringComparison.OrdinalIgnoreCase)))
            {
                activeUserSettingsSection = requestedSettingsSection;
            }
        }
    }

