    /// <summary>
    /// Renders the shared on-duty records table (used by both the Work tab open records and the
    /// On-Duty History tab). Legacy action buttons are rendered disabled for now — the backend
    /// operations behind them are deferred to a later phase.
    /// </summary>
    private RenderFragment RenderOnDutyTable(IReadOnlyList<EmployeeOnDutyRecord> records, bool isHistory) => __builder =>
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Prev Rest</th>
                        <th>Assignment</th>
                        <th>Location</th>
                        <th>On Duty</th>
                        <th>Off Duty</th>
                        <th>Total Time</th>
                        <th>CDs</th>
                        <th>Assigned</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in records)
                    {
                        <tr>
                            <td>@FormatRestHours(r.PreviousRestHours)</td>
                            <td>
                                <strong>@(string.IsNullOrEmpty(r.AssignmentCode) ? "—" : r.AssignmentCode.ToUpperInvariant())</strong>
                                @if (!string.IsNullOrEmpty(r.CrewName))
                                {
                                    <span class="small ms-1">(@r.CrewName)</span>
                                }
                            </td>
                            <td>@(string.IsNullOrEmpty(r.Location) ? "—" : r.Location.ToUpperInvariant())</td>
                            <td>@FormatDisplayLocal(r.OnDutyLocal)</td>
                            <td>@FormatDisplayLocal(r.OffDutyLocal)</td>
                            <td>@FormatTotalTime(r.TotalTimeOnDutyMin)</td>
                            <td>@r.ConsecutiveDays</td>
                            <td>
                                @if (r.IsAssigned)
                                {
                                    <span class="badge bg-info text-dark">Assigned</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                <span class="badge @GetOnDutyStatusBadge(r.Status)">@r.Status</span>
                                @if (r.IsLateCall)
                                {
                                    <span class="badge bg-warning text-dark ms-1">Late</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-1 flex-nowrap">
                                    @if (isHistory)
                                    {
                                        <button class="btn btn-sm btn-outline-secondary" disabled title="Coming soon">
                                            <span class="bi bi-eye"></span> Review
                                        </button>
                                        <button class="btn btn-sm btn-outline-primary" disabled title="Coming soon">
                                            <span class="bi bi-pencil"></span> Change
                                        </button>
                                        <button class="btn btn-sm btn-outline-dark" disabled title="Coming soon">
                                            <span class="bi bi-cash-stack"></span> Reprocess Payroll
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-success" disabled title="Coming soon">
                                            <span class="bi bi-check2-circle"></span> Complete
                                        </button>
                                        <button class="btn btn-sm btn-outline-info" disabled title="Coming soon">
                                            <span class="bi bi-arrow-up-circle"></span> Move to Foreman
                                        </button>
                                        <button class="btn btn-sm btn-outline-warning" disabled title="Coming soon">
                                            <span class="bi bi-clock"></span> Confirm On-Duty Time
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    };

    private static string FormatRestHours(string previousRestHours)
        => string.IsNullOrWhiteSpace(previousRestHours) ? "—" : $"{previousRestHours} hrs";

    private static string FormatTotalTime(int totalMinutes)
    {
        if (totalMinutes <= 0) return "—";
        var hours = totalMinutes / 60;
        var minutes = totalMinutes % 60;
        return $"{hours}h {minutes:00}m";
    }

