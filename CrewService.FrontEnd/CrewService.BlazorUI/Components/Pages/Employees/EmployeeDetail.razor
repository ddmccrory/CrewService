    private async Task OnTabChangedAsync(string tab)
    {
        activeTab = tab;

        if (tab != "profile")
        {
            activeProfileSection = "profile";
        }

        var sectionQuery = tab == "profile"
            ? $"&section={activeProfileSection}"
            : (tab == "usersettings" ? $"&settings={activeUserSettingsSection}" : string.Empty);
        Nav.NavigateTo($"/employees/{CtrlNbr}?tab={tab}{sectionQuery}", replace: true);

        if (tab == "work" && !workTabLoaded)
            await LoadWorkTabAsync();
        else if (tab == "ondutyhistory" && !onDutyHistoryLoaded)
            await LoadOnDutyHistoryAsync();
        else if (tab == "notifications" && !notificationsLoaded)
            await LoadNotificationsTabAsync();
    }

