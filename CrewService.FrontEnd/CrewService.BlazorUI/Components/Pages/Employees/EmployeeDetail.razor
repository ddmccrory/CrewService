    private async Task OnSaveProfileAsync()
    {
        if (employee is null || isProfileReadOnly)
        {
            return;
        }

        try
        {
            isSaving = true;
            errorMessage = null;
            successMessage = null;

            var messages = new List<string>();

            var profileResponse = await AccountClient.SaveProfileAsync(
                CurrentUser.Username ?? string.Empty,
                profileModel.FirstName ?? string.Empty,
                profileModel.MiddleName ?? string.Empty,
                profileModel.LastName ?? string.Empty);

            if (!profileResponse.Success)
            {
                messages.Add("Profile: " + string.Join("; ", profileResponse.Message));
            }

            var employeeResponse = await ProfileService.SaveAsync(
                employee.CtrlNbr,
                profileModel,
                employee,
                CurrentUser.IsAdmin);

            if (!employeeResponse.Success)
            {
                messages.Add("Employee: " + string.Join("; ", employeeResponse.Messages));
            }

            if (messages.Count > 0)
            {
                errorMessage = string.Join(" | ", messages);
                return;
            }

            if (!string.IsNullOrWhiteSpace(profileResponse.FullName))
            {
                AppContext.SetDisplayName(profileResponse.FullName);
            }

            successMessage = "Profile has been updated.";
            await ReloadEmployee();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save profile: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void OnCancelProfileChanges()
