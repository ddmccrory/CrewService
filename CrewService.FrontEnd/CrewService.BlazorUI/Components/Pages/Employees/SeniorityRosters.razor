    private async Task OpenMoveToBoardModal()
    {
        var emp = seniorityEntries?.FirstOrDefault(s => s.EmployeeCtrlNbr == FilterEmployeeCtrlNbr);
        lockedEmployeeName = emp is not null
            ? $"{emp.EmployeeFullNameLnf} ({emp.EmployeeNumber.ToUpperInvariant()})"
            : FilterEmployeeCtrlNbr.ToString();

        // Build the board option list for the shared dialog.
        eligibleBoardItems = eligibleBoards
            .Select(b => new SeniorityMoveNamedItem(b.CtrlNbr, b.Name))
            .ToList();

        var presetBoard = eligibleBoards.Count == 1 ? eligibleBoards[0].CtrlNbr : 0;
        moveToBoardModal?.SeedBoard(
            craftCtrlNbr:       selectedCraftCtrlNbr,
            employeeCtrlNbr:    FilterEmployeeCtrlNbr,
            targetBoardCtrlNbr: presetBoard);

        previewEffectiveUtc = string.Empty;
        previewWillWorkOffered = false;
        errorMessage = null;
        showMoveToBoardModal = true;

        // If the board is already determined, fetch the effective-date preview.
        if (presetBoard > 0)
            await LoadMoveToBoardPreviewAsync(presetBoard);
    }

