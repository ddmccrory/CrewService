        [Required(ErrorMessage = "Rank is required.")]
        [Range(1, 9999, ErrorMessage = "Rank must be between 1 and 9999.")]
        public int Rank { get; set; }

        [Required(ErrorMessage = "Seniority date is required.")]
        public DateTime RosterDate { get; set; } = DateTime.Today;

        [Range(1, long.MaxValue, ErrorMessage = "Seniority state is required.")]
        public long SeniorityStateCtrlNbr { get; set; }

        /// <summary>The state as it was when the modal opened — used to avoid applying the new state immediately when scheduling.</summary>
        public long OriginalSeniorityStateCtrlNbr { get; set; }

        /// <summary>When set to a future time, the state change is scheduled rather than applied immediately.</summary>
        public DateTime? StateEffectiveDate { get; set; } = DateTime.Today.AddDays(1).AddMinutes(1);

        public bool CanTrain { get; set; }
        public bool LastActiveRoster { get; set; } = true;
    }

