    private async Task OnSave()
    {
        try
        {
            isSaving = true;
            errorMessage = null;
            successMessage = null;

            if (editCtrlNbr > 0)
            {
                var isScheduling = saveModel.StateEffectiveDate.HasValue
                    && saveModel.StateEffectiveDate.Value > DateTime.Now
                    && saveModel.SeniorityStateCtrlNbr != saveModel.OriginalSeniorityStateCtrlNbr;

                // Always update rank, date, canTrain, lastActiveRoster immediately.
                // When scheduling a future state change, keep the current (original) state so it
                // is NOT applied right now — only the scheduled worker should apply it.
                await SeniorityClient.UpdateAsync(new UpdateSeniorityRequest
                {
                    CtrlNbr = editCtrlNbr,
                    Rank = saveModel.Rank,
                    RosterDate = saveModel.RosterDate.ToString("yyyy-MM-dd"),
                    SeniorityStateCtrlNbr = isScheduling ? saveModel.OriginalSeniorityStateCtrlNbr : saveModel.SeniorityStateCtrlNbr,
                    CanTrain = saveModel.CanTrain,
                    LastActiveRoster = saveModel.LastActiveRoster
                });

                // If a future effective date was provided for the state change, schedule it.
                if (isScheduling)
                {
                    // Convert the locally-entered datetime to UTC using the work area's configured
                    // timezone. Fall back to treating it as UTC if no timezone is set.
                    var workAreaTzId = workAreas?.FirstOrDefault(w => w.CtrlNbr == selectedWorkAreaCtrlNbr)?.TimeZoneId;
                    DateTime effectiveDateUtc;
                    if (!string.IsNullOrWhiteSpace(workAreaTzId) &&
                        TimeZoneInfo.TryFindSystemTimeZoneById(workAreaTzId, out var workAreaTz))
                    {
                        effectiveDateUtc = TimeZoneInfo.ConvertTimeToUtc(
                            DateTime.SpecifyKind(saveModel.StateEffectiveDate!.Value, DateTimeKind.Unspecified),
                            workAreaTz);
                    }
                    else
                    {
                        effectiveDateUtc = DateTime.SpecifyKind(saveModel.StateEffectiveDate!.Value, DateTimeKind.Utc);
                    }

                    await SeniorityClient.ScheduleStateChangeAsync(
                        editCtrlNbr,
                        saveModel.SeniorityStateCtrlNbr,
                        effectiveDateUtc);
                    successMessage = $"Seniority entry updated. State change scheduled for {saveModel.StateEffectiveDate.Value:g}.";
                }
                else
                {
                    successMessage = "Seniority entry updated.";
                }
            }
            else
            {
                await SeniorityClient.CreateAsync(new CreateSeniorityRequest
                {
                    RosterCtrlNbr = selectedRosterCtrlNbr,
                    EmployeeCtrlNbr = saveModel.EmployeeCtrlNbr,
                    Rank = saveModel.Rank,
                    RosterDate = saveModel.RosterDate.ToString("yyyy-MM-dd"),
                    SeniorityStateCtrlNbr = saveModel.SeniorityStateCtrlNbr,
                    CanTrain = saveModel.CanTrain,
                    LastActiveRoster = saveModel.LastActiveRoster
                });
                successMessage = "Employee added to roster.";
            }

            CloseSaveModal();
            await LoadSeniorityEntries();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save seniority entry: {ex.Message}";
        }
        finally { isSaving = false; }
    }

    private async Task ConfirmDelete()
    {
