    private async Task OpenRequestMoveModal(SeniorityResponse targetEntry)
    {
        lockedDisplacedEmployeeName = BuildLockedDisplacedName(targetEntry);

        var movingEmp = seniorityEntries?.FirstOrDefault(s => s.EmployeeCtrlNbr == FilterEmployeeCtrlNbr);
        lockedEmployeeName = movingEmp is not null
            ? $"{movingEmp.EmployeeFullNameLnf} ({movingEmp.EmployeeNumber.ToUpperInvariant()})"
            : FilterEmployeeCtrlNbr.ToString();

        // Pass the position ctrl nbr directly; API will also accept displaced employee as fallback.
        requestMoveModal?.Seed(
            craftCtrlNbr:             selectedCraftCtrlNbr,
            employeeCtrlNbr:          FilterEmployeeCtrlNbr,
            targetPositionCtrlNbr:    targetEntry.StaffablePositionCtrlNbr,
            displacedEmployeeCtrlNbr: targetEntry.EmployeeCtrlNbr);

        previewEffectiveUtc = string.Empty;
        previewWillWorkOffered = false;
        errorMessage = null;
        showRequestMoveModal = true;

        // Fetch the effective date preview from the server.
        try
        {
            var preview = await PoliciesClient.PreviewSeniorityMoveEffectiveDateAsync(
                new PreviewSeniorityMoveEffectiveDateRequest
                {
                    RailroadCtrlNbr       = SelectedRailroadCtrlNbr ?? 0,
                    EmployeeCtrlNbr       = FilterEmployeeCtrlNbr,
                    CraftCtrlNbr          = selectedCraftCtrlNbr,
                    TargetPositionCtrlNbr = targetEntry.StaffablePositionCtrlNbr
                });
            previewEffectiveUtc = preview.EffectiveUtc;
            previewWillWorkOffered = preview.WillWorkOffered;
        }
        catch { /* non-fatal: dialog shows 'Calculating…' if preview fails */ }
    }

    private void CloseRequestMoveModal()
    {
        showRequestMoveModal = false;
        previewEffectiveUtc = string.Empty;
        previewWillWorkOffered = false;
        errorMessage = null;
    }

