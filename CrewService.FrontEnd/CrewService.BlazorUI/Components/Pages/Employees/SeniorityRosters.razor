    private async Task OpenEditModal(SeniorityResponse entry)
    {
        isLoading = true;
        try
        {
            await EnsureSeniorityStatesLoaded();
            editCtrlNbr = entry.CtrlNbr;
            editEmployeeDisplay = $"{entry.EmployeeNumber.ToUpperInvariant()} — {entry.EmployeeFullNameLnf}";
            saveModel = new()
            {
                EmployeeCtrlNbr = entry.EmployeeCtrlNbr,
                Rank = entry.Rank,
                RosterDate = DateTime.TryParse(entry.RosterDate, out var dt) ? dt : DateTime.Today,
                SeniorityStateCtrlNbr = entry.SeniorityStateCtrlNbr,
                OriginalSeniorityStateCtrlNbr = entry.SeniorityStateCtrlNbr,
                CanTrain = entry.CanTrain,
                LastActiveRoster = entry.LastActiveRoster
            };

            // Load any existing pending state change so the banner shows in the modal.
            try
            {
                var pending = await SeniorityClient.GetPendingStateChangeAsync(entry.CtrlNbr);
                pendingChange = pending.Found ? pending : null;
            }
            catch
            {
                pendingChange = null;
            }

            showSaveModal = true;
        }
        finally { isLoading = false; }
    }

