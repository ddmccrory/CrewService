        => !string.IsNullOrEmpty(e.FullNameLnf) ? e.FullNameLnf : e.UserId;

    private static string BuildLockedDisplacedName(SeniorityResponse s)
    {
        var name = string.IsNullOrWhiteSpace(s.EmployeeFullNameLnf)
            ? s.EmployeeCtrlNbr.ToString()
            : s.EmployeeFullNameLnf;
        var num = string.IsNullOrWhiteSpace(s.EmployeeNumber) ? "" : $" ({s.EmployeeNumber.ToUpperInvariant()})";
        var pos = string.IsNullOrWhiteSpace(s.PositionName) ? "" : $" — {s.PositionName}";
        return $"{name}{num}{pos}";
    }
