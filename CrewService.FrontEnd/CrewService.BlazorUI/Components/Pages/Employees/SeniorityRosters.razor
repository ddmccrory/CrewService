    private IReadOnlyList<GetEmployeeResponse> AvailableEmployees
    {
        get
        {
            if (employees is null) return [];
            if (seniorityEntries is null or { Count: 0 }) return employees;
            var onRoster = new HashSet<long>(seniorityEntries.Select(s => s.EmployeeCtrlNbr));
            return employees.Where(e => !onRoster.Contains(e.CtrlNbr)).ToList();
        }
