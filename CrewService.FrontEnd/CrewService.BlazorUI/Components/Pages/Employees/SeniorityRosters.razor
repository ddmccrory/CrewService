@page "/employees/seniority"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using CrewService.BlazorUI.Clients
@using CrewService.BlazorUI.Models
@using CrewService.Presentation

@inherits AppComponentBase

@attribute [Authorize]

@inject RosterClient RosterClient
@inject CraftClient CraftClient
@inject SeniorityClient SeniorityClient
@inject EmployeeClient EmployeeClient
@inject SeniorityStateClient StateClient
@inject RailroadReferenceDataService ReferenceData
@inject PoliciesClient PoliciesClient
@inject RosterBoardClient RosterBoardClient

<PageTitle>Seniority Rosters</PageTitle>

@if (FilterEmployeeCtrlNbr > 0)
{
    <BackNavButton Text="Employee" FallbackUrl="@($"/employees/{FilterEmployeeCtrlNbr}")" />
}

<h1>Seniority Rosters</h1>
<p class="text-muted">Manage employees ranked on seniority rosters.</p>

@if (IsInitializing)
{
    <div class="d-flex align-items-center gap-2 mt-3">
        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
        <span>Loading...</span>
    </div>
}
else if (!IsContextFullySelected)
{
    <div class="alert alert-warning">
        <span class="bi bi-exclamation-triangle"></span>
        Please select a parent and railroad in the context switcher to view seniority rosters.
    </div>
}
else
{
    @* ── Request Seniority Move Modal (employee context) ────────────────── *@
    <RequestSeniorityMoveModal @ref="requestMoveModal"
                               Visible="showRequestMoveModal"
                               IsSaving="isRequestingMove"
                               LockedEmployee="true"
                               RailroadCtrlNbr="@(SelectedRailroadCtrlNbr ?? 0)"
                               LockedCraftName="@(crafts?.FirstOrDefault(c => c.CtrlNbr == selectedCraftCtrlNbr)?.CraftName ?? string.Empty)"
                               LockedEmployeeName="@lockedEmployeeName"
                               LockedDisplacedEmployeeName="@lockedDisplacedEmployeeName"
                               PreviewEffectiveUtc="@previewEffectiveUtc"
                               WillWorkOffered="@previewWillWorkOffered"
                               OnConfirm="ConfirmRequestMove"
                               OnCancel="CloseRequestMoveModal" />

    @* ── Move to Board modal (employee context) — same dialog as Request Move ── *@
    <RequestSeniorityMoveModal @ref="moveToBoardModal"
                               Visible="showMoveToBoardModal"
                               IsSaving="isMovingToBoard"
                               BoardMode="true"
                               LockedEmployee="true"
                               RailroadCtrlNbr="@(SelectedRailroadCtrlNbr ?? 0)"
                               LockedCraftName="@(crafts?.FirstOrDefault(c => c.CtrlNbr == selectedCraftCtrlNbr)?.CraftName ?? string.Empty)"
                               LockedEmployeeName="@lockedEmployeeName"
                               Boards="@eligibleBoardItems"
                               PreviewEffectiveUtc="@previewEffectiveUtc"
                               WillWorkOffered="@previewWillWorkOffered"
                               OnBoardChanged="OnMoveToBoardSelectionChanged"
                               OnConfirm="ConfirmMoveToBoard"
                               OnCancel="CloseMoveToBoardModal" />

    <Modal Visible="showSaveModal" Title="@(editCtrlNbr > 0 ? "Edit Seniority Entry" : "Add Employee to Roster")"
           Icon="@(editCtrlNbr > 0 ? "bi bi-pencil" : "bi bi-plus-circle")"
           OnClose="CloseSaveModal">
        <BodyContent>
            <EditForm Model="saveModel" OnValidSubmit="OnSave" id="save-seniority-form">
                <DataAnnotationsValidator />
                @if (editCtrlNbr == 0)
                {
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Employee</label>
                        <SelectInput TItem="GetEmployeeResponse" TValue="long"
                                     Items="AvailableEmployees"
                                     @bind-Value="saveModel.EmployeeCtrlNbr"
                                     ValueSelector="@(e => e.CtrlNbr)"
                                     TextSelector="@(e => $"{e.EmployeeNumber.ToUpperInvariant()} — {FormatEmployeeName(e)}")"
                                     Placeholder="— Select an employee —"
                                     class="form-select" />
                        <ValidationMessage For="() => saveModel.EmployeeCtrlNbr" class="text-danger" />
                    </div>
                }
                else
                {
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Employee</label>
                        <input type="text" class="form-control" value="@editEmployeeDisplay" disabled />
                    </div>
                }
                <div class="mb-3">
                    <label class="form-label fw-semibold">Rank</label>
                    <InputNumber @bind-Value="saveModel.Rank" class="form-control" />
                    <ValidationMessage For="() => saveModel.Rank" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Seniority Date</label>
                    <InputDate @bind-Value="saveModel.RosterDate" class="form-control" />
                    <ValidationMessage For="() => saveModel.RosterDate" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Seniority State</label>
                    <SelectInput TItem="SeniorityStateResponse" TValue="long"
                                 Items="seniorityStates"
                                 @bind-Value="saveModel.SeniorityStateCtrlNbr"
                                 ValueSelector="@(s => s.CtrlNbr)"
                                 TextSelector="@(s => s.StateDescription)"
                                 Placeholder="— Select a state —"
                                 class="form-select" />
                    <ValidationMessage For="() => saveModel.SeniorityStateCtrlNbr" class="text-danger" />
                </div>
                @if (editCtrlNbr > 0)
                {
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Effective Date &amp; Time
                            <span class="text-muted fw-normal small ms-1">(leave blank to apply immediately)</span>
                        </label>
                        <div class="input-group">
                            <InputDate Type="InputDateType.DateTimeLocal" @bind-Value="saveModel.StateEffectiveDate" class="form-control" />
                            <button type="button" class="btn btn-outline-secondary" @onclick="() => saveModel.StateEffectiveDate = DateTime.Now" title="Set to now">Now</button>
                        </div>
                    </div>
                    @if (pendingChange is not null)
                    {
                        <div class="alert alert-info d-flex align-items-center gap-2 py-2" role="alert">
                            <span class="bi bi-clock-history"></span>
                            <div class="flex-grow-1">
                                <strong>Scheduled:</strong>
                                → <strong>@(seniorityStates?.FirstOrDefault(s => s.CtrlNbr == pendingChange.ToStateCtrlNbr)?.StateDescription ?? pendingChange.ToStateCtrlNbr.ToString())</strong>
                                on <strong>@DateTime.Parse(pendingChange.EffectiveDateUtc).ToLocalTime().ToString("g")</strong>
                            </div>
                            @if (IsAdminUser)
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger" disabled="@isSaving" @onclick="CancelPendingChange">
                                    <span class="bi bi-x-circle me-1"></span> Cancel
                                </button>
                            }
                        </div>
                    }
                }
                <div class="mb-3 form-check form-switch">
                    <InputCheckbox @bind-Value="saveModel.CanTrain" class="form-check-input" id="canTrainCheck" />
                    <label class="form-check-label" for="canTrainCheck">Can Train</label>
                </div>
                <div class="mb-3 form-check form-switch">
                    <InputCheckbox @bind-Value="saveModel.LastActiveRoster" class="form-check-input" id="lastActiveCheck" />
                    <label class="form-check-label" for="lastActiveCheck">Last Active Roster</label>
                </div>
            </EditForm>
        </BodyContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="CloseSaveModal">Cancel</button>
            <button type="submit" form="save-seniority-form" class="btn btn-primary" disabled="@isSaving">
                <span class="bi bi-check-circle me-1"></span> @(editCtrlNbr > 0 ? "Update" : "Add")
            </button>
        </Footer>
    </Modal>

    <Modal Visible="showDeleteModal" Title="Confirm Delete" Icon="bi bi-exclamation-triangle"
           OnClose="() => showDeleteModal = false" Size="sm">
        <BodyContent>
            <p>Are you sure you want to remove <strong>@deleteEmployeeDisplay</strong> from this roster?</p>
        </BodyContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="() => showDeleteModal = false">Cancel</button>
            <button type="button" class="btn btn-danger" disabled="@isSaving" @onclick="ConfirmDelete">
                <span class="bi bi-trash me-1"></span> Remove
            </button>
        </Footer>
    </Modal>

    <Modal Visible="showRosterModal" Title="Create Roster"
           Icon="bi bi-plus-circle"
           OnClose="CloseRosterModal">
        <BodyContent>
            <EditForm Model="rosterModel" OnValidSubmit="OnSaveRoster" id="save-roster-form">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label fw-semibold">Roster Name</label>
                    <InputText @bind-Value="rosterModel.RosterName" class="form-control" placeholder="e.g. Engineer Roster" />
                    <ValidationMessage For="() => rosterModel.RosterName" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Plural Name</label>
                    <InputText @bind-Value="rosterModel.RosterPluralName" class="form-control" placeholder="e.g. Engineer Rosters" />
                    <ValidationMessage For="() => rosterModel.RosterPluralName" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Roster Number</label>
                    <InputNumber @bind-Value="rosterModel.RosterNumber" class="form-control" />
                    <ValidationMessage For="() => rosterModel.RosterNumber" class="text-danger" />
                </div>
            </EditForm>
        </BodyContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="CloseRosterModal">Cancel</button>
            <button type="submit" form="save-roster-form" class="btn btn-primary" disabled="@isSaving">
                <span class="bi bi-check-circle me-1"></span> Create
            </button>
        </Footer>
    </Modal>

    <SuccessAlert @bind-Message="successMessage" />

    @if (errorMessage is not null)
    {
        <div class="alert alert-danger alert-dismissible" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <div class="row mb-3">
        <div class="col-md-3">
            <label class="form-label fw-semibold">Work Area</label>
            <FilterSelect TItem="GroupResponse" TValue="long"
                          Items="workAreas"
                          Value="selectedWorkAreaCtrlNbr"
                          ValueChanged="OnWorkAreaChanged"
                          ValueSelector="@(wa => wa.CtrlNbr)"
                          TextSelector="@(wa => wa.Name)"
                          Placeholder="— Select a work area —"
                          class="form-select" />
        </div>
        <div class="col-md-2">
            <label class="form-label fw-semibold">Craft</label>
            <FilterSelect TItem="CraftResponse" TValue="long"
                          Items="crafts"
                          Value="selectedCraftCtrlNbr"
                          ValueChanged="OnCraftChanged"
                          ValueSelector="@(c => c.CtrlNbr)"
                          TextSelector="@(c => c.CraftName)"
                          Placeholder="— Select a craft —"
                          disabled="@(selectedWorkAreaCtrlNbr == 0 || FilterEmployeeCtrlNbr > 0)"
                          class="form-select" />
        </div>
        <div class="col-md-3">
            <label class="form-label fw-semibold">Roster</label>
            <div class="d-flex gap-2">
                <FilterSelect TItem="RosterResponse" TValue="long"
                              Items="filteredRosters"
                              Value="selectedRosterCtrlNbr"
                              ValueChanged="OnRosterChanged"
                              ValueSelector="@(r => r.CtrlNbr)"
                              TextSelector="@(r => r.RosterName)"
                              Placeholder="— Select a roster —"
                              disabled="@(selectedCraftCtrlNbr == 0 || FilterEmployeeCtrlNbr > 0)"
                              class="form-select" />
                @if (selectedCraftCtrlNbr > 0 && !IsFeatureReadOnly && FilterEmployeeCtrlNbr == 0)
                {
                    <button class="btn btn-outline-primary" title="Create Roster" disabled="@isLoading" @onclick="OpenRosterModal">
                        <span class="bi bi-plus-lg"></span>
                    </button>
                }
            </div>
        </div>
        <div class="col-md-2">
            <label class="form-label fw-semibold">State</label>
            <FilterSelect TItem="StateTypeOption" TValue="string"
                          Items="stateTypeOptions"
                          Value="selectedStateType"
                          ValueChanged="OnStateTypeChanged"
                          ValueSelector="@(o => o.Value)"
                          TextSelector="@(o => o.Label)"
                          Placeholder="— All states —"
                          disabled="@(selectedRosterCtrlNbr == 0 || FilterEmployeeCtrlNbr > 0)"
                          class="form-select" />
        </div>
    </div>

    @if (selectedWorkAreaCtrlNbr == 0)
    {
        <p class="text-muted">Select a work area above to view seniority rosters.</p>
    }
    else if (selectedCraftCtrlNbr == 0)
    {
        <p class="text-muted">Select a craft above to view its rosters.</p>
    }
    else if (selectedRosterCtrlNbr == 0)
    {
        <p class="text-muted">Select a roster above to view employees.</p>
    }
    else if (seniorityEntries is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <DataTable TItem="SeniorityResponse" Items="FilteredSeniorityEntries" Columns="Columns"
                   SearchFilter="@((s, term) => s.EmployeeNumber.Contains(term, StringComparison.OrdinalIgnoreCase) || s.EmployeeFullNameLnf.Contains(term, StringComparison.OrdinalIgnoreCase) || s.SeniorityStateName.Contains(term, StringComparison.OrdinalIgnoreCase) || s.PositionName.Contains(term, StringComparison.OrdinalIgnoreCase))"
                   SearchPlaceholder="Search employees..."
                   EmptyMessage="No employees found on this roster."
                   DefaultSortColumn="Seniority Date">
            <ToolbarContent>
                @if (!IsFeatureReadOnly && FilterEmployeeCtrlNbr == 0)
                {
                    <button class="btn btn-primary" disabled="@isLoading" @onclick="OpenCreateModal">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        }
                        else
                        {
                            <span class="bi bi-plus-circle"></span>
                        }
                        Add Employee
                    </button>
                }
                @if (FilterEmployeeCtrlNbr > 0 && craftHasMovePolicy && eligibleBoards.Count > 0
                     && !employeePositionMap.ContainsKey(FilterEmployeeCtrlNbr))
                {
                    var _canMove = seniorityEntries?.FirstOrDefault(s => s.EmployeeCtrlNbr == FilterEmployeeCtrlNbr)?.CanExerciseSeniority ?? false;
                    <button class="btn btn-success" disabled="@(!_canMove || isLoading)"
                            title="@(_canMove ? "" : "Eligibility requirement not met for this craft.")"
                            @onclick="OpenMoveToBoardModal">
                        <span class="bi bi-box-arrow-in-right me-1"></span>Move to Board
                    </button>
                }
            </ToolbarContent>
            <RowContent Context="entry">
                <td>@entry.EmployeeNumber.ToUpperInvariant()</td>
                <td>
                    @entry.EmployeeFullNameLnf
                </td>
                <td>@FormatDate(entry.RosterDate)</td>
                <td>@entry.Rank</td>
                <td>@entry.SeniorityStateName</td>
                @if (FilterEmployeeCtrlNbr == 0)
                {
                    <td>
                        <div class="form-check form-switch">
                            <input type="checkbox" class="form-check-input" checked="@entry.CanTrain" disabled />
                        </div>
                    </td>
                    <td>
                        @foreach (var label in entry.RestrictionLabels)
                        {
                            <span class="badge bg-info text-dark me-1">@label</span>
                        }
                    </td>
                }
                <td>
                    @(string.IsNullOrWhiteSpace(entry.PositionName) ? "—" : entry.PositionName)
                </td>
                <td>
                    @if (!IsFeatureReadOnly && FilterEmployeeCtrlNbr == 0)
                    {
                        <div class="d-flex gap-1">
                            <button class="btn btn-sm btn-outline-primary flex-fill" disabled="@isLoading" @onclick="() => OpenEditModal(entry)">
                                <span class="bi bi-pencil"></span> Edit
                            </button>
                            <button class="btn btn-sm btn-outline-danger flex-fill" disabled="@isLoading" @onclick="() => OpenDeleteModal(entry)">
                                <span class="bi bi-trash"></span> Remove
                            </button>
                        </div>
                    }
                    @if (FilterEmployeeCtrlNbr > 0 && craftHasMovePolicy && !employeePositionMap.ContainsKey(entry.EmployeeCtrlNbr))
                    {
                        var _canMove = seniorityEntries?.FirstOrDefault(s => s.EmployeeCtrlNbr == FilterEmployeeCtrlNbr)?.CanExerciseSeniority ?? false;
                        <button class="btn btn-sm btn-outline-primary" disabled="@(!_canMove || isLoading)"
                                title="@(_canMove ? "" : "Eligibility requirement not met for this craft.")"
                                @onclick="() => OpenRequestMoveModal(entry)">
                            <span class="bi bi-arrow-left-right me-1"></span>Request Move
                        </button>
                    }
                </td>
            </RowContent>
        </DataTable>
    }
}

@code {
    protected override string? FeatureKey => "employees/seniority";

    private IReadOnlyList<GroupResponse>? workAreas;
    private IReadOnlyList<CraftResponse>? crafts;
    private IReadOnlyList<RosterResponse>? rosters;
    private IReadOnlyList<SeniorityResponse>? seniorityEntries;

    private long selectedWorkAreaCtrlNbr;
    private long selectedCraftCtrlNbr;
    private long selectedRosterCtrlNbr;
    private string selectedStateType = "";

    [SupplyParameterFromQuery(Name = "roster")]
    public long InitialRosterCtrlNbr { get; set; }

    [SupplyParameterFromQuery(Name = "craft")]
    public long FilterCraftCtrlNbr { get; set; }

    [SupplyParameterFromQuery(Name = "employee")]
    public long FilterEmployeeCtrlNbr { get; set; }

    private sealed record StateTypeOption(string Value, string Label);
    private static readonly IReadOnlyList<StateTypeOption> stateTypeOptions =
    [
        new("Active", "Active"),
        new("CutBack", "Cut Back"),
        new("Inactive", "Inactive"),
    ];

    private IReadOnlyList<GetEmployeeResponse>? employees;
    private IReadOnlyList<SeniorityStateResponse>? seniorityStates;

    private IReadOnlyList<DataTableColumn<SeniorityResponse>> Columns
    {
        get
        {
            var cols = new List<DataTableColumn<SeniorityResponse>>
            {
                new("Employee #", s => s.EmployeeNumber.ToUpperInvariant()),
                new("Name", s => s.EmployeeFullNameLnf),
                new("Seniority Date", s => s.RosterDate),
                new("Rank", s => s.Rank, sortKey: "Rank"),
                new("State", s => s.SeniorityStateName)
            };
            if (FilterEmployeeCtrlNbr == 0)
            {
                cols.Add(new("Can Train", s => s.CanTrain ? "Yes" : "No"));
                cols.Add(new("Restrictions", s => s.RestrictionLabels.Count > 0 ? string.Join(", ", s.RestrictionLabels) : ""));
            }
            cols.Add(new("Current Position", s =>
                string.IsNullOrWhiteSpace(s.PositionName) ? "—" : s.PositionName));
            cols.Add(DataTableColumn<SeniorityResponse>.Actions());
            return cols;
        }
    }

    private bool isLoading;
    private bool showSaveModal;
    private long editCtrlNbr;
    private string editEmployeeDisplay = "";
    private SeniorityInputModel saveModel = new();

    private bool showDeleteModal;
    private long deleteCtrlNbr;
    private string deleteEmployeeDisplay = "";

    private bool showRosterModal;
    private RosterInputModel rosterModel = new();

    private PendingStateChangeResponse? pendingChange;

    private IReadOnlyList<RosterResponse> filteredRosters =>
        rosters is null || selectedWorkAreaCtrlNbr == 0
            ? []
            : rosters.Where(r => r.WorkAreaGroupCtrlNbr == selectedWorkAreaCtrlNbr).ToList();

    private IReadOnlyList<SeniorityResponse> FilteredSeniorityEntries
    {
        get
        {
            if (seniorityEntries is null) return [];

            var entries = seniorityEntries.AsEnumerable();

            // When navigated from an employee's detail page, show only employees junior to that employee.
            // Junior means: later roster date, or same date with a higher rank number.
            if (FilterEmployeeCtrlNbr > 0)
            {
                var anchor = seniorityEntries.FirstOrDefault(s => s.EmployeeCtrlNbr == FilterEmployeeCtrlNbr);
                if (anchor is not null && DateTime.TryParse(anchor.RosterDate, out var anchorDate))
                {
                    entries = entries.Where(s =>
                    {
                        if (!DateTime.TryParse(s.RosterDate, out var sDate)) return false;
                        var dateCompare = sDate.CompareTo(anchorDate);
                        return dateCompare > 0 || (dateCompare == 0 && s.Rank > anchor.Rank);
                    });
                }
            }

            if (string.IsNullOrEmpty(selectedStateType) || seniorityStates is null)
                return entries.ToList();

            var matchingCtrlNbrs = new HashSet<long>(
                seniorityStates
                    .Where(s => s.StateType.Equals(selectedStateType, StringComparison.OrdinalIgnoreCase))
                    .Select(s => s.CtrlNbr));

            return entries.Where(s => matchingCtrlNbrs.Contains(s.SeniorityStateCtrlNbr)).ToList();
        }
    }

    protected override async Task LoadDataAsync()
    {
        await LoadWorkAreas();
        await LoadCrafts();
        await EnsureSeniorityStatesLoaded();

        if (InitialRosterCtrlNbr > 0)
            await ApplyInitialRosterAsync();
    }

    protected override async Task OnAppContextChangedAsync()
    {
        selectedWorkAreaCtrlNbr = 0;
        selectedCraftCtrlNbr = 0;
        selectedRosterCtrlNbr = 0;
        selectedStateType = "";
        workAreas = null;
        rosters = null;
        seniorityEntries = null;
        employees = null;
        seniorityStates = null;
        await LoadWorkAreas();
        await LoadCrafts();
        await EnsureSeniorityStatesLoaded();
    }

    private async Task LoadWorkAreas()
    {
        try
        {
            workAreas = (await ReferenceData.GetWorkAreasAsync()).ToList();
        }
        catch
        {
            workAreas = [];
        }
    }

    private async Task LoadCrafts()
    {
        try
        {
            if (SelectedParentCtrlNbr is not long parentCtrlNbr)
            {
                crafts = [];
                return;
            }

            var response = await CraftClient.GetAllCraftsAsync(parentCtrlNbr, SelectedRailroadCtrlNbr ?? 0);
            crafts = response.Crafts.ToList();
        }
        catch
        {
            crafts = [];
        }
    }

    private Task OnWorkAreaChanged(long workAreaCtrlNbr)
    {
        selectedWorkAreaCtrlNbr = workAreaCtrlNbr;
        selectedCraftCtrlNbr = 0;
        selectedRosterCtrlNbr = 0;
        seniorityEntries = null;
        return Task.CompletedTask;
    }

    private async Task OnCraftChanged(long craftCtrlNbr)
    {
        selectedCraftCtrlNbr = craftCtrlNbr;
        selectedRosterCtrlNbr = 0;
        rosters = null;
        seniorityEntries = null;

        if (craftCtrlNbr > 0)
        {
            await LoadRosters();
        }
    }

    private async Task LoadRosters()
    {
        try
        {
            if (selectedCraftCtrlNbr == 0)
            {
                rosters = [];
                return;
            }

            var response = await RosterClient.GetAllAsync(0, craftCtrlNbr: selectedCraftCtrlNbr);
            rosters = response.Rosters.ToList();
        }
        catch
        {
            rosters = [];
        }
    }

    private async Task ApplyInitialRosterAsync()
    {
        // Find the roster in the loaded data so we can also select its craft and work area
        var allRosters = await RosterClient.GetAllAsync(SelectedParentCtrlNbr!.Value, SelectedRailroadCtrlNbr ?? 0);
        var target = allRosters.Rosters.FirstOrDefault(r => r.CtrlNbr == InitialRosterCtrlNbr);
        if (target is null) return;

        // Select work area so the craft dropdown is enabled
        selectedWorkAreaCtrlNbr = target.WorkAreaGroupCtrlNbr;

        // Lock to Active state — only active employees can exercise seniority
        selectedStateType = "Active";

        // Select craft to populate the rosters dropdown
        selectedCraftCtrlNbr = target.CraftCtrlNbr;
        await LoadRosters();

        // Now select the roster and load entries
        await OnRosterChanged(InitialRosterCtrlNbr);
    }

    private async Task OnRosterChanged(long rosterCtrlNbr)
    {
        selectedRosterCtrlNbr = rosterCtrlNbr;
        seniorityEntries = null;

        if (rosterCtrlNbr > 0)
        {
            await LoadSeniorityEntries();
        }
    }

    private void OnStateTypeChanged(string stateType)
    {
        selectedStateType = stateType;
    }

    private async Task LoadSeniorityEntries()
    {
        try
        {
            if (selectedRosterCtrlNbr == 0)
            {
                seniorityEntries = [];
                return;
            }

            var response = await SeniorityClient.GetAllByRosterAsync(selectedRosterCtrlNbr, SelectedRailroadCtrlNbr ?? 0);
            seniorityEntries = response.Seniority.ToList();

            // When in employee context, build position map so "Request Move" can resolve target positions.
            if (FilterEmployeeCtrlNbr > 0)
                await LoadBoardPositionMapAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load seniority data: {ex.Message}";
            seniorityEntries = [];
        }
    }

    /// <summary>
    /// Loads all roster boards for the current craft and builds a map of
    /// employee ctrl nbr → their board position ctrl nbr. Used to resolve the
    /// target position when the employee initiates a seniority move.
    /// </summary>
    private async Task LoadBoardPositionMapAsync()
    {
        employeePositionMap = [];
        eligibleBoards = [];
        craftHasMovePolicy = false;
        if (selectedCraftCtrlNbr == 0 || SelectedParentCtrlNbr is null) return;
        try
        {
            var boardsResp = await RosterBoardClient.GetAllAsync(
                SelectedParentCtrlNbr.Value,
                SelectedRailroadCtrlNbr ?? 0,
                selectedCraftCtrlNbr);

            foreach (var board in boardsResp.Boards)
            {
                foreach (var pos in board.Positions)
                {
                    if (pos.EmployeeCtrlNbr > 0)
                        employeePositionMap[pos.EmployeeCtrlNbr] = new BoardPositionInfo(pos.CtrlNbr, board.Name, pos.PositionOrder, board.BoardType);
                }

                if (board.AllowSeniorityMove)
                    eligibleBoards.Add(board);
            }

            // Check if this craft has a configured seniority move policy.
            var policyCrafts = await PoliciesClient.GetCraftsWithSeniorityMovePolicyAsync(SelectedRailroadCtrlNbr ?? 0, [selectedCraftCtrlNbr]);
            craftHasMovePolicy = policyCrafts.Contains(selectedCraftCtrlNbr);
        }
        catch
        {
            // Non-fatal — move actions will not appear if position/policy cannot be resolved.
        }
    }

