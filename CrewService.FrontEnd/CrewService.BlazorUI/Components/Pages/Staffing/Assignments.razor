@page "/daily/assignments"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using CrewService.BlazorUI.Clients
@using CrewService.Presentation
@inherits AppComponentBase
@attribute [Authorize]
@inject AssignmentClient AssignmentClient
@inject RailroadReferenceDataService ReferenceData
@inject NavigationManager Nav

<PageTitle>Assignments</PageTitle>
<h1>Assignments</h1>

@if (!HasRailroad)
{
    <div class="alert alert-warning">
        <span class="bi bi-exclamation-triangle"></span>
        Please select a railroad in the context switcher to manage assignments.
    </div>
}
else
{
    <p class="text-muted mb-3">Managing assignments for <strong>@SelectedRailroadName</strong></p>

    <Modal Visible="showSaveModal"
           Title="@(editCtrlNbr > 0 ? "Edit Assignment" : "Create Assignment")"
           Icon="@(editCtrlNbr > 0 ? "bi bi-pencil" : "bi bi-plus-circle")"
           OnClose="CloseSaveModal">
        <BodyContent>
            <EditForm Model="saveModel" OnValidSubmit="OnSave" id="save-assignment-form">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label fw-semibold">Group</label>
                    <SelectInput TItem="GroupResponse" TValue="long"
                                 @bind-Value="saveModel.GroupCtrlNbr"
                                 Items="allGroups"
                                 ValueSelector="@(wa => wa.CtrlNbr)"
                                 TextSelector="@(wa => wa.Name)"
                                 class="form-select" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Department</label>
                    <SelectInput TItem="DepartmentResponse" TValue="long"
                                 @bind-Value="saveModel.DepartmentCtrlNbr"
                                 Items="departments"
                                 ValueSelector="@(d => d.CtrlNbr)"
                                 TextSelector="@(d => d.Name)"
                                 class="form-select" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Code</label>
                    <InputText @bind-Value="saveModel.Code" class="form-control" placeholder="e.g. YD3" />
                    <ValidationMessage For="() => saveModel.Code" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Name</label>
                    <InputText @bind-Value="saveModel.Name" class="form-control" placeholder="e.g. Yard Job 3" />
                    <ValidationMessage For="() => saveModel.Name" class="text-danger" />
                </div>
                <div class="mb-3">
                    <div class="form-check form-switch">
                        <InputCheckbox @bind-Value="saveModel.IsExtra" class="form-check-input" id="extra-switch" />
                        <label class="form-check-label" for="extra-switch">Extra Board Assignment</label>
                    </div>
                </div>
                <div class="mb-0">
                    <div class="form-check form-switch">
                        <InputCheckbox @bind-Value="saveModel.IsActive" class="form-check-input" id="active-switch" />
                        <label class="form-check-label" for="active-switch">Active</label>
                    </div>
                </div>
            </EditForm>
        </BodyContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="CloseSaveModal">Cancel</button>
            <button type="submit" form="save-assignment-form" class="btn btn-primary" disabled="@isSaving">
                <span class="bi bi-check-circle me-1"></span> @(editCtrlNbr > 0 ? "Update" : "Create")
            </button>
        </Footer>
    </Modal>

    <ConfirmModal Visible="showDeleteModal" ItemName="@deleteName" IsSaving="isSaving"
                        OnConfirm="ConfirmDelete" OnCancel="() => showDeleteModal = false" />

    @if (successMessage is not null)
    {
        <div class="alert alert-success alert-dismissible" role="alert">
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }
    @if (errorMessage is not null)
    {
        <div class="alert alert-danger alert-dismissible" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <DataTable TItem="StaffingAssignmentResponse" Items="items" Columns="columns"
               SearchPlaceholder="Search assignments..."
               EmptyMessage="No assignments found."
               DefaultSortColumn="Code">
        <ToolbarContent>
            @if (!IsFeatureReadOnly)
            {
                <button class="btn btn-primary" @onclick="OpenCreateModal">
                    <span class="bi bi-plus-circle"></span> Create Assignment
                </button>
            }
        </ToolbarContent>
        <RowContent Context="a">
            <td><a href="daily/assignments/@a.CtrlNbr" class="text-decoration-none fw-semibold">@a.Code.ToUpperInvariant()</a></td>
            <td>@a.Name</td>
            <td>@a.GroupName</td>
            <td>@GetDepartmentName(a.DepartmentCtrlNbr)</td>
            <td>@FormatDays(a.WorkDaysMask)</td>
            <td>
                @if (a.IsActive) { <span class="badge bg-success">Active</span> }
                else { <span class="badge bg-warning text-dark">Inactive</span> }
                @if (a.IsExtra) { <span class="badge bg-info ms-1">Extra</span> }
            </td>
            <td>
                @if (!IsFeatureReadOnly)
                {
                    <div class="d-flex gap-1">
                        <button class="btn btn-sm btn-outline-primary flex-fill" @onclick="() => OpenEditModal(a)">
                            <span class="bi bi-pencil"></span> Edit
                        </button>
                        <button class="btn btn-sm btn-outline-danger flex-fill" @onclick="() => OpenDeleteModal(a)">
                            <span class="bi bi-trash"></span> Delete
                        </button>
                    </div>
                }
            </td>
        </RowContent>
    </DataTable>
}

@code {
    protected override string? FeatureKey => "staffing/crews";

    private IReadOnlyList<StaffingAssignmentResponse>? items;
    private IReadOnlyList<GroupResponse>? allGroups;
    private IReadOnlyList<DepartmentResponse>? departments;
    
    private Dictionary<long, string> departmentNames = [];

    private IReadOnlyList<DataTableColumn<StaffingAssignmentResponse>> columns =>
    [
        new("Code", a => a.Code.ToUpperInvariant()),
        new("Name", a => a.Name),
        new("Group", a => a.GroupName),
        new("Department", a => GetDepartmentName(a.DepartmentCtrlNbr)),
        new("Work Days", a => FormatDays(a.WorkDaysMask)),
        new("Status", a => a.IsActive ? "Active" : "Inactive", width: "100px"),
        DataTableColumn<StaffingAssignmentResponse>.Actions()
    ];

    private bool showSaveModal;
    private long editCtrlNbr;
    private AssignmentInputModel saveModel = new();
    private bool showDeleteModal;
    private long deleteCtrlNbr;
    private string deleteName = "";

    protected override async Task LoadDataAsync()
    {
        if (HasRailroad)
        {
            await LoadReferenceData();
            await LoadAssignments();
        }
    }

    protected override async Task OnAppContextChangedAsync()
    {
        if (HasRailroad)
        {
            await LoadReferenceData();
            await LoadAssignments();
        }
        else { items = null; allGroups = null; departments = null; }
    }

    private async Task LoadReferenceData()
    {
        ReferenceData.Invalidate();
        allGroups = await ReferenceData.GetGroupsAsync();
        departments = await ReferenceData.GetDepartmentsAsync();
        departmentNames = departments?.ToDictionary(d => d.CtrlNbr, d => d.Name) ?? [];
    }

    private async Task LoadAssignments()
    {
        try
        {
            errorMessage = null;
            var response = await AssignmentClient.GetAllAsync(railroadCtrlNbr: SelectedRailroadCtrlNbr!.Value);
            items = response.Assignments;
        }
        catch (Exception ex) { errorMessage = $"Failed to load assignments: {ex.Message}"; }
    }


    private string GetDepartmentName(long ctrlNbr) =>
        ctrlNbr > 0 && departmentNames.TryGetValue(ctrlNbr, out var n) ? n : "—";

    private static string FormatDays(int mask)
    {
        if (mask == 0) return "None";
        var days = new[] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" };
        var active = new List<string>();
        for (var i = 0; i < 7; i++)
        {
            if ((mask & (1 << i)) != 0) active.Add(days[i]);
        }
        return string.Join(", ", active);
    }

    private void OpenCreateModal()
    {
        editCtrlNbr = 0;
        saveModel = new() { IsActive = true };
        showSaveModal = true;
    }

    private void OpenEditModal(StaffingAssignmentResponse a)
    {
        editCtrlNbr = a.CtrlNbr;
        saveModel = new()
        {
            Code = a.Code, Name = a.Name,
            IsExtra = a.IsExtra, IsActive = a.IsActive,
            DepartmentCtrlNbr = a.DepartmentCtrlNbr,
            GroupCtrlNbr = a.GroupCtrlNbr
        };
        showSaveModal = true;
    }

    private void CloseSaveModal() { showSaveModal = false; editCtrlNbr = 0; saveModel = new(); }

    private void OpenDeleteModal(StaffingAssignmentResponse a)
    {
        deleteCtrlNbr = a.CtrlNbr;
        deleteName = a.Name;
        showDeleteModal = true;
    }

    private async Task OnSave()
    {
        try
        {
            isSaving = true;
            errorMessage = null; successMessage = null;
            if (editCtrlNbr > 0)
            {
                await AssignmentClient.UpdateAsync(editCtrlNbr, saveModel.Code!, saveModel.Name!, saveModel.IsExtra, saveModel.IsActive, saveModel.DepartmentCtrlNbr, saveModel.GroupCtrlNbr);
                successMessage = "Assignment updated.";
            }
            else
            {
                await AssignmentClient.CreateAsync(saveModel.GroupCtrlNbr, saveModel.Code!, saveModel.Name!, saveModel.IsExtra, saveModel.IsActive, saveModel.DepartmentCtrlNbr);
                successMessage = "Assignment created.";
            }
            CloseSaveModal();
            await LoadAssignments();
        }
        catch (Exception ex) { errorMessage = $"Failed to save: {ex.Message}"; }
        finally { isSaving = false; }
    }

    private async Task ConfirmDelete()
    {
        try
        {
            isSaving = true;
            errorMessage = null; successMessage = null;
            await AssignmentClient.DeleteAsync(deleteCtrlNbr);
            successMessage = "Assignment deleted.";
            showDeleteModal = false;
            await LoadAssignments();
        }
        catch (Exception ex) { errorMessage = $"Failed to delete: {ex.Message}"; showDeleteModal = false; }
        finally { isSaving = false; }
    }

    private sealed class AssignmentInputModel
    {
        public long GroupCtrlNbr { get; set; }
        public long DepartmentCtrlNbr { get; set; }
        [Required(ErrorMessage = "Code is required.")] public string? Code { get; set; }
        [Required(ErrorMessage = "Name is required.")] public string? Name { get; set; }
        public bool IsExtra { get; set; }
        public bool IsActive { get; set; } = true;
    }
}
