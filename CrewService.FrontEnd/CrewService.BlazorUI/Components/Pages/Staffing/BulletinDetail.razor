@page "/staffing/bulletins/{CtrlNbr:long}"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using CrewService.BlazorUI.Clients
@using CrewService.Presentation

@inherits AppComponentBase

@attribute [Authorize]

@inject BulletinsClient BulletinsClient
@inject QualificationsClient QualificationsClient

<PageTitle>Bulletin Detail</PageTitle>

@if (isLoading)
{
    <p><em>Loading...</em></p>
}
else if (bulletin is null)
{
    <div class="alert alert-warning">Bulletin not found.</div>
    <BackNavButton Text="Bulletins" FallbackUrl="/staffing/bulletins" />
}
else
{
    <BackNavButton Text="Bulletins" FallbackUrl="/staffing/bulletins" />

    <h1>@(string.IsNullOrEmpty(bulletin.PositionName) ? "Bulletin Detail" : bulletin.PositionName)</h1>
    <p class="text-muted mb-1">
        <span class="badge @bulletin.StatusBadge">@bulletin.Status</span>
    </p>

    <SuccessAlert @bind-Message="successMessage" Class="mt-2" />

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible mt-2" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <hr />

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header fw-semibold"><span class="bi bi-info-circle me-1"></span> Bulletin Info</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        @if (!string.IsNullOrEmpty(bulletin.PositionName))
                        {
                            <dt class="col-sm-5">Position</dt>
                            <dd class="col-sm-7">@bulletin.PositionName</dd>
                        }
                        <dt class="col-sm-5">Bid Window Opens</dt>
                        <dd class="col-sm-7">@FormatDateTime(bulletin.BidWindowOpensUtc)</dd>
                        <dt class="col-sm-5">Bid Window Closes</dt>
                        <dd class="col-sm-7">@FormatDateTime(bulletin.BidWindowClosesUtc)</dd>
                        <dt class="col-sm-5">Effective Date</dt>
                        <dd class="col-sm-7">@FormatDateTime(bulletin.EffectiveUtc)</dd>
                        @if (!string.IsNullOrEmpty(bulletin.VacatedByName))
                        {
                            <dt class="col-sm-5">Vacated By</dt>
                            <dd class="col-sm-7">@bulletin.VacatedByName</dd>
                        }
                        <dt class="col-sm-5"># Bids</dt>
                        <dd class="col-sm-7">@bulletin.BidCount</dd>
                        @if (bulletin.AwardedEmployeeCtrlNbr > 0)
                        {
                            <dt class="col-sm-5">Awarded To</dt>
                            <dd class="col-sm-7">
                                @(string.IsNullOrEmpty(bulletin.AwardedEmployeeName) ? bulletin.AwardedEmployeeCtrlNbr.ToString() : bulletin.AwardedEmployeeName)
                                @if (!string.IsNullOrEmpty(bulletin.AwardType)) { <span class="text-muted ms-1">(@bulletin.AwardType)</span> }
                            </dd>
                        }
                        @if (bulletin.Status == "NoBid" && !string.IsNullOrEmpty(bulletin.ForceAssignDeadlineUtc))
                        {
                            <dt class="col-sm-5">Force Assign By</dt>
                            <dd class="col-sm-7 text-warning fw-semibold">@FormatDateTime(bulletin.ForceAssignDeadlineUtc)</dd>
                        }
                    </dl>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header fw-semibold"><span class="bi bi-gear me-1"></span> Actions</div>
                <div class="card-body d-flex flex-wrap gap-2 align-items-start">
                    @if (!Permissions.IsReadOnly("staffing/bulletins") && bulletin.Status == "Posted")
                    {
                        var bidWindowClosed = DateTime.TryParse(bulletin.BidWindowClosesUtc, out var closesUtc) && DateTime.UtcNow >= closesUtc;
                        <button class="btn btn-success" @onclick="OpenAwardModal" disabled="@(isSaving || !bidWindowClosed)">
                             <span class="bi bi-trophy"></span> Award
                         </button>
                         <button class="btn btn-secondary" @onclick="OnSetNoBid" disabled="@(isSaving || !bidWindowClosed)">
                             <span class="bi bi-dash-circle"></span> Set No-Bid
                         </button>
                         <button class="btn btn-primary" @onclick="OpenAddBidModal" disabled="@isSaving">
                             <span class="bi bi-plus-circle"></span> Add Bid
                         </button>
                    }
                    @if (!Permissions.IsReadOnly("staffing/bulletins") && bulletin.Status == "NoBid")
                    {
                        <button class="btn btn-warning" @onclick="OpenForceAssignModal" disabled="@isSaving">
                             <span class="bi bi-person-fill-exclamation"></span> Force Assign
                         </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <h4 class="mb-3"><span class="bi bi-hand-index me-1"></span> Bids</h4>

    <DataTable TItem="BulletinBidResponse"
               Items="bids"
               Columns="bidColumns"
               EmptyMessage="No bids submitted.">
        <RowContent Context="bid">
            <td>@bid.Priority</td>
            <td>@(string.IsNullOrEmpty(bid.EmployeeName) ? bid.EmployeeCtrlNbr.ToString() : bid.EmployeeName)</td>
            <td>@bid.SeniorityDate</td>
            <td>@bid.SeniorityRank</td>
            <td>@FormatDateTime(bid.SubmittedUtc)</td>
            <td><span class="badge @bid.StatusBadge">@bid.Status</span></td>
            <td class="text-end">
                @if (!Permissions.IsReadOnly("staffing/bulletins") && bid.Status == "Submitted")
                {
                    <button class="btn btn-outline-danger btn-sm" @onclick="() => WithdrawBid(bid.CtrlNbr)" disabled="@isSaving">
                        <span class="bi bi-x"></span> Withdraw
                    </button>
                }
            </td>
        </RowContent>
    </DataTable>

    @* ── Add Bid Modal ── *@
    <Modal Visible="showAddBidModal" Title="Add Bid" Icon="bi bi-plus-circle-fill"
           OnClose="CloseAddBidModal" StaticBackdrop="true">
        <BodyContent>
            <EditForm Model="bidModel" OnValidSubmit="ConfirmAddBid" id="add-bid-form">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label fw-semibold">Employee</label>
                    <FilterSelect TItem="EligibleEmployeeItem" TValue="long"
                                 @bind-Value="bidModel.EmployeeCtrlNbr"
                                 Items="employees"
                                 ValueSelector="@(e => e.CtrlNbr)"
                                 TextSelector="@FormatEmployeeLabel"
                                 Placeholder="— Select employee —"
                                 Searchable="true"
                                 class="form-select" />
                    <ValidationMessage For="() => bidModel.EmployeeCtrlNbr" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Priority</label>
                    <InputNumber class="form-control" @bind-Value="bidModel.Priority" min="1" />
                    <ValidationMessage For="() => bidModel.Priority" class="text-danger" />
                </div>
            </EditForm>
        </BodyContent>
        <Footer>
            <button class="btn btn-secondary" @onclick="CloseAddBidModal">Cancel</button>
            <button class="btn btn-primary" type="submit" form="add-bid-form" disabled="@(isSaving || bidModel.EmployeeCtrlNbr <= 0)">
                @if (isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                Add Bid
            </button>
        </Footer>
    </Modal>

    @* ── Award Modal ── *@
    <Modal Visible="showAwardModal" Title="Award Bulletin" Icon="bi bi-trophy-fill"
           OnClose="() => showAwardModal = false" StaticBackdrop="true">
        <BodyContent>
            <div class="mb-3">
                <label class="form-label fw-semibold">Select Winning Bidder</label>
                @if (awardableBids.Count > 0)
                {
                    <FilterSelect TItem="BulletinBidResponse" TValue="long"
                                 @bind-Value="actionEmployeeCtrlNbr"
                                 Items="awardableBids"
                                 ValueSelector="@(b => b.EmployeeCtrlNbr)"
                                 TextSelector="@(b => $"{b.EmployeeName} — Priority {b.Priority}, Seniority {b.SeniorityDate}")"
                                 Placeholder="— Select employee —"
                                 Searchable="true"
                                 class="form-select" />
                }
                else
                {
                    <div class="alert alert-info mb-0">No submitted bids available to award. Use Force Assign instead.</div>
                }
            </div>
        </BodyContent>
        <Footer>
            <button class="btn btn-secondary" @onclick="() => showAwardModal = false">Cancel</button>
            <button class="btn btn-success" @onclick="ConfirmAward" disabled="@(isSaving || actionEmployeeCtrlNbr <= 0)">
                @if (isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                Award Position
            </button>
        </Footer>
    </Modal>

    @* ── Force Assign Modal ── *@
    <Modal Visible="showForceModal" Title="Force Assign" Icon="bi bi-person-fill-exclamation"
           OnClose="() => showForceModal = false" StaticBackdrop="true">
        <BodyContent>
            <div class="alert alert-warning">
                <span class="bi bi-exclamation-triangle me-1"></span>
                <strong>Force Assign</strong> will automatically select the most junior eligible employee
                from the extra board based on the craft's force assignment rules.
            </div>
            @if (isLoadingCandidate)
            {
                <p><span class="spinner-border spinner-border-sm me-1"></span> Resolving candidate...</p>
            }
            else if (!string.IsNullOrEmpty(forceAssignCandidateName))
            {
                <div class="alert alert-info mb-0">
                    <span class="bi bi-person-check me-1"></span>
                    <strong>Candidate:</strong> @forceAssignCandidateName
                </div>
            }
            else
            {
                <div class="alert alert-danger mb-0">
                    <span class="bi bi-exclamation-circle me-1"></span>
                    No eligible candidate found. Ensure extra board members exist for this craft.
                </div>
            }
        </BodyContent>
        <Footer>
            <button class="btn btn-secondary" @onclick="() => showForceModal = false">Cancel</button>
            <button class="btn btn-warning" @onclick="ConfirmForceAssign" disabled="@(isSaving || isLoadingCandidate || string.IsNullOrEmpty(forceAssignCandidateName))">
                @if (isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                Force Assign
            </button>
        </Footer>
    </Modal>
}

@code {
    [Parameter] public long CtrlNbr { get; set; }

    private bool isLoading;
    private new bool isSaving;
    private new string? errorMessage;
    private new string? successMessage;

    private BulletinResponse? bulletin;
    private List<BulletinBidResponse>? bids;

    private bool showAwardModal;
    private bool showForceModal;
    private bool showAddBidModal;
    private long actionEmployeeCtrlNbr;

    private List<BulletinBidResponse> awardableBids = [];
    private string? forceAssignCandidateName;
    private bool isLoadingCandidate;

    private List<EligibleEmployeeItem> employees = [];
    private AddBidModel bidModel = new();

    private static readonly IReadOnlyList<DataTableColumn<BulletinBidResponse>> bidColumns =
    [
        new("Priority",       b => (object?)b.Priority),
        new("Employee",       b => b.EmployeeName),
        new("Seniority Date", b => b.SeniorityDate),
        new("Seniority Rank", b => (object?)b.SeniorityRank),
        new("Submitted",      b => b.SubmittedUtc),
        new("Status",         b => b.Status),
        DataTableColumn<BulletinBidResponse>.Actions(),
    ];

    protected override string? FeatureKey => "staffing/bulletins";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            var result = await BulletinsClient.GetBulletinAsync(CtrlNbr);
            if (ComponentToken.IsCancellationRequested) return;
            bulletin = result;
            await LoadBidsAsync();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (!ComponentToken.IsCancellationRequested)
                errorMessage = $"Failed to load bulletin: {ex.Message}";
        }
        finally
        {
            if (!ComponentToken.IsCancellationRequested)
                isLoading = false;
        }
    }

    private async Task LoadBidsAsync()
    {
        try
        {
            var result = await BulletinsClient.GetBidsByBulletinAsync(CtrlNbr);
            if (ComponentToken.IsCancellationRequested) return;
            bids = [.. result.Bids];
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (!ComponentToken.IsCancellationRequested)
                errorMessage = $"Failed to load bids: {ex.Message}";
        }
    }

    private void OpenAwardModal()
    {
        actionEmployeeCtrlNbr = 0;
        awardableBids = [.. (bids ?? []).Where(b => b.Status == "Submitted").OrderBy(b => b.Priority)];
        if (awardableBids.Count == 1) actionEmployeeCtrlNbr = awardableBids[0].EmployeeCtrlNbr;
        showAwardModal = true;
    }

    private async Task OpenForceAssignModal()
    {
        forceAssignCandidateName = null;
        isLoadingCandidate = true;
        showForceModal = true;
        try
        {
            var result = await BulletinsClient.GetForceAssignCandidateAsync(CtrlNbr);
            forceAssignCandidateName = result.EmployeeCtrlNbr > 0 ? result.EmployeeName : null;
        }
        catch { forceAssignCandidateName = null; }
        finally { isLoadingCandidate = false; }
    }

    private async Task OpenAddBidModal()
    {
        if (isSaving) return;
        bidModel = new AddBidModel { Priority = 1 };
        employees = [];
        try
        {
            isSaving = true;
            if (bulletin is not null && bulletin.CraftRoleCtrlNbr > 0)
            {
                var result = await QualificationsClient.GetEligibleEmployeesForCraftRoleAsync(
                    bulletin.CraftRoleCtrlNbr, SelectedParentCtrlNbr ?? 0);
                var alreadyBid = (bids ?? [])
                    .Where(b => b.Status != "Withdrawn")
                    .Select(b => b.EmployeeCtrlNbr)
                    .ToHashSet();
                employees = [.. result.Employees.Where(e => !alreadyBid.Contains(e.CtrlNbr))];
            }
        }
        catch (Exception ex) { errorMessage = $"Failed to load employees: {ex.Message}"; return; }
        finally { isSaving = false; }
        showAddBidModal = true;
    }

    private void CloseAddBidModal() { showAddBidModal = false; }

    private async Task ConfirmAddBid()
    {
        if (isSaving) return;
        try
        {
            isSaving = true;
            await BulletinsClient.SubmitBidAsync(CtrlNbr, bidModel.EmployeeCtrlNbr, bidModel.Priority);
            successMessage = "Bid added successfully.";
            CloseAddBidModal();
            await LoadBidsAsync();
            bulletin = await BulletinsClient.GetBulletinAsync(CtrlNbr);
        }
        catch (Exception ex) { errorMessage = $"Failed to add bid: {ex.Message}"; }
        finally { isSaving = false; }
    }

    private async Task ConfirmAward()
    {
        if (isSaving) return;
        try
        {
            isSaving = true;
            bulletin = await BulletinsClient.AwardBulletinAsync(CtrlNbr, actionEmployeeCtrlNbr);
            successMessage = "Bulletin awarded successfully.";
            showAwardModal = false;
            await LoadBidsAsync();
        }
        catch (Exception ex) { errorMessage = $"Failed to award: {ex.Message}"; }
        finally { isSaving = false; }
    }

    private async Task ConfirmForceAssign()
    {
        if (isSaving) return;
        try
        {
            isSaving = true;
            bulletin = await BulletinsClient.AutoForceAssignBulletinAsync(CtrlNbr);
            successMessage = "Force assigned successfully.";
            showForceModal = false;
        }
        catch (Exception ex) { errorMessage = $"Failed to force assign: {ex.Message}"; }
        finally { isSaving = false; }
    }

    private async Task OnSetNoBid()
    {
        if (isSaving) return;
        try
        {
            isSaving = true;
            bulletin = await BulletinsClient.SetNoBidAsync(CtrlNbr);
            successMessage = "Bulletin marked as no-bid.";
        }
        catch (Exception ex) { errorMessage = $"Failed to set no-bid: {ex.Message}"; }
        finally { isSaving = false; }
    }

    private async Task WithdrawBid(long bidCtrlNbr)
    {
        if (isSaving) return;
        try
        {
            isSaving = true;
            StateHasChanged();
            await BulletinsClient.WithdrawBidAsync(bidCtrlNbr);
            await LoadBidsAsync();
        }
        catch (Exception ex) { errorMessage = $"Failed to withdraw bid: {ex.Message}"; }
        finally { isSaving = false; }
    }

    private static string FormatDateTime(string iso)
        => DateTime.TryParse(iso, null, System.Globalization.DateTimeStyles.RoundtripKind, out var dt)
            ? dt.ToString("MM/dd/yyyy HH:mm")
            : iso;

    private static string FormatEmployeeLabel(EligibleEmployeeItem e) => $"{e.EmployeeNumber}  {e.FullNameLnf}";

    private sealed class AddBidModel
    {
        [Range(1, long.MaxValue, ErrorMessage = "Employee is required.")]
        public long EmployeeCtrlNbr { get; set; }

        [Range(1, int.MaxValue, ErrorMessage = "Priority must be at least 1.")]
        public int Priority { get; set; } = 1;
    }

    }
