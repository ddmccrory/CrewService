@using CrewService.BlazorUI.Clients
@using CrewService.Presentation

<Modal Visible="Visible" Title="@StepTitle" Icon="bi bi-magic" OnClose="CloseWizard" Size="xl"
       Scrollable="true">
    <BodyContent>
        <div style="@(isLoading ? "cursor: wait; pointer-events: none; opacity: 0.6;" : "")">
        @if (errorMessage is not null)
        {
            <div class="alert alert-danger alert-dismissible">
                @errorMessage
                <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
            </div>
        }

        @* ── Step indicator ── *@
        @if (currentStep <= 4)
        {
            <div class="d-flex justify-content-center mb-4">
                @for (var s = 1; s <= 4; s++)
                {
                    var step = s;
                    <div class="text-center mx-3">
                        <span class="badge rounded-pill @(step == currentStep ? "bg-primary" : step < currentStep ? "bg-success" : "bg-secondary") fs-6">
                            @step
                        </span>
                        <div class="small mt-1 @(step == currentStep ? "fw-bold" : "text-muted")">
                            @(step switch { 1 => "Crew", 2 => "Assignments", 3 => "Crew Assignments", 4 => "Review", _ => "" })
                        </div>
                    </div>
                }
            </div>
        }

        @* ── Step 1: Crew ── *@
        @if (currentStep == 1)
        {
            <div class="mb-3">
                <div class="form-check form-switch">
                    <input type="checkbox" class="form-check-input" id="wizard-use-existing-crew"
                           checked="@useExistingCrew" @onchange="e => useExistingCrew = (bool)(e.Value ?? false)" />
                    <label class="form-check-label" for="wizard-use-existing-crew">Use existing crew</label>
                </div>
            </div>

            @if (useExistingCrew)
            {
                <div class="mb-3">
                    <label class="form-label fw-semibold">Select Crew</label>
                    <FilterSelect TItem="CrewResponse" TValue="long"
                                  Value="selectedCrewCtrlNbr"
                                  ValueChanged="@(val => OnExistingCrewSelected(val))"
                                  Items="ExistingCrews"
                                  ValueSelector="@(c => c.CtrlNbr)"
                                  TextSelector="@(c => c.Name)"
                                  Placeholder="-- Select a crew --"
                                  Searchable="true"
                                  class="form-select" />
                </div>

                @if (selectedCrewCtrlNbr > 0 && (assignmentEntries.Any(a => a.UseExisting && a.ExistingAssignmentCtrlNbr > 0) || positionEntries.Count > 0))
                {
                    <div class="alert alert-info small mb-0">
                        <span class="bi bi-info-circle me-1"></span>
                        Loaded @positionEntries.Count position(s) and @assignmentEntries.Count(a => a.UseExisting && a.ExistingAssignmentCtrlNbr > 0) assignment(s) from this crew.
                        You can add more or modify them on the next steps.
                    </div>
                }

                @if (selectedCrewCtrlNbr > 0)
                {
                    <div class="row g-3 mt-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Crew Type</label>
                            <FilterSelect TItem="CrewTypeOption" TValue="string"
                                          @bind-Value="existingCrewType"
                                          Items="crewTypeOptions"
                                          ValueSelector="@(ct => ct.Value)"
                                          TextSelector="@(ct => ct.Label)"
                                          class="form-select" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Effective Date</label>
                            <input type="date" class="form-control" @bind="effectiveDate" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Abolish Date</label>
                            <input type="date" class="form-control" @bind="abolishedDate" />
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Crew Type</label>
                        <FilterSelect TItem="CrewTypeOption" TValue="string"
                                      @bind-Value="newCrewType"
                                      Items="crewTypeOptions"
                                      ValueSelector="@(ct => ct.Value)"
                                      TextSelector="@(ct => ct.Label)"
                                      class="form-select" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Work Area</label>
                        <FilterSelect TItem="GroupResponse" TValue="long"
                                      @bind-Value="newWorkAreaCtrlNbr"
                                      Items="allGroups"
                                      ValueSelector="@(g => g.CtrlNbr)"
                                      TextSelector="@(g => g.Name)"
                                      Placeholder="-- Select --"
                                      class="form-select" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Department</label>
                        <FilterSelect TItem="DepartmentResponse" TValue="long"
                                      @bind-Value="newCrewDeptCtrlNbr"
                                      Items="Departments"
                                      ValueSelector="@(d => d.CtrlNbr)"
                                      TextSelector="@(d => d.Name)"
                                      Placeholder="-- Select --"
                                      class="form-select" />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">Crew Name</label>
                        <input type="text" class="form-control" @bind="newCrewName" placeholder="e.g. Jax Turn Crew A" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Effective Date</label>
                        <input type="date" class="form-control" @bind="effectiveDate" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Abolish Date</label>
                        <input type="date" class="form-control" @bind="abolishedDate" />
                    </div>
                </div>
            }

            <hr class="my-4" />
            <h6 class="fw-semibold">Crew Positions</h6>
            <p class="text-muted small">Add craft role positions for this crew. Positions define which roles can be staffed.</p>

            @for (var p = 0; p < positionEntries.Count; p++)
            {
                var pos = positionEntries[p];
                var posIdx = p;
                <div class="d-flex align-items-end gap-2 mb-2">
                    <div class="flex-grow-1">
                        <label class="form-label fw-semibold">Craft Role</label>
                        <FilterSelect TItem="CraftRoleResponse" TValue="long"
                                      @bind-Value="pos.CraftRoleCtrlNbr"
                                      Items="craftRoles"
                                      ValueSelector="@(r => r.CtrlNbr)"
                                      TextSelector="@(r => $"{r.Code.ToUpperInvariant()} — {r.Name}")"
                                      Placeholder="-- Select craft role --"
                                      class="form-select" />
                    </div>
                    <div style="width:80px">
                        <label class="form-label fw-semibold">Order</label>
                        <input type="number" class="form-control" @bind="pos.DisplayOrder" min="1" />
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-danger mb-0" style="height:38px" @onclick="() => RemovePositionEntry(pos)">
                        <span class="bi bi-trash"></span>
                    </button>
                </div>
            }

            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="AddPositionEntry">
                <span class="bi bi-plus-circle"></span> Add Position
            </button>
        }

        @* ── Step 2: Assignments (select or create) ── *@
        @if (currentStep == 2)
        {
            @for (var idx = 0; idx < assignmentEntries.Count; idx++)
            {
                var entry = assignmentEntries[idx];
                var entryIndex = idx;
                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>Assignment @(entryIndex + 1)</strong>
                        @if (assignmentEntries.Count > 1)
                        {
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveAssignmentEntry(entry)">
                                <span class="bi bi-trash"></span>
                            </button>
                        }
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input type="checkbox" class="form-check-input" id="@($"wizard-existing-asgn-{entryIndex}")"
                                       checked="@entry.UseExisting" @onchange="e => entry.UseExisting = (bool)(e.Value ?? false)" />
                                <label class="form-check-label" for="@($"wizard-existing-asgn-{entryIndex}")">Use existing assignment</label>
                            </div>
                        </div>

                        @if (entry.UseExisting)
                        {
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Select Assignment</label>
                                <FilterSelect TItem="StaffingAssignmentResponse" TValue="long"
                                              Value="entry.ExistingAssignmentCtrlNbr"
                                              ValueChanged="@(val => OnExistingAssignmentSelected(entry, val))"
                                              Items="existingAssignments"
                                              ValueSelector="@(a => a.CtrlNbr)"
                                              TextSelector="@(a => $"{a.Code.ToUpperInvariant()} — {a.Name}")"
                                              Placeholder="-- Select an assignment --"
                                              Searchable="true"
                                              class="form-select" />
                            </div>

                            @if (entry.ExistingAssignmentCtrlNbr > 0)
                            {
                                <div class="row g-3 mb-3">
                                    <div class="col-md-3">
                                        <label class="form-label fw-semibold text-muted">Code</label>
                                        <div class="form-control-plaintext">@entry.ExistingCode.ToUpperInvariant()</div>
                                    </div>
                                    <div class="col-md-5">
                                        <label class="form-label fw-semibold text-muted">Name</label>
                                        <div class="form-control-plaintext">@entry.ExistingName</div>
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label fw-semibold text-muted">Group</label>
                                        <div class="form-control-plaintext">@entry.ExistingGroupName</div>
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label fw-semibold text-muted">Status</label>
                                        <div class="form-control-plaintext">
                                            @if (entry.ExistingIsActive)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">Inactive</span>
                                            }
                                            @if (entry.ExistingIsExtra)
                                            {
                                                <span class="badge bg-info ms-1">Extra</span>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <h6 class="fw-semibold">Schedule</h6>
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold text-muted">Shift</label>
                                        <div class="form-control-plaintext">@(string.IsNullOrEmpty(entry.ExistingShiftDisplay) ? "—" : entry.ExistingShiftDisplay)</div>
                                    </div>
                                    <div class="col-md-8">
                                        <label class="form-label fw-semibold text-muted">Duty Times</label>
                                        <div class="form-control-plaintext">@(string.IsNullOrEmpty(entry.ExistingDutyTimeDisplay) ? "—" : entry.ExistingDutyTimeDisplay)</div>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label fw-semibold text-muted">Assignment Operating Days</label>
                                        <DayOfWeekPicker Value="entry.ExistingOperatingDaysMask" Disabled="true" />
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="row g-3 mb-3">
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold">Group</label>
                                    <FilterSelect TItem="GroupResponse" TValue="long"
                                                  @bind-Value="entry.NewAssignment.GroupCtrlNbr"
                                                  Items="allGroupsForAssignments"
                                                  ValueSelector="@(g => g.CtrlNbr)"
                                                  TextSelector="@(g => g.Name)"
                                                  Placeholder="-- Select --"
                                                  class="form-select" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold">Department</label>
                                    <FilterSelect TItem="DepartmentResponse" TValue="long"
                                                  @bind-Value="entry.NewAssignment.DepartmentCtrlNbr"
                                                  Items="Departments"
                                                  ValueSelector="@(d => d.CtrlNbr)"
                                                  TextSelector="@(d => d.Name)"
                                                  Placeholder="-- Select --"
                                                  class="form-select" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold">Code</label>
                                    <input type="text" class="form-control" @bind="entry.NewAssignment.Code" placeholder="e.g. JAX01" />
                                </div>
                                <div class="col-md-8">
                                    <label class="form-label fw-semibold">Name</label>
                                    <input type="text" class="form-control" @bind="entry.NewAssignment.Name" placeholder="e.g. Jacksonville Turn" />
                                </div>
                                <div class="col-md-4 d-flex align-items-end">
                                    <div class="form-check form-switch">
                                        <input type="checkbox" class="form-check-input" id="@($"wizard-extra-{entryIndex}")"
                                               checked="@entry.NewAssignment.IsExtra" @onchange="e => entry.NewAssignment.IsExtra = (bool)(e.Value ?? false)" />
                                        <label class="form-check-label" for="@($"wizard-extra-{entryIndex}")">Extra Board</label>
                                    </div>
                                </div>
                            </div>

                            <h6 class="fw-semibold">Schedule</h6>
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold">Shift Definition</label>
                                    <FilterSelect TItem="ShiftDefinitionResponse" TValue="long"
                                                  @bind-Value="entry.NewAssignment.ShiftDefinitionCtrlNbr"
                                                  Items="shiftDefinitions"
                                                  ValueSelector="@(s => s.CtrlNbr)"
                                                  TextSelector="@(s => s.DisplayName)"
                                                  Placeholder="-- Select shift --"
                                                  class="form-select" />
                                </div>
                                <div class="col-md-8">
                                    <DutyTimePicker @bind-OnDutyTime="entry.NewAssignment.OnDutyTime"
                                                    @bind-OffDutyTime="entry.NewAssignment.OffDutyTime" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-semibold">Assignment Operating Days</label>
                                    <DayOfWeekPicker @bind-Value="entry.NewAssignment.OperatingDaysMask" />
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            <button type="button" class="btn btn-outline-primary" @onclick="AddAssignmentEntry">
                <span class="bi bi-plus-circle"></span> Add Assignment
            </button>
        }

        @* ── Step 3: Crew Assignments (work days + dates) ── *@
        @if (currentStep == 3)
        {
            <p class="text-muted small mb-3">Set crew work days and effective dates for each assignment.</p>
            @for (var idx = 0; idx < assignmentEntries.Count; idx++)
            {
                var entry = assignmentEntries[idx];
                var entryIndex = idx;
                <div class="card mb-3">
                    <div class="card-header">
                        <strong>
                            @if (entry.UseExisting)
                            {
                                @($"{entry.ExistingCode.ToUpperInvariant()} — {entry.ExistingName}")
                            }
                            else
                            {
                                @($"{entry.NewAssignment.Code.ToUpperInvariant()} — {entry.NewAssignment.Name}")
                            }
                        </strong>
                        @if (entry.UseExisting)
                        {
                            <span class="badge bg-secondary ms-2">Existing</span>
                        }
                        else
                        {
                            <span class="badge bg-primary ms-2">New</span>
                        }
                    </div>
                    <div class="card-body">
                        <h6 class="fw-semibold">Crew Work Days</h6>
                        <DayOfWeekPicker @bind-Value="entry.CrewWorkDaysMask" />

                        <hr />
                        <h6 class="fw-semibold">Effective Dates</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Start Date</label>
                                <input type="date" class="form-control" @bind="entry.StartDate" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">End Date <span class="text-muted fw-normal">(optional)</span></label>
                                <input type="date" class="form-control" @bind="entry.EndDate" />
                            </div>
                        </div>
                    </div>
                </div>
            }
        }

        @* ── Step 4: Review ── *@
        @if (currentStep == 4)
        {
            <h6 class="fw-semibold">Crew</h6>
            @if (useExistingCrew)
            {
                var crew = ExistingCrews?.FirstOrDefault(c => c.CtrlNbr == selectedCrewCtrlNbr);
                <p>Using existing crew: <strong>@(crew?.Name ?? "—")</strong></p>
            }
            else
            {
                <p>Creating new <strong>@newCrewType</strong> crew: <strong>@newCrewName</strong></p>
            }
            <p class="text-muted small">
                <strong>Effective:</strong> @effectiveDate.ToString("d")
                @if (abolishedDate.HasValue)
                {
                    <span class="ms-3"><strong>Abolished:</strong> @abolishedDate.Value.ToString("d")</span>
                }
            </p>

            @if (positionEntries.Count > 0)
            {
                <h6 class="fw-semibold mt-3">Positions (@positionEntries.Count)</h6>
                <table class="table table-sm">
                    <thead><tr><th>#</th><th>Craft Role</th></tr></thead>
                    <tbody>
                        @foreach (var pos in positionEntries)
                        {
                            var role = craftRoles?.FirstOrDefault(r => r.CtrlNbr == pos.CraftRoleCtrlNbr);
                            <tr>
                                <td>@pos.DisplayOrder</td>
                                <td>@(role is not null ? $"{role.Code.ToUpperInvariant()} — {role.Name}" : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <h6 class="fw-semibold mt-3">Assignments (@assignmentEntries.Count)</h6>
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Assignment</th>
                        <th>Group</th>
                        <th>Shift</th>
                        <th>Crew Days</th>
                        <th>On Duty</th>
                        <th>Start</th>
                        <th>End</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in assignmentEntries)
                    {
                        <tr>
                            <td>@(entry.UseExisting ? "Existing" : "New")</td>
                            <td>
                                @if (entry.UseExisting)
                                {
                                    @($"{entry.ExistingCode.ToUpperInvariant()} — {entry.ExistingName}")
                                }
                                else
                                {
                                    @($"{entry.NewAssignment.Code.ToUpperInvariant()} — {entry.NewAssignment.Name}")
                                }
                            </td>
                            <td>
                                @if (entry.UseExisting)
                                {
                                    @(entry.ExistingGroupName ?? "—")
                                }
                                else
                                {
                                    @(allGroupsForAssignments?.FirstOrDefault(g => g.CtrlNbr == entry.NewAssignment.GroupCtrlNbr)?.Name ?? "—")
                                }
                            </td>
                            <td>
                                @if (entry.UseExisting)
                                {
                                    @(string.IsNullOrEmpty(entry.ExistingShiftDisplay) ? "—" : entry.ExistingShiftDisplay)
                                }
                                else
                                {
                                    @(entry.NewAssignment.ShiftDefinitionCtrlNbr > 0 ? "✓" : "—")
                                }
                            </td>
                            <td>@DayOfWeekPicker.FormatDays(entry.CrewWorkDaysMask)</td>
                            <td>
                                @if (entry.UseExisting)
                                {
                                    @(string.IsNullOrEmpty(entry.ExistingDutyTimeDisplay) ? "—" : entry.ExistingDutyTimeDisplay)
                                }
                                else
                                {
                                    @($"{entry.NewAssignment.OnDutyTime:HH:mm}")
                                }
                            </td>
                            <td>@entry.StartDate.ToString("d")</td>
                            <td>@(entry.EndDate?.ToString("d") ?? "Open-ended")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @* ── Step 5: Success ── *@
        @if (currentStep == 5)
        {
            <div class="alert alert-success">
                <span class="bi bi-check-circle me-2"></span>@successSummary
            </div>
        }
        </div>
    </BodyContent>
    <Footer>
        @if (currentStep <= 4)
        {
            <button type="button" class="btn btn-outline-secondary" disabled="@isLoading" @onclick="CloseWizard">Cancel</button>
        }
        @if (currentStep > 1 && currentStep <= 4)
        {
            <button type="button" class="btn btn-outline-primary" disabled="@isLoading" @onclick="GoBack">
                <span class="bi bi-arrow-left"></span> Back
            </button>
        }
        @if (currentStep < 4)
        {
            <button type="button" class="btn btn-primary" disabled="@(!CanGoNext || isLoading)" @onclick="GoNext">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                }
                Next <span class="bi bi-arrow-right"></span>
            </button>
        }
        @if (currentStep == 4)
        {
            <button type="button" class="btn btn-success" disabled="@(isSaving || isLoading)" @onclick="Submit">
                @if (isSaving)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                }
                <span class="bi bi-check-circle me-1"></span> Submit
            </button>
        }
        @if (currentStep == 5)
        {
            <button type="button" class="btn btn-primary" @onclick="CloseWizard">Done</button>
        }
    </Footer>
</Modal>
