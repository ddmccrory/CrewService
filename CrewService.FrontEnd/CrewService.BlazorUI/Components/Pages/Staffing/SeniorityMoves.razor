    // ── display helpers ────────────────────────────────────────────────
    private string MovesEmptyMessage => showHistory ? "No seniority move history found." : "No active seniority moves.";

    // Employee/position names are resolved server-side; fall back to the
    // control number when the server could not resolve a display name.
    private static string DisplayEmployee(SeniorityMoveResponse move) =>
        string.IsNullOrWhiteSpace(move.EmployeeName) ? move.EmployeeCtrlNbr.ToString() : move.EmployeeName;

    private static string DisplayPosition(SeniorityMoveResponse move) =>
        string.IsNullOrWhiteSpace(move.TargetPositionName) ? move.TargetPositionCtrlNbr.ToString() : move.TargetPositionName;

    private static string FormatMoveType(string moveType) => moveType switch
    {
        "Voluntary"   => "Voluntary",
        "ForceAssign" => "Force Assign",
        _             => moveType
    };

    // Parses an offset-carrying ISO instant for chronological column sorting;
    // empty/unparsable values sort first (MinValue).
    private static DateTimeOffset SortableInstant(string? iso) =>
        DateTimeOffset.TryParse(iso, System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.RoundtripKind, out var dto)
            ? dto
            : DateTimeOffset.MinValue;
}