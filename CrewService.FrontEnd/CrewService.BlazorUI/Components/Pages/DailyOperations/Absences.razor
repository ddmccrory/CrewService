    private Task LoadNext24HourRequestsAsync() => LoadAbsencesAsync("next24Hours");

    private async Task LoadAbsencesAsync(string type)
    {
        try
        {
            isLoadingOpenAbsences = type == "open";
            isLoadingTomorrowRequests = type == "next24Hours";
            errorMessage = null;

            var nowUtc = DateTime.UtcNow;

            if (type == "open")
            {
                var openRangeStartUtc = nowUtc.AddDays(-1);
                var openRangeEndUtc = nowUtc.AddDays(1);

                var openResponse = await AbsenceClient.GetOpenAbsencesAsync(
                    openRangeStartUtc,
                    openRangeEndUtc,
                    selectedWorkAreaCtrlNbr > 0 ? selectedWorkAreaCtrlNbr : null,
                    selectedCraftCtrlNbr > 0 ? selectedCraftCtrlNbr : null,
                    selectedDepartmentCtrlNbr > 0 ? selectedDepartmentCtrlNbr : null);

                var requestsToLoad = openResponse.Requests
                    .ToList();

                openAbsenceRecords = requestsToLoad;
            }
            else // next24Hours
            {
                var response = await AbsenceClient.GetScheduledAbsencesAsync(
                    selectedWorkAreaCtrlNbr > 0 ? selectedWorkAreaCtrlNbr : null,
                    selectedCraftCtrlNbr > 0 ? selectedCraftCtrlNbr : null,
                    selectedDepartmentCtrlNbr > 0 ? selectedDepartmentCtrlNbr : null);

                tomorrowRequests = response.Requests
                    .OrderBy(r => r.StartUtc.ToDateTime())
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load { (type == "open" ? "open absences" : "tomorrow's requests") }: {ex.Message}";
            if (type == "open")
                openAbsenceRecords = [];
            else
                tomorrowRequests = [];
        }
        finally
        {
            isLoadingOpenAbsences = false;
            isLoadingTomorrowRequests = false;
        }
    }

