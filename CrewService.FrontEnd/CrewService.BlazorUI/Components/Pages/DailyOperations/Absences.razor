    private async Task OpenDecisionModalAsync(long absenceRequestCtrlNbr, bool isApprove)
    {
        decisionRequestCtrlNbr = absenceRequestCtrlNbr;
        decisionIsApprove = isApprove;
        decisionNotes = null;
        decisionOfficerCtrlNbr = 0;
        decisionApprovalLevel = string.Empty;
        decisionApprovalLevelDescription = string.Empty;
        decisionApprovers = [];
        try
        {
            var context = await AbsenceClient.GetAbsenceApprovalContextAsync(absenceRequestCtrlNbr);
            decisionApprovalLevel = context.ApprovalLevel;
            decisionApprovalLevelDescription = context.ApprovalLevelDescription;
            decisionApprovers = context.Approvers.ToList();
            if (context.DefaultOfficerCtrlNbr > 0)
                decisionOfficerCtrlNbr = context.DefaultOfficerCtrlNbr;
            else if (decisionApprovers.Count == 1)
                decisionOfficerCtrlNbr = decisionApprovers[0].OfficerCtrlNbr;
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load approval context: {ex.Message}";
            return;
        }

        showDecisionModal = true;
    }

