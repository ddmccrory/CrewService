    private void RebuildCalendarGrid()
    {
        calendarDays.Clear();
        var firstDay = new DateTime(displayedMonth.Year, displayedMonth.Month, 1);
        var daysInMonth = DateTime.DaysInMonth(displayedMonth.Year, displayedMonth.Month);
        var leading = (int)firstDay.DayOfWeek;

        for (var i = 0; i < leading; i++)
            calendarDays.Add(null);

        for (var day = 1; day <= daysInMonth; day++)
            calendarDays.Add(new DateTime(displayedMonth.Year, displayedMonth.Month, day));

        while (calendarDays.Count % 7 != 0)
            calendarDays.Add(null);
    }

    private async Task LoadSchedulerMetadataAsync()
    {
        if (selectedWorkAreaCtrlNbr <= 0)
        {
            nextCallSheetEventSummary = null;
            return;
        }

        try
        {
            var response = await DailyOperationsClient.GetNextCallSheetEventAsync(selectedWorkAreaCtrlNbr);
            if (response is null || string.IsNullOrWhiteSpace(response.NextEventLocal))
            {
                nextCallSheetEventSummary = null;
                return;
            }

            var shiftLabel = string.IsNullOrWhiteSpace(response.ShiftDisplayName)
                ? response.ShiftCode
                : response.ShiftDisplayName;

            var formattedNextEvent = FormatDisplayLocal(response.NextEventLocal);

            nextCallSheetEventSummary = string.IsNullOrWhiteSpace(shiftLabel)
                ? formattedNextEvent
                : $"{shiftLabel} at {formattedNextEvent}";
        }
        catch
        {
            nextCallSheetEventSummary = null;
        }
    }

