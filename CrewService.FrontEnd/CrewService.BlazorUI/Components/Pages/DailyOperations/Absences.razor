    private async Task LoadMonthCountsAsync()
    {
        monthCountsCts?.Cancel();
        monthCountsCts?.Dispose();
        monthCountsCts = new CancellationTokenSource();
        var cancellationToken = monthCountsCts.Token;

        var cacheKey = (displayedMonth.Year, displayedMonth.Month, includeAllStatuses);
        if (monthCountsCache.TryGetValue(cacheKey, out var cached))
        {
            monthCounts.Clear();
            foreach (var kvp in cached)
                monthCounts[kvp.Key] = kvp.Value;
            await InvokeAsync(StateHasChanged);
            return;
        }

        monthCounts.Clear();

        try
        {
            var daysInMonth = DateTime.DaysInMonth(displayedMonth.Year, displayedMonth.Month);
            var start = new DateTime(displayedMonth.Year, displayedMonth.Month, 1);
            using var gate = new SemaphoreSlim(6);

            var tasks = Enumerable.Range(0, daysInMonth)
                .Select(async offset =>
                {
                    cancellationToken.ThrowIfCancellationRequested();
                    await gate.WaitAsync(cancellationToken);
                    try
                    {
                        var date = start.AddDays(offset).Date;
                        var response = await AbsenceClient.GetAbsenceRequestsAsync(
                            date,
                            includeAllStatuses,
                            selectedWorkAreaCtrlNbr > 0 ? selectedWorkAreaCtrlNbr : null,
                            selectedCraftCtrlNbr > 0 ? selectedCraftCtrlNbr : null,
                            selectedDepartmentCtrlNbr > 0 ? selectedDepartmentCtrlNbr : null);
                        var compensated = 0;
                        var notCompensated = 0;

                        foreach (var item in response.Requests)
                        {
                            if (absenceCodeCompensationLookup.TryGetValue(item.AbsenceCodeCtrlNbr, out var isCompensated) && isCompensated)
                                compensated++;
                            else
                                notCompensated++;
                        }

                        return (Date: date, Compensated: compensated, NotCompensated: notCompensated);
                    }
                    finally
                    {
                        gate.Release();
                    }
                })
                .ToList();

            var results = await Task.WhenAll(tasks);
            cancellationToken.ThrowIfCancellationRequested();
            foreach (var result in results)
                monthCounts[result.Date] = (result.Compensated, result.NotCompensated);

            monthCountsCache[cacheKey] = monthCounts.ToDictionary(kvp => kvp.Key, kvp => kvp.Value);
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
        }
        catch
        {
            monthCounts.Clear();
        }
    }

    private (int Compensated, int NotCompensated) GetCountsForDay(DateTime date)
        => monthCounts.TryGetValue(date.Date, out var counts) ? counts : (0, 0);

