    private async Task ConfirmMarkOffAsync()
    {
        if (markOffRequestCtrlNbr <= 0)
            return;

        try
        {
            isSaving = true;
            errorMessage = null;
            successMessage = null;

            await AbsenceClient.MarkOffAbsenceRequestAsync(markOffRequestCtrlNbr);
            successMessage = "Absence request marked off.";

            showMarkOffModal = false;
            markOffRequestCtrlNbr = 0;
            monthCountsCache.Clear();
            await LoadRequests();
            _ = LoadMonthCountsAsync();
            await RefreshOpenAbsencesSectionAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to mark off absence request: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task SubmitDecisionAsync()
    {
        if (decisionOfficerCtrlNbr <= 0)
        {
            errorMessage = decisionIsApprove
                ? "Please select an approver before approving this request."
                : "Please select an approver before declining this request.";
            return;
        }

        try
        {
            isSaving = true;
            errorMessage = null;
            successMessage = null;

            if (decisionIsApprove)
            {
                await AbsenceClient.ApproveAbsenceRequestAsync(decisionRequestCtrlNbr, decisionOfficerCtrlNbr, decisionNotes);
                successMessage = "Absence request approved.";
            }
            else
            {
                await AbsenceClient.DeclineAbsenceRequestAsync(decisionRequestCtrlNbr, decisionOfficerCtrlNbr, decisionNotes);
                successMessage = "Absence request declined.";
            }

            showDecisionModal = false;
            monthCountsCache.Clear();
            await LoadRequests();
            _ = LoadMonthCountsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = decisionIsApprove
                ? $"Failed to approve absence request: {ex.Message}"
                : $"Failed to decline absence request: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private static bool MatchesStatusFilter(MarkOffAbsenceRequestListItem request, string filter)
    {
        if (string.Equals(filter, "ALL", StringComparison.OrdinalIgnoreCase))
            return true;

        if (string.Equals(filter, "WAITLISTED", StringComparison.OrdinalIgnoreCase))
            return request.IsWaitlisted;

        return IsStatus(request.Status, filter);
    }

    private static bool IsStatus(string? value, string expected)
        => string.Equals(value, expected, StringComparison.OrdinalIgnoreCase);

    private string GetReasonDisplay(MarkOffAbsenceRequestListItem request)
    {
        if (request.AbsenceCodeCtrlNbr > 0
            && absenceCodeDisplayLookup.TryGetValue(request.AbsenceCodeCtrlNbr, out var display)
            && !string.IsNullOrWhiteSpace(display))
        {
            return display;
        }

        return request.AbsenceCodeCtrlNbr > 0
            ? $"Unknown absence code ({request.AbsenceCodeCtrlNbr})"
            : "Unknown absence code";
    }

    private static string BuildAbsenceCodeDisplay(MarkOffCodeResponse code)
    {
        if (string.IsNullOrWhiteSpace(code.Code) && string.IsNullOrWhiteSpace(code.Description))
            return "—";

        if (string.IsNullOrWhiteSpace(code.Description))
            return code.Code;

        if (string.IsNullOrWhiteSpace(code.Code))
            return code.Description;

        return $"{code.Code} — {code.Description}";
    }

    private string GetEmployeeDisplay(long employeeCtrlNbr)
    {
        if (employeeDisplayLookup.TryGetValue(employeeCtrlNbr, out var display)
            && !string.IsNullOrWhiteSpace(display))
        {
            return display;
        }

        return $"Unknown employee ({employeeCtrlNbr})";
    }

    private static string BuildEmployeeDisplay(GetEmployeeResponse employee)
    {
        var number = string.IsNullOrWhiteSpace(employee.EmployeeNumber)
            ? employee.CtrlNbr.ToString()
            : employee.EmployeeNumber;
        var name = string.IsNullOrWhiteSpace(employee.FullNameLnf)
            ? "(No name)"
            : employee.FullNameLnf;
        return $"{number} — {name}";
    }

    private static string GetStatusBadge(MarkOffAbsenceRequestListItem request)
    {
        if (request.IsWaitlisted)
            return "text-bg-warning";

        return request.Status.ToUpperInvariant() switch
        {
            "APPROVED" => "text-bg-success",
            "EXERCISED" => "text-bg-info",
            "DENIED" => "text-bg-danger",
            "CANCELLED" => "text-bg-dark",
            _ => "text-bg-secondary"
        };
    }

    private static string GetStartDisplay(MarkOffAbsenceRequestListItem request)
    {
        if (!string.IsNullOrWhiteSpace(request.StartLocal))
            return FormatIsoForDisplay(request.StartLocal);

        return request.StartUtc.ToDateTime().ToString("yyyy-MM-dd HH:mm");
    }

    private static string GetEndDisplay(MarkOffAbsenceRequestListItem request)
    {
        if (!string.IsNullOrWhiteSpace(request.EndLocal))
            return FormatIsoForDisplay(request.EndLocal);

        return request.EndUtc is null ? "—" : request.EndUtc.ToDateTime().ToString("yyyy-MM-dd HH:mm");
    }

    private static string FormatIsoForDisplay(string iso)
    {
        if (DateTimeOffset.TryParse(iso, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.RoundtripKind, out var parsed))
            return parsed.ToString("yyyy-MM-dd HH:mm");

        return iso;
    }

    private string BuildDecisionApproverDisplay(AbsenceApprovalOfficerItem approver)
    {
        var baseDisplay = approver.DisplayName;

        if (employeeDisplayLookup.TryGetValue(approver.OfficerCtrlNbr, out var employeeDisplay)
            && !string.IsNullOrWhiteSpace(employeeDisplay))
        {
            baseDisplay = employeeDisplay;
        }

        if (string.IsNullOrWhiteSpace(approver.Role))
            return baseDisplay;

        return $"{baseDisplay} ({approver.Role})";
    }


