@page "/daily/absences"
@page "/daily/mark-offs"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using CrewService.BlazorUI.Clients
@using CrewService.BlazorUI.Services
@using CrewService.Presentation

@inherits AppComponentBase

@attribute [Authorize]

@inject AbsenceClient AbsenceClient
@inject CraftClient CraftClient
@inject RailroadReferenceDataService ReferenceData
@inject DailyOperationsClient DailyOperationsClient
@inject EmployeeClient EmployeeClient

<PageTitle>Absences</PageTitle>

<h1>Absences</h1>

@if (ShowSelectRailroadBanner)
{
    <div class="alert alert-warning">
        <span class="bi bi-exclamation-triangle"></span>
        Please select a railroad in the context switcher to manage absences.
    </div>
}
else if (HasRailroad)
{
    @if (isPageLoading)
    {
        <LoadingMessage ContainerClass="d-flex align-items-center gap-2 mt-3" />
    }
    else
    {
    <p class="text-muted mb-1">Daily operations for <strong>@SelectedRailroadName</strong></p>

    @if (!string.IsNullOrWhiteSpace(nextCallSheetEventSummary))
    {
        <p class="text-muted mb-1 small">
            <span class="bi bi-clock me-1"></span>Next processing event: <strong>@nextCallSheetEventSummary</strong>
        </p>
    }

    <SuccessAlert @bind-Message="successMessage" />

    <div class="d-flex align-items-center gap-2 flex-nowrap w-100 mb-3" style="overflow-x: auto;">
        <label class="form-label mb-0 small">Work Area</label>
        <select class="form-select form-select-sm" style="width: 220px;" @bind="selectedWorkAreaCtrlNbr" @bind:after="OnWorkAreaChangedAsync">
            @if (workAreas.Count != 1)
            {
                <option value="0">All Work Areas</option>
            }
            @foreach (var wa in workAreas)
            {
                <option value="@wa.CtrlNbr">@wa.Name</option>
            }
        </select>

        <label class="form-label mb-0 small">Department</label>
        <select class="form-select form-select-sm" style="width: 220px;" @bind="selectedDepartmentCtrlNbr" @bind:after="OnDepartmentChangedAsync">
            @if (departments.Count != 1)
            {
                <option value="0">All Departments</option>
            }
            @foreach (var dept in departments)
            {
                <option value="@dept.CtrlNbr">@dept.Name</option>
            }
        </select>

        <label class="form-label mb-0 small">Craft</label>
        <select class="form-select form-select-sm" style="width: 220px;" @bind="selectedCraftCtrlNbr" @bind:after="OnCraftChangedAsync">
            @if (crafts.Count != 1)
            {
                <option value="0">All Crafts</option>
            }
            @foreach (var craft in crafts)
            {
                <option value="@craft.CtrlNbr">@craft.CraftName</option>
            }
        </select>
    </div>

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button type="button" class="nav-link @(!IsRequestsTab ? "active" : null)" @onclick="ShowOpenAbsencesTabAsync">
                Open Absences
            </button>
        </li>
        <li class="nav-item">
            <button type="button" class="nav-link @(IsRequestsTab ? "active" : null)" @onclick="ShowRequestsTabAsync">
                Absence Requests
            </button>
        </li>
    </ul>

    @if (IsRequestsTab)
    {
    <div class="card mb-3">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center mb-0">
                <div class="d-flex align-items-center">
                    <span class="bi bi-calendar3 me-1"></span>
                    <strong>Absence Calendar</strong>
                </div>
                <div class="d-flex align-items-center gap-2 justify-content-end flex-nowrap" style="overflow-x: auto; min-height: 36px;">
                    <label class="form-label mb-0 small">Calendar</label>
                    <div class="btn-group btn-group-sm" role="group" aria-label="Month navigation">
                        <button type="button" class="btn btn-outline-secondary" @onclick="PreviousCalendarMonth" title="Previous month">
                            <span class="bi bi-chevron-left"></span>
                        </button>
                        <select class="form-select form-select-sm" style="width: 130px;" @bind="selectedCalendarMonth" @bind:after="OnCalendarPeriodChangedAsync">
                            @foreach (var month in monthOptions)
                            {
                                <option value="@month.Value">@month.Label</option>
                            }
                        </select>
                        <button type="button" class="btn btn-outline-secondary" @onclick="NextCalendarMonth" title="Next month">
                            <span class="bi bi-chevron-right"></span>
                        </button>
                    </div>
                    <div class="btn-group btn-group-sm" role="group" aria-label="Year navigation">
                        <button type="button" class="btn btn-outline-secondary" @onclick="PreviousCalendarYear" title="Previous year">
                            <span class="bi bi-chevron-left"></span>
                        </button>
                        <select class="form-select form-select-sm" style="width: 100px;" @bind="selectedCalendarYear" @bind:after="OnCalendarPeriodChangedAsync">
                            @foreach (var year in calendarYearOptions)
                            {
                                <option value="@year">@year</option>
                            }
                        </select>
                        <button type="button" class="btn btn-outline-secondary" @onclick="NextCalendarYear" title="Next year">
                            <span class="bi bi-chevron-right"></span>
                        </button>
                    </div>
                    <div class="btn-group btn-group-sm" role="group" aria-label="Day navigation">
                        <button class="btn btn-outline-secondary" @onclick="PreviousDay" title="Previous day">
                            <span class="bi bi-chevron-left"></span>
                        </button>
                        <button class="btn btn-outline-secondary" @onclick="GoToCurrentMonth">Today</button>
                        <button class="btn btn-outline-secondary" @onclick="NextDay" title="Next day">
                            <span class="bi bi-chevron-right"></span>
                        </button>
                    </div>
                </div>
            </div>

        </div>
        <div class="card-body">
            <div class="mb-3">
                <strong>@displayedMonth.ToString("MMMM yyyy")</strong>
            </div>

            <div class="table-responsive mb-3">
                <table class="table table-bordered align-middle text-center mb-0" style="table-layout: fixed;">
                    <thead>
                        <tr class="small">
                            @foreach (var dayName in dayNames)
                            {
                                <th class="fw-semibold">@dayName</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (var weekStart = 0; weekStart < calendarDays.Count; weekStart += 7)
                        {
                            <tr>
                                @for (var i = 0; i < 7; i++)
                                {
                                    var day = calendarDays[weekStart + i];
                                    if (day.HasValue)
                                    {
                                        var isSelected = day.Value.Date == selectedDate.Date;
                                        var counts = GetCountsForDay(day.Value.Date);
                                        <td class="p-1">
                                            <button class="btn btn-sm w-100 text-start @(isSelected ? "btn-primary" : "btn-outline-secondary")"
                                                    style="aspect-ratio: 2 / 1;"
                                                    @onclick="() => SelectCalendarDayAsync(day.Value)">
                                                <div class="d-flex justify-content-between">
                                                    <strong>@day.Value.Day</strong>
                                                </div>
                                                <div class="mt-1 d-flex gap-1 flex-wrap">
                                                    <span class="badge @(isSelected ? "text-bg-light" : "text-bg-success")">C @counts.Compensated</span>
                                                    <span class="badge @(isSelected ? "text-bg-light" : "text-bg-danger")">N @counts.NotCompensated</span>
                                                </div>
                                            </button>
                                        </td>
                                    }
                                    else
                                    {
                                        <td class="bg-body-tertiary"></td>
                                    }
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
    }
    else
    {
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <span class="bi bi-list-check me-1"></span>
                    <strong>Open Absences</strong>
                </div>
                <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshOpenAbsencesSectionAsync" disabled="@(isLoadingOpenAbsences || isLoadingTomorrowRequests)">
                    <span class="bi bi-arrow-repeat"></span> Refresh
                </button>
            </div>
            <div class="card-body">
                @if (isLoadingOpenAbsences)
                {
                    <LoadingMessage />
                }
                else if (openAbsenceRecords.Count == 0)
                {
                    <div class="alert alert-info mb-0">No open absence records found.</div>
                }
                else
                {
                    <DataTable TItem="MarkOffAbsenceRequestListItem"
                               Items="openAbsenceRecords"
                               Columns="OpenAbsenceColumns"
                               SearchFilter="MatchesAbsenceTableSearch"
                               SearchPlaceholder="Filter open absences..."
                               DefaultSortColumn="Start">
                        <RowContent Context="req">
                            <td><span class="badge @GetStatusBadge(req)">@req.Status</span></td>
                            <td>@GetEmployeeDisplay(req.EmployeeCtrlNbr)</td>
                            <td>@GetReasonDisplay(req)</td>
                            <td>@GetStartDisplay(req)</td>
                            <td>@GetEndDisplay(req)</td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(req.Notes))
                                {
                                    <span>—</span>
                                }
                                else
                                {
                                    <span class="bi bi-chat-left-text" title="@req.Notes" aria-label="Has notes"></span>
                                }
                            </td>
                        </RowContent>
                    </DataTable>
                }

                <hr />

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="mb-0">Scheduled Absences (Next 24 Hours)</h6>
                    <span class="badge text-bg-secondary">@next24HourScheduledAbsences.Count Scheduled</span>
                </div>

                @if (isLoadingTomorrowRequests)
                {
                    <LoadingMessage ContainerClass="d-flex align-items-center gap-2 text-muted mb-2" />
                }
                else if (next24HourScheduledAbsences.Count == 0)
                {
                    <div class="alert alert-info mb-0">No absence requests found for the next 24 hours.</div>
                }
                else
                {
                    <DataTable TItem="MarkOffAbsenceRequestListItem"
                               Items="next24HourScheduledAbsences"
                               Columns="ScheduledAbsenceColumns"
                               SearchFilter="MatchesAbsenceTableSearch"
                               SearchPlaceholder="Filter scheduled absences..."
                               DefaultSortColumn="Start">
                        <RowContent Context="req">
                            <td><span class="badge @GetStatusBadge(req)">@req.Status</span></td>
                            <td>@GetEmployeeDisplay(req.EmployeeCtrlNbr)</td>
                            <td>@GetReasonDisplay(req)</td>
                            <td>@GetStartDisplay(req)</td>
                            <td>@GetEndDisplay(req)</td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(req.Notes))
                                {
                                    <span>—</span>
                                }
                                else
                                {
                                    <span class="bi bi-chat-left-text" title="@req.Notes" aria-label="Has notes"></span>
                                }
                            </td>
                            @if (ShowScheduledActionsColumn)
                            {
                                <td class="text-end">
                                    @if (IsStatus(req.Status, "APPROVED"))
                                    {
                                        <button class="btn btn-outline-primary btn-sm"
                                                @onclick="() => OpenMarkOffModal(req.CtrlNbr)"
                                                disabled="@isSaving">
                                            Mark-off
                                        </button>
                                    }
                                </td>
                            }
                        </RowContent>
                    </DataTable>
                }
            </div>
        </div>
    }

    }

    <Modal Visible="showRequestsModal"
           Title="@($"Absence Requests — {selectedDate:MM/dd/yyyy}")"
           Icon="bi bi-list-check"
           OnClose="CloseRequestsModal"
           Size="xl"
           Scrollable="true">
        <BodyContent>
            <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
                <div class="form-check form-switch mb-0">
                    <InputCheckbox @bind-Value="includeAllStatuses" class="form-check-input" id="includeAllStatuses" @bind-Value:after="OnIncludeAllStatusesChangedAsync" />
                    <label class="form-check-label" for="includeAllStatuses">Include denied/cancelled</label>
                </div>
                <button class="btn btn-sm btn-outline-secondary" @onclick="LoadRequests">
                    <span class="bi bi-arrow-repeat"></span> Refresh
                </button>
                @if (!IsFeatureReadOnly)
                {
                    <button class="btn btn-sm btn-primary" @onclick="OpenCreateRequestModalAsync" disabled="@(absenceCodes.Count == 0)">
                        <span class="bi bi-plus-circle"></span> Create Request
                    </button>
                }
            </div>

            <div class="d-flex align-items-center gap-2 mb-3">
                <label class="form-label mb-0 small">Status</label>
                <select class="form-select form-select-sm" style="width: 180px;" @bind="selectedStatusFilter">
                    <option value="ALL">All</option>
                    <option value="PENDING">Requested</option>
                    <option value="WAITLISTED">Waitlisted</option>
                    <option value="APPROVED">Scheduled</option>
                    <option value="EXERCISED">Exercised</option>
                    <option value="DENIED">Denied</option>
                    <option value="CANCELLED">Cancelled</option>
                </select>
            </div>

            <div class="d-flex flex-wrap gap-2 mb-3">
                <span class="badge text-bg-secondary">Total @requests.Count</span>
                <span class="badge text-bg-secondary">Requested @requests.Count(r => IsStatus(r.Status, "PENDING"))</span>
                <span class="badge text-bg-secondary">Waitlisted @requests.Count(r => r.IsWaitlisted)</span>
                <span class="badge text-bg-secondary">Scheduled @requests.Count(r => IsStatus(r.Status, "APPROVED"))</span>
                <span class="badge text-bg-secondary">Exercised @requests.Count(r => IsStatus(r.Status, "EXERCISED"))</span>
            </div>

            @if (!IsFeatureReadOnly && absenceCodes.Count == 0)
            {
                <div class="alert alert-warning mb-3">
                    No active absence codes are configured for this railroad. Create codes in Work Management before creating requests.
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger mb-3">@errorMessage</div>
            }

            @if (isLoadingRequests)
            {
                <div class="text-muted">
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    Loading absence requests...
                </div>
            }
            else if (filteredRequests.Count == 0)
            {
                <div class="alert alert-info mb-0">No absence requests found for the selected date.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Status</th>
                                <th>Employee</th>
                                <th>Reason</th>
                                    <th>Start (Work Area Local)</th>
                                    <th>End (Work Area Local)</th>
                                <th>Notes</th>
                                @if (ShowRequestActionsColumn)
                                {
                                    <th class="text-end">Actions</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var req in filteredRequests)
                            {
                                <tr>
                                    <td><span class="badge @GetStatusBadge(req)">@req.Status</span></td>
                                    <td>@GetEmployeeDisplay(req.EmployeeCtrlNbr)</td>
                                    <td>@GetReasonDisplay(req)</td>
                                    <td>@GetStartDisplay(req)</td>
                                    <td>@GetEndDisplay(req)</td>
                                    <td>
                                        @if (string.IsNullOrWhiteSpace(req.Notes))
                                        {
                                            <span>—</span>
                                        }
                                        else
                                        {
                                            <span class="bi bi-chat-left-text" title="@req.Notes" aria-label="Has notes"></span>
                                        }
                                    </td>
                                    @if (ShowRequestActionsColumn)
                                    {
                                        <td class="text-end">
                                            @if (IsStatus(req.Status, "PENDING") || req.IsWaitlisted)
                                            {
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <button class="btn btn-outline-success" @onclick="() => ApproveRequest(req.CtrlNbr)" disabled="@isSaving">Approve</button>
                                                    <button class="btn btn-outline-danger" @onclick="() => DeclineRequest(req.CtrlNbr)" disabled="@isSaving">Decline</button>
                                                </div>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </BodyContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="CloseRequestsModal">Close</button>
        </Footer>
    </Modal>

    <CreateAbsenceRequestModal Visible="showCreateRequestModal"
                              OnClose="CloseCreateRequestModal"
                              OnCreated="OnCreateRequestCreatedAsync"
                              OnError="OnCreateRequestError"
                              ParentCtrlNbr="SelectedParentCtrlNbr"
                              RailroadCtrlNbr="SelectedRailroadCtrlNbr"
                              SelectedCraftCtrlNbr="selectedCraftCtrlNbr"
                              SelectedDepartmentCtrlNbr="selectedDepartmentCtrlNbr"
                              SelectedWorkAreaCtrlNbr="selectedWorkAreaCtrlNbr"
                              SelectedDate="selectedDate"
                              DefaultEmployeeCtrlNbr="DefaultCreateEmployeeCtrlNbr"
                              AbsenceCodes="absenceCodes"
                              WorkAreas="workAreas"
                              EmployeeDisplayLookup="employeeDisplayLookup" />

    <Modal Visible="showDecisionModal"
           Title="@(decisionIsApprove ? "Approve Absence Request" : "Decline Absence Request")"
           Icon="@(decisionIsApprove ? "bi bi-check-circle" : "bi bi-x-circle")"
           OnClose="CloseDecisionModal">
        <BodyContent>
            <div class="mb-3">
                <label class="form-label fw-semibold">Approval Level</label>
                <div class="form-control-plaintext border rounded px-2 py-1 bg-body-tertiary">@decisionApprovalLevelDescription</div>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Approved By</label>
                <InputSelect @bind-Value="decisionOfficerCtrlNbr" class="form-select" disabled="@(decisionApprovers.Count == 0)">
                    <option value="0">-- Select approver --</option>
                    @foreach (var approver in decisionApprovers)
                    {
                        <option value="@approver.OfficerCtrlNbr">@BuildDecisionApproverDisplay(approver)</option>
                    }
                </InputSelect>
            </div>
            <div class="mb-0">
                <label class="form-label fw-semibold">Notes (optional)</label>
                <InputTextArea @bind-Value="decisionNotes" class="form-control" rows="3" />
            </div>
        </BodyContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="CloseDecisionModal">Cancel</button>
            <button type="button" class="btn @(decisionIsApprove ? "btn-success" : "btn-danger")" @onclick="SubmitDecisionAsync" disabled="@isSaving">
                @(decisionIsApprove ? "Approve" : "Decline")
            </button>
        </Footer>
    </Modal>

    <Modal Visible="showMarkOffModal"
           Title="Mark-off Approved Absence"
           Icon="bi bi-check2-square"
           OnClose="CloseMarkOffModal">
        <BodyContent>
            <p class="mb-0">Confirm mark-off for this approved absence request?</p>
        </BodyContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="CloseMarkOffModal">Cancel</button>
            <button type="button" class="btn btn-primary" @onclick="ConfirmMarkOffAsync" disabled="@isSaving">Mark-off</button>
        </Footer>
    </Modal>
}

@code {
    protected override string? FeatureKey => "daily/mark-offs";

    private DateTime selectedDate = DateTime.Today;
    private bool includeAllStatuses;
    private bool isLoadingRequests;
    private bool showRequestsModal;
    private bool showCreateRequestModal;
    private bool showDecisionModal;
    private bool showMarkOffModal;
    private bool decisionIsApprove;
    private long decisionRequestCtrlNbr;
    private long decisionOfficerCtrlNbr;
    private long markOffRequestCtrlNbr;
    private string? decisionNotes;
    private string decisionApprovalLevel = string.Empty;
    private string decisionApprovalLevelDescription = string.Empty;
    private List<AbsenceApprovalOfficerItem> decisionApprovers = [];
    private string selectedStatusFilter = "ALL";
    private List<MarkOffCodeResponse> absenceCodes = [];
    private Dictionary<long, bool> absenceCodeCompensationLookup = [];
    private Dictionary<long, string> absenceCodeDisplayLookup = [];
    private Dictionary<long, string> employeeDisplayLookup = [];
    private List<GroupResponse> workAreas = [];
    private List<DepartmentResponse> departments = [];
    private List<CraftResponse> crafts = [];
    private long? DefaultCreateEmployeeCtrlNbr;
    private List<MarkOffAbsenceRequestListItem> requests = [];
    private List<MarkOffAbsenceRequestListItem> openAbsenceRecords = [];
    private List<MarkOffAbsenceRequestListItem> tomorrowRequests = [];
    private bool isLoadingOpenAbsences;
    private bool isLoadingTomorrowRequests;
    private bool isPageLoading = true;
    private string activeAbsenceTab = "open";
    private long selectedCraftCtrlNbr;
    private long selectedDepartmentCtrlNbr;
    private long selectedWorkAreaCtrlNbr;
    private DateTime displayedMonth = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private int selectedCalendarMonth = DateTime.Today.Month;
    private int selectedCalendarYear = DateTime.Today.Year;
    private string? nextCallSheetEventSummary;

    private static readonly string[] dayNames = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
    private static readonly (int Value, string Label)[] monthOptions =
    [
        (1, "January"), (2, "February"), (3, "March"), (4, "April"), (5, "May"), (6, "June"),
        (7, "July"), (8, "August"), (9, "September"), (10, "October"), (11, "November"), (12, "December")
    ];
    private List<DateTime?> calendarDays = [];
    private readonly Dictionary<DateTime, (int Compensated, int NotCompensated)> monthCounts = [];
    private readonly Dictionary<(int Year, int Month, bool IncludeAllStatuses), Dictionary<DateTime, (int Compensated, int NotCompensated)>> monthCountsCache = [];
    private CancellationTokenSource? monthCountsCts;
    private IEnumerable<int> calendarYearOptions => Enumerable.Range(DateTime.Today.Year - 5, 11);
    private bool IsRequestsTab => string.Equals(activeAbsenceTab, "requests", StringComparison.OrdinalIgnoreCase);
    private List<MarkOffAbsenceRequestListItem> next24HourScheduledAbsences => tomorrowRequests
        .Where(r => IsStatus(r.Status, "APPROVED"))
        .ToList();

    private List<MarkOffAbsenceRequestListItem> filteredRequests => requests
        .Where(r => MatchesStatusFilter(r, selectedStatusFilter))
        .ToList();

    private bool ShowRequestActionsColumn
        => !IsFeatureReadOnly
            && filteredRequests.Any(r => IsStatus(r.Status, "PENDING") || r.IsWaitlisted);

    private bool ShowScheduledActionsColumn
        => !IsFeatureReadOnly
            && tomorrowRequests.Any(r => IsStatus(r.Status, "APPROVED"));

    private IReadOnlyList<DataTableColumn<MarkOffAbsenceRequestListItem>> OpenAbsenceColumns =>
    [
        new("Status", req => req.Status),
        new("Employee", req => GetEmployeeDisplay(req.EmployeeCtrlNbr)),
        new("Reason", req => GetReasonDisplay(req)),
        new("Start (Work Area Local)", req => req.StartUtc?.ToDateTime() ?? DateTime.MinValue, sortKey: "Start"),
        new("End (Work Area Local)", req => req.EndUtc?.ToDateTime() ?? DateTime.MaxValue),
        new("Notes", req => req.Notes ?? string.Empty)
    ];

    private IReadOnlyList<DataTableColumn<MarkOffAbsenceRequestListItem>> ScheduledAbsenceColumns
    {
        get
        {
            var columns = new List<DataTableColumn<MarkOffAbsenceRequestListItem>>
            {
                new("Status", req => req.Status),
                new("Employee", req => GetEmployeeDisplay(req.EmployeeCtrlNbr)),
                new("Reason", req => GetReasonDisplay(req)),
                new("Start (Work Area Local)", req => req.StartUtc?.ToDateTime() ?? DateTime.MinValue, sortKey: "Start"),
                new("End (Work Area Local)", req => req.EndUtc?.ToDateTime() ?? DateTime.MaxValue),
                new("Notes", req => req.Notes ?? string.Empty)
            };

            if (ShowScheduledActionsColumn)
                columns.Add(DataTableColumn<MarkOffAbsenceRequestListItem>.Actions("120px"));

            return columns;
        }
    }

    private bool MatchesAbsenceTableSearch(MarkOffAbsenceRequestListItem req, string term)
    {
        return req.Status.Contains(term, StringComparison.OrdinalIgnoreCase)
            || GetEmployeeDisplay(req.EmployeeCtrlNbr).Contains(term, StringComparison.OrdinalIgnoreCase)
            || GetReasonDisplay(req).Contains(term, StringComparison.OrdinalIgnoreCase)
            || (!string.IsNullOrWhiteSpace(req.Notes) && req.Notes.Contains(term, StringComparison.OrdinalIgnoreCase));
    }

    protected override async Task LoadDataAsync()
    {
        if (!HasRailroad)
            return;

        isPageLoading = true;
        try
        {
            await Task.WhenAll(
                LoadAbsenceCodes(),
                LoadEmployeeDisplayLookupAsync(),
                LoadWorkAreasAsync(),
                LoadDepartmentsAsync(),
                LoadCraftsAsync());

            selectedCalendarMonth = displayedMonth.Month;
            selectedCalendarYear = displayedMonth.Year;
            RebuildCalendarGrid();
            _ = LoadMonthCountsAsync();
            await LoadSchedulerMetadataAsync();

            if (!IsRequestsTab)
            {
                await Task.WhenAll(
                    LoadOpenAbsencesAsync(),
                    LoadNext24HourRequestsAsync());
            }
        }
        finally
        {
            isPageLoading = false;
        }
    }

    private Task ShowRequestsTabAsync() => SetActiveAbsenceTabAsync("requests");

    private Task ShowOpenAbsencesTabAsync() => SetActiveAbsenceTabAsync("open");

    private async Task SetActiveAbsenceTabAsync(string tab)
    {
        if (string.Equals(activeAbsenceTab, tab, StringComparison.OrdinalIgnoreCase))
            return;

        activeAbsenceTab = tab;
        if (!IsRequestsTab)
        {
            await LoadOpenAbsencesAsync();
            await LoadNext24HourRequestsAsync();
        }
    }

    protected override async Task OnAppContextChangedAsync()
    {
        requests = [];
        absenceCodes = [];
        employeeDisplayLookup = [];
        crafts = [];
        workAreas = [];
        departments = [];
        openAbsenceRecords = [];
        tomorrowRequests = [];
        selectedCraftCtrlNbr = 0;
        selectedDepartmentCtrlNbr = 0;
        selectedWorkAreaCtrlNbr = 0;
        nextCallSheetEventSummary = null;
        monthCountsCache.Clear();

        if (!HasRailroad)
            return;

        isPageLoading = true;
        try
        {
            await Task.WhenAll(
                LoadAbsenceCodes(),
                LoadEmployeeDisplayLookupAsync(),
                LoadWorkAreasAsync(),
                LoadDepartmentsAsync(),
                LoadCraftsAsync());

            displayedMonth = new DateTime(selectedDate.Year, selectedDate.Month, 1);
            selectedCalendarMonth = displayedMonth.Month;
            selectedCalendarYear = displayedMonth.Year;
            RebuildCalendarGrid();
            _ = LoadMonthCountsAsync();
            await LoadSchedulerMetadataAsync();

            if (!IsRequestsTab)
            {
                await Task.WhenAll(
                    LoadOpenAbsencesAsync(),
                    LoadNext24HourRequestsAsync());
            }
        }
        finally
        {
            isPageLoading = false;
        }
    }

