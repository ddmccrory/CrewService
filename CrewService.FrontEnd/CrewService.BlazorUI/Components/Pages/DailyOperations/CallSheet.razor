@page "/daily-operations/call-sheet"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using CrewService.BlazorUI.Clients
@using CrewService.Presentation

@inherits AppComponentBase

@attribute [Authorize]

@inject DailyOperationsClient DailyOperationsClient
@inject WorkManagementClient WorkManagementClient
@inject RailroadReferenceDataService ReferenceData

<PageTitle>Call Sheet</PageTitle>

<h1>Call Sheet</h1>

@if (!HasRailroad)
{
    <div class="alert alert-warning">
        <span class="bi bi-exclamation-triangle"></span>
        Please select a railroad in the context switcher to view call sheets.
    </div>
}
else
{
    <p class="text-muted mb-3">Daily operations for <strong>@SelectedRailroadName</strong></p>

    <div class="row align-items-end g-2" style="margin-bottom: 2.25rem;">
        <div class="col-auto">
            <label class="form-label fw-semibold">Work Area</label>
            <FilterSelect TItem="GroupResponse" TValue="long"
                          @bind-Value="selectedWorkAreaCtrlNbr"
                          @bind-Value:after="OnWorkAreaSelected"
                          Items="workAreas"
                          ValueSelector="@(wa => wa.CtrlNbr)"
                          TextSelector="@(wa => wa.Name)"
                          Placeholder="-- Select Work Area --"
                          class="form-select form-select-sm" style="width: 180px;" />
        </div>
        <div class="col-auto" style="position: relative;">
            <label class="form-label fw-semibold">Date</label>
            <input type="date" class="form-control form-control-sm" style="width: 180px;"
                   value="@selectedDate.ToString("yyyy-MM-dd")"
                   @onchange="OnDateChanged" />
            <div class="btn-group mt-1" style="position: absolute; width: 180px; font-size: 0.7rem;">
                <button type="button" class="btn btn-outline-secondary py-0 px-1 flex-fill" style="font-size: inherit;" @onclick="() => SetDate(-1)">Yesterday</button>
                <button type="button" class="btn btn-outline-secondary py-0 px-1 flex-fill" style="font-size: inherit;" @onclick="() => SetDate(0)">Today</button>
                <button type="button" class="btn btn-outline-secondary py-0 px-1 flex-fill" style="font-size: inherit;" @onclick="() => SetDate(1)">Tomorrow</button>
            </div>
        </div>
        <div class="col-auto">
            <label class="form-label fw-semibold">Department</label>
            <FilterSelect TItem="DepartmentResponse" TValue="long"
                          @bind-Value="selectedDepartmentCtrlNbr"
                          @bind-Value:after="OnDepartmentSelected"
                          Items="departments"
                          ValueSelector="@(d => d.CtrlNbr)"
                          TextSelector="@(d => d.Name)"
                          Placeholder="-- Select Department --"
                          class="form-select form-select-sm" style="width: 180px;" />
        </div>
        <div class="col-auto d-flex align-items-end" style="padding-bottom: 0.375rem;">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="showClosedToggle"
                       checked="@showClosedShifts"
                       @onchange="OnShowClosedChanged" />
                <label class="form-check-label" for="showClosedToggle">Show closed</label>
            </div>
        </div>
    </div>

    <SuccessAlert @bind-Message="successMessage" />

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (selectedWorkAreaCtrlNbr > 0 && callSheetLoaded)
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">
                Call Sheet for @selectedDate.ToString("dddd, MMMM d, yyyy")
            </h5>
            @if (!IsFeatureReadOnly)
            {
                <button class="btn btn-success" @onclick="OpenGenerateModal">
                    <span class="bi bi-plus-circle"></span> Generate Shift
                </button>
            }
        </div>

        @if (selectedDepartmentCtrlNbr == 0)
        {
            <div class="alert alert-info">
                <span class="bi bi-info-circle"></span>
                Please select a department to view call sheets.
            </div>
        }
        else
        {
            var filteredShifts = (shifts ?? [])
                .Where(s => s.DepartmentCtrlNbr == selectedDepartmentCtrlNbr)
                .OrderBy(s => s.ShiftCode)
                .ToList();

            if (filteredShifts.Count == 0)
            {
                <div class="alert alert-info">
                    <span class="bi bi-info-circle"></span>
                    No shifts have been generated for this department. Click <strong>Generate Shift</strong> to create one.
                </div>
            }
            else
            {
                var activeShift = filteredShifts.FirstOrDefault(s => s.CtrlNbr == activeShiftCtrlNbr) ?? filteredShifts[0];
                var isShiftReadOnly = IsFeatureReadOnly || activeShift.Status == "Completed";

                <ul class="nav nav-tabs mb-3">
                    @foreach (var shift in filteredShifts)
                    {
                        <li class="nav-item">
                            <button class="nav-link @(activeShift.CtrlNbr == shift.CtrlNbr ? "active" : "") @(shift.Status == "Completed" ? "text-muted" : "")"
                                    @onclick="() => activeShiftCtrlNbr = shift.CtrlNbr">
                                <span class="badge @(shift.Status == "Completed" ? "bg-secondary" : "bg-primary") me-1">@shift.ShiftCode.ToUpperInvariant()</span>
                                @shift.ShiftDisplayName
                            </button>
                        </li>
                    }
                </ul>

                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-end align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <div class="btn-group btn-group-sm" role="group" aria-label="Layout toggle">
                                <button type="button" class="btn @(useHorizontalLayout ? "btn-outline-secondary" : "btn-secondary")"
                                        @onclick="() => useHorizontalLayout = false" title="Vertical layout">
                                    <span class="bi bi-list"></span>
                                </button>
                                <button type="button" class="btn @(useHorizontalLayout ? "btn-secondary" : "btn-outline-secondary")"
                                        @onclick="() => useHorizontalLayout = true" title="Horizontal layout">
                                    <span class="bi bi-table"></span>
                                </button>
                            </div>
                            <span class="badge @GetStatusBadgeClass(activeShift.Status)">@activeShift.Status</span>
                            @if (activeShift.Status != "Completed")
                            {
                                <button class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => RefreshShift(activeShift.CtrlNbr)"
                                        title="Rebuild this call sheet">
                                    <span class="bi bi-arrow-clockwise"></span> Refresh
                                </button>
                                @if (!IsFeatureReadOnly)
                                {
                                    <button class="btn btn-sm btn-outline-primary"
                                            @onclick="() => OpenAddAssignmentModal(activeShift.CtrlNbr)"
                                            title="Add an extra assignment to this shift">
                                        <span class="bi bi-plus-circle"></span> Add Assignment
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => OpenCloseModal(activeShift)"
                                            title="Close this shift">
                                        <span class="bi bi-x-circle"></span> Close
                                    </button>
                                }
                            }
                            else if (!IsFeatureReadOnly)
                            {
                                <button class="btn btn-sm btn-outline-success"
                                        @onclick="() => ReopenShift(activeShift.CtrlNbr)"
                                        disabled="@isReopening"
                                        title="Re-open this completed shift">
                                    @if (isReopening)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                    }
                                    <span class="bi bi-arrow-counterclockwise"></span> Re-open
                                </button>
                            }
                        </div>
                    </div>
                    <div class="card-body p-0" style="overflow: visible;">
                        @if (activeShift.PositionSlots.Count == 0)
                        {
                            <p class="text-muted p-3 mb-0"><em>No positions on this shift.</em></p>
                        }
                        else if (useHorizontalLayout)
                        {
                            var assignmentGroups = activeShift.PositionSlots
                                .GroupBy(p => new { p.AssignmentCtrlNbr, p.AssignmentCode, p.OnDutyTime, p.OffDutyTime, p.GroupCode })
                                .OrderBy(g => g.Key.AssignmentCode)
                                .ToList();

                            var craftRoleColumns = activeShift.PositionSlots
                                .Select(s => s.CraftRoleName)
                                .Distinct()
                                .OrderBy(name => name)
                                .ToList();

                            <div class="table-responsive" style="overflow: visible; font-size: 0.85rem;">
                                <table class="table table-sm table-striped table-hover mb-0">
                                    <thead>
                                        <tr>
                                            <th>Assignment</th>
                                            <th>Location</th>
                                            <th>On Duty</th>
                                            @foreach (var role in craftRoleColumns)
                                            {
                                                <th style="min-width: 15ch;">@role</th>
                                            }
                                            @if (!isShiftReadOnly)
                                            {
                                                <th style="width: 80px;" class="text-end">Actions</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var group in assignmentGroups)
                                        {
                                            var slotsByRole = group
                                                .GroupBy(s => s.CraftRoleName)
                                                .ToDictionary(g => g.Key, g => g.OrderBy(s => s.DisplayOrder).ToList());
                                            var allAnnulled = IsAssignmentFullyAnnulled(group);
                                            var hNote = GetAssignmentNote(activeShift, group.Key.AssignmentCtrlNbr);

                                            <tr class="@(allAnnulled ? "text-muted text-decoration-line-through" : "")">
                                                <td>
                                                    <strong>@group.Key.AssignmentCode.ToUpperInvariant()</strong>
                                                    @{ var hReliefName = group.FirstOrDefault(s => s.CrewType == "RELIEF")?.CrewName; }
                                                    @if (!string.IsNullOrEmpty(hReliefName))
                                                    {
                                                        <span class="small ms-1">(@hReliefName)</span>
                                                    }
                                                    @if (!string.IsNullOrEmpty(hNote))
                                                    {
                                                        <span class="bi bi-journal-text text-info ms-1" title="@hNote"></span>
                                                    }
                                                </td>
                                                <td>@group.Key.GroupCode.ToUpperInvariant()</td>
                                                <td class="text-nowrap">@group.Key.OnDutyTime</td>
                                                @foreach (var role in craftRoleColumns)
                                                                {
                                                                    @if (slotsByRole.TryGetValue(role, out var slots))
                                                                    {
                                                                        <td>
                                                                            @foreach (var slot in slots)
                                                                            {
                                                                                <div class="d-flex align-items-center gap-1">
                                                                                    @{ var hVacancy = GetSlotVacancyDisplay(slot); }
                                                                                    @if (!string.IsNullOrEmpty(hVacancy))
                                                                                    {
                                                                                        <strong class="text-primary small font-monospace" style="white-space: pre;">@hVacancy</strong>
                                                                                    }
                                                                                    else if (slot.HasIncumbentEmployeeCtrlNbr)
                                                                                    {
                                                                                        <span class="@GetSlotEmployeeCssClass(slot)">@GetSlotEmployeeDisplay(slot)</span>
                                                                                        @if (slot.Status == PositionSlotStatusEnum.PositionSlotStatusAnnulled)
                                                                                        {
                                                                                            <small class="text-primary ms-1">ANLD</small>
                                                                                        }
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <span class="badge @GetSlotStatusBadgeClass(slot)">@GetSlotDisplayStatus(slot)</span>
                                                                                    }
                                                                                    @if (!isShiftReadOnly && IsSlotActionable(slot))
                                                                                    {
                                                                                        <div class="dropdown">
                                                                                            <button class="btn btn-sm btn-outline-secondary py-0 px-1" type="button"
                                                                                                    data-bs-toggle="dropdown" aria-expanded="false" title="Position actions">
                                                                                                <span class="bi bi-three-dots-vertical"></span>
                                                                                            </button>
                                                                                            <ul class="dropdown-menu dropdown-menu-end">
                                                                                                @if (slot.Status == PositionSlotStatusEnum.PositionSlotStatusOpen
                                                                                                    || slot.Status == PositionSlotStatusEnum.PositionSlotStatusExtraBoard
                                                                                                    || slot.Status == PositionSlotStatusEnum.PositionSlotStatusNoBids)
                                                                                                {
                                                                                                    <li><button class="dropdown-item" disabled><span class="bi bi-person-plus me-2"></span>Fill Vacancy</button></li>
                                                                                                }
                                                                                                @if (slot.Status == PositionSlotStatusEnum.PositionSlotStatusFilled)
                                                                                                {
                                                                                                    <li><button class="dropdown-item" disabled><span class="bi bi-box-arrow-in-right me-2"></span>Place On Duty</button></li>
                                                                                                }
                                                                                                @if (slot.Status == PositionSlotStatusEnum.PositionSlotStatusOnDuty
                                                                                                    || slot.Status == PositionSlotStatusEnum.PositionSlotStatusOnDutyOvertime)
                                                                                                {
                                                                                                    <li><button class="dropdown-item" disabled><span class="bi bi-box-arrow-right me-2"></span>Tie Up</button></li>
                                                                                                }
                                                                                                @if (slot.Status != PositionSlotStatusEnum.PositionSlotStatusAnnulled
                                                                                                    && slot.Status != PositionSlotStatusEnum.PositionSlotStatusDoNotFill
                                                                                                    && slot.Status != PositionSlotStatusEnum.PositionSlotStatusTiedUp)
                                                                                                {
                                                                                                    <li><hr class="dropdown-divider" /></li>
                                                                                                    <li><button class="dropdown-item" @onclick="() => OpenAnnulModal(activeShift.CtrlNbr, slot.CtrlNbr, 0, slot.CraftRoleName)"><span class="bi bi-x-circle me-2"></span>Annul</button></li>
                                                                                                    <li><button class="dropdown-item" @onclick="() => OpenDoNotFillModal(activeShift.CtrlNbr, slot.CtrlNbr, slot.CraftRoleName)"><span class="bi bi-slash-circle me-2"></span>Do Not Fill</button></li>
                                                                                                }
                                                                                                @if (slot.Status == PositionSlotStatusEnum.PositionSlotStatusAnnulled
                                                                                                    || slot.Status == PositionSlotStatusEnum.PositionSlotStatusDoNotFill)
                                                                                                {
                                                                                                    <li><hr class="dropdown-divider" /></li>
                                                                                                    <li><button class="dropdown-item" @onclick="() => OpenRestoreModal(activeShift.CtrlNbr, slot.CtrlNbr, slot.CraftRoleName)"><span class="bi bi-arrow-counterclockwise me-2"></span>Restore</button></li>
                                                                                                }
                                                                                            </ul>
                                                                                        </div>
                                                                                    }
                                                                                </div>
                                                                            }
                                                                        </td>
                                                                    }
                                                                    else
                                                                    {
                                                                        <td></td>
                                                                    }
                                                                }
                                                                @if (!isShiftReadOnly)
                                                                {
                                                                    <td class="text-end">
                                                                        <div class="dropdown">
                                                                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button"
                                                                                    data-bs-toggle="dropdown" aria-expanded="false">
                                                                                <span class="bi bi-three-dots-vertical"></span>
                                                                            </button>
                                                                            <ul class="dropdown-menu dropdown-menu-end">
                                                                                <li><button class="dropdown-item" disabled="@allAnnulled" @onclick="() => OpenAnnulModal(activeShift.CtrlNbr, 0, group.Key.AssignmentCtrlNbr, group.Key.AssignmentCode.ToUpperInvariant())"><span class="bi bi-x-circle me-2"></span>Annul Assignment</button></li>
                                                                                                @if (allAnnulled)
                                                                                                {
                                                                                                        <li><button class="dropdown-item" @onclick="() => OpenRestoreAssignmentModal(activeShift.CtrlNbr, group.Key.AssignmentCtrlNbr, group.Key.AssignmentCode.ToUpperInvariant())"><span class="bi bi-arrow-counterclockwise me-2"></span>Restore Assignment</button></li>
                                                                                                    }
                                                                                                    <li><hr class="dropdown-divider" /></li>
                                                                                                    <li><button class="dropdown-item" @onclick="() => OpenNotesModal(activeShift.CtrlNbr, group.Key.AssignmentCtrlNbr, group.Key.AssignmentCode.ToUpperInvariant(), hNote)"><span class="bi bi-journal-text me-2"></span>Notes</button></li>
                                                                                                    <li><button class="dropdown-item" @onclick="() => OpenPositionsModal(activeShift.CtrlNbr, group.Key.AssignmentCtrlNbr, group.Key.AssignmentCode.ToUpperInvariant(), group)"><span class="bi bi-people me-2"></span>Positions</button></li>
                                                                                                    <li><hr class="dropdown-divider" /></li>
                                                                                                    <li><button class="dropdown-item text-danger" @onclick="() => OpenRemoveAssignmentModal(activeShift.CtrlNbr, group.Key.AssignmentCtrlNbr, group.Key.AssignmentCode.ToUpperInvariant())"><span class="bi bi-trash me-2"></span>Remove Assignment</button></li>
                                                                            </ul>
                                                                        </div>
                                                                    </td>
                                                                }
                                            </tr>
                                            @if (!string.IsNullOrEmpty(hNote))
                                            {
                                                <tr class="border-0">
                                                    <td colspan="@(3 + craftRoleColumns.Count + (isShiftReadOnly ? 0 : 1))" class="border-0 pt-0 pb-1 text-info fst-italic small ps-4">
                                                        <span class="bi bi-journal-text me-1"></span>@hNote
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            @foreach (var assignmentGroup in activeShift.PositionSlots
                                .GroupBy(p => new { p.AssignmentCtrlNbr, p.AssignmentCode, p.AssignmentName, p.OnDutyTime, p.OffDutyTime, p.GroupCode, p.GroupName })
                                .OrderBy(g => g.Key.AssignmentCode))
                            {
                                var vAllAnnulled = IsAssignmentFullyAnnulled(assignmentGroup);
                                var vNote = GetAssignmentNote(activeShift, assignmentGroup.Key.AssignmentCtrlNbr);
                                <div class="ms-3 mb-2 mt-2 @(vAllAnnulled ? "text-muted" : "")" style="font-size: 0.85rem;">
                                    <div class="d-flex align-items-center @(vAllAnnulled ? "text-decoration-line-through" : "")">
                                        <div class="d-flex align-items-center" style="min-width: 280px;">
                                            <strong>@assignmentGroup.Key.AssignmentName</strong>
                                            @{ var vReliefName = assignmentGroup.FirstOrDefault(s => s.CrewType == "RELIEF")?.CrewName; }
                                            @if (!string.IsNullOrEmpty(vReliefName))
                                            {
                                                <span class="small ms-1">(@vReliefName)</span>
                                            }
                                            @if (!string.IsNullOrEmpty(vNote))
                                            {
                                                <span class="bi bi-journal-text text-info ms-1" title="@vNote"></span>
                                            }
                                        </div>
                                        <span class="text-muted" style="min-width: 160px;">@assignmentGroup.Key.GroupName</span>
                                        <span class="text-muted small">@assignmentGroup.Key.OnDutyTime</span>
                                        @if (!isShiftReadOnly)
                                        {
                                            <div class="dropdown ms-auto">
                                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle py-0" type="button"
                                                        data-bs-toggle="dropdown" aria-expanded="false">
                                                    <span class="bi bi-three-dots-vertical"></span>
                                                </button>
                                                <ul class="dropdown-menu">
                                                    <li><button class="dropdown-item" disabled="@vAllAnnulled" @onclick="() => OpenAnnulModal(activeShift.CtrlNbr, 0, assignmentGroup.Key.AssignmentCtrlNbr, assignmentGroup.Key.AssignmentCode.ToUpperInvariant())"><span class="bi bi-x-circle me-2"></span>Annul Assignment</button></li>
                                                    @if (vAllAnnulled)
                                                    {
                                                        <li><button class="dropdown-item" @onclick="() => OpenRestoreAssignmentModal(activeShift.CtrlNbr, assignmentGroup.Key.AssignmentCtrlNbr, assignmentGroup.Key.AssignmentCode.ToUpperInvariant())"><span class="bi bi-arrow-counterclockwise me-2"></span>Restore Assignment</button></li>
                                                    }
                                                    <li><hr class="dropdown-divider" /></li>
                                                    <li><button class="dropdown-item" @onclick="() => OpenNotesModal(activeShift.CtrlNbr, assignmentGroup.Key.AssignmentCtrlNbr, assignmentGroup.Key.AssignmentCode.ToUpperInvariant(), vNote)"><span class="bi bi-journal-text me-2"></span>Notes</button></li>
                                                    <li><button class="dropdown-item" @onclick="() => OpenPositionsModal(activeShift.CtrlNbr, assignmentGroup.Key.AssignmentCtrlNbr, assignmentGroup.Key.AssignmentCode.ToUpperInvariant(), assignmentGroup)"><span class="bi bi-people me-2"></span>Positions</button></li>
                                                    <li><hr class="dropdown-divider" /></li>
                                                    <li><button class="dropdown-item text-danger" @onclick="() => OpenRemoveAssignmentModal(activeShift.CtrlNbr, assignmentGroup.Key.AssignmentCtrlNbr, assignmentGroup.Key.AssignmentCode.ToUpperInvariant())"><span class="bi bi-trash me-2"></span>Remove Assignment</button></li>
                                                </ul>
                                            </div>
                                        }
                                    </div>
                                    @if (!string.IsNullOrEmpty(vNote))
                                    {
                                        <table class="table table-sm table-borderless mb-0 mt-1">
                                            <tr>
                                                <td class="text-info fst-italic small pt-0 pb-1 ps-2">
                                                    <span class="bi bi-journal-text me-1"></span>@vNote
                                                </td>
                                            </tr>
                                        </table>
                                    }
                                    <table class="table table-sm table-hover mb-0 mt-1">
                                        <thead>
                                            <tr>
                                                <th style="width: 60px;">#</th>
                                                <th>Craft/Role</th>
                                                <th>Status</th>
                                                <th>Employee</th>
                                                @if (!isShiftReadOnly)
                                                {
                                                    <th style="width: 80px;" class="text-end">Actions</th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var slot in assignmentGroup.OrderBy(s => s.DisplayOrder))
                                            {
                                                <tr>
                                                    <td>@slot.DisplayOrder</td>
                                                    <td>@slot.CraftRoleName</td>
                                                    <td>
                                                        <span class="badge @GetSlotStatusBadgeClass(slot)">
                                                            @GetSlotDisplayStatus(slot)
                                                        </span>
                                                    </td>
                                                    <td>
                                                        @{ var vacancyText = GetSlotVacancyDisplay(slot); }
                                                        @if (!string.IsNullOrEmpty(vacancyText))
                                                        {
                                                            <strong class="text-primary small font-monospace" style="white-space: pre;">@vacancyText</strong>
                                                        }
                                                        else if (slot.HasIncumbentEmployeeCtrlNbr)
                                                        {
                                                            <span class="@GetSlotEmployeeCssClass(slot)">@GetSlotEmployeeDisplay(slot)</span>
                                                            @if (slot.Status == PositionSlotStatusEnum.PositionSlotStatusAnnulled)
                                                            {
                                                                <small class="text-primary ms-1">ANLD</small>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <em class="text-muted">—</em>
                                                        }
                                                    </td>
                                                    @if (!isShiftReadOnly)
                                                    {
                                                        <td class="text-end">
                                                            @if (IsSlotActionable(slot))
                                                            {
                                                                <div class="dropdown">
                                                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button"
                                                                            data-bs-toggle="dropdown" aria-expanded="false">
                                                                        <span class="bi bi-three-dots-vertical"></span>
                                                                    </button>
                                                                    <ul class="dropdown-menu dropdown-menu-end">
                                                                        @if (slot.Status == PositionSlotStatusEnum.PositionSlotStatusOpen
                                                                            || slot.Status == PositionSlotStatusEnum.PositionSlotStatusExtraBoard
                                                                            || slot.Status == PositionSlotStatusEnum.PositionSlotStatusNoBids)
                                                                        {
                                                                            <li><button class="dropdown-item" disabled><span class="bi bi-person-plus me-2"></span>Fill Vacancy</button></li>
                                                                        }
                                                                        @if (slot.Status == PositionSlotStatusEnum.PositionSlotStatusFilled)
                                                                        {
                                                                            <li><button class="dropdown-item" disabled><span class="bi bi-box-arrow-in-right me-2"></span>Place On Duty</button></li>
                                                                        }
                                                                        @if (slot.Status == PositionSlotStatusEnum.PositionSlotStatusOnDuty
                                                                            || slot.Status == PositionSlotStatusEnum.PositionSlotStatusOnDutyOvertime)
                                                                        {
                                                                            <li><button class="dropdown-item" disabled><span class="bi bi-box-arrow-right me-2"></span>Tie Up</button></li>
                                                                        }
                                                                        @if (slot.Status != PositionSlotStatusEnum.PositionSlotStatusAnnulled
                                                                            && slot.Status != PositionSlotStatusEnum.PositionSlotStatusDoNotFill
                                                                            && slot.Status != PositionSlotStatusEnum.PositionSlotStatusTiedUp)
                                                                        {
                                                                            <li><hr class="dropdown-divider" /></li>
                                                                            <li><button class="dropdown-item" @onclick="() => OpenAnnulModal(activeShift.CtrlNbr, slot.CtrlNbr, 0, slot.CraftRoleName)"><span class="bi bi-x-circle me-2"></span>Annul</button></li>
                                                                            <li><button class="dropdown-item" @onclick="() => OpenDoNotFillModal(activeShift.CtrlNbr, slot.CtrlNbr, slot.CraftRoleName)"><span class="bi bi-slash-circle me-2"></span>Do Not Fill</button></li>
                                                                        }
                                                                        @if (slot.Status == PositionSlotStatusEnum.PositionSlotStatusAnnulled
                                                                            || slot.Status == PositionSlotStatusEnum.PositionSlotStatusDoNotFill)
                                                                        {
                                                                            <li><hr class="dropdown-divider" /></li>
                                                                            <li><button class="dropdown-item" @onclick="() => OpenRestoreModal(activeShift.CtrlNbr, slot.CtrlNbr, slot.CraftRoleName)"><span class="bi bi-arrow-counterclockwise me-2"></span>Restore</button></li>
                                                                        }
                                                                    </ul>
                                                                </div>
                                                            }
                                                        </td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        }
    }

    @* ── Generate Shift Modal ── *@
    <Modal Visible="showGenerateModal"
           Title="Generate Shift Call Sheet"
           Icon="bi bi-clipboard-plus"
           OnClose="CloseGenerateModal">
        <BodyContent>
            <EditForm Model="generateModel" OnValidSubmit="OnGenerate" id="generate-shift-form">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Shift Definition</label>
                    <SelectInput TItem="ShiftDefinitionResponse" TValue="long"
                                 @bind-Value="generateModel.ShiftDefinitionCtrlNbr"
                                 Items="availableShifts"
                                 ValueSelector="@(s => s.CtrlNbr)"
                                 TextSelector="@(s => $"{s.ShiftCode.ToUpperInvariant()} — {s.DisplayName}")"
                                 Placeholder="-- Select Shift --"
                                 class="form-select" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Department</label>
                    <SelectInput TItem="DepartmentResponse" TValue="long"
                                 @bind-Value="generateModel.DepartmentCtrlNbr"
                                 Items="departments"
                                 ValueSelector="@(d => d.CtrlNbr)"
                                 TextSelector="@(d => d.Name)"
                                 Placeholder="-- None --"
                                 class="form-select" />
                </div>
                <p class="text-muted">
                    This will generate the call sheet for the selected shift on <strong>@selectedDate.ToString("yyyy-MM-dd")</strong>,
                    creating all scheduled positions as open vacancies.
                </p>
            </EditForm>
        </BodyContent>
        <Footer>
            <button type="button" class="btn btn-secondary" @onclick="CloseGenerateModal">Cancel</button>
            <button type="submit" form="generate-shift-form" class="btn btn-success"
                    disabled="@(generateModel.ShiftDefinitionCtrlNbr == 0 || isGenerating)">
                @if (isGenerating)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                Generate
            </button>
        </Footer>
    </Modal>

    @* ── Close Shift Confirmation Modal ── *@
    <ConfirmModal Visible="showCloseModal" ItemName="@closeShiftName" IsSaving="isSaving"
                        ActionVerb="Close" ButtonIcon="bi bi-x-circle" ButtonClass="btn-warning"
                        OnConfirm="ConfirmClose" OnCancel="() => showCloseModal = false" />

    @* ── Annul Modal (shared for position and assignment) ── *@
    <Modal Visible="showAnnulModal"
           Title="@annulModalTitle"
           Icon="bi bi-x-circle"
           OnClose="CloseAnnulModal">
        <BodyContent>
            <EditForm Model="annulModel" OnValidSubmit="ConfirmAnnul" id="annul-form">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Annulment Date/Time</label>
                    <input type="datetime-local" class="form-control"
                           value="@annulModel.AnnulmentDateTime.ToString("yyyy-MM-ddTHH:mm")"
                           @onchange="e => annulModel.AnnulmentDateTime = DateTime.Parse(e.Value!.ToString()!)" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Reason</label>
                    <InputTextArea @bind-Value="annulModel.Reason" class="form-control" rows="3" placeholder="Enter annulment reason..." />
                </div>
            </EditForm>
        </BodyContent>
        <Footer>
            <button type="button" class="btn btn-secondary" @onclick="CloseAnnulModal">Cancel</button>
            <button type="submit" form="annul-form" class="btn btn-danger"
                    disabled="@(string.IsNullOrWhiteSpace(annulModel.Reason) || isAnnulling)">
                @if (isAnnulling)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                <span class="bi bi-x-circle me-1"></span> Annul
            </button>
        </Footer>
    </Modal>

    @* ── Do Not Fill Confirmation Modal ── *@
    <ConfirmModal Visible="showDoNotFillModal" ItemName="@doNotFillItemName" IsSaving="isDoNotFilling"
                        ActionVerb="Do Not Fill" ButtonIcon="bi bi-slash-circle" ButtonClass="btn-warning"
                        OnConfirm="ConfirmDoNotFill" OnCancel="() => showDoNotFillModal = false" />

    @* ── Restore Position Confirmation Modal ── *@
    <ConfirmModal Visible="showRestoreModal" ItemName="@restoreItemName" IsSaving="isRestoring"
                        ActionVerb="Restore" ButtonIcon="bi bi-arrow-counterclockwise" ButtonClass="btn-success"
                        OnConfirm="ConfirmRestore" OnCancel="() => showRestoreModal = false" />

    @* ── Restore Assignment Confirmation Modal ── *@
    <ConfirmModal Visible="showRestoreAssignmentModal" ItemName="@restoreAssignmentItemName" IsSaving="isRestoringAssignment"
                        ActionVerb="Restore Assignment" ButtonIcon="bi bi-arrow-counterclockwise" ButtonClass="btn-success"
                        OnConfirm="ConfirmRestoreAssignment" OnCancel="() => showRestoreAssignmentModal = false" />

    @* ── Remove Assignment Confirmation Modal ── *@
    <ConfirmModal Visible="showRemoveAssignmentModal" ItemName="@removeAssignmentItemName" IsSaving="isRemovingAssignment"
                        ActionVerb="Remove" ButtonIcon="bi bi-trash" ButtonClass="btn-danger"
                        OnConfirm="ConfirmRemoveAssignment" OnCancel="() => showRemoveAssignmentModal = false" />

    @* ── Assignment Notes Modal ── *@
    <Modal Visible="showNotesModal"
           Title="@notesModalTitle"
           Icon="bi bi-journal-text"
           OnClose="() => showNotesModal = false">
        <BodyContent>
            <EditForm Model="notesModel" OnValidSubmit="SaveNotes" id="notes-form">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Notes</label>
                    <InputTextArea @bind-Value="notesModel.NoteText" class="form-control" rows="6" />
                </div>
            </EditForm>
        </BodyContent>
        <Footer>
            <button type="button" class="btn btn-secondary" @onclick="() => showNotesModal = false">Cancel</button>
            <button type="submit" form="notes-form" class="btn btn-primary"
                    disabled="@isSavingNotes">
                @if (isSavingNotes)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                <span class="bi bi-floppy me-1"></span> Save
            </button>
        </Footer>
    </Modal>

    @* ── Manage Positions Modal ── *@
    <Modal Visible="showPositionsModal"
           Title="@positionsModalTitle"
           Icon="bi bi-people"
           Size="lg"
           OnClose="() => showPositionsModal = false">
        <BodyContent>
            @if (!IsFeatureReadOnly)
            {
                <div class="d-flex align-items-end gap-2 mb-3">
                    <div class="flex-grow-1">
                        <label class="form-label fw-semibold">Add Position</label>
                        <select class="form-select form-select-sm" @bind="positionsSelectedCraftRole">
                            <option value="">-- Select Craft/Role --</option>
                            @if (positionsCraftRoles is not null)
                            {
                                @foreach (var role in positionsCraftRoles.OrderBy(r => r.Name))
                                {
                                    <option value="@role.Name">@role.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <button type="button" class="btn btn-sm btn-success"
                            disabled="@string.IsNullOrEmpty(positionsSelectedCraftRole)"
                            @onclick="AddPosition">
                        <span class="bi bi-plus-circle me-1"></span> Add
                    </button>
                </div>
            }

            @{ var craftGroups = positionsEditList
                   .GroupBy(p => p.CraftRoleName)
                   .OrderBy(g => g.Key)
                   .ToList(); }

            @if (craftGroups.Count == 0)
            {
                <p class="text-muted"><em>No positions on this assignment.</em></p>
            }
            else
            {
                @foreach (var craftGroup in craftGroups)
                {
                    <h6 class="mt-2 mb-1">@craftGroup.Key</h6>
                    <table class="table table-sm table-hover mb-2">
                        <thead>
                            <tr>
                                <th style="width: 50px;">#</th>
                                <th>Status</th>
                                <th>Type</th>
                                @if (!IsFeatureReadOnly)
                                {
                                    <th style="width: 120px;" class="text-end">Actions</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in craftGroup.Where(p => !p.IsRemoved).OrderBy(p => p.DisplayOrder))
                            {
                                <tr class="@(item.IsNew ? "table-success" : "")">
                                    <td>@item.DisplayOrder</td>
                                    <td>
                                        <span class="badge @(item.IsNew ? "bg-success" : "bg-secondary")">
                                            @(item.IsNew ? "New" : item.Status)
                                        </span>
                                    </td>
                                    <td>
                                        @if (item.IsAdHoc || item.IsNew)
                                        {
                                            <span class="badge bg-info">Ad-Hoc</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Template</span>
                                        }
                                    </td>
                                    @if (!IsFeatureReadOnly)
                                    {
                                        <td class="text-end">
                                            <div class="btn-group btn-group-sm">
                                                <button type="button" class="btn btn-outline-secondary py-0"
                                                        disabled="@(!CanMoveUp(item))"
                                                        @onclick="() => MovePositionUp(item)" title="Move up">
                                                    <span class="bi bi-arrow-up"></span>
                                                </button>
                                                <button type="button" class="btn btn-outline-secondary py-0"
                                                        disabled="@(!CanMoveDown(item))"
                                                        @onclick="() => MovePositionDown(item)" title="Move down">
                                                    <span class="bi bi-arrow-down"></span>
                                                </button>
                                                @if (item.CanRemove)
                                                {
                                                    <button type="button" class="btn btn-outline-danger py-0"
                                                            @onclick="() => RemovePosition(item)" title="Remove">
                                                        <span class="bi bi-trash"></span>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                            @foreach (var item in craftGroup.Where(p => p.IsRemoved))
                            {
                                <tr class="table-danger text-decoration-line-through">
                                    <td>@item.DisplayOrder</td>
                                    <td><span class="badge bg-danger">Removed</span></td>
                                    <td><span class="badge bg-info">Ad-Hoc</span></td>
                                    @if (!IsFeatureReadOnly)
                                    {
                                        <td class="text-end">
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0"
                                                    @onclick="() => UndoRemovePosition(item)" title="Undo remove">
                                                <span class="bi bi-arrow-counterclockwise"></span>
                                            </button>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            }
        </BodyContent>
        <Footer>
            <button type="button" class="btn btn-secondary" @onclick="() => showPositionsModal = false">Cancel</button>
            <button type="button" class="btn btn-primary"
                    disabled="@(!HasPositionChanges || isSavingPositions)"
                    @onclick="SavePositions">
                @if (isSavingPositions)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                <span class="bi bi-floppy me-1"></span> Save Changes
            </button>
        </Footer>
    </Modal>

    @* ── Add Assignment Modal (unified) ── *@
    <Modal Visible="showAddAssignmentModal"
           Title="Add Assignment"
           Icon="bi bi-plus-circle"
           OnClose="() => showAddAssignmentModal = false">
        <BodyContent>
            @if (isLoadingTemplates)
            {
                <div class="text-center py-3">
                    <span class="spinner-border spinner-border-sm me-1"></span> Loading templates…
                </div>
            }
            else
            {
                <div class="mb-3">
                    <label class="form-label fw-semibold">Seed from Template</label>
                    <FilterSelect TItem="AvailableAssignmentResponse" TValue="long"
                                  Value="addAssignmentSelectedTemplate"
                                  ValueChanged="SeedFromTemplate"
                                  Items="availableExtraAssignments"
                                  ValueSelector="@(a => a.AssignmentCtrlNbr)"
                                  TextSelector="@(a => $"{a.AssignmentCode.ToUpperInvariant()} — {a.AssignmentName} ({a.PositionCount} pos)")"
                                  Placeholder="-- None (Ad-Hoc) --"
                                  AlwaysShowPlaceholder="true"
                                  class="form-select" />
                </div>

                <hr />

                <EditForm Model="addAssignmentModel" OnValidSubmit="ConfirmAddAssignment" id="add-assignment-form">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Code</label>
                        <InputText @bind-Value="addAssignmentModel.Code" class="form-control" />
                        <ValidationMessage For="() => addAssignmentModel.Code" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Name</label>
                        <InputText @bind-Value="addAssignmentModel.Name" class="form-control" />
                        <ValidationMessage For="() => addAssignmentModel.Name" />
                    </div>
                    <DutyTimePicker @bind-OnDutyTime="addAssignmentModel.OnDutyTime" @bind-OffDutyTime="addAssignmentModel.OffDutyTime" CssClass="mb-3" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Group</label>
                        <SelectInput TItem="GroupResponse" TValue="long"
                                     @bind-Value="addAssignmentModel.GroupCtrlNbr"
                                     Items="allGroups"
                                     ValueSelector="@(g => g.CtrlNbr)"
                                     TextSelector="@(g => g.Name)"
                                     Placeholder="-- Select Group --"
                                     class="form-select" />
                    </div>

                    @if (addAssignmentSelectedTemplate == 0)
                    {
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Craft/Roles</label>
                            <div class="d-flex align-items-end gap-2 mb-2">
                                <div class="flex-grow-1">
                                    <FilterSelect TItem="CraftRoleResponse" TValue="string"
                                                  @bind-Value="addAssignmentSelectedCraftRole"
                                                  Items="craftRoles"
                                                  ValueSelector="@(r => r.Name)"
                                                  TextSelector="@(r => r.Name)"
                                                  Placeholder="-- Select Craft/Role --"
                                                  class="form-select form-select-sm" />
                                </div>
                                <button type="button" class="btn btn-sm btn-success"
                                        disabled="@string.IsNullOrEmpty(addAssignmentSelectedCraftRole)"
                                        @onclick="AddAssignmentCraftRole">
                                    <span class="bi bi-plus-circle me-1"></span> Add
                                </button>
                            </div>
                            @if (addAssignmentModel.CraftRoleNames.Count > 0)
                            {
                                <ul class="list-group list-group-flush">
                                    @for (var i = 0; i < addAssignmentModel.CraftRoleNames.Count; i++)
                                    {
                                        var idx = i;
                                        <li class="list-group-item d-flex justify-content-between align-items-center py-1">
                                            @addAssignmentModel.CraftRoleNames[idx]
                                            <button type="button" class="btn btn-sm btn-outline-danger py-0"
                                                    @onclick="() => addAssignmentModel.CraftRoleNames.RemoveAt(idx)">
                                                <span class="bi bi-trash"></span>
                                            </button>
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <small class="text-muted">Add at least one craft/role.</small>
                            }
                        </div>
                    }
                    else
                    {
                        var selectedTpl = availableExtraAssignments?.FirstOrDefault(a => a.AssignmentCtrlNbr == addAssignmentSelectedTemplate);
                        if (selectedTpl is not null)
                        {
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Positions</label>
                                <div class="border rounded p-2 bg-body-secondary">
                                    <span class="bi bi-people me-1"></span> @selectedTpl.PositionCount position(s) from template
                                </div>
                            </div>
                        }
                    }
                </EditForm>
            }
        </BodyContent>
        <Footer>
            <button type="button" class="btn btn-secondary" @onclick="() => showAddAssignmentModal = false">Cancel</button>
            <button type="submit" form="add-assignment-form" class="btn btn-primary"
                    disabled="@(!CanSubmitAddAssignment || isAddingAssignment)">
                @if (isAddingAssignment)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                <span class="bi bi-plus-circle me-1"></span> Add Assignment
            </button>
        </Footer>
    </Modal>
}

@code {
    protected override string? FeatureKey => "daily-operations/call-sheet";

    private IReadOnlyList<GroupResponse>? workAreas;
    private IReadOnlyList<GroupResponse>? allGroups;
    private IReadOnlyList<DailyShiftInstanceResponse>? shifts;
    private IReadOnlyList<ShiftDefinitionResponse>? availableShifts;
    private IReadOnlyList<DepartmentResponse>? departments;
    private IReadOnlyList<CraftRoleResponse>? craftRoles;
    private long selectedWorkAreaCtrlNbr;
    private DateOnly selectedDate = DateOnly.FromDateTime(DateTime.Today);
    private bool callSheetLoaded;
    private long selectedDepartmentCtrlNbr;
    private long activeShiftCtrlNbr;
    private bool useHorizontalLayout;
    private bool showClosedShifts;

    private bool showGenerateModal;
    private bool isGenerating;
    private GenerateShiftModel generateModel = new();

    private bool showCloseModal;
    private long closeShiftCtrlNbr;
    private string closeShiftName = "";
    private bool isReopening;

    // Annul modal state
    private bool showAnnulModal;
    private bool isAnnulling;
    private string annulModalTitle = "";
    private AnnulModel annulModel = new();

    // Do Not Fill modal state
    private bool showDoNotFillModal;
    private bool isDoNotFilling;
    private long doNotFillShiftCtrlNbr;
    private long doNotFillSlotCtrlNbr;
    private string doNotFillItemName = "";

    // Restore modal state
    private bool showRestoreModal;
    private bool isRestoring;
    private long restoreShiftCtrlNbr;
    private long restoreSlotCtrlNbr;
    private string restoreItemName = "";

    // Restore Assignment modal state
    private bool showRestoreAssignmentModal;
    private bool isRestoringAssignment;
    private long restoreAssignmentShiftCtrlNbr;
    private long restoreAssignmentCtrlNbr;
    private string restoreAssignmentItemName = "";

    // Remove Assignment modal state
    private bool showRemoveAssignmentModal;
    private bool isRemovingAssignment;
    private long removeAssignmentShiftCtrlNbr;
    private long removeAssignmentCtrlNbr;
    private string removeAssignmentItemName = "";

    // Notes modal state
    private bool showNotesModal;
    private bool isSavingNotes;
    private long notesShiftCtrlNbr;
    private long notesAssignmentCtrlNbr;
    private string notesModalTitle = "";
    private NotesModel notesModel = new();

    // Positions modal state
    private bool showPositionsModal;
    private bool isSavingPositions;
    private long positionsShiftCtrlNbr;
    private long positionsAssignmentCtrlNbr;
    private string positionsModalTitle = "";
    private string positionsSelectedCraftRole = "";
    private List<PositionEditItem> positionsEditList = [];
    private IReadOnlyList<CraftRoleResponse>? positionsCraftRoles;

    // Add Assignment modal state (unified)
    private bool showAddAssignmentModal;
    private bool isLoadingTemplates;
    private bool isAddingAssignment;
    private long addAssignmentShiftCtrlNbr;
    private long addAssignmentSelectedTemplate;
    private string addAssignmentSelectedCraftRole = "";
    private IReadOnlyList<AvailableAssignmentResponse>? availableExtraAssignments;
    private AddAssignmentModel addAssignmentModel = new();

    protected override async Task LoadDataAsync()
    {
        if (HasRailroad)
            await LoadReferenceData();
    }

    protected override async Task OnAppContextChangedAsync()
    {
        selectedWorkAreaCtrlNbr = 0;
        selectedDepartmentCtrlNbr = 0;
        activeShiftCtrlNbr = 0;
        shifts = null;
        callSheetLoaded = false;
        availableShifts = null;
        showClosedShifts = false;

        if (HasRailroad)
            await LoadReferenceData();
        else
        {
            workAreas = null;
            allGroups = null;
            departments = null;
            craftRoles = null;
        }
    }

    private async Task LoadReferenceData()
    {
        ReferenceData.Invalidate();
        workAreas = await ReferenceData.GetWorkAreasAsync();
        allGroups = await ReferenceData.GetGroupsAsync();
        departments = await ReferenceData.GetDepartmentsAsync();
        craftRoles = await ReferenceData.GetCraftRolesAsync();

        if (workAreas?.Count == 1)
        {
            selectedWorkAreaCtrlNbr = workAreas[0].CtrlNbr;
            await LoadCallSheet();
        }
    }

    private async Task OnWorkAreaSelected()
    {
        shifts = null;
        callSheetLoaded = false;
        availableShifts = null;
        activeShiftCtrlNbr = 0;

        if (selectedWorkAreaCtrlNbr > 0)
            await LoadCallSheet();
    }

    private async Task OnDateChanged(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var date))
        {
            selectedDate = date;
            shifts = null;
            callSheetLoaded = false;
            activeShiftCtrlNbr = 0;

            if (selectedWorkAreaCtrlNbr > 0)
                await LoadCallSheet();
        }
    }

    private Task SetDate(int offsetFromToday)
    {
        var e = new ChangeEventArgs { Value = DateOnly.FromDateTime(DateTime.Today.AddDays(offsetFromToday)).ToString("yyyy-MM-dd") };
        return OnDateChanged(e);
    }

    private async Task LoadCallSheet()
    {
        if (selectedWorkAreaCtrlNbr == 0) return;

        errorMessage = null;
        successMessage = null;

        try
        {
            var response = await DailyOperationsClient.GetCallSheetAsync(
                selectedWorkAreaCtrlNbr, selectedDate.ToString("yyyy-MM-dd"), showClosedShifts);
            shifts = response.Shifts;
            callSheetLoaded = true;
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load call sheet: {ex.Message}";
            shifts = null;
            callSheetLoaded = true;
        }
    }

    private async Task RefreshShift(long shiftCtrlNbr)
    {
        errorMessage = null;
        successMessage = null;

        try
        {
            await DailyOperationsClient.RefreshShiftInstanceAsync(shiftCtrlNbr);
            await LoadCallSheet();
            successMessage = "Call sheet rebuilt successfully.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to rebuild call sheet: {ex.Message}";
        }
    }

    private async Task OpenGenerateModal()
    {
        errorMessage = null;
        successMessage = null;
        generateModel = new() { DepartmentCtrlNbr = selectedDepartmentCtrlNbr };
        try
        {
            var response = await WorkManagementClient.GetShiftDefinitionsAsync(selectedWorkAreaCtrlNbr);
            availableShifts = response.ShiftDefinitions.Where(s => s.IsActive).ToList();
        }
        catch
        {
            availableShifts = [];
        }

        showGenerateModal = true;
    }

    private void OnDepartmentSelected()
    {
        activeShiftCtrlNbr = 0;
        var dept = departments?.FirstOrDefault(d => d.CtrlNbr == selectedDepartmentCtrlNbr);
        useHorizontalLayout = dept?.DefaultCallSheetView.Equals("Horizontal", StringComparison.OrdinalIgnoreCase) == true;
    }

    private async Task OnShowClosedChanged(ChangeEventArgs e)
    {
        showClosedShifts = e.Value is true;
        if (selectedWorkAreaCtrlNbr > 0)
            await LoadCallSheet();
    }

    private void CloseGenerateModal() => showGenerateModal = false;

    private async Task OnGenerate()
    {
        if (generateModel.ShiftDefinitionCtrlNbr == 0) return;

        isGenerating = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            await DailyOperationsClient.GenerateCallSheetAsync(
                selectedWorkAreaCtrlNbr,
                generateModel.ShiftDefinitionCtrlNbr,
                selectedDate.ToString("yyyy-MM-dd"),
                generateModel.DepartmentCtrlNbr);
            showGenerateModal = false;
            successMessage = "Shift call sheet generated successfully.";
            await LoadCallSheet();
        }
        catch (Exception ex)
        {
            errorMessage = $"Generation failed: {ex.Message}";
        }
        finally
        {
            isGenerating = false;
        }
    }

    private void OpenCloseModal(DailyShiftInstanceResponse shift)
    {
        closeShiftCtrlNbr = shift.CtrlNbr;
        closeShiftName = $"{shift.ShiftCode.ToUpperInvariant()} — {shift.ShiftDisplayName}";
        showCloseModal = true;
    }

    private async Task ConfirmClose()
    {
        isSaving = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            await DailyOperationsClient.CloseShiftInstanceAsync(closeShiftCtrlNbr);
            showCloseModal = false;
            successMessage = $"Shift '{closeShiftName}' has been closed.";
            await LoadCallSheet();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to close shift: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ReopenShift(long shiftCtrlNbr)
    {
        isReopening = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            await DailyOperationsClient.ReopenShiftInstanceAsync(shiftCtrlNbr);
            successMessage = "Shift has been re-opened.";
            await LoadCallSheet();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to re-open shift: {ex.Message}";
        }
        finally
        {
            isReopening = false;
        }
    }

    private static string GetStatusBadgeClass(string status) => status switch
    {
        "Active" => "bg-success",
        "Completed" => "bg-secondary",
        "Cancelled" => "bg-danger",
        _ => "bg-info"
    };

    private static string GetSlotStatusBadgeClass(DailyPositionSlotResponse slot) => slot.Status switch
    {
        PositionSlotStatusEnum.PositionSlotStatusAnnulled => "bg-danger",
        PositionSlotStatusEnum.PositionSlotStatusDoNotFill => "bg-warning text-dark",
        PositionSlotStatusEnum.PositionSlotStatusSkipped => "bg-secondary",
