    private async Task OpenAddAssignmentModal(long shiftCtrlNbr)
    {
        addAssignmentShiftCtrlNbr = shiftCtrlNbr;
        addAssignmentSelectedTemplate = 0;
        addAssignmentSelectedCraftRole = "";
        addAssignmentModel = new();
        availableExtraAssignments = null;
        isLoadingTemplates = true;
        showAddAssignmentModal = true;

        try
        {
            var response = await DailyOperationsClient.GetAvailableExtraAssignmentsAsync(shiftCtrlNbr);
            availableExtraAssignments = response.Assignments.ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load available templates: {ex.Message}";
            showAddAssignmentModal = false;
        }
        finally
        {
            isLoadingTemplates = false;
        }
    }

    private void SeedFromTemplate(long templateCtrlNbr)
    {
        addAssignmentSelectedTemplate = templateCtrlNbr;
        if (templateCtrlNbr == 0) return;

        var tpl = availableExtraAssignments?.FirstOrDefault(a => a.AssignmentCtrlNbr == templateCtrlNbr);
        if (tpl is null) return;

        addAssignmentModel.Code = tpl.AssignmentCode;
        addAssignmentModel.Name = tpl.AssignmentName;
        addAssignmentModel.OnDutyTime = TimeOnly.TryParse(tpl.OnDutyTime, out var on) ? on : default;
        addAssignmentModel.OffDutyTime = TimeOnly.TryParse(tpl.OffDutyTime, out var off) ? off : default;

        var matchingGroup = allGroups?.FirstOrDefault(g =>
            string.Equals(g.Name, tpl.GroupName, StringComparison.OrdinalIgnoreCase));
        addAssignmentModel.GroupCtrlNbr = matchingGroup?.CtrlNbr ?? 0;

        addAssignmentModel.CraftRoleNames.Clear();
    }

    private bool CanSubmitAddAssignment =>
        addAssignmentSelectedTemplate > 0 || addAssignmentModel.CraftRoleNames.Count > 0;

    private void AddAssignmentCraftRole()
    {
        if (string.IsNullOrEmpty(addAssignmentSelectedCraftRole)) return;
        addAssignmentModel.CraftRoleNames.Add(addAssignmentSelectedCraftRole);
        addAssignmentSelectedCraftRole = "";
    }

    private async Task ConfirmAddAssignment()
    {
        if (!CanSubmitAddAssignment) return;

        isAddingAssignment = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            if (addAssignmentSelectedTemplate > 0)
            {
                await DailyOperationsClient.AddAssignmentFromTemplateAsync(
                    addAssignmentShiftCtrlNbr, addAssignmentSelectedTemplate,
                    addAssignmentModel.OnDutyTime.ToString("HH:mm"),
                    addAssignmentModel.OffDutyTime.ToString("HH:mm"));
            }
            else
            {
                var selectedGroup = allGroups?.FirstOrDefault(g => g.CtrlNbr == addAssignmentModel.GroupCtrlNbr);
                await DailyOperationsClient.AddAdHocAssignmentAsync(
                    addAssignmentShiftCtrlNbr,
                    addAssignmentModel.Code ?? "",
                    addAssignmentModel.Name ?? "",
                    selectedGroup?.Name ?? "",
                    selectedGroup?.Code ?? "",
                    addAssignmentModel.OnDutyTime.ToString("HH:mm"),
                    addAssignmentModel.OffDutyTime.ToString("HH:mm"),
                    addAssignmentModel.CraftRoleNames);
            }

            showAddAssignmentModal = false;
            successMessage = addAssignmentSelectedTemplate > 0
                ? "Assignment added from template successfully."
                : "Ad-hoc assignment added successfully.";
            await LoadCallSheet();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to add assignment: {ex.Message}";
        }
        finally
        {
            isAddingAssignment = false;
        }
    }

