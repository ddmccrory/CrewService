    private async Task OpenPositionsModal(long shiftCtrlNbr, long assignmentCtrlNbr, string assignmentCode,
        IEnumerable<DailyPositionSlotResponse> currentSlots)
    {
        positionsShiftCtrlNbr = shiftCtrlNbr;
        positionsAssignmentCtrlNbr = assignmentCtrlNbr;
        positionsModalTitle = $"Manage Positions — {assignmentCode}";
        positionsSelectedCraftRole = "";

        positionsEditList = currentSlots
            .OrderBy(s => s.CraftRoleName)
            .ThenBy(s => s.DisplayOrder)
            .Select(s => new PositionEditItem
            {
                CtrlNbr = s.CtrlNbr,
                CraftRoleName = s.CraftRoleName,
                DisplayOrder = s.DisplayOrder,
                Status = GetSlotDisplayStatus(s),
                IsAdHoc = s.IsAdHoc,
                IsOpen = s.Status == PositionSlotStatusEnum.PositionSlotStatusOpen,
                IsNew = false,
                IsRemoved = false
            })
            .ToList();

        positionsCraftRoles = craftRoles;

        showPositionsModal = true;
    }

    private void AddPosition()
    {
        if (string.IsNullOrEmpty(positionsSelectedCraftRole)) return;

        var maxOrder = positionsEditList
            .Where(p => p.CraftRoleName == positionsSelectedCraftRole && !p.IsRemoved)
            .Select(p => p.DisplayOrder)
            .DefaultIfEmpty(0)
            .Max();

        positionsEditList.Add(new PositionEditItem
        {
            CtrlNbr = 0,
            CraftRoleName = positionsSelectedCraftRole,
            DisplayOrder = maxOrder + 1,
            Status = "Vacancy",
            IsAdHoc = true,
            IsOpen = true,
            IsNew = true,
            IsRemoved = false
        });

        positionsSelectedCraftRole = "";
    }

    private void RemovePosition(PositionEditItem item)
    {
        if (item.IsNew)
            positionsEditList.Remove(item);
        else
            item.IsRemoved = true;
    }

    private void UndoRemovePosition(PositionEditItem item)
    {
        item.IsRemoved = false;
    }

    private void MovePositionUp(PositionEditItem item)
    {
        var craftGroup = positionsEditList
            .Where(p => p.CraftRoleName == item.CraftRoleName && !p.IsRemoved)
            .OrderBy(p => p.DisplayOrder)
            .ToList();
        var idx = craftGroup.IndexOf(item);
        if (idx <= 0) return;
        (craftGroup[idx].DisplayOrder, craftGroup[idx - 1].DisplayOrder) =
            (craftGroup[idx - 1].DisplayOrder, craftGroup[idx].DisplayOrder);
    }

    private void MovePositionDown(PositionEditItem item)
    {
        var craftGroup = positionsEditList
            .Where(p => p.CraftRoleName == item.CraftRoleName && !p.IsRemoved)
            .OrderBy(p => p.DisplayOrder)
            .ToList();
        var idx = craftGroup.IndexOf(item);
        if (idx < 0 || idx >= craftGroup.Count - 1) return;
        (craftGroup[idx].DisplayOrder, craftGroup[idx + 1].DisplayOrder) =
            (craftGroup[idx + 1].DisplayOrder, craftGroup[idx].DisplayOrder);
    }

    private bool CanMoveUp(PositionEditItem item)
    {
        var craftGroup = positionsEditList
            .Where(p => p.CraftRoleName == item.CraftRoleName && !p.IsRemoved)
            .OrderBy(p => p.DisplayOrder)
            .ToList();
        return craftGroup.IndexOf(item) > 0;
    }

    private bool CanMoveDown(PositionEditItem item)
    {
        var craftGroup = positionsEditList
            .Where(p => p.CraftRoleName == item.CraftRoleName && !p.IsRemoved)
            .OrderBy(p => p.DisplayOrder)
            .ToList();
        var idx = craftGroup.IndexOf(item);
        return idx >= 0 && idx < craftGroup.Count - 1;
    }

    private bool HasPositionChanges =>
        positionsEditList.Any(p => p.IsNew || p.IsRemoved) ||
        positionsEditList.Any(p => !p.IsNew && !p.IsRemoved && p.DisplayOrder != p.OriginalDisplayOrder);

    private async Task SavePositions()
    {
        isSavingPositions = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var addedRoles = positionsEditList.Where(p => p.IsNew).Select(p => p.CraftRoleName);
            var removedIds = positionsEditList.Where(p => p.IsRemoved && !p.IsNew).Select(p => p.CtrlNbr);
            var orders = positionsEditList
                .Where(p => !p.IsNew && !p.IsRemoved)
                .Select(p => (p.CtrlNbr, p.DisplayOrder));

            await DailyOperationsClient.ManageAssignmentPositionsAsync(
                positionsShiftCtrlNbr,
                positionsAssignmentCtrlNbr,
                addedRoles,
                removedIds,
                orders);

            showPositionsModal = false;
            successMessage = "Positions updated successfully.";
            await LoadCallSheet();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to update positions: {ex.Message}";
        }
        finally
        {
            isSavingPositions = false;
        }
    }

    private class PositionEditItem
    {
        public long CtrlNbr { get; set; }
        public string CraftRoleName { get; set; } = "";
        private int _displayOrder;
        public int DisplayOrder
        {
            get => _displayOrder;
            set
            {
                if (!_initialized) { _originalDisplayOrder = value; _initialized = true; }
                _displayOrder = value;
            }
        }
        public int OriginalDisplayOrder => _originalDisplayOrder;
        private int _originalDisplayOrder;
        private bool _initialized;
        public string Status { get; set; } = "";
        public bool IsAdHoc { get; set; }
        public bool IsOpen { get; set; }
        public bool IsNew { get; set; }
        public bool IsRemoved { get; set; }
        public bool CanRemove => (IsAdHoc || IsNew) && IsOpen;
    }

