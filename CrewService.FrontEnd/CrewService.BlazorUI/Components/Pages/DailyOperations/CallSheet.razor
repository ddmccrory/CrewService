@page "/daily-operations/call-sheet"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using CrewService.BlazorUI.Clients
@using CrewService.Presentation

@inherits AppComponentBase

@attribute [Authorize]

@inject DailyOperationsClient DailyOperationsClient
@inject WorkManagementClient WorkManagementClient
@inject TenantConfigClient TenantConfigClient
@inject DepartmentClient DepartmentClient

<PageTitle>Call Sheet</PageTitle>

<h1>Call Sheet</h1>

@if (!HasRailroad)
{
    <div class="alert alert-warning">
        <span class="bi bi-exclamation-triangle"></span>
        Please select a railroad in the context switcher to view call sheets.
    </div>
}
else
{
    <p class="text-muted mb-3">Daily operations for <strong>@SelectedRailroadName</strong></p>

    <div class="row align-items-end g-2" style="margin-bottom: 2.25rem;">
        <div class="col-auto">
            <label class="form-label fw-semibold">Work Area</label>
            <FilterSelect TItem="GroupResponse" TValue="long"
                          @bind-Value="selectedWorkAreaCtrlNbr"
                          @bind-Value:after="OnWorkAreaSelected"
                          Items="workAreas"
                          ValueSelector="@(wa => wa.CtrlNbr)"
                          TextSelector="@(wa => wa.Name)"
                          Placeholder="-- Select Work Area --"
                          class="form-select form-select-sm" style="width: 180px;" />
        </div>
        <div class="col-auto" style="position: relative;">
            <label class="form-label fw-semibold">Date</label>
            <input type="date" class="form-control form-control-sm" style="width: 180px;"
                   value="@selectedDate.ToString("yyyy-MM-dd")"
                   @onchange="OnDateChanged" />
            <div class="btn-group mt-1" style="position: absolute; width: 180px; font-size: 0.7rem;">
                <button type="button" class="btn btn-outline-secondary py-0 px-1 flex-fill" style="font-size: inherit;" @onclick="() => SetDate(-1)">Yesterday</button>
                <button type="button" class="btn btn-outline-secondary py-0 px-1 flex-fill" style="font-size: inherit;" @onclick="() => SetDate(0)">Today</button>
                <button type="button" class="btn btn-outline-secondary py-0 px-1 flex-fill" style="font-size: inherit;" @onclick="() => SetDate(1)">Tomorrow</button>
            </div>
        </div>
        <div class="col-auto">
            <label class="form-label fw-semibold">Department</label>
            <FilterSelect TItem="DepartmentResponse" TValue="long"
                          @bind-Value="selectedDepartmentCtrlNbr"
                          @bind-Value:after="OnDepartmentSelected"
                          Items="departments"
                          ValueSelector="@(d => d.CtrlNbr)"
                          TextSelector="@(d => d.Name)"
                          Placeholder="-- Select Department --"
                          class="form-select form-select-sm" style="width: 180px;" />
        </div>
        <div class="col-auto d-flex align-items-end" style="padding-bottom: 0.375rem;">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="showClosedToggle"
                       checked="@showClosedShifts"
                       @onchange="OnShowClosedChanged" />
                <label class="form-check-label" for="showClosedToggle">Show closed</label>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show">
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (selectedWorkAreaCtrlNbr > 0 && callSheetLoaded)
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">
                Call Sheet for @selectedDate.ToString("dddd, MMMM d, yyyy")
            </h5>
            @if (!IsFeatureReadOnly)
            {
                <button class="btn btn-success" @onclick="OpenGenerateModal">
                    <span class="bi bi-plus-circle"></span> Generate Shift
                </button>
            }
        </div>

        @if (selectedDepartmentCtrlNbr == 0)
        {
            <div class="alert alert-info">
                <span class="bi bi-info-circle"></span>
                Please select a department to view call sheets.
            </div>
        }
        else
        {
            var filteredShifts = (shifts ?? [])
                .Where(s => s.DepartmentCtrlNbr == selectedDepartmentCtrlNbr)
                .OrderBy(s => s.ShiftCode)
                .ToList();

            if (filteredShifts.Count == 0)
            {
                <div class="alert alert-info">
                    <span class="bi bi-info-circle"></span>
                    No shifts have been generated for this department. Click <strong>Generate Shift</strong> to create one.
                </div>
            }
            else
            {
                var activeShift = filteredShifts.FirstOrDefault(s => s.CtrlNbr == activeShiftCtrlNbr) ?? filteredShifts[0];
                var isShiftReadOnly = IsFeatureReadOnly || activeShift.Status == "Completed";

                <ul class="nav nav-tabs mb-3">
                    @foreach (var shift in filteredShifts)
                    {
                        <li class="nav-item">
                            <button class="nav-link @(activeShift.CtrlNbr == shift.CtrlNbr ? "active" : "") @(shift.Status == "Completed" ? "text-muted" : "")"
                                    @onclick="() => activeShiftCtrlNbr = shift.CtrlNbr">
                                <span class="badge @(shift.Status == "Completed" ? "bg-secondary" : "bg-primary") me-1">@shift.ShiftCode.ToUpperInvariant()</span>
                                @shift.ShiftDisplayName
                            </button>
                        </li>
                    }
                </ul>

                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h6 class="mb-0">
                            <span class="badge bg-primary me-1">@activeShift.ShiftCode.ToUpperInvariant()</span>
                            @activeShift.ShiftDisplayName
                        </h6>
                        <div class="d-flex align-items-center gap-2">
                            <div class="btn-group btn-group-sm" role="group" aria-label="Layout toggle">
                                <button type="button" class="btn @(useHorizontalLayout ? "btn-outline-secondary" : "btn-secondary")"
                                        @onclick="() => useHorizontalLayout = false" title="Vertical layout">
                                    <span class="bi bi-list"></span>
                                </button>
                                <button type="button" class="btn @(useHorizontalLayout ? "btn-secondary" : "btn-outline-secondary")"
                                        @onclick="() => useHorizontalLayout = true" title="Horizontal layout">
                                    <span class="bi bi-table"></span>
                                </button>
                            </div>
                            <span class="badge @GetStatusBadgeClass(activeShift.Status)">@activeShift.Status</span>
                            @if (activeShift.Status != "Completed")
                            {
                                <button class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => RefreshShift(activeShift.CtrlNbr)"
                                        title="Rebuild this call sheet">
                                    <span class="bi bi-arrow-clockwise"></span> Refresh
                                </button>
                                @if (!IsFeatureReadOnly)
                                {
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button"
                                                data-bs-toggle="dropdown" aria-expanded="false"
                                                title="Add an extra assignment to this shift">
                                            <span class="bi bi-plus-circle"></span> Add Assignment
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li><button class="dropdown-item" disabled><span class="bi bi-clipboard-check me-2"></span>From Template</button></li>
                                            <li><button class="dropdown-item" disabled><span class="bi bi-pencil-square me-2"></span>Ad-Hoc</button></li>
                                        </ul>
                                    </div>
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => OpenCloseModal(activeShift)"
                                            title="Close this shift">
                                        <span class="bi bi-x-circle"></span> Close
                                    </button>
                                }
                            }
                            else if (!IsFeatureReadOnly)
                            {
                                <button class="btn btn-sm btn-outline-success"
                                        @onclick="() => ReopenShift(activeShift.CtrlNbr)"
                                        disabled="@isReopening"
                                        title="Re-open this completed shift">
                                    @if (isReopening)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                    }
                                    <span class="bi bi-arrow-counterclockwise"></span> Re-open
                                </button>
                            }
                        </div>
                    </div>
                    <div class="card-body p-0" style="overflow: visible;">
                        @if (activeShift.PositionSlots.Count == 0)
                        {
                            <p class="text-muted p-3 mb-0"><em>No positions on this shift.</em></p>
                        }
                        else if (useHorizontalLayout)
                        {
                            var assignmentGroups = activeShift.PositionSlots
                                .GroupBy(p => new { p.AssignmentCtrlNbr, p.AssignmentCode, p.OnDutyTime, p.OffDutyTime, p.GroupCode })
                                .OrderBy(g => g.Key.AssignmentCode)
                                .ToList();

                            var craftRoleColumns = activeShift.PositionSlots
                                .Select(s => s.CraftRoleName)
                                .Distinct()
                                .OrderBy(name => name)
                                .ToList();

                            <div class="table-responsive" style="overflow: visible; font-size: 0.85rem;">
                                <table class="table table-sm table-striped table-hover mb-0">
                                    <thead>
                                        <tr>
                                            <th>Assignment</th>
                                            <th>Location</th>
                                            <th>On Duty</th>
                                            <th>Off Duty</th>
                                            @foreach (var role in craftRoleColumns)
                                            {
                                                <th style="min-width: 15ch;">@role</th>
                                            }
                                            @if (!isShiftReadOnly)
                                            {
                                                <th style="width: 80px;" class="text-end">Actions</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var group in assignmentGroups)
                                        {
                                            var slotsByRole = group
                                                .GroupBy(s => s.CraftRoleName)
                                                .ToDictionary(g => g.Key, g => g.OrderBy(s => s.DisplayOrder).ToList());
                                            var allAnnulled = IsAssignmentFullyAnnulled(group);

                                            <tr class="@(allAnnulled ? "text-muted text-decoration-line-through" : "")">
                                                <td>
                                                    <strong>@group.Key.AssignmentCode.ToUpperInvariant()</strong>
                                                </td>
                                                <td>@group.Key.GroupCode.ToUpperInvariant()</td>
                                                <td class="text-nowrap">@group.Key.OnDutyTime</td>
                                                <td class="text-nowrap">@group.Key.OffDutyTime</td>
                                                @foreach (var role in craftRoleColumns)
                                                                {
                                                                    @if (slotsByRole.TryGetValue(role, out var slots))
                                                                    {
                                                                        <td>
                                                                            @foreach (var slot in slots)
                                                                            {
                                                                                <div class="d-flex align-items-center gap-1">
                                                                                    @{ var hVacancy = GetSlotVacancyDisplay(slot); }
                                                                                    @if (!string.IsNullOrEmpty(hVacancy))
                                                                                    {
                                                                                        <strong class="text-primary small">@hVacancy</strong>
                                                                                    }
                                                                                    else if (slot.HasIncumbentEmployeeCtrlNbr)
                                                                                    {
                                                                                        <span class="@GetSlotEmployeeCssClass(slot)">@GetSlotEmployeeDisplay(slot)</span>
                                                                                        @if (slot.Status == PositionSlotStatusEnum.PositionSlotStatusAnnulled)
                                                                                        {
                                                                                            <small class="text-primary ms-1">ANLD</small>
                                                                                        }
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <span class="badge @GetSlotStatusBadgeClass(slot)">@GetSlotDisplayStatus(slot)</span>
                                                                                    }
                                                                                    @if (!isShiftReadOnly && IsSlotActionable(slot))
                                                                                    {
                                                                                        <div class="dropdown">
                                                                                            <button class="btn btn-sm btn-outline-secondary py-0 px-1" type="button"
                                                                                                    data-bs-toggle="dropdown" aria-expanded="false" title="Position actions">
                                                                                                <span class="bi bi-three-dots-vertical"></span>
                                                                                            </button>
                                                                                            <ul class="dropdown-menu dropdown-menu-end">
                                                                                                @if (slot.Status == PositionSlotStatusEnum.PositionSlotStatusOpen
                                                                                                    || slot.Status == PositionSlotStatusEnum.PositionSlotStatusExtraBoard
                                                                                                    || slot.Status == PositionSlotStatusEnum.PositionSlotStatusNoBids)
                                                                                                {
                                                                                                    <li><button class="dropdown-item" disabled><span class="bi bi-person-plus me-2"></span>Fill Vacancy</button></li>
                                                                                                }
                                                                                                @if (slot.Status == PositionSlotStatusEnum.PositionSlotStatusFilled)
                                                                                                {
                                                                                                    <li><button class="dropdown-item" disabled><span class="bi bi-box-arrow-in-right me-2"></span>Place On Duty</button></li>
                                                                                                }
                                                                                                @if (slot.Status == PositionSlotStatusEnum.PositionSlotStatusOnDuty
                                                                                                    || slot.Status == PositionSlotStatusEnum.PositionSlotStatusOnDutyOvertime)
                                                                                                {
                                                                                                    <li><button class="dropdown-item" disabled><span class="bi bi-box-arrow-right me-2"></span>Tie Up</button></li>
                                                                                                }
                                                                                                @if (slot.Status != PositionSlotStatusEnum.PositionSlotStatusAnnulled
                                                                                                    && slot.Status != PositionSlotStatusEnum.PositionSlotStatusDoNotFill
                                                                                                    && slot.Status != PositionSlotStatusEnum.PositionSlotStatusTiedUp)
                                                                                                {
                                                                                                    <li><hr class="dropdown-divider" /></li>
                                                                                                    <li><button class="dropdown-item" @onclick="() => OpenAnnulModal(activeShift.CtrlNbr, slot.CtrlNbr, 0, slot.CraftRoleName)"><span class="bi bi-x-circle me-2"></span>Annul</button></li>
                                                                                                    <li><button class="dropdown-item" @onclick="() => OpenDoNotFillModal(activeShift.CtrlNbr, slot.CtrlNbr, slot.CraftRoleName)"><span class="bi bi-slash-circle me-2"></span>Do Not Fill</button></li>
                                                                                                }
                                                                                                @if (slot.Status == PositionSlotStatusEnum.PositionSlotStatusAnnulled
                                                                                                    || slot.Status == PositionSlotStatusEnum.PositionSlotStatusDoNotFill)
                                                                                                {
                                                                                                    <li><hr class="dropdown-divider" /></li>
                                                                                                    <li><button class="dropdown-item" @onclick="() => OpenRestoreModal(activeShift.CtrlNbr, slot.CtrlNbr, slot.CraftRoleName)"><span class="bi bi-arrow-counterclockwise me-2"></span>Restore</button></li>
                                                                                                }
                                                                                            </ul>
                                                                                        </div>
                                                                                    }
                                                                                </div>
                                                                            }
                                                                        </td>
                                                                    }
                                                                    else
                                                                    {
                                                                        <td></td>
                                                                    }
                                                                }
                                                                @if (!isShiftReadOnly)
                                                                {
                                                                    <td class="text-end">
                                                                        <div class="dropdown">
                                                                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button"
                                                                                    data-bs-toggle="dropdown" aria-expanded="false">
                                                                                <span class="bi bi-three-dots-vertical"></span>
                                                                            </button>
                                                                            <ul class="dropdown-menu dropdown-menu-end">
                                                                                <li><button class="dropdown-item" @onclick="() => OpenAnnulModal(activeShift.CtrlNbr, 0, group.Key.AssignmentCtrlNbr, group.Key.AssignmentCode.ToUpperInvariant())"><span class="bi bi-x-circle me-2"></span>Annul Assignment</button></li>
                                                                                <li><button class="dropdown-item" disabled><span class="bi bi-journal-text me-2"></span>Notes</button></li>
                                                                                <li><button class="dropdown-item" disabled><span class="bi bi-people me-2"></span>Positions</button></li>
                                                                            </ul>
                                                                        </div>
                                                                    </td>
                                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            @foreach (var assignmentGroup in activeShift.PositionSlots
                                .GroupBy(p => new { p.AssignmentCtrlNbr, p.AssignmentCode, p.AssignmentName, p.OnDutyTime, p.OffDutyTime, p.GroupCode, p.GroupName })
                                .OrderBy(g => g.Key.AssignmentCode))
                            {
                                var vAllAnnulled = IsAssignmentFullyAnnulled(assignmentGroup);
                                <div class="ms-3 mb-2 mt-2 @(vAllAnnulled ? "text-muted" : "")" style="font-size: 0.85rem;">
                                    <div class="d-flex align-items-center @(vAllAnnulled ? "text-decoration-line-through" : "")">
                                        <strong>@assignmentGroup.Key.AssignmentName</strong>
                                        <span class="text-muted ms-2">@assignmentGroup.Key.GroupName</span>
                                        <span class="text-muted ms-2 small">@assignmentGroup.Key.OnDutyTime – @assignmentGroup.Key.OffDutyTime</span>
                                        @if (!isShiftReadOnly)
                                        {
                                            <div class="dropdown ms-2">
                                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle py-0" type="button"
                                                        data-bs-toggle="dropdown" aria-expanded="false">
                                                    <span class="bi bi-three-dots-vertical"></span>
                                                </button>
                                                <ul class="dropdown-menu">
                                                    <li><button class="dropdown-item" @onclick="() => OpenAnnulModal(activeShift.CtrlNbr, 0, assignmentGroup.Key.AssignmentCtrlNbr, assignmentGroup.Key.AssignmentCode.ToUpperInvariant())"><span class="bi bi-x-circle me-2"></span>Annul Assignment</button></li>
                                                    <li><button class="dropdown-item" disabled><span class="bi bi-journal-text me-2"></span>Notes</button></li>
                                                    <li><button class="dropdown-item" disabled><span class="bi bi-people me-2"></span>Positions</button></li>
                                                </ul>
                                            </div>
                                        }
                                    </div>
                                    <table class="table table-sm table-hover mb-0 mt-1">
                                        <thead>
                                            <tr>
                                                <th style="width: 60px;">#</th>
                                                <th>Craft/Role</th>
                                                <th>Status</th>
                                                <th>Employee</th>
                                                @if (!isShiftReadOnly)
                                                {
                                                    <th style="width: 80px;" class="text-end">Actions</th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var slot in assignmentGroup.OrderBy(s => s.DisplayOrder))
                                            {
                                                <tr>
                                                    <td>@slot.DisplayOrder</td>
                                                    <td>@slot.CraftRoleName</td>
                                                    <td>
                                                        <span class="badge @GetSlotStatusBadgeClass(slot)">
                                                            @GetSlotDisplayStatus(slot)
                                                        </span>
                                                    </td>
                                                    <td>
                                                        @{ var vacancyText = GetSlotVacancyDisplay(slot); }
                                                        @if (!string.IsNullOrEmpty(vacancyText))
                                                        {
                                                            <strong class="text-primary">@vacancyText</strong>
                                                        }
                                                        else if (slot.HasIncumbentEmployeeCtrlNbr)
                                                        {
                                                            <span class="@GetSlotEmployeeCssClass(slot)">@GetSlotEmployeeDisplay(slot)</span>
                                                            @if (slot.Status == PositionSlotStatusEnum.PositionSlotStatusAnnulled)
                                                            {
                                                                <small class="text-primary ms-1">ANLD</small>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <em class="text-muted">—</em>
                                                        }
                                                    </td>
                                                    @if (!isShiftReadOnly)
                                                    {
                                                        <td class="text-end">
                                                            @if (IsSlotActionable(slot))
                                                            {
                                                                <div class="dropdown">
                                                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button"
                                                                            data-bs-toggle="dropdown" aria-expanded="false">
                                                                        <span class="bi bi-three-dots-vertical"></span>
                                                                    </button>
                                                                    <ul class="dropdown-menu dropdown-menu-end">
                                                                        @if (slot.Status == PositionSlotStatusEnum.PositionSlotStatusOpen
                                                                            || slot.Status == PositionSlotStatusEnum.PositionSlotStatusExtraBoard
                                                                            || slot.Status == PositionSlotStatusEnum.PositionSlotStatusNoBids)
                                                                        {
                                                                            <li><button class="dropdown-item" disabled><span class="bi bi-person-plus me-2"></span>Fill Vacancy</button></li>
                                                                        }
                                                                        @if (slot.Status == PositionSlotStatusEnum.PositionSlotStatusFilled)
                                                                        {
                                                                            <li><button class="dropdown-item" disabled><span class="bi bi-box-arrow-in-right me-2"></span>Place On Duty</button></li>
                                                                        }
                                                                        @if (slot.Status == PositionSlotStatusEnum.PositionSlotStatusOnDuty
                                                                            || slot.Status == PositionSlotStatusEnum.PositionSlotStatusOnDutyOvertime)
                                                                        {
                                                                            <li><button class="dropdown-item" disabled><span class="bi bi-box-arrow-right me-2"></span>Tie Up</button></li>
                                                                        }
                                                                        @if (slot.Status != PositionSlotStatusEnum.PositionSlotStatusAnnulled
                                                                            && slot.Status != PositionSlotStatusEnum.PositionSlotStatusDoNotFill
                                                                            && slot.Status != PositionSlotStatusEnum.PositionSlotStatusTiedUp)
                                                                        {
                                                                            <li><hr class="dropdown-divider" /></li>
                                                                            <li><button class="dropdown-item" @onclick="() => OpenAnnulModal(activeShift.CtrlNbr, slot.CtrlNbr, 0, slot.CraftRoleName)"><span class="bi bi-x-circle me-2"></span>Annul</button></li>
                                                                            <li><button class="dropdown-item" @onclick="() => OpenDoNotFillModal(activeShift.CtrlNbr, slot.CtrlNbr, slot.CraftRoleName)"><span class="bi bi-slash-circle me-2"></span>Do Not Fill</button></li>
                                                                        }
                                                                        @if (slot.Status == PositionSlotStatusEnum.PositionSlotStatusAnnulled
                                                                            || slot.Status == PositionSlotStatusEnum.PositionSlotStatusDoNotFill)
                                                                        {
                                                                            <li><hr class="dropdown-divider" /></li>
                                                                            <li><button class="dropdown-item" @onclick="() => OpenRestoreModal(activeShift.CtrlNbr, slot.CtrlNbr, slot.CraftRoleName)"><span class="bi bi-arrow-counterclockwise me-2"></span>Restore</button></li>
                                                                        }
                                                                    </ul>
                                                                </div>
                                                            }
                                                        </td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        }
    }

    @* ── Generate Shift Modal ── *@
    <Modal Visible="showGenerateModal"
           Title="Generate Shift Call Sheet"
           Icon="bi bi-clipboard-plus"
           OnClose="CloseGenerateModal">
        <BodyContent>
            <EditForm Model="generateModel" OnValidSubmit="OnGenerate" id="generate-shift-form">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Shift Definition</label>
                    <SelectInput TItem="ShiftDefinitionResponse" TValue="long"
                                 @bind-Value="generateModel.ShiftDefinitionCtrlNbr"
                                 Items="availableShifts"
                                 ValueSelector="@(s => s.CtrlNbr)"
                                 TextSelector="@(s => $"{s.ShiftCode.ToUpperInvariant()} — {s.DisplayName}")"
                                 Placeholder="-- Select Shift --"
                                 class="form-select" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Department</label>
                    <SelectInput TItem="DepartmentResponse" TValue="long"
                                 @bind-Value="generateModel.DepartmentCtrlNbr"
                                 Items="departments"
                                 ValueSelector="@(d => d.CtrlNbr)"
                                 TextSelector="@(d => d.Name)"
                                 Placeholder="-- None --"
                                 class="form-select" />
                </div>
                <p class="text-muted">
                    This will generate the call sheet for the selected shift on <strong>@selectedDate.ToString("yyyy-MM-dd")</strong>,
                    creating all scheduled positions as open vacancies.
                </p>
            </EditForm>
        </BodyContent>
        <Footer>
            <button type="button" class="btn btn-secondary" @onclick="CloseGenerateModal">Cancel</button>
            <button type="submit" form="generate-shift-form" class="btn btn-success"
                    disabled="@(generateModel.ShiftDefinitionCtrlNbr == 0 || isGenerating)">
                @if (isGenerating)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                Generate
            </button>
        </Footer>
    </Modal>

    @* ── Close Shift Confirmation Modal ── *@
    <ConfirmModal Visible="showCloseModal" ItemName="@closeShiftName" IsSaving="isSaving"
                        ActionVerb="Close" ButtonIcon="bi bi-x-circle" ButtonClass="btn-warning"
                        OnConfirm="ConfirmClose" OnCancel="() => showCloseModal = false" />

    @* ── Annul Modal (shared for position and assignment) ── *@
    <Modal Visible="showAnnulModal"
           Title="@annulModalTitle"
           Icon="bi bi-x-circle"
           OnClose="CloseAnnulModal">
        <BodyContent>
            <EditForm Model="annulModel" OnValidSubmit="ConfirmAnnul" id="annul-form">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Annulment Date/Time</label>
                    <input type="datetime-local" class="form-control"
                           value="@annulModel.AnnulmentDateTime.ToString("yyyy-MM-ddTHH:mm")"
                           @onchange="e => annulModel.AnnulmentDateTime = DateTime.Parse(e.Value!.ToString()!)" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Reason</label>
                    <InputTextArea @bind-Value="annulModel.Reason" class="form-control" rows="3" placeholder="Enter annulment reason..." />
                </div>
            </EditForm>
        </BodyContent>
        <Footer>
            <button type="button" class="btn btn-secondary" @onclick="CloseAnnulModal">Cancel</button>
            <button type="submit" form="annul-form" class="btn btn-danger"
                    disabled="@(string.IsNullOrWhiteSpace(annulModel.Reason) || isAnnulling)">
                @if (isAnnulling)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                <span class="bi bi-x-circle me-1"></span> Annul
            </button>
        </Footer>
    </Modal>

    @* ── Do Not Fill Confirmation Modal ── *@
    <ConfirmModal Visible="showDoNotFillModal" ItemName="@doNotFillItemName" IsSaving="isDoNotFilling"
                        ActionVerb="Do Not Fill" ButtonIcon="bi bi-slash-circle" ButtonClass="btn-warning"
                        OnConfirm="ConfirmDoNotFill" OnCancel="() => showDoNotFillModal = false" />

    @* ── Restore Position Confirmation Modal ── *@
    <ConfirmModal Visible="showRestoreModal" ItemName="@restoreItemName" IsSaving="isRestoring"
                        ActionVerb="Restore" ButtonIcon="bi bi-arrow-counterclockwise" ButtonClass="btn-success"
                        OnConfirm="ConfirmRestore" OnCancel="() => showRestoreModal = false" />
}

@code {
    protected override string? FeatureKey => "daily-operations/call-sheet";

    private IReadOnlyList<GroupResponse>? workAreas;
    private IReadOnlyList<DailyShiftInstanceResponse>? shifts;
    private IReadOnlyList<ShiftDefinitionResponse>? availableShifts;
    private IReadOnlyList<DepartmentResponse>? departments;
    private long selectedWorkAreaCtrlNbr;
    private DateOnly selectedDate = DateOnly.FromDateTime(DateTime.Today);
    private bool callSheetLoaded;
    private long selectedDepartmentCtrlNbr;
    private long activeShiftCtrlNbr;
    private bool useHorizontalLayout;
    private bool showClosedShifts;

    private bool showGenerateModal;
    private bool isGenerating;
    private GenerateShiftModel generateModel = new();

    private bool showCloseModal;
    private long closeShiftCtrlNbr;
    private string closeShiftName = "";
    private bool isReopening;

    // Annul modal state
    private bool showAnnulModal;
    private bool isAnnulling;
    private string annulModalTitle = "";
    private AnnulModel annulModel = new();

    // Do Not Fill modal state
    private bool showDoNotFillModal;
    private bool isDoNotFilling;
    private long doNotFillShiftCtrlNbr;
    private long doNotFillSlotCtrlNbr;
    private string doNotFillItemName = "";

    // Restore modal state
    private bool showRestoreModal;
    private bool isRestoring;
    private long restoreShiftCtrlNbr;
    private long restoreSlotCtrlNbr;
    private string restoreItemName = "";

    protected override async Task LoadDataAsync()
    {
        if (HasRailroad)
            await LoadWorkAreas();
    }

    protected override async Task OnAppContextChangedAsync()
    {
        selectedWorkAreaCtrlNbr = 0;
        selectedDepartmentCtrlNbr = 0;
        activeShiftCtrlNbr = 0;
        shifts = null;
        callSheetLoaded = false;
        availableShifts = null;
        showClosedShifts = false;

        if (HasRailroad)
            await LoadWorkAreas();
        else
        {
            workAreas = null;
            departments = null;
        }
    }

    private async Task LoadWorkAreas()
    {
        try
        {
            var response = await TenantConfigClient.GetWorkAreasAsync(SelectedRailroadCtrlNbr!.Value);
            workAreas = response.Groups.ToList();
        }
        catch { workAreas = []; }

        try
        {
            var deptResponse = await DepartmentClient.GetAllAsync(SelectedParentCtrlNbr!.Value, SelectedRailroadCtrlNbr!.Value);
            departments = deptResponse.Departments;
        }
        catch { departments = []; }

        if (workAreas?.Count == 1)
        {
            selectedWorkAreaCtrlNbr = workAreas[0].CtrlNbr;
            await LoadCallSheet();
        }
    }

    private async Task OnWorkAreaSelected()
    {
        shifts = null;
        callSheetLoaded = false;
        availableShifts = null;
        activeShiftCtrlNbr = 0;

        if (selectedWorkAreaCtrlNbr > 0)
            await LoadCallSheet();
    }

    private async Task OnDateChanged(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var date))
        {
            selectedDate = date;
            shifts = null;
            callSheetLoaded = false;
            activeShiftCtrlNbr = 0;

            if (selectedWorkAreaCtrlNbr > 0)
                await LoadCallSheet();
        }
    }

    private Task SetDate(int offsetFromToday)
    {
        var e = new ChangeEventArgs { Value = DateOnly.FromDateTime(DateTime.Today.AddDays(offsetFromToday)).ToString("yyyy-MM-dd") };
        return OnDateChanged(e);
    }

    private async Task LoadCallSheet()
    {
        if (selectedWorkAreaCtrlNbr == 0) return;

        errorMessage = null;
        successMessage = null;

        try
        {
            var response = await DailyOperationsClient.GetCallSheetAsync(
                selectedWorkAreaCtrlNbr, selectedDate.ToString("yyyy-MM-dd"), showClosedShifts);
            shifts = response.Shifts;
            callSheetLoaded = true;
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load call sheet: {ex.Message}";
            shifts = null;
            callSheetLoaded = true;
        }
    }

    private async Task RefreshShift(long shiftCtrlNbr)
    {
        errorMessage = null;
        successMessage = null;

        try
        {
            await DailyOperationsClient.RefreshShiftInstanceAsync(shiftCtrlNbr);
            await LoadCallSheet();
            successMessage = "Call sheet rebuilt successfully.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to rebuild call sheet: {ex.Message}";
        }
    }

    private async Task OpenGenerateModal()
    {
        errorMessage = null;
        successMessage = null;
        generateModel = new() { DepartmentCtrlNbr = selectedDepartmentCtrlNbr };
        try
        {
            var response = await WorkManagementClient.GetShiftDefinitionsAsync(selectedWorkAreaCtrlNbr);
            availableShifts = response.ShiftDefinitions.Where(s => s.IsActive).ToList();
        }
        catch
        {
            availableShifts = [];
        }

        showGenerateModal = true;
    }

    private void OnDepartmentSelected()
    {
        activeShiftCtrlNbr = 0;
        var dept = departments?.FirstOrDefault(d => d.CtrlNbr == selectedDepartmentCtrlNbr);
        useHorizontalLayout = dept?.DefaultCallSheetView.Equals("Horizontal", StringComparison.OrdinalIgnoreCase) == true;
    }

    private async Task OnShowClosedChanged(ChangeEventArgs e)
    {
        showClosedShifts = e.Value is true;
        if (selectedWorkAreaCtrlNbr > 0)
            await LoadCallSheet();
    }

    private void CloseGenerateModal() => showGenerateModal = false;

    private async Task OnGenerate()
    {
        if (generateModel.ShiftDefinitionCtrlNbr == 0) return;

        isGenerating = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            await DailyOperationsClient.GenerateCallSheetAsync(
                selectedWorkAreaCtrlNbr,
                generateModel.ShiftDefinitionCtrlNbr,
                selectedDate.ToString("yyyy-MM-dd"),
                generateModel.DepartmentCtrlNbr);
            showGenerateModal = false;
            successMessage = "Shift call sheet generated successfully.";
            await LoadCallSheet();
        }
        catch (Exception ex)
        {
            errorMessage = $"Generation failed: {ex.Message}";
        }
        finally
        {
            isGenerating = false;
        }
    }

    private void OpenCloseModal(DailyShiftInstanceResponse shift)
    {
        closeShiftCtrlNbr = shift.CtrlNbr;
        closeShiftName = $"{shift.ShiftCode.ToUpperInvariant()} — {shift.ShiftDisplayName}";
        showCloseModal = true;
    }

    private async Task ConfirmClose()
    {
        isSaving = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            await DailyOperationsClient.CloseShiftInstanceAsync(closeShiftCtrlNbr);
            showCloseModal = false;
            successMessage = $"Shift '{closeShiftName}' has been closed.";
            await LoadCallSheet();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to close shift: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ReopenShift(long shiftCtrlNbr)
    {
        isReopening = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            await DailyOperationsClient.ReopenShiftInstanceAsync(shiftCtrlNbr);
            successMessage = "Shift has been re-opened.";
            await LoadCallSheet();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to re-open shift: {ex.Message}";
        }
        finally
        {
            isReopening = false;
        }
    }

    private static string GetStatusBadgeClass(string status) => status switch
    {
        "Active" => "bg-success",
        "Completed" => "bg-secondary",
        "Cancelled" => "bg-danger",
        _ => "bg-info"
    };

    private static string GetSlotStatusBadgeClass(DailyPositionSlotResponse slot) => slot.Status switch
    {
        PositionSlotStatusEnum.PositionSlotStatusAnnulled => "bg-danger",
        PositionSlotStatusEnum.PositionSlotStatusDoNotFill => "bg-warning text-dark",
        PositionSlotStatusEnum.PositionSlotStatusSkipped => "bg-secondary",
        PositionSlotStatusEnum.PositionSlotStatusFilled => "bg-info",
        PositionSlotStatusEnum.PositionSlotStatusOnDuty => "bg-success",
        PositionSlotStatusEnum.PositionSlotStatusOnDutyOvertime => "bg-danger",
        PositionSlotStatusEnum.PositionSlotStatusTiedUp => "bg-secondary",
        PositionSlotStatusEnum.PositionSlotStatusMarkedOff => "bg-danger",
        PositionSlotStatusEnum.PositionSlotStatusUnavailable => "bg-danger",
        PositionSlotStatusEnum.PositionSlotStatusExtraBoard => "bg-primary",
        PositionSlotStatusEnum.PositionSlotStatusNoBids => "bg-primary",
        _ => "bg-warning text-dark" // Open
    };

    private static string GetSlotDisplayStatus(DailyPositionSlotResponse slot) => slot.Status switch
    {
        PositionSlotStatusEnum.PositionSlotStatusOpen => "Vacancy",
        PositionSlotStatusEnum.PositionSlotStatusFilled => "Filled",
        PositionSlotStatusEnum.PositionSlotStatusOnDuty => "On Duty",
        PositionSlotStatusEnum.PositionSlotStatusOnDutyOvertime => "Overtime",
        PositionSlotStatusEnum.PositionSlotStatusTiedUp => "Tied Up",
        PositionSlotStatusEnum.PositionSlotStatusMarkedOff => "Marked Off",
        PositionSlotStatusEnum.PositionSlotStatusUnavailable => "Unavailable",
        PositionSlotStatusEnum.PositionSlotStatusAnnulled => "Annulled",
        PositionSlotStatusEnum.PositionSlotStatusDoNotFill => "Do Not Fill",
        PositionSlotStatusEnum.PositionSlotStatusExtraBoard => "Extra Board",
        PositionSlotStatusEnum.PositionSlotStatusNoBids => "No Bids",
        PositionSlotStatusEnum.PositionSlotStatusSkipped => "Skipped",
        _ => "Open"
    };

    private static string GetSlotEmployeeDisplay(DailyPositionSlotResponse slot)
    {
        if (!slot.HasIncumbentEmployeeCtrlNbr) return string.Empty;
        var prefix = slot.IsIncumbent ? "" : "* ";
        return $"{prefix}Emp #{slot.IncumbentEmployeeCtrlNbr}";
    }

    private static string GetSlotEmployeeCssClass(DailyPositionSlotResponse slot) => slot.Status switch
    {
        PositionSlotStatusEnum.PositionSlotStatusOnDuty => "text-success fw-bold",
        PositionSlotStatusEnum.PositionSlotStatusOnDutyOvertime => "text-danger fw-bold",
        PositionSlotStatusEnum.PositionSlotStatusTiedUp => "",
        PositionSlotStatusEnum.PositionSlotStatusMarkedOff => "text-danger text-decoration-line-through",
        PositionSlotStatusEnum.PositionSlotStatusUnavailable => "text-danger text-decoration-line-through",
        PositionSlotStatusEnum.PositionSlotStatusAnnulled => "text-decoration-line-through",
        _ => ""
    };

    private static string GetSlotVacancyDisplay(DailyPositionSlotResponse slot) => slot.Status switch
    {
        PositionSlotStatusEnum.PositionSlotStatusOpen => "***VACANCY***  ",
        PositionSlotStatusEnum.PositionSlotStatusExtraBoard => "*EXTRA BOARD*  ",
        PositionSlotStatusEnum.PositionSlotStatusNoBids => "***NO BIDS***  ",
        PositionSlotStatusEnum.PositionSlotStatusDoNotFill => "**DO NOT FILL**",
        PositionSlotStatusEnum.PositionSlotStatusAnnulled when !slot.HasIncumbentEmployeeCtrlNbr => "***ANNULLED*** ",
        _ => string.Empty
    };

    private static bool IsSlotActionable(DailyPositionSlotResponse slot) =>
        slot.Status is not PositionSlotStatusEnum.PositionSlotStatusSkipped;

    private static bool IsAssignmentFullyAnnulled(IEnumerable<DailyPositionSlotResponse> slots) =>
        slots.All(s => s.Status == PositionSlotStatusEnum.PositionSlotStatusAnnulled);

    private void OpenAnnulModal(long shiftCtrlNbr, long slotCtrlNbr, long assignmentCtrlNbr, string itemName)
    {
        annulModel = new()
        {
            ShiftInstanceCtrlNbr = shiftCtrlNbr,
            PositionSlotCtrlNbr = slotCtrlNbr,
            AssignmentCtrlNbr = assignmentCtrlNbr,
            AnnulmentDateTime = DateTime.Now
        };
        annulModalTitle = assignmentCtrlNbr > 0
            ? $"Annul Assignment — {itemName}"
            : $"Annul Position — {itemName}";
        showAnnulModal = true;
    }

    private void CloseAnnulModal() => showAnnulModal = false;

    private async Task ConfirmAnnul()
    {
        isAnnulling = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var annulmentUtc = DateTime.SpecifyKind(annulModel.AnnulmentDateTime, DateTimeKind.Utc);

            if (annulModel.AssignmentCtrlNbr > 0)
            {
                await DailyOperationsClient.AnnulAssignmentAsync(
                    annulModel.ShiftInstanceCtrlNbr,
                    annulModel.AssignmentCtrlNbr,
                    annulModel.Reason ?? "",
                    annulmentUtc);
                successMessage = "Assignment annulled successfully.";
            }
            else
            {
                await DailyOperationsClient.AnnulPositionAsync(
                    annulModel.ShiftInstanceCtrlNbr,
                    annulModel.PositionSlotCtrlNbr,
                    annulModel.Reason ?? "",
                    annulmentUtc);
                successMessage = "Position annulled successfully.";
            }

            showAnnulModal = false;
            await LoadCallSheet();
        }
        catch (Exception ex)
        {
            errorMessage = $"Annulment failed: {ex.Message}";
        }
        finally
        {
            isAnnulling = false;
        }
    }

    private void OpenDoNotFillModal(long shiftCtrlNbr, long slotCtrlNbr, string itemName)
    {
        doNotFillShiftCtrlNbr = shiftCtrlNbr;
        doNotFillSlotCtrlNbr = slotCtrlNbr;
        doNotFillItemName = itemName;
        showDoNotFillModal = true;
    }

    private async Task ConfirmDoNotFill()
    {
        isDoNotFilling = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            await DailyOperationsClient.DoNotFillPositionAsync(doNotFillShiftCtrlNbr, doNotFillSlotCtrlNbr);
            showDoNotFillModal = false;
            successMessage = "Position marked as Do Not Fill.";
            await LoadCallSheet();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to mark position: {ex.Message}";
        }
        finally
        {
            isDoNotFilling = false;
        }
    }

    private void OpenRestoreModal(long shiftCtrlNbr, long slotCtrlNbr, string itemName)
    {
        restoreShiftCtrlNbr = shiftCtrlNbr;
        restoreSlotCtrlNbr = slotCtrlNbr;
        restoreItemName = itemName;
        showRestoreModal = true;
    }

    private async Task ConfirmRestore()
    {
        isRestoring = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            await DailyOperationsClient.RestorePositionAsync(restoreShiftCtrlNbr, restoreSlotCtrlNbr);
            showRestoreModal = false;
            successMessage = "Position restored successfully.";
            await LoadCallSheet();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to restore position: {ex.Message}";
        }
        finally
        {
            isRestoring = false;
        }
    }

    private class GenerateShiftModel
    {
        public long ShiftDefinitionCtrlNbr { get; set; }
        public long DepartmentCtrlNbr { get; set; }
    }

    private class AnnulModel
    {
        public long ShiftInstanceCtrlNbr { get; set; }
        public long PositionSlotCtrlNbr { get; set; }
        public long AssignmentCtrlNbr { get; set; }
        public string? Reason { get; set; }
        public DateTime AnnulmentDateTime { get; set; } = DateTime.Now;
    }
