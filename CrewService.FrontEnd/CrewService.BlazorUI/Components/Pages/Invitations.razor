@page "/admin/invitations"
@attribute [ExcludeFromInteractiveRouting]

@using Microsoft.AspNetCore.Authorization
@using CrewService.BlazorUI.Clients
@using CrewService.BlazorUI.Services
@using CrewService.Presentation

@attribute [Authorize(Roles = "SystemAdmin,ParentAdmin,RailroadAdmin")]

@inject InvitationsClient InvitationsClient
@inject AppContextService AppContext
@inject NavigationManager NavigationManager

<PageTitle>Invitations</PageTitle>

<h1>Invitations</h1>

@if (!AppContext.HasParent)
{
    <div class="alert alert-warning">
        <span class="bi bi-exclamation-triangle"></span>
        Please select a parent in the context switcher to manage invitations.
    </div>
}
else
{
    <p class="text-muted mb-3">Managing invitations for <strong>@AppContext.SelectedParentName</strong></p>

    @if (!showCreateForm)
    {
        <div class="mb-3">
            <form method="post" @formname="showCreate" @onsubmit="ShowCreateForm">
                <AntiforgeryToken />
                <button type="submit" class="btn btn-primary">
                    <span class="bi bi-plus-circle"></span> Create Invitation
                </button>
            </form>
        </div>
    }

    @if (showCreateForm)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">Create Invitation</h5>
                <EditForm Model="createModel" method="post" OnValidSubmit="CreateInvitation" FormName="createInvitation">
                    <DataAnnotationsValidator />
                    <div class="row g-3 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label">Email</label>
                            <InputText @bind-Value="createModel.Email" class="form-control" placeholder="jane@railroad.com" />
                            <ValidationMessage For="() => createModel.Email" class="text-danger" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Role</label>
                            <InputSelect @bind-Value="createModel.Role" class="form-select">
                                <option value="">-- Select Role --</option>
                                @foreach (var role in availableRoles)
                                {
                                    <option value="@role">@role</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => createModel.Role" class="text-danger" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Expires (days)</label>
                            <InputNumber @bind-Value="createModel.ExpirationDays" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-success me-2">Send Invitation</button>
                        </div>
                    </div>
                </EditForm>
                <form method="post" @formname="cancelCreate" @onsubmit="CancelCreate" class="mt-2">
                    <AntiforgeryToken />
                    <button type="submit" class="btn btn-secondary">Cancel</button>
                </form>
            </div>
        </div>
    }

    @if (successMessage is not null)
    {
        <div class="alert alert-success" role="alert">@successMessage</div>
    }

    @if (errorMessage is not null)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    @if (invitations is null)
    {
        <p><em>Loading...</em></p>
    }
    else if (invitations.Count == 0)
    {
        <p>No invitations found for this parent.</p>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Expires</th>
                    <th style="width: 180px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var inv in invitations)
                {
                    <tr>
                        <td>@inv.Email</td>
                        <td>@inv.Role</td>
                        <td>
                            @{
                                var badgeClass = inv.Status switch
                                {
                                    "Pending" => "bg-warning text-dark",
                                    "Accepted" => "bg-success",
                                    "Expired" => "bg-secondary",
                                    "Revoked" => "bg-danger",
                                    _ => "bg-info"
                                };
                            }
                            <span class="badge @badgeClass">@inv.Status</span>
                        </td>
                        <td>@(new DateTime(inv.ExpiresAt, DateTimeKind.Utc).AddDays(-7).ToString("MMM d, yyyy"))</td>
                        <td>@(new DateTime(inv.ExpiresAt, DateTimeKind.Utc).ToString("MMM d, yyyy"))</td>
                        <td>
                            @if (inv.Status == "Pending")
                            {
                                <form method="post" @formname="@($"resend-{inv.CtrlNbr}")" @onsubmit="ResendInvitation" style="display:inline" data-confirm="Resend this invitation?">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="ActionCtrlNbr" value="@inv.CtrlNbr" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary me-1">
                                        <span class="bi bi-arrow-repeat"></span> Resend
                                    </button>
                                </form>
                                <form method="post" @formname="@($"revoke-{inv.CtrlNbr}")" @onsubmit="RevokeInvitation" style="display:inline" data-confirm="Revoke this invitation?">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="ActionCtrlNbr" value="@inv.CtrlNbr" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <span class="bi bi-x-circle"></span> Revoke
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private IReadOnlyList<InvitationResponse>? invitations;
    private string? errorMessage;
    private string? successMessage;
    private bool showCreateForm;
    private List<string> availableRoles = [];

    [SupplyParameterFromForm]
    private CreateInvitationModel createModel { get; set; } = new();

    [SupplyParameterFromForm(Name = "ActionCtrlNbr")]
    private long? ActionCtrlNbr { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        DetermineAvailableRoles();

        if (AppContext.HasParent)
            await LoadInvitations();
    }

    private void DetermineAvailableRoles()
    {
        var user = HttpContext.User;
        var isSystemAdmin = user.Claims.Any(c => c.Type == "role" && c.Value == "SystemAdmin");
        var isParentAdmin = user.Claims.Any(c => c.Type == "role" && c.Value == "ParentAdmin")
                         || user.Claims.Any(c => c.Type == "parent_role" && c.Value.EndsWith(":ParentAdmin"));

        if (isSystemAdmin || isParentAdmin)
        {
            availableRoles = ["ParentAdmin", "RailroadAdmin", "CraftManager", "CrewManager", "Dispatcher", "PayrollClerk", "ReadOnly"];
        }
        else
        {
            availableRoles = ["CraftManager", "CrewManager", "Dispatcher", "PayrollClerk", "ReadOnly"];
        }
    }

    private async Task LoadInvitations()
    {
        try
        {
            errorMessage = null;
            var response = await InvitationsClient.GetByParentAsync(AppContext.SelectedParentCtrlNbr!.Value);
            invitations = response.Invitations;
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load invitations: {ex.Message}";
        }
    }

    private void ShowCreateForm() => showCreateForm = true;

    private void CancelCreate() => showCreateForm = false;

    private async Task CreateInvitation()
    {
        try
        {
            errorMessage = null;
            successMessage = null;

            await InvitationsClient.CreateAsync(
                createModel.Email,
                AppContext.SelectedParentCtrlNbr!.Value,
                createModel.Role,
                createModel.ExpirationDays);

            successMessage = $"Invitation sent to {createModel.Email}.";
            showCreateForm = false;
            createModel = new();
            await LoadInvitations();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to create invitation: {ex.Message}";
            showCreateForm = true;
        }
    }

    private async Task ResendInvitation()
    {
        if (ActionCtrlNbr is null) return;

        try
        {
            errorMessage = null;
            successMessage = null;

            await InvitationsClient.ResendAsync(ActionCtrlNbr.Value);
            successMessage = "Invitation resent.";
            await LoadInvitations();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to resend invitation: {ex.Message}";
        }
    }

    private async Task RevokeInvitation()
    {
        if (ActionCtrlNbr is null) return;

        try
        {
            errorMessage = null;
            successMessage = null;

            await InvitationsClient.RevokeAsync(ActionCtrlNbr.Value);
            successMessage = "Invitation revoked.";
            await LoadInvitations();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to revoke invitation: {ex.Message}";
        }
    }

    private sealed class CreateInvitationModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required]
        public string Role { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Range(1, 90)]
        public int ExpirationDays { get; set; } = 7;
    }
}
