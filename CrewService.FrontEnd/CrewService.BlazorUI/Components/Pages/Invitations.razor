@page "/admin/invitations"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using CrewService.BlazorUI.Clients
@using CrewService.BlazorUI.Models.Auth
@using CrewService.Presentation

@inherits AppComponentBase

@attribute [Authorize]

@inject InvitationsClient InvitationsClient
@inject TenantConfigClient ConfigClient
@inject AuthorizationClient AuthorizationClient

<PageTitle>Invitations</PageTitle>

<h1>Invitations</h1>

@if (!HasParent && !IsSystemAdmin)
{
    <div class="alert alert-warning">
        <span class="bi bi-exclamation-triangle"></span>
        Please select a parent in the context switcher to manage invitations.
    </div>
}
else
{
    @if (HasParent)
    {
        <p class="text-muted mb-3">Managing invitations for <strong>@SelectedParentName</strong></p>
    }
    else
    {
        <p class="text-muted mb-3">Managing <strong>SystemAdmin</strong> invitations</p>
    }

    <Modal Visible="showCreateForm"
           Title="Create Invitation"
           Icon="bi bi-plus-circle"
           OnClose="() => showCreateForm = false">
        <BodyContent>
            <EditForm Model="createModel" OnValidSubmit="CreateInvitation" id="create-invitation-form">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label fw-semibold">Email Address</label>
                    <InputText @bind-Value="createModel.Email" class="form-control" placeholder="jane@railroad.com" />
                    <ValidationMessage For="() => createModel.Email" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Role</label>
                    <SelectInput TItem="string" TValue="string"
                                 @bind-Value="createModel.Role"
                                 @bind-Value:after="OnRoleChanged"
                                 Items="availableRoles"
                                 ValueSelector="@(r => r)"
                                 TextSelector="@(r => r)"
                                 Placeholder="-- Select Role --"
                                 class="form-select" />
                    <ValidationMessage For="() => createModel.Role" class="text-danger" />
                </div>
                @if (showRailroadDropdown && HasParent)
                {
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Railroad</label>
                        <SelectInput TItem="GroupResponse" TValue="long"
                                     @bind-Value="createModel.RailroadCtrlNbr"
                                     Items="parentRailroads"
                                     ValueSelector="@(rr => rr.CtrlNbr)"
                                     TextSelector="@(rr => rr.Name)"
                                     Placeholder="-- Select Railroad --"
                                     class="form-select" />
                    </div>
                }
                <div class="mb-0">
                    <label class="form-label fw-semibold">Expires In (days)</label>
                    <InputNumber @bind-Value="createModel.ExpirationDays" class="form-control" />
                    <div class="form-text">1–90 days from today</div>
                </div>
            </EditForm>
        </BodyContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="() => showCreateForm = false">Cancel</button>
            <button type="submit" form="create-invitation-form" class="btn btn-primary" disabled="@isSaving">
                <span class="bi bi-send me-1"></span> Send Invitation
            </button>
        </Footer>
    </Modal>

    <SuccessAlert @bind-Message="successMessage" />

    @if (errorMessage is not null)
    {
        <div class="alert alert-danger alert-dismissible" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (invitations is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <ul class="nav nav-tabs mb-3">
            @foreach (var tab in statusTabs)
            {
                var count = GetCountForTab(tab);
                <li class="nav-item">
                    <button class="nav-link @(activeTab == tab ? "active" : "")" @onclick="() => activeTab = tab">
                        @tab
                        <span class="badge rounded-pill @GetTabBadgeClass(tab) ms-1">@count</span>
                    </button>
                </li>
            }
        </ul>

        <DataTable TItem="InvitationResponse" Items="TabFilteredInvitations" Columns="InvitationColumns"
                   SearchFilter="@((i, term) => i.Email.Contains(term, StringComparison.OrdinalIgnoreCase) || i.Role.Contains(term, StringComparison.OrdinalIgnoreCase) || (i.RailroadCtrlNbr > 0 && GetRailroadName(i.RailroadCtrlNbr).Contains(term, StringComparison.OrdinalIgnoreCase)))"
                   SearchPlaceholder="Search by email, role, or railroad..."
                   EmptyMessage="@($"No {activeTab.ToLower()} invitations found.")"
                   DefaultSortColumn="Email">
            <ToolbarContent>
                <button class="btn btn-primary" @onclick="OpenCreateForm">
                    <span class="bi bi-plus-circle"></span> Create Invitation
                </button>
            </ToolbarContent>
            <RowContent Context="inv">
                <td>@inv.Email</td>
                <td>@inv.Role</td>
                <td>@(inv.RailroadCtrlNbr > 0 ? GetRailroadName(inv.RailroadCtrlNbr) : "—")</td>
                <td>@(inv.CreatedAt > 0 ? new DateTime(inv.CreatedAt, DateTimeKind.Utc).ToString("MMM d, yyyy") : "—")</td>
                <td>@FormatStatusDate(inv)</td>
                @if (activeTab == "Pending")
                {
                    <td>
                        <div class="d-flex flex-nowrap gap-1">
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => ResendInvitation(inv.CtrlNbr)">
                                <span class="bi bi-arrow-repeat"></span> Resend
                            </button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => RevokeInvitation(inv.CtrlNbr)">
                                <span class="bi bi-x-circle"></span> Revoke
                            </button>
                        </div>
                    </td>
                }
            </RowContent>
        </DataTable>
    }
}

@code {
    protected override string? FeatureKey => "admin/invitations";

    private IReadOnlyList<InvitationResponse>? invitations;
    private IReadOnlyList<RoleResponse> allSystemRoles = [];
    private bool showCreateForm;
    private CreateInvitationModel createModel = new();
    private List<string> availableRoles = [];
    private List<GroupResponse> parentRailroads = [];
    private bool showRailroadDropdown;
    private HashSet<long> userRailroadCtrlNbrs = [];
    private string activeTab = "Pending";
    private bool IsSystemAdmin => CurrentUser.User?.IsInRole(Roles.SystemAdmin) ?? false;
    private bool CanManageInvitations => HasParent || IsSystemAdmin;

    private static readonly string[] statusTabs = ["Pending", "Accepted", "Expired", "Revoked", "Superseded"];

    private IReadOnlyList<InvitationResponse> TabFilteredInvitations =>
        invitations?.Where(i => i.Status == activeTab).ToList() ?? [];

    private IReadOnlyList<DataTableColumn<InvitationResponse>> InvitationColumns
    {
        get
        {
            var statusDateTitle = activeTab is "Pending" or "Expired" ? "Expires" : activeTab;
            var cols = new List<DataTableColumn<InvitationResponse>>
            {
                new("Email", i => i.Email),
                new("Role", i => i.Role),
                new("Railroad", i => GetRailroadName(i.RailroadCtrlNbr)),
                new("Created", i => (object)i.CreatedAt, sortKey: "Created"),
                new(statusDateTitle, i => (object)GetStatusTicks(i), sortKey: "StatusDate"),
            };

            if (activeTab == "Pending")
                cols.Add(DataTableColumn<InvitationResponse>.Actions());

            return cols;
        }
    }

    private long GetStatusTicks(InvitationResponse inv) => activeTab switch
    {
        "Pending" or "Expired" => inv.ExpiresAt,
        "Accepted" => inv.AcceptedAt,
        "Revoked" => inv.RevokedAt,
        "Superseded" => inv.SupersededAt,
        _ => 0
    };

    private int GetCountForTab(string tab)
    {
        if (invitations is null) return 0;
        return invitations.Count(i => i.Status == tab);
    }

    private static string GetTabBadgeClass(string tab) => tab switch
    {
        "Pending" => "bg-warning text-dark",
        "Accepted" => "bg-success",
        "Expired" => "bg-secondary",
        "Revoked" => "bg-danger",
        "Superseded" => "bg-info",
        _ => "bg-secondary"
    };

    private string FormatStatusDate(InvitationResponse inv)
    {
        var ticks = activeTab switch
        {
            "Pending" or "Expired" => inv.ExpiresAt,
            "Accepted" => inv.AcceptedAt,
            "Revoked" => inv.RevokedAt,
            "Superseded" => inv.SupersededAt,
            _ => 0
        };
        return ticks > 0 ? new DateTime(ticks, DateTimeKind.Utc).ToString("MMM d, yyyy") : "—";
    }

    protected override async Task LoadDataAsync()
    {
        await LoadSystemRoles();
        DetermineAvailableRoles();

        if (HasParent)
        {
            await LoadParentRailroads();
            await LoadInvitations();
        }
        else if (IsSystemAdmin)
        {
            await LoadInvitations();
        }
    }

    protected override async Task OnAppContextChangedAsync()
    {
        DetermineAvailableRoles();

        if (HasParent)
        {
            await LoadParentRailroads();
            await LoadInvitations();
        }
        else if (IsSystemAdmin)
        {
            parentRailroads = [];
            await LoadInvitations();
        }
        else
        {
            invitations = null;
            parentRailroads = [];
        }
    }

    private void DetermineAvailableRoles()
    {
        if (!HasParent && IsSystemAdmin)
        {
            availableRoles = [Roles.SystemAdmin];
            userRailroadCtrlNbrs = [];
        }
        else
        {
            var (roles, railroads) = InvitationRoleResolver.Resolve(CurrentUser.User!, allSystemRoles);
            availableRoles = [.. roles];
            userRailroadCtrlNbrs = railroads;
        }
    }

    private async Task LoadSystemRoles()
    {
        try
        {
            var response = await AuthorizationClient.GetAllRolesAsync();
            allSystemRoles = response.Roles;
        }
        catch
        {
            allSystemRoles = [];
        }
    }

    private async Task LoadInvitations()
    {
        try
        {
            errorMessage = null;
            var parentCtrlNbr = SelectedParentCtrlNbr ?? 0;
            var response = await InvitationsClient.GetByParentAsync(parentCtrlNbr);
            invitations = response.Invitations;
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load invitations: {ex.Message}";
        }
    }

    private async Task LoadParentRailroads()
    {
        try
        {
            var response = await ConfigClient.GetGroupsByTypeNameAsync("Railroad", SelectedParentCtrlNbr!.Value);
            parentRailroads = userRailroadCtrlNbrs.Count > 0
                ? [.. response.Groups.Where(rr => userRailroadCtrlNbrs.Contains(rr.CtrlNbr))]
                : [.. response.Groups];
        }
        catch
        {
            parentRailroads = [];
        }
    }

    private void OnRoleChanged()
    {
        showRailroadDropdown = !string.IsNullOrEmpty(createModel.Role)
            && Roles.RequiresRailroad(createModel.Role);

        if (!showRailroadDropdown)
            createModel.RailroadCtrlNbr = 0;
    }

    private void OpenCreateForm()
    {
        createModel = new();
        showRailroadDropdown = false;
        showCreateForm = true;
    }

    private string GetRailroadName(long ctrlNbr)
    {
        return parentRailroads.FirstOrDefault(rr => rr.CtrlNbr == ctrlNbr)?.Name ?? ctrlNbr.ToString();
    }

    private async Task CreateInvitation()
    {
        try
        {
            isSaving = true;
            errorMessage = null;
            successMessage = null;

            var parentCtrlNbr = SelectedParentCtrlNbr ?? 0;

            await InvitationsClient.CreateAsync(
                createModel.Email,
                parentCtrlNbr,
                createModel.Role,
                createModel.ExpirationDays,
                createModel.RailroadCtrlNbr);

            successMessage = $"Invitation sent to {createModel.Email}.";
            showCreateForm = false;
            showRailroadDropdown = false;
            createModel = new();
            await LoadInvitations();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to create invitation: {ex.Message}";
            showCreateForm = true;
        }
        finally { isSaving = false; }
    }

    private async Task ResendInvitation(long ctrlNbr)
    {
        try
        {
            errorMessage = null;
            successMessage = null;

            await InvitationsClient.ResendAsync(ctrlNbr);
            successMessage = "Invitation resent.";
            await LoadInvitations();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to resend invitation: {ex.Message}";
        }
    }

    private async Task RevokeInvitation(long ctrlNbr)
    {
        try
        {
            errorMessage = null;
            successMessage = null;

            await InvitationsClient.RevokeAsync(ctrlNbr);
            successMessage = "Invitation revoked.";
            await LoadInvitations();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to revoke invitation: {ex.Message}";
        }
    }

    private sealed class CreateInvitationModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required]
        public string Role { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Range(1, 90)]
        public int ExpirationDays { get; set; } = 7;

        public long RailroadCtrlNbr { get; set; }
    }
}
