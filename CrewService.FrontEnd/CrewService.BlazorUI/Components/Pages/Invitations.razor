@page "/admin/invitations"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using CrewService.BlazorUI.Clients
@using CrewService.BlazorUI.Services
@using CrewService.Presentation

@attribute [Authorize(Roles = "SystemAdmin,ParentAdmin,RailroadAdmin")]

@inject InvitationsClient InvitationsClient
@inject AppContextService AppContext

<PageTitle>Invitations</PageTitle>

<h1>Invitations</h1>

@if (!AppContext.HasParent)
{
    <div class="alert alert-warning">
        <span class="bi bi-exclamation-triangle"></span>
        Please select a parent in the context switcher to manage invitations.
    </div>
}
else
{
    <p class="text-muted mb-3">Managing invitations for <strong>@AppContext.SelectedParentName</strong></p>

    <div class="mb-3">
        <button class="btn btn-primary" @onclick="() => showCreateForm = true">
            <span class="bi bi-plus-circle"></span> Create Invitation
        </button>
    </div>

    @if (showCreateForm)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">Create Invitation</h5>
                <EditForm Model="createModel" OnValidSubmit="CreateInvitation">
                    <DataAnnotationsValidator />
                    <div class="row g-3 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label">Email</label>
                            <InputText @bind-Value="createModel.Email" class="form-control" placeholder="jane@railroad.com" />
                            <ValidationMessage For="() => createModel.Email" class="text-danger" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Role</label>
                            <InputSelect @bind-Value="createModel.Role" class="form-select">
                                <option value="">-- Select Role --</option>
                                @foreach (var role in availableRoles)
                                {
                                    <option value="@role">@role</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => createModel.Role" class="text-danger" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Expires (days)</label>
                            <InputNumber @bind-Value="createModel.ExpirationDays" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-success me-2">Send Invitation</button>
                            <button type="button" class="btn btn-secondary" @onclick="() => showCreateForm = false">Cancel</button>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    @if (successMessage is not null)
    {
        <div class="alert alert-success alert-dismissible" role="alert">
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    @if (errorMessage is not null)
    {
        <div class="alert alert-danger alert-dismissible" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (invitations is null)
    {
        <p><em>Loading...</em></p>
    }
    else if (invitations.Count == 0)
    {
        <p>No invitations found for this parent.</p>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Expires</th>
                    <th style="width: 180px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var inv in invitations)
                {
                    <tr>
                        <td>@inv.Email</td>
                        <td>@inv.Role</td>
                        <td>
                            @{
                                var badgeClass = inv.Status switch
                                {
                                    "Pending" => "bg-warning text-dark",
                                    "Accepted" => "bg-success",
                                    "Expired" => "bg-secondary",
                                    "Revoked" => "bg-danger",
                                    _ => "bg-info"
                                };
                            }
                            <span class="badge @badgeClass">@inv.Status</span>
                        </td>
                        <td>@(new DateTime(inv.ExpiresAt, DateTimeKind.Utc).AddDays(-7).ToString("MMM d, yyyy"))</td>
                        <td>@(new DateTime(inv.ExpiresAt, DateTimeKind.Utc).ToString("MMM d, yyyy"))</td>
                        <td>
                            @if (inv.Status == "Pending")
                            {
                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => ResendInvitation(inv.CtrlNbr)">
                                    <span class="bi bi-arrow-repeat"></span> Resend
                                </button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => RevokeInvitation(inv.CtrlNbr)">
                                    <span class="bi bi-x-circle"></span> Revoke
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private IReadOnlyList<InvitationResponse>? invitations;
    private string? errorMessage;
    private string? successMessage;
    private bool showCreateForm;
    private CreateInvitationModel createModel = new();
    private List<string> availableRoles = [];

    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await DetermineAvailableRoles();

        if (AppContext.HasParent)
            await LoadInvitations();
    }

    private async Task DetermineAvailableRoles()
    {
        var authState = await AuthStateTask;
        var user = authState.User;

        var isSystemAdmin = user.IsInRole("SystemAdmin");
        var isParentAdmin = user.IsInRole("ParentAdmin")
                         || user.Claims.Any(c => c.Type == "parent_role" && c.Value.EndsWith(":ParentAdmin"));

        if (isSystemAdmin || isParentAdmin)
        {
            availableRoles = ["ParentAdmin", "RailroadAdmin", "CraftManager", "CrewManager", "Dispatcher", "PayrollClerk", "ReadOnly"];
        }
        else
        {
            availableRoles = ["CraftManager", "CrewManager", "Dispatcher", "PayrollClerk", "ReadOnly"];
        }
    }

    private async Task LoadInvitations()
    {
        try
        {
            errorMessage = null;
            var response = await InvitationsClient.GetByParentAsync(AppContext.SelectedParentCtrlNbr!.Value);
            invitations = response.Invitations;
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load invitations: {ex.Message}";
        }
    }

    private async Task CreateInvitation()
    {
        try
        {
            errorMessage = null;
            successMessage = null;

            await InvitationsClient.CreateAsync(
                createModel.Email,
                AppContext.SelectedParentCtrlNbr!.Value,
                createModel.Role,
                createModel.ExpirationDays);

            successMessage = $"Invitation sent to {createModel.Email}.";
            showCreateForm = false;
            createModel = new();
            await LoadInvitations();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to create invitation: {ex.Message}";
            showCreateForm = true;
        }
    }

    private async Task ResendInvitation(long ctrlNbr)
    {
        try
        {
            errorMessage = null;
            successMessage = null;

            await InvitationsClient.ResendAsync(ctrlNbr);
            successMessage = "Invitation resent.";
            await LoadInvitations();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to resend invitation: {ex.Message}";
        }
    }

    private async Task RevokeInvitation(long ctrlNbr)
    {
        try
        {
            errorMessage = null;
            successMessage = null;

            await InvitationsClient.RevokeAsync(ctrlNbr);
            successMessage = "Invitation revoked.";
            await LoadInvitations();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to revoke invitation: {ex.Message}";
        }
    }

    private sealed class CreateInvitationModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required]
        public string Role { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Range(1, 90)]
        public int ExpirationDays { get; set; } = 7;
    }
}
