@page "/parents"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using CrewService.BlazorUI.Clients
@using CrewService.Presentation

@inherits AppComponentBase

@attribute [Authorize]

@inject ParentsClient ParentsClient

<PageTitle>Parents</PageTitle>

<h1>Parents</h1>

<Modal Visible="showSaveModal"
       Icon="@(editCtrlNbr > 0 ? "bi bi-pencil" : "bi bi-plus-circle")"
       OnClose="CloseSaveModal">
    <BodyContent>
        <EditForm Model="saveModel" OnValidSubmit="OnSave" id="save-parent-form">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label class="form-label fw-semibold">Name</label>
                <InputText @bind-Value="saveModel.Name" class="form-control" placeholder="Parent Name" />
                <ValidationMessage For="() => saveModel.Name" class="text-danger" />
            </div>
        </EditForm>
    </BodyContent>
    <Footer>
        <button type="button" class="btn btn-outline-secondary" @onclick="CloseSaveModal">Cancel</button>
        <button type="submit" form="save-parent-form" class="btn btn-primary">
            <span class="bi bi-check-circle me-1"></span> @(editCtrlNbr > 0 ? "Update" : "Create")
        </button>
    </Footer>
</Modal>

<Modal Visible="showDeleteModal" Title="Confirm Delete" Icon="bi bi-exclamation-triangle"
       OnClose="() => showDeleteModal = false" Size="sm">
    <BodyContent>
        <p>Are you sure you want to delete <strong>@deleteParentName</strong>?</p>
    </BodyContent>
    <Footer>
        <button type="button" class="btn btn-outline-secondary" @onclick="() => showDeleteModal = false">Cancel</button>
        <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">
            <span class="bi bi-trash me-1"></span> Delete
        </button>
    </Footer>
</Modal>

@if (successMessage is not null)
{
    <div class="alert alert-success alert-dismissible" role="alert">
        @successMessage
        <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
    </div>
}

@if (errorMessage is not null)
{
    <div class="alert alert-danger alert-dismissible" role="alert">
        @errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
    </div>
}

<DataTable TItem="GetParentResponse" Items="parents" Columns="parentColumns"
           SearchFilter="@((p, term) => p.Name.Contains(term, StringComparison.OrdinalIgnoreCase))"
           SearchPlaceholder="Search by name..."
           EmptyMessage="No parents found."
           DefaultSortColumn="Name">
    <ToolbarContent>
        <button class="btn btn-primary" @onclick="OpenCreateModal">
            <span class="bi bi-plus-circle"></span> Create Parent
        </button>
    </ToolbarContent>
    <RowContent Context="parent">
        <td>
            <a href="/parents/@parent.CtrlNbr" class="text-decoration-none">@parent.Name</a>
        </td>
        <td>@parent.Railroads.Count</td>
        <td>
            <div class="d-flex gap-1">
                <button class="btn btn-sm btn-outline-primary flex-fill" @onclick="() => OpenEditModal(parent)">
                    <span class="bi bi-pencil"></span> Edit
                </button>
                <button class="btn btn-sm btn-outline-danger flex-fill" @onclick="() => OpenDeleteModal(parent)">
                    <span class="bi bi-trash"></span> Delete
                </button>
            </div>
        </td>
    </RowContent>
</DataTable>

@code {
    protected override string? FeatureKey => "parents";

    private IReadOnlyList<GetParentResponse>? parents;

    private static readonly IReadOnlyList<DataTableColumn<GetParentResponse>> parentColumns =
    [
        new("Name", p => p.Name),
        new("Railroads", p => (object)p.Railroads.Count),
        DataTableColumn<GetParentResponse>.Actions()
    ];

    private bool showSaveModal;
    private long editCtrlNbr;
    private ParentInputModel saveModel = new();

    private bool showDeleteModal;
    private long deleteCtrlNbr;
    private string deleteParentName = "";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await LoadParents();
    }

    private async Task LoadParents()
    {
        try
        {
            var response = await ParentsClient.GetAllAsync();
            parents = response.Parent;
        }
        catch
        {
            parents = [];
        }
    }

    private void OpenCreateModal()
    {
        editCtrlNbr = 0;
        saveModel = new();
        showSaveModal = true;
    }

    private void OpenEditModal(GetParentResponse parent)
    {
        editCtrlNbr = parent.CtrlNbr;
        saveModel = new() { Name = parent.Name };
        showSaveModal = true;
    }

    private void CloseSaveModal()
    {
        showSaveModal = false;
        editCtrlNbr = 0;
        saveModel = new();
    }

    private void OpenDeleteModal(GetParentResponse parent)
    {
        deleteCtrlNbr = parent.CtrlNbr;
        deleteParentName = parent.Name;
        showDeleteModal = true;
    }

    private async Task OnSave()
    {
        try
        {
            errorMessage = null;
            successMessage = null;

            if (editCtrlNbr > 0)
            {
                await ParentsClient.UpdateAsync(editCtrlNbr, saveModel.Name ?? string.Empty);
                successMessage = "Parent updated.";
            }
            else
            {
                await ParentsClient.CreateAsync(saveModel.Name ?? string.Empty);
                successMessage = "Parent created.";
            }

            CloseSaveModal();
            await LoadParents();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save parent: {ex.Message}";
        }
    }

    private async Task ConfirmDelete()
    {
        try
        {
            errorMessage = null;
            successMessage = null;

            await ParentsClient.DeleteAsync(deleteCtrlNbr);
            successMessage = "Parent deleted.";
            showDeleteModal = false;
            await LoadParents();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to delete parent: {ex.Message}";
            showDeleteModal = false;
        }
    }

    private sealed class ParentInputModel
    {
        [Required(ErrorMessage = "Name is required.")]
        [StringLength(100, MinimumLength = 1)]
        public string? Name { get; set; }
    }
}
