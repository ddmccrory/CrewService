@page "/parents"

@using Microsoft.AspNetCore.Authorization
@using CrewService.BlazorUI.Clients
@using CrewService.Presentation

@attribute [Authorize]

@inject ParentsClient ParentsClient
@inject NavigationManager NavigationManager

<PageTitle>Parents</PageTitle>

<h1>Parents</h1>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="ShowCreateForm">
        <span class="bi bi-plus-circle"></span> New Parent
    </button>
</div>

@if (showCreateForm)
{
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Create Parent</h5>
            <EditForm Model="createModel" OnValidSubmit="CreateParent" FormName="createParent">
                <DataAnnotationsValidator />
                <div class="form-floating mb-3">
                    <InputText @bind-Value="createModel.Name" class="form-control" placeholder="Parent Name" />
                    <label>Name</label>
                    <ValidationMessage For="() => createModel.Name" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-success me-2">Create</button>
                <button type="button" class="btn btn-secondary" @onclick="CancelCreate">Cancel</button>
            </EditForm>
        </div>
    </div>
}

@if (errorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (parents is null)
{
    <p><em>Loading...</em></p>
}
else if (parents.Count == 0)
{
    <p>No parents found.</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Name</th>
                <th>Railroads</th>
                <th style="width: 120px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var parent in parents)
            {
                <tr>
                    <td>
                        <a href="/parents/@parent.CtrlNbr">@parent.Name</a>
                    </td>
                    <td>@parent.Railroads.Count</td>
                    <td>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteParent(parent.CtrlNbr)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<GetParentResponse>? parents;
    private string? errorMessage;
    private bool showCreateForm;
    private CreateParentModel createModel = new();

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadParents();
    }

    private async Task LoadParents()
    {
        try
        {
            errorMessage = null;
            var response = await ParentsClient.GetAllAsync();
            parents = response.Parent;
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load parents: {ex.Message}";
        }
    }

    private void ShowCreateForm() => showCreateForm = true;
    private void CancelCreate()
    {
        showCreateForm = false;
        createModel = new();
    }

    private async Task CreateParent()
    {
        try
        {
            errorMessage = null;
            await ParentsClient.CreateAsync(createModel.Name);
            showCreateForm = false;
            createModel = new();
            await LoadParents();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to create parent: {ex.Message}";
        }
    }

    private async Task DeleteParent(long ctrlNbr)
    {
        try
        {
            errorMessage = null;
            await ParentsClient.DeleteAsync(ctrlNbr);
            await LoadParents();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to delete parent: {ex.Message}";
        }
    }

    private sealed class CreateParentModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.StringLength(100, MinimumLength = 1)]
        public string Name { get; set; } = "";
    }
}
