@page "/notifications/review"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using CrewService.BlazorUI.Clients
@using CrewService.Presentation

@inherits AppComponentBase

@attribute [Authorize]

@inject NotificationsClient NotificationsClient

<PageTitle>Notifications — Crew Service</PageTitle>

<h1>Notifications</h1>
<p class="text-muted mb-3">Railroad notification feed for managerial review (reference only).</p>

@if (errorMessage is not null)
{
    <div class="alert alert-danger alert-dismissible" role="alert">
        @errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
    </div>
}

<DataTable TItem="NotificationResponse"
           Items="DisplayedNotifications"
           Columns="columns"
           SearchFilter="@((n, term) => n.Message.Contains(term, StringComparison.OrdinalIgnoreCase) || NotificationCategories.Label(n.Category).Contains(term, StringComparison.OrdinalIgnoreCase) || n.EmployeeName.Contains(term, StringComparison.OrdinalIgnoreCase))"
           SearchPlaceholder="Search by message, category, or employee..."
           EmptyMessage="No notifications."
           DefaultSortColumn="Date"
           DefaultSortAscending="false">
    <ToolbarContent>
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="showAccepted" @bind="showAccepted" />
            <label class="form-check-label" for="showAccepted">Show accepted</label>
        </div>
    </ToolbarContent>
    <RowContent Context="n">
        <td>@FormatDisplayLocal(n.CreatedAtLocal)</td>
        <td>@n.EmployeeName</td>
        <td><span class="badge bg-secondary">@NotificationCategories.Label(n.Category)</span></td>
        <td>@n.Message</td>
        <td>@FormatDisplayLocal(n.AcceptedAtLocal)</td>
        <td>
            @if (!n.RequiresAcknowledgement)
            {
                <span class="text-muted">—</span>
            }
            else if (n.IsAcknowledged)
            {
                <span class="badge bg-success">Accepted</span>
            }
            else
            {
                <span class="badge bg-warning text-dark">Open</span>
            }
        </td>
    </RowContent>
</DataTable>

@code {
    protected override string? FeatureKey => "employees/notifications";

    private static readonly IReadOnlyList<DataTableColumn<NotificationResponse>> columns =
    [
        new("Date", n => n.CreatedAt.ToDateTime()),
        new("Employee", n => n.EmployeeName),
        new("Category", n => NotificationCategories.Label(n.Category)),
        new("Message", n => n.Message),
        new("Accepted", n => n.AcceptedAt?.ToDateTime()),
        new("Status", n => n.RequiresAcknowledgement ? (n.IsAcknowledged ? "Accepted" : "Open") : ""),
    ];

    private IReadOnlyList<NotificationResponse> notifications = [];
    private bool showAccepted;

    private IReadOnlyList<NotificationResponse> DisplayedNotifications =>
        showAccepted
            ? notifications
            : [.. notifications.Where(n => n.RequiresAcknowledgement && !n.IsAcknowledged)];

    protected override async Task LoadDataAsync()
    {
        RequireFeatureAccess();
        try
        {
            var response = await NotificationsClient.GetRailroadNotificationsAsync(SelectedRailroadCtrlNbr ?? 0);
            notifications = [.. response.Notifications];
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load notifications: {ex.Message}";
            notifications = [];
        }
    }

    protected override Task OnAppContextChangedAsync() => LoadDataAsync();
}
