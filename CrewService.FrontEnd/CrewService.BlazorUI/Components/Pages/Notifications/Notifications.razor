@page "/notifications"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using CrewService.BlazorUI.Clients
@using CrewService.Presentation

@inherits AppComponentBase

@attribute [Authorize]

@inject NotificationsClient NotificationsClient

<PageTitle>Notifications</PageTitle>

<h1>Notifications</h1>

@if (!CurrentUser.IsEmployee)
{
    <div class="alert alert-info">
        <span class="bi bi-info-circle"></span>
        Notifications are only available for employee accounts.
    </div>
}
else
{
    <p class="text-muted mb-3">Your notification history. Open notices must be reviewed at sign-in.</p>

    @if (errorMessage is not null)
    {
        <div class="alert alert-danger alert-dismissible" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <DataTable TItem="NotificationResponse"
               Items="notifications"
               Columns="columns"
               SearchFilter="@((n, term) => n.Message.Contains(term, StringComparison.OrdinalIgnoreCase) || NotificationCategories.Label(n.Category).Contains(term, StringComparison.OrdinalIgnoreCase))"
               SearchPlaceholder="Search by message or category..."
               EmptyMessage="You have no notifications."
               DefaultSortColumn="Date"
               DefaultSortAscending="false">
        <RowContent Context="n">
            <td>@FormatLocalDateTime(n.CreatedAtLocal)</td>
            <td><span class="badge bg-secondary">@NotificationCategories.Label(n.Category)</span></td>
            <td>@n.Message</td>
            <td>@FormatLocalDateTime(n.EffectiveAtLocal)</td>
            <td>
                @if (!n.RequiresAcknowledgement)
                {
                    <span class="text-muted">—</span>
                }
                else if (n.IsAcknowledged)
                {
                    <span class="badge bg-success">Accepted</span>
                }
                else
                {
                    <span class="badge bg-warning text-dark">Open</span>
                }
            </td>
        </RowContent>
    </DataTable>
}

@code {
    private static readonly IReadOnlyList<DataTableColumn<NotificationResponse>> columns =
    [
        new("Date", n => n.CreatedAt.ToDateTime()),
        new("Category", n => NotificationCategories.Label(n.Category)),
        new("Message", n => n.Message),
        new("Effective", n => n.EffectiveAt?.ToDateTime()),
        new("Status", n => n.RequiresAcknowledgement ? (n.IsAcknowledged ? "Accepted" : "Open") : ""),
    ];

    private IReadOnlyList<NotificationResponse> notifications = [];

    protected override async Task LoadDataAsync()
    {
        if (!CurrentUser.IsEmployee) { notifications = []; return; }
        try
        {
            var response = await NotificationsClient.GetMyNotificationsAsync();
            notifications = [.. response.Notifications];
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load notifications: {ex.Message}";
            notifications = [];
        }
    }
}
