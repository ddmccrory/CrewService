@page "/config/group-types/{CtrlNbr:long}"

@using Microsoft.AspNetCore.Authorization
@using CrewService.BlazorUI.Clients
@using CrewService.Presentation

@attribute [Authorize]

@inject TenantConfigClient ConfigClient
@inject NavigationManager NavigationManager

<PageTitle>Group Type Detail</PageTitle>

@if (errorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (groupType is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/config/group-types">Group Types</a></li>
            <li class="breadcrumb-item active" aria-current="page">@groupType.Name</li>
        </ol>
    </nav>

    @if (!isEditing)
    {
        <h1>@groupType.Name</h1>
        <p class="text-muted">@groupType.Description</p>
        @if (groupType.IsWorkArea)
        {
            <span class="badge bg-success mb-2">Work Area</span>
        }
        <div class="mb-3">
            <button class="btn btn-sm btn-outline-primary me-2" @onclick="StartEdit">Edit</button>
            <button class="btn btn-sm btn-outline-danger" @onclick="Delete">Delete</button>
        </div>
    }
    else
    {
        <EditForm Model="editModel" OnValidSubmit="SaveEdit" FormName="editGroupType">
            <DataAnnotationsValidator />
            <div class="row">
                <div class="col-md-4">
                    <div class="form-floating mb-3">
                        <InputText @bind-Value="editModel.Name" class="form-control" placeholder="Name" />
                        <label>Name</label>
                        <ValidationMessage For="() => editModel.Name" class="text-danger" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating mb-3">
                        <InputText @bind-Value="editModel.Description" class="form-control" placeholder="Description" />
                        <label>Description</label>
                    </div>
                </div>
                <div class="col-md-2 d-flex align-items-center">
                    <div class="form-check">
                        <InputCheckbox @bind-Value="editModel.IsWorkArea" class="form-check-input" id="editIsWorkArea" />
                        <label class="form-check-label" for="editIsWorkArea">Work Area</label>
                    </div>
                </div>
            </div>
            <button type="submit" class="btn btn-success me-2">Save</button>
            <button type="button" class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
        </EditForm>
    }

    <hr />

    <h3>Groups</h3>

    <div class="mb-3">
        <button class="btn btn-sm btn-primary" @onclick="ShowAddGroup">
            <span class="bi bi-plus-circle"></span> Add Group
        </button>
    </div>

    @if (showAddGroupForm)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">Add Group</h5>
                <EditForm Model="addGroupModel" OnValidSubmit="AddGroup" FormName="addGroup">
                    <DataAnnotationsValidator />
                    <div class="row">
                        <div class="col-md-5">
                            <div class="form-floating mb-3">
                                <InputText @bind-Value="addGroupModel.Name" class="form-control" placeholder="Group Name" />
                                <label>Name</label>
                                <ValidationMessage For="() => addGroupModel.Name" class="text-danger" />
                            </div>
                        </div>
                        <div class="col-md-5">
                            <div class="form-floating mb-3">
                                <InputSelect @bind-Value="addGroupModel.ParentGroupCtrlNbr" class="form-select">
                                    <option value="0">(No parent — top level)</option>
                                    @if (groups is not null)
                                    {
                                        @foreach (var g in groups)
                                        {
                                            <option value="@g.CtrlNbr">@g.Name</option>
                                        }
                                    }
                                </InputSelect>
                                <label>Parent Group</label>
                            </div>
                        </div>
                        <div class="col-md-2 d-flex align-items-center">
                            <div class="form-check">
                                <InputCheckbox @bind-Value="addGroupModel.IsWorkArea" class="form-check-input" id="addIsWorkArea" />
                                <label class="form-check-label" for="addIsWorkArea">Work Area</label>
                            </div>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-success me-2">Add</button>
                    <button type="button" class="btn btn-secondary" @onclick="CancelAddGroup">Cancel</button>
                </EditForm>
            </div>
        </div>
    }

    @if (groups is null)
    {
        <p><em>Loading groups...</em></p>
    }
    else if (groups.Count == 0)
    {
        <p class="text-muted">No groups defined for this type yet.</p>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Parent Group</th>
                    <th>Work Area</th>
                    <th style="width: 180px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var g in groups)
                {
                    <tr>
                        <td>
                            <a href="/config/groups/@g.CtrlNbr">@g.Name</a>
                        </td>
                        <td>
                            @if (g.ParentGroupCtrlNbr > 0)
                            {
                                var parentName = groups.FirstOrDefault(x => x.CtrlNbr == g.ParentGroupCtrlNbr)?.Name ?? g.ParentGroupCtrlNbr.ToString();
                                @parentName
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            @if (g.IsWorkArea)
                            {
                                <span class="badge bg-success">Yes</span>
                            }
                        </td>
                        <td>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteGroup(g.CtrlNbr)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    [Parameter]
    public long CtrlNbr { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private GroupTypeResponse? groupType;
    private IReadOnlyList<GroupResponse>? groups;
    private string? errorMessage;
    private bool isEditing;
    private GroupTypeEditModel editModel = new();
    private bool showAddGroupForm;
    private AddGroupModel addGroupModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadGroupType();
        await LoadGroups();
    }

    private async Task LoadGroupType()
    {
        try
        {
            errorMessage = null;
            groupType = await ConfigClient.GetGroupTypeAsync(CtrlNbr);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load group type: {ex.Message}";
        }
    }

    private async Task LoadGroups()
    {
        try
        {
            var response = await ConfigClient.GetGroupTreeAsync();
            groups = response.Groups.Where(g => g.GroupTypeCtrlNbr == CtrlNbr).ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load groups: {ex.Message}";
        }
    }

    private void StartEdit()
    {
        editModel = new()
        {
            Name = groupType!.Name,
            Description = groupType.Description,
            IsWorkArea = groupType.IsWorkArea
        };
        isEditing = true;
    }

    private void CancelEdit() => isEditing = false;

    private async Task SaveEdit()
    {
        try
        {
            errorMessage = null;
            await ConfigClient.UpdateGroupTypeAsync(CtrlNbr, editModel.Name, editModel.Description, editModel.IsWorkArea);
            isEditing = false;
            await LoadGroupType();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to update group type: {ex.Message}";
        }
    }

    private async Task Delete()
    {
        try
        {
            await ConfigClient.DeleteGroupTypeAsync(CtrlNbr);
            NavigationManager.NavigateTo("/config/group-types");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to delete group type: {ex.Message}";
        }
    }

    private void ShowAddGroup() => showAddGroupForm = true;
    private void CancelAddGroup()
    {
        showAddGroupForm = false;
        addGroupModel = new();
    }

    private async Task AddGroup()
    {
        try
        {
            errorMessage = null;
            await ConfigClient.CreateGroupAsync(CtrlNbr, addGroupModel.Name, addGroupModel.ParentGroupCtrlNbr, addGroupModel.IsWorkArea);
            showAddGroupForm = false;
            addGroupModel = new();
            await LoadGroups();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to create group: {ex.Message}";
        }
    }

    private async Task DeleteGroup(long ctrlNbr)
    {
        try
        {
            errorMessage = null;
            await ConfigClient.DeleteGroupAsync(ctrlNbr);
            await LoadGroups();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to delete group: {ex.Message}";
        }
    }

    private sealed class GroupTypeEditModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.StringLength(100, MinimumLength = 1)]
        public string Name { get; set; } = "";

        public string Description { get; set; } = "";
        public bool IsWorkArea { get; set; }
    }

    private sealed class AddGroupModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.StringLength(100, MinimumLength = 1)]
        public string Name { get; set; } = "";

        public long ParentGroupCtrlNbr { get; set; }
        public bool IsWorkArea { get; set; }
    }
}
