@page "/config/group-types/{CtrlNbr:long}"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using CrewService.BlazorUI.Clients
@using CrewService.BlazorUI.Models.Entities
@using CrewService.Presentation

@inherits AppComponentBase

@attribute [Authorize]

@inject TenantConfigClient ConfigClient

<PageTitle>Group Type Detail</PageTitle>

@if (groupType is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <BackNavButton Text="Group Types" OnClick="NavigateBack" />

    <h1>@groupType.Name</h1>
    <p class="text-muted">@groupType.Description</p>
    @if (groupType.IsWorkArea)
    {
        <span class="badge bg-success mb-2">Work Area</span>
    }
    <SuccessAlert @bind-Message="successMessage" />

    @if (errorMessage is not null)
    {
        <div class="alert alert-danger alert-dismissible" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <hr />

    <TabPanel Tabs="tabs" @bind-ActiveTab="activeTab" />

    @if (activeTab == "groups")
    {
    @* ?????????????????????????????????????????????????????????????????? *@
    @* Groups Section                                                    *@
    @* ?????????????????????????????????????????????????????????????????? *@

    @* ?? Create / Edit Group Modal ?? *@
    <Modal Visible="showGroupSaveModal" Title="@(editGroupCtrlNbr > 0 ? "Edit Group" : "Add Group")"
           Icon="@(editGroupCtrlNbr > 0 ? "bi bi-pencil" : "bi bi-plus-circle")"
           OnClose="CloseGroupSaveModal">
        <BodyContent>
            <EditForm Model="groupSaveModel" OnValidSubmit="OnSaveGroup" id="save-group-form">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label fw-semibold">Code</label>
                    <InputText @bind-Value="groupSaveModel.Code" class="form-control" placeholder="Short identifier (e.g. railroad mark)" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Name</label>
                    <InputText @bind-Value="groupSaveModel.Name" class="form-control" placeholder="Group Name" />
                    <ValidationMessage For="() => groupSaveModel.Name" class="text-danger" />
                </div>
                @if (parentTypeGroups is not null && parentTypeGroups.Count > 0)
                {
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Parent Group@(string.IsNullOrEmpty(parentGroupTypeName) ? "" : $" ({parentGroupTypeName})")</label>
                        <InputSelect @bind-Value="groupSaveModel.ParentGroupCtrlNbr" class="form-select" disabled="@parentGroupLocked">
                            @if (!hasDefinedParentType)
                            {
                                <option value="0">(No parent)</option>
                            }
                            @foreach (var g in parentTypeGroups)
                            {
                                <option value="@g.CtrlNbr">@g.Name</option>
                            }
                        </InputSelect>
                    </div>
                }
                <div class="form-check form-switch form-check-reverse mb-3">
                    <InputCheckbox @bind-Value="groupSaveModel.IsWorkArea" class="form-check-input" id="groupIsWorkArea" disabled />
                    <label class="form-check-label text-muted" for="groupIsWorkArea">Work Area (inherited from group type)</label>
                </div>
                @if (groupSaveModel.Attributes.Count > 0)
                {
                    <hr />
                    <h6 class="fw-semibold">Attributes</h6>
                    @foreach (var attr in groupSaveModel.Attributes)
                    {
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                @attr.AttributeName
                                @if (attr.IsRequired)
                                {
                                    <span class="text-danger">*</span>
                                }
                            </label>
                            @if (attr.DataType == "bool")
                            {
                                <div class="form-check form-switch">
                                    <input type="checkbox" class="form-check-input"
                                           checked="@(attr.Value == "true")"
                                           @onchange="@(e => attr.Value = e.Value is true ? "true" : "false")" />
                                </div>
                            }
                            else
                            {
                                <input type="@(attr.DataType switch { "int" or "decimal" => "number", "date" => "date", "time" => "time", _ => "text" })"
                                       class="form-control"
                                       value="@attr.Value"
                                       @onchange="@(e => attr.Value = e.Value?.ToString() ?? string.Empty)"
                                       placeholder="@(string.IsNullOrEmpty(attr.DefaultValue) ? attr.AttributeName : $"Default: {attr.DefaultValue}")" />
                            }
                        </div>
                    }
                }
            </EditForm>
        </BodyContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="CloseGroupSaveModal">Cancel</button>
            <button type="submit" form="save-group-form" class="btn btn-primary" disabled="@isSaving">
                <span class="bi bi-check-circle me-1"></span> @(editGroupCtrlNbr > 0 ? "Update" : "Add")
            </button>
        </Footer>
    </Modal>

    @* ?? Delete Group Modal ?? *@
    <Modal Visible="showGroupDeleteModal" Title="Confirm Delete" Icon="bi bi-exclamation-triangle"
           OnClose="() => showGroupDeleteModal = false" Size="sm">
        <BodyContent>
            <p>Are you sure you want to delete <strong>@deleteGroupName</strong>?</p>
        </BodyContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="() => showGroupDeleteModal = false">Cancel</button>
            <button type="button" class="btn btn-danger" disabled="@isSaving" @onclick="ConfirmDeleteGroup">
                <span class="bi bi-trash me-1"></span> Delete
            </button>
        </Footer>
    </Modal>

    <DataTable TItem="GroupResponse" Items="groups" Columns="groupColumns"
               SearchFilter="@((g, term) => g.Name.Contains(term, StringComparison.OrdinalIgnoreCase) || (!string.IsNullOrEmpty(g.Code) && g.Code.Contains(term, StringComparison.OrdinalIgnoreCase)) || (g.ParentGroupCtrlNbr > 0 && allGroupsLookup.GetValueOrDefault(g.ParentGroupCtrlNbr, "").Contains(term, StringComparison.OrdinalIgnoreCase)))"
               SearchPlaceholder="Search groups..."
               EmptyMessage="No groups defined for this type yet."
               DefaultSortColumn="Code">
        <ToolbarContent>
            @if (!IsFeatureReadOnly)
            {
                <button class="btn btn-primary" @onclick="OpenCreateGroupModal">
                    <span class="bi bi-plus-circle"></span> Add Group
                </button>
            }
        </ToolbarContent>
        <RowContent Context="g">
            <td>@(string.IsNullOrEmpty(g.Code) ? "\u2014" : g.Code.ToUpperInvariant())</td>
            <td>
                <a href="/config/groups/@g.CtrlNbr" class="text-decoration-none">@g.Name</a>
            </td>
            <td>
                @if (g.ParentGroupCtrlNbr > 0)
                {
                    @allGroupsLookup.GetValueOrDefault(g.ParentGroupCtrlNbr, g.ParentGroupCtrlNbr.ToString())
                }
                else
                {
                    <span class="text-muted">&mdash;</span>
                }
            </td>
            @foreach (var ad in attributeDefinitions ?? [])
            {
                <td>@FormatAttributeValue(g.CtrlNbr, ad)</td>
            }
            <td>
                @if (!IsFeatureReadOnly)
                {
                    <div class="d-flex gap-1">
                        <button class="btn btn-sm btn-outline-primary flex-fill" @onclick="() => OpenEditGroupModal(g)">
                            <span class="bi bi-pencil"></span> Edit
                        </button>
                        <button class="btn btn-sm btn-outline-danger flex-fill" @onclick="() => OpenDeleteGroupModal(g)">
                            <span class="bi bi-trash"></span> Delete
                        </button>
                    </div>
                }
            </td>
        </RowContent>
    </DataTable>
    } @* end groups tab *@

    @if (activeTab == "settings")
    {
    @* ?????????????????????????????????????????????????????????????????? *@
    @* Attribute Definitions Section                                      *@
    @* ?????????????????????????????????????????????????????????????????? *@

    @* ?? Create / Edit Attribute Modal ?? *@
    <Modal Visible="showAttrSaveModal" Title="@(editAttrCtrlNbr > 0 ? "Edit Attribute" : "Add Attribute")"
           Icon="@(editAttrCtrlNbr > 0 ? "bi bi-pencil" : "bi bi-plus-circle")"
           OnClose="CloseAttrSaveModal">
        <BodyContent>
            <EditForm Model="attrSaveModel" OnValidSubmit="OnSaveAttribute" id="save-attr-form">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label fw-semibold">Attribute Name</label>
                    <InputText @bind-Value="attrSaveModel.AttributeName" class="form-control" placeholder="Attribute Name" />
                    <ValidationMessage For="() => attrSaveModel.AttributeName" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Data Type</label>
                    <InputSelect @bind-Value="attrSaveModel.DataType" class="form-select">
                        <option value="string">String</option>
                        <option value="int">Integer</option>
                        <option value="bool">Boolean</option>
                        <option value="decimal">Decimal</option>
                        <option value="date">Date</option>
                        <option value="time">Time</option>
                    </InputSelect>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Default Value</label>
                    <InputText @bind-Value="attrSaveModel.DefaultValue" class="form-control" placeholder="Default Value" />
                </div>
                <div class="form-check form-switch mb-3">
                    <InputCheckbox @bind-Value="attrSaveModel.IsRequired" class="form-check-input" id="attrRequired" />
                    <label class="form-check-label" for="attrRequired">Required</label>
                </div>
            </EditForm>
        </BodyContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="CloseAttrSaveModal">Cancel</button>
            <button type="submit" form="save-attr-form" class="btn btn-primary" disabled="@isSaving">
                <span class="bi bi-check-circle me-1"></span> @(editAttrCtrlNbr > 0 ? "Update" : "Add")
            </button>
        </Footer>
    </Modal>

    @* ?? Delete Attribute Modal ?? *@
    <Modal Visible="showAttrDeleteModal" Title="Confirm Delete" Icon="bi bi-exclamation-triangle"
           OnClose="() => showAttrDeleteModal = false" Size="sm">
        <BodyContent>
            <p>Are you sure you want to delete attribute <strong>@deleteAttrName</strong>?</p>
        </BodyContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="() => showAttrDeleteModal = false">Cancel</button>
            <button type="button" class="btn btn-danger" disabled="@isSaving" @onclick="ConfirmDeleteAttribute">
                <span class="bi bi-trash me-1"></span> Delete
            </button>
        </Footer>
    </Modal>

    <DataTable TItem="AttributeDefinitionResponse" Items="attributeDefinitions" Columns="attrColumns"
               SearchFilter="@((ad, term) => ad.AttributeName.Contains(term, StringComparison.OrdinalIgnoreCase))"
               SearchPlaceholder="Search attributes..."
               EmptyMessage="No attribute definitions yet."
               DefaultSortColumn="Name">
        <ToolbarContent>
            @if (!IsFeatureReadOnly)
            {
                <button class="btn btn-primary" @onclick="OpenCreateAttrModal">
                    <span class="bi bi-plus-circle"></span> Add Attribute
                </button>
            }
            <p class="text-muted mb-0 ms-3">Define metadata fields that groups of this type can carry.</p>
        </ToolbarContent>
        <RowContent Context="ad">
            <td>@ad.AttributeName</td>
            <td><code>@ad.DataType</code></td>
            <td>
                @if (ad.IsRequired)
                {
                    <span class="badge bg-warning">Required</span>
                }
            </td>
            <td>@(string.IsNullOrEmpty(ad.DefaultValue) ? "\u2014" : ad.DefaultValue)</td>
            <td>
                @if (!IsFeatureReadOnly)
                {
                    <div class="d-flex gap-1">
                        <button class="btn btn-sm btn-outline-primary flex-fill" @onclick="() => OpenEditAttrModal(ad)">
                            <span class="bi bi-pencil"></span> Edit
                        </button>
                        <button class="btn btn-sm btn-outline-danger flex-fill" @onclick="() => OpenDeleteAttrModal(ad)">
                            <span class="bi bi-trash"></span> Delete
                        </button>
                    </div>
                }
            </td>
        </RowContent>
    </DataTable>
    } @* end settings tab *@
}

@code {
    protected override string? FeatureKey => "config/group-types";

    [Parameter]
    public long CtrlNbr { get; set; }

    private GroupTypeResponse? groupType;
    private IReadOnlyList<GroupResponse>? groups;
    private IReadOnlyList<AttributeDefinitionResponse>? attributeDefinitions;
    private IReadOnlyList<GroupResponse>? parentTypeGroups;
    private Dictionary<long, string> allGroupsLookup = new();
    private Dictionary<long, Dictionary<long, string>> groupAttributeValues = new();
    private string parentGroupTypeName = "";
    private bool hasDefinedParentType;
    private bool parentGroupLocked;

    private string activeTab = "groups";
    private static readonly IReadOnlyList<TabPanel.TabItem> tabs =
    [
        new("groups", "Groups", "bi bi-collection"),
        new("settings", "Settings", "bi bi-gear")
    ];

    private IReadOnlyList<DataTableColumn<GroupResponse>> groupColumns =>
    [
        new("Code", g => (g.Code ?? "").ToUpperInvariant()),
        new("Name", g => g.Name),
        new("Parent Group", g => g.ParentGroupCtrlNbr > 0 ? allGroupsLookup.GetValueOrDefault(g.ParentGroupCtrlNbr, "") : ""),
        ..BuildAttributeColumns(),
        DataTableColumn<GroupResponse>.Actions()
    ];

    private static readonly IReadOnlyList<DataTableColumn<AttributeDefinitionResponse>> attrColumns =
    [
        new("Name", ad => ad.AttributeName),
        new("Data Type", ad => ad.DataType),
        new("Required", ad => ad.IsRequired ? "Yes" : ""),
        new("Default", ad => ad.DefaultValue ?? ""),
        DataTableColumn<AttributeDefinitionResponse>.Actions()
    ];

    private void NavigateBack() => NavigationManager.NavigateTo("/config/group-types");

    // ?? Groups CRUD ??
    private bool showGroupSaveModal;
    private long editGroupCtrlNbr;
    private GroupInputModel groupSaveModel = new();
    private bool showGroupDeleteModal;
    private long deleteGroupCtrlNbr;
    private string deleteGroupName = "";

    // ?? Attribute Definitions CRUD ??
    private bool showAttrSaveModal;
    private long editAttrCtrlNbr;
    private AttributeInputModel attrSaveModel = new();
    private bool showAttrDeleteModal;
    private long deleteAttrCtrlNbr;
    private string deleteAttrName = "";

    protected override async Task LoadDataAsync()
    {
        await LoadGroupType();
        await LoadGroupsAndParentCandidates();
        await LoadAttributeDefinitions();
        await LoadGroupAttributeValues();
    }

    protected override async Task OnAppContextChangedAsync()
    {
        if (groupType is not null && !IsGroupTypeInScope(groupType))
        {
            NavigationManager.NavigateTo("/config/group-types");
            return;
        }

        await LoadGroupsAndParentCandidates();
    }

    private bool IsGroupTypeInScope(GroupTypeResponse gt)
    {
        // Global system types are always in scope
        if (gt.ParentCtrlNbr == 0)
            return true;

        if (SelectedRailroadCtrlNbr is long railroadCtrlNbr)
            return gt.ParentCtrlNbr == SelectedParentCtrlNbr && (gt.RailroadCtrlNbr == railroadCtrlNbr || gt.RailroadCtrlNbr == 0);

        if (SelectedParentCtrlNbr is long parentCtrlNbr)
            return gt.ParentCtrlNbr == parentCtrlNbr && gt.RailroadCtrlNbr == 0;

        return true;
    }

    private bool IsGroupInScope(GroupResponse g)
    {
        if (SelectedRailroadCtrlNbr is long railroadCtrlNbr)
            return g.ParentCtrlNbr == SelectedParentCtrlNbr && (g.RailroadCtrlNbr == railroadCtrlNbr || g.RailroadCtrlNbr == 0);

        if (SelectedParentCtrlNbr is long parentCtrlNbr)
            return g.ParentCtrlNbr == parentCtrlNbr;

        return true;
    }

    // ??????????????????????????????????????????????????????????????????
    // Data loading
    // ??????????????????????????????????????????????????????????????????

    private async Task LoadGroupType()
    {
        try
        {
            groupType = await ConfigClient.GetGroupTypeAsync(CtrlNbr);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load group type: {ex.Message}";
        }
    }

    private async Task LoadGroupsAndParentCandidates()
    {
        try
        {
            var response = await ConfigClient.GetGroupTreeAsync();
            var allGroups = response.Groups.ToList();

            // Lookup for resolving parent group names
            allGroupsLookup = allGroups.ToDictionary(g => g.CtrlNbr, g => g.Name);

            // Groups belonging to this type, scoped to selected parent/railroad
            groups = allGroups.Where(g => g.GroupTypeCtrlNbr == CtrlNbr && IsGroupInScope(g)).ToList();

            // Parent group candidates for the create/edit dialog
            parentTypeGroups = null;
            parentGroupTypeName = "";
            hasDefinedParentType = false;

            if (groupType is null) return;

            if (groupType.ParentGroupTypeCtrlNbr > 0)
            {
                hasDefinedParentType = true;
                // Type has a defined parent group type � show only groups of that type
                var parentType = await ConfigClient.GetGroupTypeAsync(groupType.ParentGroupTypeCtrlNbr);
                parentGroupTypeName = parentType.Name;
                parentTypeGroups = allGroups
                    .Where(g => g.GroupTypeCtrlNbr == groupType.ParentGroupTypeCtrlNbr && IsGroupInScope(g))
                    .ToList();
            }
            else
            {
                // No parent group type � show all groups of other types as candidates
                var candidates = allGroups
                    .Where(g => g.GroupTypeCtrlNbr != CtrlNbr && IsGroupInScope(g))
                    .ToList();
                if (candidates.Count > 0)
                {
                    parentGroupTypeName = "";
                    parentTypeGroups = candidates;
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load groups: {ex.Message}";
        }
    }

    private async Task LoadAttributeDefinitions()
    {
        try
        {
            var response = await ConfigClient.GetAttributeDefinitionsAsync(CtrlNbr);
            attributeDefinitions = response.AttributeDefinitions;
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load attribute definitions: {ex.Message}";
        }
    }

    private async Task LoadGroupAttributeValues()
    {
        groupAttributeValues.Clear();
        if (groups is null || groups.Count == 0) return;

        foreach (var g in groups)
        {
            try
            {
                var valuesResponse = await ConfigClient.GetAttributeValuesAsync(g.CtrlNbr);
                groupAttributeValues[g.CtrlNbr] = valuesResponse.AttributeValues
                    .ToDictionary(v => v.AttributeDefinitionCtrlNbr, v => v.Value);
            }
            catch { /* skip — group has no values yet */ }
        }
    }

    private IEnumerable<DataTableColumn<GroupResponse>> BuildAttributeColumns()
    {
        if (attributeDefinitions is null) return [];
        return attributeDefinitions.Select(ad =>
            new DataTableColumn<GroupResponse>(ad.AttributeName, g => FormatAttributeValue(g.CtrlNbr, ad)));
    }

    private string FormatAttributeValue(long groupCtrlNbr, AttributeDefinitionResponse ad)
    {
        if (!groupAttributeValues.TryGetValue(groupCtrlNbr, out var values))
            return ad.DefaultValue ?? "";
        var raw = values.GetValueOrDefault(ad.CtrlNbr, ad.DefaultValue ?? "");
        if (ad.DataType == "bool")
            return raw == "true" ? "Yes" : "No";
        if (ad.DataType == "time" && TimeOnly.TryParse(raw, out var time))
            return time.ToString("h:mm tt");
        return raw;
    }

    // ??????????????????????????????????????????????????????????????????
    // Groups CRUD
    // ??????????????????????????????????????????????????????????????????

    private void OpenCreateGroupModal()
    {
        editGroupCtrlNbr = 0;
        groupSaveModel = new() { IsWorkArea = groupType?.IsWorkArea ?? false };

        // Build attribute entries from definitions with default values
        if (attributeDefinitions is not null)
        {
            groupSaveModel.Attributes = attributeDefinitions.Select(ad => new GroupAttributeEntry
            {
                AttributeDefinitionCtrlNbr = ad.CtrlNbr,
                AttributeName = ad.AttributeName,
                DataType = ad.DataType,
                IsRequired = ad.IsRequired,
                DefaultValue = ad.DefaultValue ?? string.Empty,
                Value = ad.DefaultValue ?? string.Empty
            }).ToList();
        }

        // Auto-assign parent group when the hierarchy defines a parent type
        if (hasDefinedParentType && parentTypeGroups is { Count: 1 })
        {
            groupSaveModel.ParentGroupCtrlNbr = parentTypeGroups[0].CtrlNbr;
            parentGroupLocked = true;
        }
        else if (hasDefinedParentType && parentTypeGroups is { Count: > 1 })
        {
            groupSaveModel.ParentGroupCtrlNbr = parentTypeGroups[0].CtrlNbr;
            parentGroupLocked = false;
        }
        else
        {
            parentGroupLocked = false;
        }

        showGroupSaveModal = true;
    }

    private async Task OpenEditGroupModal(GroupResponse g)
    {
        editGroupCtrlNbr = g.CtrlNbr;
        groupSaveModel = new()
        {
            Name = g.Name,
            Code = g.Code,
            ParentGroupCtrlNbr = g.ParentGroupCtrlNbr,
            IsWorkArea = groupType?.IsWorkArea ?? false
        };

        // Build attribute entries from definitions, populated with existing values
        if (attributeDefinitions is not null && attributeDefinitions.Count > 0)
        {
            Dictionary<long, string> existingValues = new();
            try
            {
                var valuesResponse = await ConfigClient.GetAttributeValuesAsync(g.CtrlNbr);
                existingValues = valuesResponse.AttributeValues.ToDictionary(v => v.AttributeDefinitionCtrlNbr, v => v.Value);
            }
            catch { /* fall back to defaults */ }

            groupSaveModel.Attributes = attributeDefinitions.Select(ad => new GroupAttributeEntry
            {
                AttributeDefinitionCtrlNbr = ad.CtrlNbr,
                AttributeName = ad.AttributeName,
                DataType = ad.DataType,
                IsRequired = ad.IsRequired,
                DefaultValue = ad.DefaultValue ?? string.Empty,
                Value = existingValues.GetValueOrDefault(ad.CtrlNbr, ad.DefaultValue ?? string.Empty)
            }).ToList();
        }

        parentGroupLocked = hasDefinedParentType;
        showGroupSaveModal = true;
    }

    private void CloseGroupSaveModal()
    {
        showGroupSaveModal = false;
        editGroupCtrlNbr = 0;
        parentGroupLocked = false;
        groupSaveModel = new();
    }

    private void OpenDeleteGroupModal(GroupResponse g)
    {
        deleteGroupCtrlNbr = g.CtrlNbr;
        deleteGroupName = g.Name;
        showGroupDeleteModal = true;
    }

    private async Task OnSaveGroup()
    {
        try
        {
            isSaving = true;
            errorMessage = null;
            successMessage = null;

            long savedGroupCtrlNbr;

            if (editGroupCtrlNbr > 0)
            {
                var result = await ConfigClient.UpdateGroupAsync(editGroupCtrlNbr, groupSaveModel.Name ?? string.Empty, groupSaveModel.ParentGroupCtrlNbr, groupSaveModel.IsWorkArea, groupSaveModel.Code, SelectedParentCtrlNbr ?? 0, SelectedRailroadCtrlNbr ?? 0);
                savedGroupCtrlNbr = result.CtrlNbr;
                successMessage = "Group updated.";
            }
            else
            {
                var result = await ConfigClient.CreateGroupAsync(CtrlNbr, groupSaveModel.Name ?? string.Empty, groupSaveModel.ParentGroupCtrlNbr, groupSaveModel.IsWorkArea, groupSaveModel.Code, SelectedParentCtrlNbr ?? 0, SelectedRailroadCtrlNbr ?? 0);
                savedGroupCtrlNbr = result.CtrlNbr;
                successMessage = "Group added.";
            }

            // Save attribute values
            foreach (var attr in groupSaveModel.Attributes)
            {
                if (!string.IsNullOrEmpty(attr.Value))
                    await ConfigClient.SetAttributeValueAsync(savedGroupCtrlNbr, attr.AttributeDefinitionCtrlNbr, attr.Value);
            }

            CloseGroupSaveModal();
            await LoadGroupsAndParentCandidates();
            await LoadGroupAttributeValues();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save group: {ex.Message}";
        }
        finally { isSaving = false; }
    }

    private async Task ConfirmDeleteGroup()
    {
        try
        {
            isSaving = true;
            errorMessage = null;
            successMessage = null;

            await ConfigClient.DeleteGroupAsync(deleteGroupCtrlNbr);
            successMessage = "Group deleted.";
            showGroupDeleteModal = false;
            await LoadGroupsAndParentCandidates();
            await LoadGroupAttributeValues();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to delete group: {ex.Message}";
            showGroupDeleteModal = false;
        }
        finally { isSaving = false; }
    }

    // ??????????????????????????????????????????????????????????????????
    // Attribute Definitions CRUD
    // ??????????????????????????????????????????????????????????????????

    private void OpenCreateAttrModal()
    {
        editAttrCtrlNbr = 0;
        attrSaveModel = new();
        showAttrSaveModal = true;
    }

    private void OpenEditAttrModal(AttributeDefinitionResponse ad)
    {
        editAttrCtrlNbr = ad.CtrlNbr;
        attrSaveModel = new()
        {
            AttributeName = ad.AttributeName,
            DataType = ad.DataType,
            IsRequired = ad.IsRequired,
            DefaultValue = ad.DefaultValue
        };
        showAttrSaveModal = true;
    }

    private void CloseAttrSaveModal()
    {
        showAttrSaveModal = false;
        editAttrCtrlNbr = 0;
        attrSaveModel = new();
    }

    private void OpenDeleteAttrModal(AttributeDefinitionResponse ad)
    {
        deleteAttrCtrlNbr = ad.CtrlNbr;
        deleteAttrName = ad.AttributeName;
        showAttrDeleteModal = true;
    }

    private async Task OnSaveAttribute()
    {
        try
        {
            isSaving = true;
            errorMessage = null;
            successMessage = null;

            if (editAttrCtrlNbr > 0)
            {
                await ConfigClient.UpdateAttributeDefinitionAsync(editAttrCtrlNbr, attrSaveModel.AttributeName ?? string.Empty, attrSaveModel.DataType, attrSaveModel.IsRequired, attrSaveModel.DefaultValue);
                successMessage = "Attribute updated.";
            }
            else
            {
                await ConfigClient.CreateAttributeDefinitionAsync(CtrlNbr, attrSaveModel.AttributeName ?? string.Empty, attrSaveModel.DataType, attrSaveModel.IsRequired, attrSaveModel.DefaultValue);
                successMessage = "Attribute added.";
            }

            CloseAttrSaveModal();
            await LoadAttributeDefinitions();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save attribute: {ex.Message}";
        }
        finally { isSaving = false; }
    }

    private async Task ConfirmDeleteAttribute()
    {
        try
        {
            isSaving = true;
            errorMessage = null;
            successMessage = null;

            await ConfigClient.DeleteAttributeDefinitionAsync(deleteAttrCtrlNbr);
            successMessage = "Attribute deleted.";
            showAttrDeleteModal = false;
            await LoadAttributeDefinitions();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to delete attribute: {ex.Message}";
            showAttrDeleteModal = false;
        }
        finally { isSaving = false; }
    }

