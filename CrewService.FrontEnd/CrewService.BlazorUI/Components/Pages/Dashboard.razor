@page "/"

@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using CrewService.BlazorUI.Clients

@attribute [Authorize]

@inject ParentsClient ParentsClient

<PageTitle>Dashboard</PageTitle>

<h1>Dashboard</h1>

<AuthorizeView>
    <Authorized>
        <p>Welcome, @context.User.Identity?.Name</p>
        @* DEBUG: Remove later *@
        <div class="alert alert-info mt-3">
            <strong>Roles:</strong> @string.Join(", ", context.User.Claims.Where(c => c.Type == ClaimTypes.Role).Select(c => c.Value))
            <br />
            <strong>Parent Roles:</strong> @string.Join(", ", parentRoleDisplay)
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private List<string> parentRoleDisplay = [];

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user = HttpContext.User;
        var parentRoleClaims = user.Claims
            .Where(c => c.Type == "parent_role")
            .Select(c => c.Value.Split(':'))
            .Where(parts => parts.Length == 2)
            .ToList();

        if (parentRoleClaims.Count == 0) return;

        var parents = await ParentsClient.GetAllAsync();
        var nameMap = parents.Parent.ToDictionary(p => p.CtrlNbr, p => p.Name);

        parentRoleDisplay = parentRoleClaims
            .Select(parts =>
            {
                var ctrlNbr = long.TryParse(parts[0], out var id) ? id : 0;
                var name = nameMap.TryGetValue(ctrlNbr, out var n) ? n : parts[0];
                return $"{name}:{parts[1]}";
            })
            .ToList();
    }
}
