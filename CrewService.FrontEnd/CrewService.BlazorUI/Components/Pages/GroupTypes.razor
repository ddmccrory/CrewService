@page "/work-management/group-types"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using CrewService.BlazorUI.Clients
@using CrewService.BlazorUI.Models
@using CrewService.Presentation

@inherits AppComponentBase

@attribute [Authorize]

@inject TenantConfigClient ConfigClient
@inject ParentsClient ParentsClient

<PageTitle>Group Types</PageTitle>

<h1>Group Types</h1>
<p class="text-muted">Define the organizational taxonomy (e.g., Region, Division, Yard).</p>

<div class="d-flex align-items-center mb-3">
    <button class="btn btn-primary" @onclick="OpenCreateModal" disabled="@(!SelectedParentCtrlNbr.HasValue)">
        <span class="bi bi-plus-circle"></span> New Group Type
    </button>
    @if (!SelectedParentCtrlNbr.HasValue)
    {
        <span class="text-muted small ms-2">Select a parent to add group types.</span>
    }
</div>

<Modal Visible="showSaveModal" Title="@(editCtrlNbr > 0 ? "Edit Group Type" : "Create Group Type")"
       Icon="@(editCtrlNbr > 0 ? "bi bi-pencil" : "bi bi-plus-circle")"
       OnClose="CloseSaveModal">
    <BodyContent>
        <EditForm Model="saveModel" OnValidSubmit="OnSave" id="save-grouptype-form">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label class="form-label fw-semibold">Name</label>
                <InputText @bind-Value="saveModel.Name" class="form-control" placeholder="Name" disabled="@isEditingSystemType" />
                <ValidationMessage For="() => saveModel.Name" class="text-danger" />
                @if (isEditingSystemType)
                {
                    <div class="form-text text-warning">System types cannot be renamed.</div>
                }
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Description</label>
                <InputText @bind-Value="saveModel.Description" class="form-control" placeholder="Description" />
            </div>
<div class="mb-3">
    <label class="form-label fw-semibold">Scope</label>
    <InputSelect @bind-Value="saveModel.RailroadCtrlNbr" class="form-select">
        <option value="0">@(SelectedParentName ?? "Parent") (All Railroads)</option>
        @foreach (var rr in railroadOptions)
        {
            <option value="@rr.CtrlNbr">@rr.DisplayName</option>
        }
    </InputSelect>
    <div class="form-text">Parent-wide types are visible to all railroads. Railroad-specific types only appear when that railroad is selected.</div>
</div>
<div class="form-check form-switch form-check-reverse mb-3">
    <InputCheckbox @bind-Value="saveModel.IsWorkArea" class="form-check-input" id="isWorkArea" />
                <label class="form-check-label" for="isWorkArea">Work Area</label>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Parent Group Type</label>
                <InputSelect @bind-Value="saveModel.ParentGroupTypeCtrlNbr" class="form-select">
                    <option value="0">(None — root level)</option>
                    @if (groupTypes is not null)
                    {
                        @foreach (var gt in groupTypes.Where(x => x.CtrlNbr != editCtrlNbr))
                        {
                            <option value="@gt.CtrlNbr">@gt.Name</option>
                        }
                    }
                </InputSelect>
                <div class="form-text">Groups of this type can be children of groups belonging to the parent type.</div>
            </div>
        </EditForm>
    </BodyContent>
    <Footer>
        <button type="button" class="btn btn-outline-secondary" @onclick="CloseSaveModal">Cancel</button>
        <button type="submit" form="save-grouptype-form" class="btn btn-primary" disabled="@isSaving">
            <span class="bi bi-check-circle me-1"></span> @(editCtrlNbr > 0 ? "Update" : "Create")
        </button>
    </Footer>
</Modal>

<Modal Visible="showDeleteModal" Title="Confirm Delete" Icon="bi bi-exclamation-triangle"
       OnClose="() => showDeleteModal = false" Size="sm">
    <BodyContent>
        <p>Are you sure you want to delete <strong>@deleteGroupTypeName</strong>?</p>
    </BodyContent>
    <Footer>
        <button type="button" class="btn btn-outline-secondary" @onclick="() => showDeleteModal = false">Cancel</button>
        <button type="button" class="btn btn-danger" disabled="@isSaving" @onclick="ConfirmDelete">
            <span class="bi bi-trash me-1"></span> Delete
        </button>
    </Footer>
</Modal>

<SuccessAlert @bind-Message="successMessage" />

@if (errorMessage is not null)
{
    <div class="alert alert-danger alert-dismissible" role="alert">
        @errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
    </div>
}

@if (groupTypes is null)
{
    <p><em>Loading...</em></p>
}
else if (groupTypes.Count == 0)
{
    <p>No group types defined yet.</p>
}
else
{
    <TabPanel Tabs="tabs" @bind-ActiveTab="activeTab" />

    @if (activeTab == "types")
    {
<DataTable TItem="GroupTypeResponse" Items="groupTypes" Columns="GroupTypeColumns"
           SearchFilter="@((gt, term) => gt.Name.Contains(term, StringComparison.OrdinalIgnoreCase) || (!string.IsNullOrEmpty(gt.Description) && gt.Description.Contains(term, StringComparison.OrdinalIgnoreCase)))"
           SearchPlaceholder="Search by name or description..."
           EmptyMessage="No group types match the current filter."
           DefaultSortColumn="Name">
    <RowContent Context="gt">
        <td>
            <a href="/work-management/group-types/@gt.CtrlNbr" class="text-decoration-none">@gt.Name</a>
        </td>
        <td>@gt.Description</td>
        <td>
            @if (gt.ParentGroupTypeCtrlNbr > 0)
            {
                var parentGtName = groupTypes?.FirstOrDefault(x => x.CtrlNbr == gt.ParentGroupTypeCtrlNbr)?.Name ?? gt.ParentGroupTypeCtrlNbr.ToString();
                @parentGtName
            }
            else
            {
                <span class="text-muted">—</span>
            }
        </td>
        <td>
            <div class="d-flex gap-1">
                @if (gt.IsSystemType)
                        {
                            <span class="badge bg-info">System</span>
                        }
                        @if (gt.IsWorkArea)
                        {
                            <span class="badge bg-success">Work Area</span>
                        }
                    </div>
                </td>
                <td>
                    <div class="d-flex gap-1">
                        <button class="btn btn-sm btn-outline-primary flex-fill" @onclick="() => OpenEditModal(gt)">
                            <span class="bi bi-pencil"></span> Edit
                        </button>
                        @if (!gt.IsSystemType)
                        {
                            <button class="btn btn-sm btn-outline-danger flex-fill" @onclick="() => OpenDeleteModal(gt)">
                                <span class="bi bi-trash"></span> Delete
                            </button>
                        }
                    </div>
                </td>
            </RowContent>
        </DataTable>
    }

    @if (activeTab == "hierarchy")
    {
        <div class="card">
            <div class="card-header fw-semibold">
                <span class="bi bi-diagram-3 me-1"></span> Group Type Hierarchy
            </div>
            <div class="card-body">
                <TreeView Nodes="BuildTypeHierarchy()" />
            </div>
        </div>
    }
}

@code {
    protected override string? FeatureKey => "work-management/group-types";

    private IReadOnlyList<GroupTypeResponse>? groupTypes;
    private List<RailroadScopeOption> railroadOptions = [];

    private IReadOnlyList<DataTableColumn<GroupTypeResponse>> GroupTypeColumns =>
    [
        new("Name", gt => gt.Name),
        new("Description", gt => gt.Description ?? ""),
        new("Parent Group Type", gt => GetParentTypeName(gt.ParentGroupTypeCtrlNbr), sortKey: "ParentType"),
        new("Tags", gt => GetTagsSortKey(gt), sortKey: "Tags"),
        DataTableColumn<GroupTypeResponse>.Actions()
    ];

    private static string GetTagsSortKey(GroupTypeResponse gt)
    {
        var parts = new List<string>();
        if (gt.IsSystemType) parts.Add("System");
        if (gt.IsWorkArea) parts.Add("Work Area");
        return string.Join(", ", parts);
    }

    private string GetParentTypeName(long parentGroupTypeCtrlNbr)
    {
        if (parentGroupTypeCtrlNbr == 0) return "";
        return groupTypes?.FirstOrDefault(x => x.CtrlNbr == parentGroupTypeCtrlNbr)?.Name ?? parentGroupTypeCtrlNbr.ToString();
    }

    private string activeTab = "types";
    private static readonly IReadOnlyList<TabPanel.TabItem> tabs =
    [
        new("types", "Group Types", "bi bi-collection"),
        new("hierarchy", "Hierarchy", "bi bi-diagram-3")
    ];

    private bool showSaveModal;
    private long editCtrlNbr;
    private bool isEditingSystemType;
    private GroupTypeInputModel saveModel = new();

    private bool showDeleteModal;
    private long deleteCtrlNbr;
    private string deleteGroupTypeName = "";

    protected override async Task LoadDataAsync()
    {
        await LoadRailroadOptions();
        await LoadGroupTypes();
    }

    protected override async Task OnAppContextChangedAsync()
    {
        await LoadRailroadOptions();
        await LoadGroupTypes();
    }

    private async Task LoadGroupTypes()
    {
        try
        {
            var response = await ConfigClient.GetAllGroupTypesAsync();
            var all = response.GroupTypes;

            if (SelectedRailroadCtrlNbr is long railroadCtrlNbr)
            {
                groupTypes = all
                    .Where(gt => gt.ParentCtrlNbr == 0 || (gt.ParentCtrlNbr == SelectedParentCtrlNbr && (gt.RailroadCtrlNbr == railroadCtrlNbr || gt.RailroadCtrlNbr == 0)))
                    .ToList();
            }
            else if (SelectedParentCtrlNbr is long parentCtrlNbr)
            {
                groupTypes = all
                    .Where(gt => gt.ParentCtrlNbr == 0 || (gt.ParentCtrlNbr == parentCtrlNbr && gt.RailroadCtrlNbr == 0))
                    .ToList();
            }
            else
            {
                groupTypes = all;
            }
        }
        catch
        {
            groupTypes = [];
        }
    }

    private async Task LoadRailroadOptions()
    {
        if (SelectedParentCtrlNbr is not long parentCtrlNbr)
        {
            railroadOptions = [];
            return;
        }

        try
        {
            var parent = await ParentsClient.GetByCtrlNbrAsync(parentCtrlNbr);
            railroadOptions = parent.Railroads
                .Select(r => new RailroadScopeOption(r.CtrlNbr, string.IsNullOrWhiteSpace(r.RrMark) ? r.Name : $"{r.RrMark} — {r.Name}"))
                .OrderBy(r => r.DisplayName)
                .ToList();
        }
        catch
        {
            railroadOptions = [];
        }
    }

    private List<TreeNode> BuildTypeHierarchy()
    {
        if (groupTypes is null || groupTypes.Count == 0) return [];

        var lookup = groupTypes.ToDictionary(gt => gt.CtrlNbr);

        TreeNode ToNode(GroupTypeResponse gt) => new()
        {
            Label = gt.Name,
            Href = $"/config/group-types/{gt.CtrlNbr}",
            Subtitle = gt.Description,
            Badges = BuildBadges(gt),
            Children = groupTypes
                .Where(child => child.ParentGroupTypeCtrlNbr == gt.CtrlNbr)
                .Select(ToNode)
                .ToList()
        };

        // Root types are those with no parent or whose parent isn't in the current list
        return groupTypes
            .Where(gt => gt.ParentGroupTypeCtrlNbr == 0 || !lookup.ContainsKey(gt.ParentGroupTypeCtrlNbr))
            .Select(ToNode)
            .ToList();
    }

    private static List<BadgeItem> BuildBadges(GroupTypeResponse gt)
    {
        var badges = new List<BadgeItem>();
        if (gt.IsSystemType) badges.Add(new BadgeItem("System", "bg-info"));
        if (gt.IsWorkArea) badges.Add(new BadgeItem("Work Area", "bg-success"));
        return badges;
    }

    private void OpenCreateModal()
    {
        editCtrlNbr = 0;
        saveModel = new();
        showSaveModal = true;
    }

    private void OpenEditModal(GroupTypeResponse gt)
    {
        editCtrlNbr = gt.CtrlNbr;
        isEditingSystemType = gt.IsSystemType;
        saveModel = new() { Name = gt.Name, Description = gt.Description, IsWorkArea = gt.IsWorkArea, RailroadCtrlNbr = gt.RailroadCtrlNbr, ParentGroupTypeCtrlNbr = gt.ParentGroupTypeCtrlNbr };
        showSaveModal = true;
    }

    private void CloseSaveModal()
    {
        showSaveModal = false;
        editCtrlNbr = 0;
        isEditingSystemType = false;
        saveModel = new();
    }

    private void OpenDeleteModal(GroupTypeResponse gt)
    {
        deleteCtrlNbr = gt.CtrlNbr;
        deleteGroupTypeName = gt.Name;
        showDeleteModal = true;
    }

    private async Task OnSave()
    {
        try
        {
            isSaving = true;
            errorMessage = null;
            successMessage = null;

            var parentScope = SelectedParentCtrlNbr ?? 0;

            if (editCtrlNbr > 0)
            {
                await ConfigClient.UpdateGroupTypeAsync(editCtrlNbr, saveModel.Name ?? string.Empty, saveModel.Description ?? string.Empty, saveModel.IsWorkArea, parentCtrlNbr: parentScope, railroadCtrlNbr: saveModel.RailroadCtrlNbr, parentGroupTypeCtrlNbr: saveModel.ParentGroupTypeCtrlNbr);
                successMessage = "Group type updated.";
            }
            else
            {
                await ConfigClient.CreateGroupTypeAsync(saveModel.Name ?? string.Empty, saveModel.Description ?? string.Empty, saveModel.IsWorkArea, parentCtrlNbr: parentScope, railroadCtrlNbr: saveModel.RailroadCtrlNbr, parentGroupTypeCtrlNbr: saveModel.ParentGroupTypeCtrlNbr);
                successMessage = "Group type created.";
            }

            CloseSaveModal();
            await LoadGroupTypes();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save group type: {ex.Message}";
        }
        finally { isSaving = false; }
    }

    private async Task ConfirmDelete()
    {
        try
        {
            isSaving = true;
            errorMessage = null;
            successMessage = null;

            await ConfigClient.DeleteGroupTypeAsync(deleteCtrlNbr);
            successMessage = "Group type deleted.";
            showDeleteModal = false;
            await LoadGroupTypes();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to delete group type: {ex.Message}";
            showDeleteModal = false;
        }
        finally { isSaving = false; }
    }

    private sealed class GroupTypeInputModel
    {
        [Required(ErrorMessage = "Name is required.")]
        [StringLength(100, MinimumLength = 1)]
        public string? Name { get; set; }

        public string? Description { get; set; }
        public bool IsWorkArea { get; set; }
        public long RailroadCtrlNbr { get; set; }
        public long ParentGroupTypeCtrlNbr { get; set; }
    }

    private sealed record RailroadScopeOption(long CtrlNbr, string DisplayName);
}
