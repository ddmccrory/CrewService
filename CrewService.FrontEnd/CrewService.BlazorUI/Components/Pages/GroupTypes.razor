@page "/config/group-types"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using CrewService.BlazorUI.Clients
@using CrewService.Presentation

@inherits AppComponentBase

@attribute [Authorize]

@inject TenantConfigClient ConfigClient

<PageTitle>Group Types</PageTitle>

<h1>Group Types</h1>
<p class="text-muted">Define the organizational taxonomy (e.g., Region, Division, Yard).</p>

<div class="d-flex justify-content-between align-items-center mb-3">
    <button class="btn btn-primary" @onclick="OpenCreateModal" disabled="@(!SelectedParentCtrlNbr.HasValue)">
        <span class="bi bi-plus-circle"></span> New Group Type
    </button>
    @if (!SelectedParentCtrlNbr.HasValue)
    {
        <span class="text-muted small">Select a parent to add group types.</span>
    }
</div>

<Modal Visible="showSaveModal" Title="@(editCtrlNbr > 0 ? "Edit Group Type" : "Create Group Type")"
       Icon="@(editCtrlNbr > 0 ? "bi bi-pencil" : "bi bi-plus-circle")"
       OnClose="CloseSaveModal">
    <BodyContent>
        <EditForm Model="saveModel" OnValidSubmit="OnSave" id="save-grouptype-form">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label class="form-label fw-semibold">Name</label>
                <InputText @bind-Value="saveModel.Name" class="form-control" placeholder="Name" disabled="@isEditingSystemType" />
                <ValidationMessage For="() => saveModel.Name" class="text-danger" />
                @if (isEditingSystemType)
                {
                    <div class="form-text text-warning">System types cannot be renamed.</div>
                }
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Description</label>
                <InputText @bind-Value="saveModel.Description" class="form-control" placeholder="Description" />
            </div>
            <div class="form-check mb-3">
                <InputCheckbox @bind-Value="saveModel.IsWorkArea" class="form-check-input" id="isWorkArea" disabled="@isEditingSystemType" />
                <label class="form-check-label" for="isWorkArea">Work Area</label>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Parent Group Type</label>
                <InputSelect @bind-Value="saveModel.ParentGroupTypeCtrlNbr" class="form-select">
                    <option value="0">(None — root level)</option>
                    @if (groupTypes is not null)
                    {
                        @foreach (var gt in groupTypes.Where(x => x.CtrlNbr != editCtrlNbr))
                        {
                            <option value="@gt.CtrlNbr">@gt.Name</option>
                        }
                    }
                </InputSelect>
                <div class="form-text">Groups of this type can be children of groups belonging to the parent type.</div>
            </div>
        </EditForm>
    </BodyContent>
    <Footer>
        <button type="button" class="btn btn-outline-secondary" @onclick="CloseSaveModal">Cancel</button>
        <button type="submit" form="save-grouptype-form" class="btn btn-primary">
            <span class="bi bi-check-circle me-1"></span> @(editCtrlNbr > 0 ? "Update" : "Create")
        </button>
    </Footer>
</Modal>

<Modal Visible="showDeleteModal" Title="Confirm Delete" Icon="bi bi-exclamation-triangle"
       OnClose="() => showDeleteModal = false" Size="sm">
    <BodyContent>
        <p>Are you sure you want to delete <strong>@deleteGroupTypeName</strong>?</p>
    </BodyContent>
    <Footer>
        <button type="button" class="btn btn-outline-secondary" @onclick="() => showDeleteModal = false">Cancel</button>
        <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">
            <span class="bi bi-trash me-1"></span> Delete
        </button>
    </Footer>
</Modal>

@if (successMessage is not null)
{
    <div class="alert alert-success alert-dismissible" role="alert">
        @successMessage
        <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
    </div>
}

@if (errorMessage is not null)
{
    <div class="alert alert-danger alert-dismissible" role="alert">
        @errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
    </div>
}

@if (groupTypes is null)
{
    <p><em>Loading...</em></p>
}
else if (groupTypes.Count == 0)
{
    <p>No group types defined yet.</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Name</th>
                    <th>Description</th>
                    <th>Parent Group Type</th>
                    <th>Work Area</th>
                <th style="width: 180px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var gt in groupTypes)
            {
                <tr>
                    <td>
                        <a href="/config/group-types/@gt.CtrlNbr" class="text-decoration-none">@gt.Name</a>
                    </td>
                    <td>@gt.Description</td>
                    <td>
                        @if (gt.ParentGroupTypeCtrlNbr > 0)
                        {
                            var parentGtName = groupTypes?.FirstOrDefault(x => x.CtrlNbr == gt.ParentGroupTypeCtrlNbr)?.Name ?? gt.ParentGroupTypeCtrlNbr.ToString();
                            @parentGtName
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td>
                        @if (gt.IsWorkArea)
                        {
                            <span class="badge bg-success">Yes</span>
                        }
                    </td>
                    <td>
                        <div class="d-flex gap-1">
                            <button class="btn btn-sm btn-outline-primary flex-fill" @onclick="() => OpenEditModal(gt)">
                                <span class="bi bi-pencil"></span> Edit
                            </button>
                            @if (!gt.IsSystemType)
                            {
                                <button class="btn btn-sm btn-outline-danger flex-fill" @onclick="() => OpenDeleteModal(gt)">
                                    <span class="bi bi-trash"></span> Delete
                                </button>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<GroupTypeResponse>? groupTypes;

    private bool showSaveModal;
    private long editCtrlNbr;
    private bool isEditingSystemType;
    private GroupTypeInputModel saveModel = new();

    private bool showDeleteModal;
    private long deleteCtrlNbr;
    private string deleteGroupTypeName = "";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await LoadGroupTypes();
    }

    protected override async Task OnAppContextChangedAsync()
    {
        await LoadGroupTypes();
    }

    private async Task LoadGroupTypes()
    {
        try
        {
            var response = await ConfigClient.GetAllGroupTypesAsync();
            var all = response.GroupTypes;

            if (SelectedRailroadCtrlNbr is long railroadCtrlNbr)
            {
                groupTypes = all
                    .Where(gt => gt.ParentCtrlNbr == SelectedParentCtrlNbr && (gt.RailroadCtrlNbr == railroadCtrlNbr || gt.RailroadCtrlNbr == 0))
                    .ToList();
            }
            else if (SelectedParentCtrlNbr is long parentCtrlNbr)
            {
                groupTypes = all
                    .Where(gt => gt.ParentCtrlNbr == parentCtrlNbr && gt.RailroadCtrlNbr == 0)
                    .ToList();
            }
            else
            {
                groupTypes = all;
            }
        }
        catch
        {
            groupTypes = [];
        }
    }

    private void OpenCreateModal()
    {
        editCtrlNbr = 0;
        saveModel = new();
        showSaveModal = true;
    }

    private void OpenEditModal(GroupTypeResponse gt)
    {
        editCtrlNbr = gt.CtrlNbr;
        isEditingSystemType = gt.IsSystemType;
        saveModel = new() { Name = gt.Name, Description = gt.Description, IsWorkArea = gt.IsWorkArea, ParentGroupTypeCtrlNbr = gt.ParentGroupTypeCtrlNbr };
        showSaveModal = true;
    }

    private void CloseSaveModal()
    {
        showSaveModal = false;
        editCtrlNbr = 0;
        isEditingSystemType = false;
        saveModel = new();
    }

    private void OpenDeleteModal(GroupTypeResponse gt)
    {
        deleteCtrlNbr = gt.CtrlNbr;
        deleteGroupTypeName = gt.Name;
        showDeleteModal = true;
    }

    private async Task OnSave()
    {
        try
        {
            errorMessage = null;
            successMessage = null;

            var parentScope = SelectedParentCtrlNbr ?? 0;
            var railroadScope = SelectedRailroadCtrlNbr ?? 0;

            if (editCtrlNbr > 0)
            {
                await ConfigClient.UpdateGroupTypeAsync(editCtrlNbr, saveModel.Name ?? string.Empty, saveModel.Description ?? string.Empty, saveModel.IsWorkArea, parentCtrlNbr: parentScope, railroadCtrlNbr: railroadScope, parentGroupTypeCtrlNbr: saveModel.ParentGroupTypeCtrlNbr);
                successMessage = "Group type updated.";
            }
            else
            {
                await ConfigClient.CreateGroupTypeAsync(saveModel.Name ?? string.Empty, saveModel.Description ?? string.Empty, saveModel.IsWorkArea, parentCtrlNbr: parentScope, railroadCtrlNbr: railroadScope, parentGroupTypeCtrlNbr: saveModel.ParentGroupTypeCtrlNbr);
                successMessage = "Group type created.";
            }

            CloseSaveModal();
            await LoadGroupTypes();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save group type: {ex.Message}";
        }
    }

    private async Task ConfirmDelete()
    {
        try
        {
            errorMessage = null;
            successMessage = null;

            await ConfigClient.DeleteGroupTypeAsync(deleteCtrlNbr);
            successMessage = "Group type deleted.";
            showDeleteModal = false;
            await LoadGroupTypes();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to delete group type: {ex.Message}";
            showDeleteModal = false;
        }
    }

    private sealed class GroupTypeInputModel
    {
        [Required(ErrorMessage = "Name is required.")]
        [StringLength(100, MinimumLength = 1)]
        public string? Name { get; set; }

        public string? Description { get; set; }
        public bool IsWorkArea { get; set; }
        public long ParentGroupTypeCtrlNbr { get; set; }
    }
}
