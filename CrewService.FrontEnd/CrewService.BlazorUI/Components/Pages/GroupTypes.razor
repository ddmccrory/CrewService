@page "/config/group-types"

@using Microsoft.AspNetCore.Authorization
@using CrewService.BlazorUI.Clients
@using CrewService.Presentation

@attribute [Authorize]

@inject TenantConfigClient ConfigClient

<PageTitle>Group Types</PageTitle>

<h1>Group Types</h1>
<p class="text-muted">Define the organizational taxonomy (e.g., Region, Division, Yard).</p>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="ShowCreateForm">
        <span class="bi bi-plus-circle"></span> New Group Type
    </button>
</div>

@if (showCreateForm)
{
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Create Group Type</h5>
            <EditForm Model="formModel" OnValidSubmit="CreateGroupType" FormName="createGroupType">
                <DataAnnotationsValidator />
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-floating mb-3">
                            <InputText @bind-Value="formModel.Name" class="form-control" placeholder="Name" />
                            <label>Name</label>
                            <ValidationMessage For="() => formModel.Name" class="text-danger" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <InputText @bind-Value="formModel.Description" class="form-control" placeholder="Description" />
                            <label>Description</label>
                        </div>
                    </div>
                    <div class="col-md-2 d-flex align-items-center">
                        <div class="form-check">
                            <InputCheckbox @bind-Value="formModel.IsWorkArea" class="form-check-input" id="isWorkArea" />
                            <label class="form-check-label" for="isWorkArea">Work Area</label>
                        </div>
                    </div>
                </div>
                <button type="submit" class="btn btn-success me-2">Create</button>
                <button type="button" class="btn btn-secondary" @onclick="CancelForm">Cancel</button>
            </EditForm>
        </div>
    </div>
}

@if (errorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (groupTypes is null)
{
    <p><em>Loading...</em></p>
}
else if (groupTypes.Count == 0)
{
    <p>No group types defined yet.</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Work Area</th>
                <th style="width: 180px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var gt in groupTypes)
            {
                <tr>
                    <td>
                        <a href="/config/group-types/@gt.CtrlNbr">@gt.Name</a>
                    </td>
                    <td>@gt.Description</td>
                    <td>
                        @if (gt.IsWorkArea)
                        {
                            <span class="badge bg-success">Yes</span>
                        }
                    </td>
                    <td>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteGroupType(gt.CtrlNbr)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<GroupTypeResponse>? groupTypes;
    private string? errorMessage;
    private bool showCreateForm;
    private GroupTypeFormModel formModel = new();

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadGroupTypes();
    }

    private async Task LoadGroupTypes()
    {
        try
        {
            errorMessage = null;
            var response = await ConfigClient.GetAllGroupTypesAsync();
            groupTypes = response.GroupTypes;
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load group types: {ex.Message}";
        }
    }

    private void ShowCreateForm() => showCreateForm = true;
    private void CancelForm()
    {
        showCreateForm = false;
        formModel = new();
    }

    private async Task CreateGroupType()
    {
        try
        {
            errorMessage = null;
            await ConfigClient.CreateGroupTypeAsync(formModel.Name, formModel.Description, formModel.IsWorkArea);
            showCreateForm = false;
            formModel = new();
            await LoadGroupTypes();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to create group type: {ex.Message}";
        }
    }

    private async Task DeleteGroupType(long ctrlNbr)
    {
        try
        {
            errorMessage = null;
            await ConfigClient.DeleteGroupTypeAsync(ctrlNbr);
            await LoadGroupTypes();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to delete group type: {ex.Message}";
        }
    }

    private sealed class GroupTypeFormModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.StringLength(100, MinimumLength = 1)]
        public string Name { get; set; } = "";

        public string Description { get; set; } = "";
        public bool IsWorkArea { get; set; }
    }
}
