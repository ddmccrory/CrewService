@page "/config/groups/{CtrlNbr:long}"

@using Microsoft.AspNetCore.Authorization
@using CrewService.BlazorUI.Clients
@using CrewService.Presentation

@attribute [Authorize]

@inject TenantConfigClient ConfigClient
@inject RailroadsClient RailroadsClient
@inject NavigationManager NavigationManager

<PageTitle>Group Detail</PageTitle>

@if (errorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (group is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/config/group-types">Group Types</a></li>
            <li class="breadcrumb-item"><a href="/config/group-types/@group.GroupTypeCtrlNbr">@groupTypeName</a></li>
            <li class="breadcrumb-item active" aria-current="page">@group.Name</li>
        </ol>
    </nav>

    @if (!isEditing)
    {
        <h1>@group.Name</h1>
        @if (group.IsWorkArea)
        {
            <span class="badge bg-success mb-2">Work Area</span>
        }
        <div class="mb-3">
            <button class="btn btn-sm btn-outline-primary me-2" @onclick="StartEdit">Edit</button>
            <button class="btn btn-sm btn-outline-danger" @onclick="Delete">Delete</button>
        </div>
    }
    else
    {
        <EditForm Model="editModel" OnValidSubmit="SaveEdit" FormName="editGroup">
            <DataAnnotationsValidator />
            <div class="row">
                <div class="col-md-5">
                    <div class="form-floating mb-3">
                        <InputText @bind-Value="editModel.Name" class="form-control" placeholder="Name" />
                        <label>Name</label>
                        <ValidationMessage For="() => editModel.Name" class="text-danger" />
                    </div>
                </div>
                <div class="col-md-2 d-flex align-items-center">
                    <div class="form-check">
                        <InputCheckbox @bind-Value="editModel.IsWorkArea" class="form-check-input" id="editWA" />
                        <label class="form-check-label" for="editWA">Work Area</label>
                    </div>
                </div>
            </div>
            <button type="submit" class="btn btn-success me-2">Save</button>
            <button type="button" class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
        </EditForm>
    }

    <hr />

    <h3>Railroad Placements</h3>

    <div class="mb-3">
        <button class="btn btn-sm btn-primary" @onclick="ShowPlaceForm">
            <span class="bi bi-plus-circle"></span> Place Railroad
        </button>
    </div>

    @if (showPlaceForm)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">Place Railroad in Group</h5>
                @if (availableRailroads is null)
                {
                    <p><em>Loading railroads...</em></p>
                }
                else
                {
                    <EditForm Model="placeModel" OnValidSubmit="PlaceRailroad" FormName="placeRailroad">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <InputSelect @bind-Value="placeModel.RailroadCtrlNbr" class="form-select">
                                        <option value="0">-- Select Railroad --</option>
                                        @foreach (var rr in availableRailroads)
                                        {
                                            <option value="@rr.CtrlNbr">@rr.RrMark — @rr.Name</option>
                                        }
                                    </InputSelect>
                                    <label>Railroad</label>
                                </div>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-success me-2" disabled="@(placeModel.RailroadCtrlNbr == 0)">Place</button>
                        <button type="button" class="btn btn-secondary" @onclick="CancelPlace">Cancel</button>
                    </EditForm>
                }
            </div>
        </div>
    }

    @if (placements is null)
    {
        <p><em>Loading placements...</em></p>
    }
    else if (placements.Count == 0)
    {
        <p class="text-muted">No railroads placed in this group yet.</p>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>RR Mark</th>
                    <th>Name</th>
                    <th style="width: 120px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in placements)
                {
                    var rr = allRailroads?.FirstOrDefault(r => r.CtrlNbr == p.RailroadCtrlNbr);
                    <tr>
                        <td><strong>@(rr?.RrMark ?? p.RailroadCtrlNbr.ToString())</strong></td>
                        <td>@(rr?.Name ?? "Unknown")</td>
                        <td>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => RemovePlacement(p.CtrlNbr)">Remove</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <hr />

    <h3>Child Groups</h3>

    @if (childGroups is not null && childGroups.Count > 0)
    {
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Work Area</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var child in childGroups)
                {
                    <tr>
                        <td><a href="/config/groups/@child.CtrlNbr">@child.Name</a></td>
                        <td>
                            @if (child.IsWorkArea)
                            {
                                <span class="badge bg-success">Yes</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">No child groups.</p>
    }

    <hr />

    <h3>Attributes</h3>

    @if (attributeDefinitions is not null && attributeDefinitions.Count > 0)
    {
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Attribute</th>
                    <th>Type</th>
                    <th>Required</th>
                    <th>Value</th>
                    <th style="width: 120px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ad in attributeDefinitions)
                {
                    var existingValue = attributeValues?.FirstOrDefault(v => v.AttributeDefinitionCtrlNbr == ad.CtrlNbr);
                    var currentValue = GetEditableValue(ad.CtrlNbr);
                    <tr>
                        <td>@ad.AttributeName</td>
                        <td><code>@ad.DataType</code></td>
                        <td>
                            @if (ad.IsRequired)
                            {
                                <span class="badge bg-warning">Required</span>
                            }
                        </td>
                        <td>
                            <input type="text" class="form-control form-control-sm"
                                   value="@currentValue"
                                   @onchange="(e) => OnAttributeValueChanged(ad.CtrlNbr, e.Value?.ToString())" />
                        </td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => SaveAttributeValue(ad.CtrlNbr)">Save</button>
                            @if (existingValue is not null)
                            {
                                <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => DeleteAttributeValue(existingValue.CtrlNbr)">Clear</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">No attribute definitions for this group type. <a href="/config/group-types/@group.GroupTypeCtrlNbr">Define attributes on the group type.</a></p>
    }
}

@code {
    [Parameter]
    public long CtrlNbr { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private GroupResponse? group;
    private string groupTypeName = "";
    private IReadOnlyList<RailroadGroupPlacementResponse>? placements;
    private IReadOnlyList<GroupResponse>? childGroups;
    private IReadOnlyList<GetRailroadResponse>? allRailroads;
    private IReadOnlyList<GetRailroadResponse>? availableRailroads;
    private IReadOnlyList<AttributeDefinitionResponse>? attributeDefinitions;
    private IReadOnlyList<AttributeValueResponse>? attributeValues;
    private Dictionary<long, string> editableValues = new();
    private string? errorMessage;
    private bool isEditing;
    private EditGroupModel editModel = new();
    private bool showPlaceForm;
    private PlaceRailroadModel placeModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadGroup();
        await LoadPlacements();
        await LoadRailroads();
        await LoadChildGroups();
        await LoadAttributes();
    }

    private async Task LoadGroup()
    {
        try
        {
            errorMessage = null;
            group = await ConfigClient.GetGroupAsync(CtrlNbr);
            var gt = await ConfigClient.GetGroupTypeAsync(group.GroupTypeCtrlNbr);
            groupTypeName = gt.Name;
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load group: {ex.Message}";
        }
    }

    private async Task LoadPlacements()
    {
        try
        {
            var response = await ConfigClient.GetRailroadsInGroupAsync(CtrlNbr);
            placements = response.Placements;
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load placements: {ex.Message}";
        }
    }

    private async Task LoadRailroads()
    {
        try
        {
            var response = await RailroadsClient.GetAllAsync();
            allRailroads = response.Railroad;
            UpdateAvailableRailroads();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load railroads: {ex.Message}";
        }
    }

    private async Task LoadChildGroups()
    {
        try
        {
            var response = await ConfigClient.GetAllGroupsAsync(CtrlNbr);
            childGroups = response.Groups;
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load child groups: {ex.Message}";
        }
    }

    private void UpdateAvailableRailroads()
    {
        if (allRailroads is null || placements is null)
        {
            availableRailroads = allRailroads;
            return;
        }

        var placedIds = placements.Select(p => p.RailroadCtrlNbr).ToHashSet();
        availableRailroads = allRailroads.Where(r => !placedIds.Contains(r.CtrlNbr)).ToList();
    }

    private void StartEdit()
    {
        editModel = new()
        {
            Name = group!.Name,
            IsWorkArea = group.IsWorkArea
        };
        isEditing = true;
    }

    private void CancelEdit() => isEditing = false;

    private async Task SaveEdit()
    {
        try
        {
            errorMessage = null;
            await ConfigClient.UpdateGroupAsync(CtrlNbr, editModel.Name, group!.ParentGroupCtrlNbr, editModel.IsWorkArea);
            isEditing = false;
            await LoadGroup();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to update group: {ex.Message}";
        }
    }

    private async Task Delete()
    {
        try
        {
            var groupTypeId = group!.GroupTypeCtrlNbr;
            await ConfigClient.DeleteGroupAsync(CtrlNbr);
            NavigationManager.NavigateTo($"/config/group-types/{groupTypeId}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to delete group: {ex.Message}";
        }
    }

    private async Task ShowPlaceForm()
    {
        await LoadRailroads();
        showPlaceForm = true;
    }

    private void CancelPlace()
    {
        showPlaceForm = false;
        placeModel = new();
    }

    private async Task PlaceRailroad()
    {
        try
        {
            errorMessage = null;
            await ConfigClient.PlaceRailroadAsync(placeModel.RailroadCtrlNbr, CtrlNbr);
            showPlaceForm = false;
            placeModel = new();
            await LoadPlacements();
            UpdateAvailableRailroads();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to place railroad: {ex.Message}";
        }
    }

    private async Task RemovePlacement(long placementCtrlNbr)
    {
        try
        {
            errorMessage = null;
            await ConfigClient.RemoveRailroadFromGroupAsync(placementCtrlNbr);
            await LoadPlacements();
            UpdateAvailableRailroads();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to remove placement: {ex.Message}";
        }
    }

    private sealed class EditGroupModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.StringLength(100, MinimumLength = 1)]
        public string Name { get; set; } = "";

        public bool IsWorkArea { get; set; }
    }

    private sealed class PlaceRailroadModel
    {
        public long RailroadCtrlNbr { get; set; }
    }

    // Attribute Values
    private async Task LoadAttributes()
    {
        try
        {
            if (group is null) return;
            var defsResponse = await ConfigClient.GetAttributeDefinitionsAsync(group.GroupTypeCtrlNbr);
            attributeDefinitions = defsResponse.AttributeDefinitions;

            var valsResponse = await ConfigClient.GetAttributeValuesAsync(CtrlNbr);
            attributeValues = valsResponse.AttributeValues;

            editableValues.Clear();
            foreach (var ad in attributeDefinitions)
            {
                var existing = attributeValues.FirstOrDefault(v => v.AttributeDefinitionCtrlNbr == ad.CtrlNbr);
                editableValues[ad.CtrlNbr] = existing?.Value ?? ad.DefaultValue ?? "";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load attributes: {ex.Message}";
        }
    }

    private string GetEditableValue(long attrDefCtrlNbr)
    {
        return editableValues.TryGetValue(attrDefCtrlNbr, out var val) ? val : "";
    }

    private void OnAttributeValueChanged(long attrDefCtrlNbr, string? value)
    {
        editableValues[attrDefCtrlNbr] = value ?? "";
    }

    private async Task SaveAttributeValue(long attrDefCtrlNbr)
    {
        try
        {
            errorMessage = null;
            var value = GetEditableValue(attrDefCtrlNbr);
            await ConfigClient.SetAttributeValueAsync(CtrlNbr, attrDefCtrlNbr, value);
            await LoadAttributes();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save attribute value: {ex.Message}";
        }
    }

    private async Task DeleteAttributeValue(long valueCtrlNbr)
    {
        try
        {
            errorMessage = null;
            await ConfigClient.DeleteAttributeValueAsync(valueCtrlNbr);
            await LoadAttributes();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to clear attribute value: {ex.Message}";
        }
    }
}
