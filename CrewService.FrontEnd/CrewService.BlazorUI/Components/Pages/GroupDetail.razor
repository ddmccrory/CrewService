@page "/config/groups/{CtrlNbr:long}"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using CrewService.BlazorUI.Clients
@using CrewService.BlazorUI.Models
@using CrewService.Presentation

@inherits AppComponentBase

@attribute [Authorize]

@inject TenantConfigClient ConfigClient

<PageTitle>Group Detail</PageTitle>

@if (errorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (group is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <BackNavButton Text="@groupTypeName" OnClick="NavigateBack" />

    <h1>@group.Name</h1>
    @if (group.IsWorkArea)
    {
        <span class="badge bg-success mb-2">Work Area</span>
    }

    <hr />

    <TabPanel Tabs="tabs" @bind-ActiveTab="activeTab" />

    @if (activeTab == "overview")
    {
    @* ?????????????????????????????????????????????????????????????????? *@
    @* Hierarchy Map                                                      *@
    @* ?????????????????????????????????????????????????????????????????? *@

    <h3>Hierarchy</h3>

    <div class="card mb-4">
        <div class="card-body">
            <TreeView Nodes="BuildGroupHierarchy()" />
        </div>
    </div>

    <hr />

    <h3>Child Groups</h3>

    @if (childGroups is not null && childGroups.Count > 0)
    {
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Work Area</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var child in childGroups)
                {
                    <tr>
                        <td><a href="/config/groups/@child.CtrlNbr">@child.Name</a></td>
                        <td>
                            @if (child.IsWorkArea)
                            {
                                <span class="badge bg-success">Yes</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">No child groups.</p>
    }
    } @* end overview tab *@

    @if (activeTab == "attributes")
    {
    <h3>Attributes</h3>

    @if (attributeDefinitions is not null && attributeDefinitions.Count > 0)
    {
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Attribute</th>
                    <th>Type</th>
                    <th>Required</th>
                    <th>Value</th>
                    <th style="width: 120px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ad in attributeDefinitions)
                {
                    var existingValue = attributeValues?.FirstOrDefault(v => v.AttributeDefinitionCtrlNbr == ad.CtrlNbr);
                    var currentValue = GetEditableValue(ad.CtrlNbr);
                    <tr>
                        <td>@ad.AttributeName</td>
                        <td><code>@ad.DataType</code></td>
                        <td>
                            @if (ad.IsRequired)
                            {
                                <span class="badge bg-warning">Required</span>
                            }
                        </td>
                        <td>
                            <input type="text" class="form-control form-control-sm"
                                   value="@currentValue"
                                   @onchange="(e) => OnAttributeValueChanged(ad.CtrlNbr, e.Value?.ToString())" />
                        </td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => SaveAttributeValue(ad.CtrlNbr)">Save</button>
                            @if (existingValue is not null)
                            {
                                <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => DeleteAttributeValue(existingValue.CtrlNbr)">Clear</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">No attribute definitions for this group type. <a href="/config/group-types/@group.GroupTypeCtrlNbr">Define attributes on the group type.</a></p>
    }
    } @* end attributes tab *@
}

@code {
    [Parameter]
    public long CtrlNbr { get; set; }

    private GroupResponse? group;
    private string groupTypeName = "";

    private string activeTab = "overview";
    private static readonly IReadOnlyList<TabPanel.TabItem> tabs =
    [
        new("overview", "Overview", "bi bi-diagram-3"),
        new("attributes", "Attributes", "bi bi-tags")
    ];

    private void NavigateBack() => NavigationManager.NavigateTo($"/config/group-types/{group?.GroupTypeCtrlNbr}");
    private IReadOnlyList<GroupResponse>? childGroups;
    private IReadOnlyList<GroupResponse>? ancestors;
    private Dictionary<long, string> groupTypeNames = new();
    private IReadOnlyList<AttributeDefinitionResponse>? attributeDefinitions;
    private IReadOnlyList<AttributeValueResponse>? attributeValues;
    private Dictionary<long, string> editableValues = new();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await LoadGroup();
        await LoadGroupTypeNames();
        await LoadAncestors();
        await LoadChildGroups();
        await LoadAttributes();
    }

    private async Task LoadGroup()
    {
        try
        {
            errorMessage = null;
            group = await ConfigClient.GetGroupAsync(CtrlNbr);
            var gt = await ConfigClient.GetGroupTypeAsync(group.GroupTypeCtrlNbr);
            groupTypeName = gt.Name;
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load group: {ex.Message}";
        }
    }

    private async Task LoadChildGroups()
    {
        try
        {
            var response = await ConfigClient.GetAllGroupsAsync(CtrlNbr);
            childGroups = response.Groups;
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load child groups: {ex.Message}";
        }
    }

    private async Task LoadAncestors()
    {
        try
        {
            var response = await ConfigClient.GetAncestorsAsync(CtrlNbr);
            ancestors = response.Groups;
        }
        catch
        {
            ancestors = [];
        }
    }

    private async Task LoadGroupTypeNames()
    {
        try
        {
            var response = await ConfigClient.GetAllGroupTypesAsync();
            groupTypeNames = response.GroupTypes.ToDictionary(gt => gt.CtrlNbr, gt => gt.Name);
        }
        catch
        {
            groupTypeNames = new();
        }
    }

    private string GetGroupTypeName(long groupTypeCtrlNbr)
    {
        return groupTypeNames.TryGetValue(groupTypeCtrlNbr, out var name) ? name : "";
    }

    private List<TreeNode> BuildGroupHierarchy()
    {
        if (group is null) return [];

        // Build the current node
        var currentNode = new TreeNode
        {
            Label = group.Name,
            Subtitle = $"({groupTypeName})",
            IsHighlighted = true,
            Badge = group.IsWorkArea ? "Work Area" : null,
            BadgeClass = "bg-success",
            Children = (childGroups ?? []).Select(child => new TreeNode
            {
                Label = child.Name,
                Href = $"/config/groups/{child.CtrlNbr}",
                Subtitle = $"({GetGroupTypeName(child.GroupTypeCtrlNbr)})",
                Badge = child.IsWorkArea ? "Work Area" : null,
                BadgeClass = "bg-success"
            }).ToList()
        };

        // Wrap ancestors around the current node (innermost → outermost)
        if (ancestors is not null)
        {
            foreach (var ancestor in ancestors)
            {
                currentNode = new TreeNode
                {
                    Label = ancestor.Name,
                    Href = $"/config/groups/{ancestor.CtrlNbr}",
                    Subtitle = $"({GetGroupTypeName(ancestor.GroupTypeCtrlNbr)})",
                    Children = [currentNode]
                };
            }
        }

        return [currentNode];
    }

    // Attribute Values
    private async Task LoadAttributes()
    {
        try
        {
            if (group is null) return;
            var defsResponse = await ConfigClient.GetAttributeDefinitionsAsync(group.GroupTypeCtrlNbr);
            attributeDefinitions = defsResponse.AttributeDefinitions;

            var valsResponse = await ConfigClient.GetAttributeValuesAsync(CtrlNbr);
            attributeValues = valsResponse.AttributeValues;

            editableValues.Clear();
            foreach (var ad in attributeDefinitions)
            {
                var existing = attributeValues.FirstOrDefault(v => v.AttributeDefinitionCtrlNbr == ad.CtrlNbr);
                editableValues[ad.CtrlNbr] = existing?.Value ?? ad.DefaultValue ?? "";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load attributes: {ex.Message}";
        }
    }

    private string GetEditableValue(long attrDefCtrlNbr)
    {
        return editableValues.TryGetValue(attrDefCtrlNbr, out var val) ? val : "";
    }

    private void OnAttributeValueChanged(long attrDefCtrlNbr, string? value)
    {
        editableValues[attrDefCtrlNbr] = value ?? "";
    }

    private async Task SaveAttributeValue(long attrDefCtrlNbr)
    {
        try
        {
            errorMessage = null;
            var value = GetEditableValue(attrDefCtrlNbr);
            await ConfigClient.SetAttributeValueAsync(CtrlNbr, attrDefCtrlNbr, value);
            await LoadAttributes();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save attribute value: {ex.Message}";
        }
    }

    private async Task DeleteAttributeValue(long valueCtrlNbr)
    {
        try
        {
            errorMessage = null;
            await ConfigClient.DeleteAttributeValueAsync(valueCtrlNbr);
            await LoadAttributes();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to clear attribute value: {ex.Message}";
        }
    }
}
