@page "/config/groups/{CtrlNbr:long}"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using CrewService.BlazorUI.Clients
@using CrewService.BlazorUI.Models
@using CrewService.Presentation

@inherits AppComponentBase

@attribute [Authorize]

@inject TenantConfigClient ConfigClient

<PageTitle>Group Detail</PageTitle>

@if (errorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (group is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <BackNavButton Text="@groupTypeName" OnClick="NavigateBack" />

    <h1>@group.Name</h1>
    @if (group.IsWorkArea)
    {
        <span class="badge bg-success mb-2">Work Area</span>
    }

    <hr />

    <TabPanel Tabs="tabs" @bind-ActiveTab="activeTab" />

    @if (activeTab == "overview")
    {
    @* ?????????????????????????????????????????????????????????????????? *@
    @* Child Groups                                                        *@
    @* ?????????????????????????????????????????????????????????????????? *@

    @if (DirectChildren.Count > 0)
    {
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Work Area</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var child in DirectChildren)
                {
                    <tr>
                        <td><a href="/config/groups/@child.CtrlNbr">@child.Name</a></td>
                        <td>
                            @if (child.IsWorkArea)
                            {
                                <span class="badge bg-success">Yes</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">No child groups.</p>
    }
    } @* end overview tab *@

    @if (activeTab == "hierarchy")
    {
    @* ?????????????????????????????????????????????????????????????????? *@
    @* Hierarchy Map                                                       *@
    @* ?????????????????????????????????????????????????????????????????? *@

    <div class="card">
        <div class="card-body">
            <TreeView Nodes="BuildGroupHierarchy()" />
        </div>
    </div>
    } @* end hierarchy tab *@
}

@code {
    protected override string? FeatureKey => "config/group-types";

    [Parameter]
    public long CtrlNbr { get; set; }

    private GroupResponse? group;
    private GroupTypeResponse? groupType;
    private string groupTypeName = "";

    private string activeTab = "overview";
    private static readonly IReadOnlyList<TabPanel.TabItem> tabs =
    [
        new("overview", "Overview", "bi bi-collection"),
        new("hierarchy", "Hierarchy", "bi bi-diagram-3")
    ];

    private void NavigateBack() => NavigationManager.NavigateTo($"/config/group-types/{group?.GroupTypeCtrlNbr}");
    private IReadOnlyList<GroupResponse>? descendants;
    private IReadOnlyList<GroupResponse>? ancestors;
    private Dictionary<long, string> groupTypeNames = new();

    private IReadOnlyList<GroupResponse> DirectChildren =>
        descendants?.Where(d => d.ParentGroupCtrlNbr == CtrlNbr).ToList() ?? [];

    protected override async Task LoadDataAsync()
    {
        await LoadGroup();
        await LoadGroupTypeNames();
        await LoadAncestors();
        await LoadDescendants();
    }

    protected override async Task OnAppContextChangedAsync()
    {
        if (groupType is not null && !IsGroupTypeInScope(groupType))
        {
            NavigationManager.NavigateTo("/config/group-types");
            return;
        }

        await LoadGroup();
        await LoadGroupTypeNames();
        await LoadAncestors();
        await LoadDescendants();
    }

    private bool IsGroupTypeInScope(GroupTypeResponse gt)
    {
        if (SelectedRailroadCtrlNbr is long railroadCtrlNbr)
            return gt.ParentCtrlNbr == SelectedParentCtrlNbr && (gt.RailroadCtrlNbr == railroadCtrlNbr || gt.RailroadCtrlNbr == 0);

        if (SelectedParentCtrlNbr is long parentCtrlNbr)
            return gt.ParentCtrlNbr == parentCtrlNbr && gt.RailroadCtrlNbr == 0;

        return true;
    }

    private async Task LoadGroup()
    {
        try
        {
            errorMessage = null;
            group = await ConfigClient.GetGroupAsync(CtrlNbr);
            groupType = await ConfigClient.GetGroupTypeAsync(group.GroupTypeCtrlNbr);
            groupTypeName = groupType.Name;
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load group: {ex.Message}";
        }
    }

    private async Task LoadDescendants()
    {
        try
        {
            // Load tree from the topmost ancestor so siblings at every level appear
            var rootCtrlNbr = ancestors is { Count: > 0 }
                ? ancestors[^1].CtrlNbr
                : CtrlNbr;
            var response = await ConfigClient.GetGroupTreeAsync(rootCtrlNbr);
            descendants = response.Groups;
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load group tree: {ex.Message}";
        }
    }

    private async Task LoadAncestors()
    {
        try
        {
            var response = await ConfigClient.GetAncestorsAsync(CtrlNbr);
            ancestors = response.Groups;
        }
        catch
        {
            ancestors = [];
        }
    }

    private async Task LoadGroupTypeNames()
    {
        try
        {
            var response = await ConfigClient.GetAllGroupTypesAsync();
            groupTypeNames = response.GroupTypes.ToDictionary(gt => gt.CtrlNbr, gt => gt.Name);
        }
        catch
        {
            groupTypeNames = new();
        }
    }

    private string GetGroupTypeName(long groupTypeCtrlNbr)
    {
        return groupTypeNames.TryGetValue(groupTypeCtrlNbr, out var name) ? name : "";
    }

    private List<TreeNode> BuildGroupHierarchy()
    {
        if (group is null || descendants is null or { Count: 0 }) return [];

        // The root is the topmost ancestor, or the current group if no ancestors
        var rootCtrlNbr = ancestors is { Count: > 0 }
            ? ancestors[^1].CtrlNbr
            : CtrlNbr;

        return [BuildSubtree(rootCtrlNbr, descendants)];
    }

    private TreeNode BuildSubtree(long nodeCtrlNbr, IReadOnlyList<GroupResponse> allGroups)
    {
        var node = nodeCtrlNbr == CtrlNbr
            ? group!
            : allGroups.First(d => d.CtrlNbr == nodeCtrlNbr);

        var children = allGroups
            .Where(d => d.ParentGroupCtrlNbr == nodeCtrlNbr && d.CtrlNbr != nodeCtrlNbr)
            .Select(child => BuildSubtree(child.CtrlNbr, allGroups))
            .ToList();

        return new TreeNode
        {
            Label = node.Name,
            Subtitle = $"({GetGroupTypeName(node.GroupTypeCtrlNbr)})",
            IsHighlighted = node.CtrlNbr == CtrlNbr,
            Href = node.CtrlNbr == CtrlNbr ? null : $"/config/groups/{node.CtrlNbr}",
            Badge = node.IsWorkArea ? "Work Area" : null,
            BadgeClass = "bg-success",
            Children = children
        };
    }
}
