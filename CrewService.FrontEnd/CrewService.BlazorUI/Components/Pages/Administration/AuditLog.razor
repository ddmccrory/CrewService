@page "/admin/audit-log"
@rendermode InteractiveServer

@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using CrewService.BlazorUI.Clients
@using CrewService.Presentation

@inherits AppComponentBase

@attribute [Authorize]

@inject AuditLogClient AuditLogClient

<PageTitle>Audit Log — Crew Service</PageTitle>

<h1>Audit Log</h1>
<p class="text-muted">Read-only log of all domain events recorded by the system.</p>

<div class="card mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-semibold small mb-1">From</label>
                <input type="date" class="form-control" @bind="dateFrom" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold small mb-1">To</label>
                <input type="date" class="form-control" @bind="dateTo" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold small mb-1">Search</label>
                <input type="text" class="form-control" placeholder="Search events, types, users, payload…"
                       @bind="searchText" @bind:event="oninput" @onkeydown="OnSearchKeyDown" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="button" class="btn btn-primary flex-fill" @onclick="ApplySearch">
                    <span class="bi bi-search me-1"></span>Search
                </button>
                <button type="button" class="btn btn-outline-secondary flex-fill" @onclick="ClearSearch">
                    <span class="bi bi-x-lg me-1"></span>Clear
                </button>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger d-flex align-items-center" role="alert">
        <span class="bi bi-exclamation-triangle-fill me-2"></span>@errorMessage
    </div>
}

@if (entries is null)
{
    <p class="text-muted"><em>Loading audit log…</em></p>
}
else if (entries.Count == 0)
{
    <div class="alert alert-info">No audit log entries found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th style="width:180px">Occurred At (UTC)</th>
                    <th>Event Type</th>
                    <th>Aggregate Type</th>
                    <th>Aggregate ID</th>
                    <th>Performed By</th>
                    <th>Payload</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in entries)
                {
                    <tr>
                        <td class="text-nowrap">@FormatTimestamp(entry.OccurredAt)</td>
                        <td>@FormatEventType(entry.EventType)</td>
                        <td>@entry.AggregateType</td>
                        <td>@entry.AggregateId</td>
                        <td>@entry.PerformedBy</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(entry.PayloadJson))
                            {
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => TogglePayload(entry.EventId)">
                                    <span class="bi @(IsPayloadVisible(entry.EventId) ? "bi-chevron-up" : "bi-chevron-down")"></span>
                                </button>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                    </tr>
                    @if (IsPayloadVisible(entry.EventId))
                    {
                        <tr>
                            <td colspan="6" class="bg-body-secondary text-body p-2">
                                <pre class="mb-0 small" style="max-height:200px; overflow:auto; white-space:pre-wrap;">@entry.PayloadJson</pre>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-2">
        <p class="text-muted small mb-0">Showing @((currentPage - 1) * pageSize + 1)–@((currentPage - 1) * pageSize + entries.Count) of @totalCount entries.</p>

        @if (totalPages > 1)
        {
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <button class="page-link" @onclick="() => GoToPageAsync(currentPage - 1)" disabled="@(currentPage <= 1)">Previous</button>
                    </li>
                    @foreach (var p in GetVisiblePages())
                    {
                        @if (p == -1)
                        {
                            <li class="page-item disabled"><span class="page-link">…</span></li>
                        }
                        else
                        {
                            <li class="page-item @(p == currentPage ? "active" : "")">
                                <button class="page-link" @onclick="() => GoToPageAsync(p)">@p</button>
                            </li>
                        }
                    }
                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <button class="page-link" @onclick="() => GoToPageAsync(currentPage + 1)" disabled="@(currentPage >= totalPages)">Next</button>
                    </li>
                </ul>
            </nav>
        }
    </div>
}

@code {
    protected override string? FeatureKey => "admin/audit-log";

    private IReadOnlyList<AuditLogEntry>? entries;
    private int totalCount;
    private int currentPage = 1;
    private const int pageSize = 250;
    private int totalPages => totalCount > 0 ? (int)Math.Ceiling((double)totalCount / pageSize) : 1;
    private readonly HashSet<string> expandedPayloads = new();

    private string? searchText;
    private DateTime? dateFrom;
    private DateTime? dateTo;

    protected override async Task LoadDataAsync()
    {
        RequireFeatureAccess();
        await LoadEntriesAsync();
    }

    private async Task LoadEntriesAsync()
    {
        try
        {
            var response = await AuditLogClient.GetAllAsync(
                pageNumber: currentPage,
                pageSize: pageSize,
                searchText: searchText,
                dateFrom: dateFrom?.ToString("O"),
                dateTo: dateTo?.Date.AddDays(1).AddTicks(-1).ToString("O"));
            entries = response.Entries;
            totalCount = response.TotalCount;
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load audit log: {ex.Message}";
        }
    }

    private async Task ApplySearch()
    {
        currentPage = 1;
        entries = null;
        await LoadEntriesAsync();
    }

    private async Task ClearSearch()
    {
        searchText = null;
        dateFrom = null;
        dateTo = null;
        currentPage = 1;
        entries = null;
        await LoadEntriesAsync();
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await ApplySearch();
    }

    private void TogglePayload(string eventId)
    {
        if (!expandedPayloads.Remove(eventId))
            expandedPayloads.Add(eventId);
    }

    private bool IsPayloadVisible(string eventId) => expandedPayloads.Contains(eventId);

    private static string FormatEventType(string eventType)
    {
        // Strip "DomainEvent" suffix for cleaner display
        const string suffix = "DomainEvent";
        if (eventType.EndsWith(suffix, StringComparison.Ordinal))
            return eventType[..^suffix.Length];
        return eventType;
    }

    private async Task GoToPageAsync(int page)
    {
        if (page < 1 || page > totalPages || page == currentPage)
            return;
        currentPage = page;
        entries = null;
        await LoadEntriesAsync();
    }

    private List<int> GetVisiblePages()
    {
        var pages = new List<int>();
        const int wing = 2; // pages shown around current

        pages.Add(1);

        var start = Math.Max(2, currentPage - wing);
        var end = Math.Min(totalPages - 1, currentPage + wing);

        if (start > 2)
            pages.Add(-1); // ellipsis

        for (var i = start; i <= end; i++)
            pages.Add(i);

        if (end < totalPages - 1)
            pages.Add(-1); // ellipsis

        if (totalPages > 1)
            pages.Add(totalPages);

        return pages;
    }

    private static string FormatTimestamp(string isoUtc)
    {
        if (DateTime.TryParse(isoUtc, CultureInfo.InvariantCulture,
                DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal, out var dt))
            return dt.ToString("yyyy-MM-dd HH:mm:ss 'UTC'", CultureInfo.InvariantCulture);
        return isoUtc;
    }
}
