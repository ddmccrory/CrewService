        public string Name { get; set; } = string.Empty;
        public bool CanStartFromTrigger { get; set; } = true;
        public long TriggerTypeCtrlNbr { get; set; }
        public string TriggerTypeName { get; set; } = string.Empty;
        public string TriggerConditionGroupOperator { get; set; } = "ALL";
        public List<WorkflowConditionDraft> TriggerConditions { get; set; } = [];
        public bool IsEnabled { get; set; } = true;
        public string Status { get; set; } = "Draft";
        public int CurrentVersionNumber { get; set; }
        public int StepCount { get; set; }
        public List<WorkflowStepDraft> Steps { get; set; } = [];
        public List<WorkflowTemplateVersion> Versions { get; set; } = [];
    }

    private readonly List<TriggerDefinition> triggerDefinitions = [];

    private readonly IReadOnlyList<DataTableColumn<WorkflowTemplateDraft>> workflowColumns =
    [
        new("Name", w => w.Name),
        new("Trigger Mode", w => w.CanStartFromTrigger ? "Enabled" : "Disabled", width: "180px"),
        new("Trigger Name", w => w.CanStartFromTrigger && !string.IsNullOrWhiteSpace(w.TriggerTypeName) ? w.TriggerTypeName : "—", width: "260px"),
        new("Status", w => w.Status, width: "140px"),
        new("Enabled", w => w.IsEnabled ? "Enabled" : "Disabled", width: "120px"),
        new("Version", w => w.CurrentVersionNumber > 0 ? $"v{w.CurrentVersionNumber}" : "Draft", width: "120px"),
        new("Steps", w => w.StepCount, width: "90px"),
        DataTableColumn<WorkflowTemplateDraft>.Actions("340px")
    ];

    private readonly IReadOnlyList<DataTableColumn<WorkflowExecutionHistoryItem>> workflowHistoryColumns =
    [
        new("Started (Local)", h => h.StartedAtDisplay, width: "180px"),
        new("Status", h => h.Status, width: "120px"),
        new("Version", h => h.WorkflowVersionNumber, width: "100px"),
        new("Trigger", h => h.TriggerType, width: "220px"),
        new("Aggregate", h => h.AggregateDisplay, width: "220px"),
        new("Details", h => h.DetailsSummary)
    ];

    private readonly List<(long CtrlNbr, string Code, string Name)> effectTypeOptions = [];
    private readonly List<WorkflowOperatorOption> operatorTypeOptions = [];
    private readonly Dictionary<long, string> triggerTypeNameByCtrlNbr = [];
    private long addToRosterBoardEffectTypeCtrlNbr;
    private long sendInvitationEffectTypeCtrlNbr;
    private long callWorkflowEffectTypeCtrlNbr;
    private long departmentNameMetadataFieldTypeCtrlNbr;
    private long craftNameMetadataFieldTypeCtrlNbr;
    private long seniorityStateNameMetadataFieldTypeCtrlNbr;
    private long newSeniorityStateMetadataFieldTypeCtrlNbr;

    private readonly List<RoleOption> roleOptions = [];
    private readonly Dictionary<long, List<string>> triggerFilterValueOptionsByFieldCtrlNbr = [];

    private static readonly List<string> boardTypeOptions =
    [
        "Hangout",
        "Extended Absence",
        "Extra Board",
        "Training",
        "New Hires"
    ];

    private static readonly List<(string Value, string Label)> invitationEmailSourceOptions =
    [
        ("primary", "Primary Email")
    ];

    private readonly List<WorkflowTemplateDraft> workflows = [];

    private WorkflowTemplateDraft? activeWorkflow;
    private WorkflowTemplateDraft? historyWorkflow;
    private bool isPageLoading = true;
    private bool showWorkflowDetailsModal;
    private bool showWorkflowHistoryModal;
    private bool isHistoryLoading;
    private List<WorkflowExecutionHistoryItem> workflowHistoryEntries = [];
    private string versionNotes = string.Empty;
    private string? statusMessage;
    private string detailsModalTitle = "Workflow Details";
    private string historyModalTitle = "Workflow History";

    private static bool WorkflowSearchFilter(WorkflowTemplateDraft workflow, string term)
    {
        return workflow.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
            || (workflow.CanStartFromTrigger ? "Enabled" : "Disabled").Contains(term, StringComparison.OrdinalIgnoreCase)
            || workflow.TriggerTypeName.Contains(term, StringComparison.OrdinalIgnoreCase)
            || workflow.Status.Contains(term, StringComparison.OrdinalIgnoreCase);
    }

    private static bool WorkflowHistorySearchFilter(WorkflowExecutionHistoryItem entry, string term)
    {
        return entry.StartedAtDisplay.Contains(term, StringComparison.OrdinalIgnoreCase)
            || entry.Status.Contains(term, StringComparison.OrdinalIgnoreCase)
            || entry.TriggerType.Contains(term, StringComparison.OrdinalIgnoreCase)
            || entry.AggregateDisplay.Contains(term, StringComparison.OrdinalIgnoreCase)
            || entry.DetailsSummary.Contains(term, StringComparison.OrdinalIgnoreCase);
    }

    protected override async Task LoadDataAsync()
    {
        isPageLoading = true;
        try
        {
            RequireFeatureAccess();

            await LoadRoleOptionsAsync();

            triggerDefinitions.Clear();
            effectTypeOptions.Clear();
            operatorTypeOptions.Clear();
            triggerTypeNameByCtrlNbr.Clear();
            addToRosterBoardEffectTypeCtrlNbr = 0;
            sendInvitationEffectTypeCtrlNbr = 0;
            callWorkflowEffectTypeCtrlNbr = 0;
            departmentNameMetadataFieldTypeCtrlNbr = 0;
            craftNameMetadataFieldTypeCtrlNbr = 0;
            seniorityStateNameMetadataFieldTypeCtrlNbr = 0;
            newSeniorityStateMetadataFieldTypeCtrlNbr = 0;

            workflows.Clear();

            if (!HasRailroad || SelectedRailroadCtrlNbr is null)
                return;

            await LoadReferenceCatalogAsync(SelectedRailroadCtrlNbr.Value);
            await LoadTriggerFilterValueOptionsAsync();

            var response = await WorkflowTemplatesClient.GetByRailroadAsync(SelectedRailroadCtrlNbr.Value);
            workflows.AddRange(response.Workflows.Select(MapSummary));

            foreach (var workflow in workflows)
                ReorderSteps(workflow.Steps);

            if (activeWorkflow is not null)
                activeWorkflow = workflows.FirstOrDefault(w => w.CtrlNbr == activeWorkflow.CtrlNbr);
        }
        finally
        {
            isPageLoading = false;
        }
    }

    private async Task LoadRoleOptionsAsync()
    {
        try
        {
            var response = await AuthorizationClient.GetAllRolesAsync();

            roleOptions.Clear();
            roleOptions.AddRange(response.Roles
                .Where(role => !role.Name.Equals("SystemAdmin", StringComparison.OrdinalIgnoreCase))
                .OrderBy(role => role.Level)
                .ThenBy(role => role.Name, StringComparer.OrdinalIgnoreCase)
                .Select(role => new RoleOption
                {
                    CtrlNbr = role.CtrlNbr,
                    Name = role.Name,
                    Level = role.Level
                })
                .GroupBy(role => role.CtrlNbr)
                .Select(group => group.First()));
        }
        catch
        {
            roleOptions.Clear();
        }
    }

    private async Task LoadTriggerFilterValueOptionsAsync()
    {
        triggerFilterValueOptionsByFieldCtrlNbr.Clear();

        if (SelectedParentCtrlNbr is not long parentCtrlNbr || SelectedRailroadCtrlNbr is not long railroadCtrlNbr)
            return;

        try
        {
            var departmentsResponse = await DepartmentClient.GetAllAsync(parentCtrlNbr, railroadCtrlNbr);
            var departmentNames = departmentsResponse.Departments
                .Select(d => d.Name)
                .Where(name => !string.IsNullOrWhiteSpace(name))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(name => name, StringComparer.OrdinalIgnoreCase)
                .ToList();
            if (departmentNameMetadataFieldTypeCtrlNbr > 0)
                triggerFilterValueOptionsByFieldCtrlNbr[departmentNameMetadataFieldTypeCtrlNbr] = departmentNames;
        }
        catch
        {
            if (departmentNameMetadataFieldTypeCtrlNbr > 0)
                triggerFilterValueOptionsByFieldCtrlNbr[departmentNameMetadataFieldTypeCtrlNbr] = [];
        }

        try
        {
            var craftsResponse = await CraftClient.GetAllCraftsAsync(parentCtrlNbr, railroadCtrlNbr);
            var craftNames = craftsResponse.Crafts
                .Select(c => c.CraftName)
                .Where(name => !string.IsNullOrWhiteSpace(name))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(name => name, StringComparer.OrdinalIgnoreCase)
                .ToList();
            if (craftNameMetadataFieldTypeCtrlNbr > 0)
                triggerFilterValueOptionsByFieldCtrlNbr[craftNameMetadataFieldTypeCtrlNbr] = craftNames;
        }
        catch
        {
            if (craftNameMetadataFieldTypeCtrlNbr > 0)
                triggerFilterValueOptionsByFieldCtrlNbr[craftNameMetadataFieldTypeCtrlNbr] = [];
        }

        try
        {
            var statesResponse = await SeniorityStateClient.GetAllAsync(parentCtrlNbr);
            var stateNames = statesResponse.States
                .Select(s => s.StateDescription)
                .Where(name => !string.IsNullOrWhiteSpace(name))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(name => name, StringComparer.OrdinalIgnoreCase)
                .ToList();

            if (seniorityStateNameMetadataFieldTypeCtrlNbr > 0)
                triggerFilterValueOptionsByFieldCtrlNbr[seniorityStateNameMetadataFieldTypeCtrlNbr] = stateNames;

            if (stateNames.Count > 0 && newSeniorityStateMetadataFieldTypeCtrlNbr > 0)
                triggerFilterValueOptionsByFieldCtrlNbr[newSeniorityStateMetadataFieldTypeCtrlNbr] = stateNames;
        }
        catch
        {
            if (seniorityStateNameMetadataFieldTypeCtrlNbr > 0)
                triggerFilterValueOptionsByFieldCtrlNbr[seniorityStateNameMetadataFieldTypeCtrlNbr] = [];
        }
    }

    private async Task LoadReferenceCatalogAsync(long railroadCtrlNbr)
    {
        var response = await WorkflowTemplatesClient.GetReferenceCatalogAsync(railroadCtrlNbr);

        operatorTypeOptions.AddRange(response.OperatorTypes
            .Select(o => new WorkflowOperatorOption
            {
                CtrlNbr = o.CtrlNbr,
                Code = o.Code,
                Name = o.Name
            })
            .OrderBy(o => o.Name, StringComparer.OrdinalIgnoreCase));

        foreach (var trigger in response.TriggerTypes)
            triggerTypeNameByCtrlNbr[trigger.CtrlNbr] = trigger.Name;

        foreach (var effect in response.EffectTypes)
            effectTypeOptions.Add((effect.CtrlNbr, effect.Code, effect.Name));

        effectTypeOptions.Sort((a, b) => StringComparer.OrdinalIgnoreCase.Compare(a.Name, b.Name));

        var metadataFieldsByCtrlNbr = response.MetadataFieldTypes
            .ToDictionary(
                m => m.CtrlNbr,
                m => new TriggerMetadataFieldDefinition
                {
                    CtrlNbr = m.CtrlNbr,
                    Key = m.Code,
                    Label = m.Name,
                    AllowedValues = [],
                    AllowedOperators = operatorTypeOptions.ToList()
                });

        addToRosterBoardEffectTypeCtrlNbr = response.EffectTypes
            .FirstOrDefault(e => string.Equals(e.Code, "Add to Roster Board", StringComparison.Ordinal))?.CtrlNbr ?? 0;
        sendInvitationEffectTypeCtrlNbr = response.EffectTypes
            .FirstOrDefault(e => string.Equals(e.Code, "Send Invitation", StringComparison.Ordinal))?.CtrlNbr ?? 0;
        callWorkflowEffectTypeCtrlNbr = response.EffectTypes
            .FirstOrDefault(e => string.Equals(e.Code, "Call Workflow", StringComparison.Ordinal))?.CtrlNbr ?? 0;

        departmentNameMetadataFieldTypeCtrlNbr = response.MetadataFieldTypes
            .FirstOrDefault(m => string.Equals(m.Code, "departmentName", StringComparison.Ordinal))?.CtrlNbr ?? 0;
        craftNameMetadataFieldTypeCtrlNbr = response.MetadataFieldTypes
            .FirstOrDefault(m => string.Equals(m.Code, "craftName", StringComparison.Ordinal))?.CtrlNbr ?? 0;
        seniorityStateNameMetadataFieldTypeCtrlNbr = response.MetadataFieldTypes
            .FirstOrDefault(m => string.Equals(m.Code, "seniorityStateName", StringComparison.Ordinal))?.CtrlNbr ?? 0;
        newSeniorityStateMetadataFieldTypeCtrlNbr = response.MetadataFieldTypes
            .FirstOrDefault(m => string.Equals(m.Code, "newSeniorityState", StringComparison.Ordinal))?.CtrlNbr ?? 0;

        var metadataFieldCtrlNbrByTriggerCtrlNbr = response.TriggerMetadataFieldMaps
            .GroupBy(m => m.TriggerTypeCtrlNbr)
            .ToDictionary(
                g => g.Key,
                g => g.Select(m => m.MetadataFieldTypeCtrlNbr).Distinct().ToList());

        triggerDefinitions.AddRange(response.TriggerTypes
            .Select(trigger => new TriggerDefinition
            {
                CtrlNbr = trigger.CtrlNbr,
                Name = trigger.Name,
                MetadataFields = metadataFieldCtrlNbrByTriggerCtrlNbr.TryGetValue(trigger.CtrlNbr, out var mappedFields)
                    ? mappedFields
                        .Where(metadataFieldsByCtrlNbr.ContainsKey)
                        .Select(ctrlNbr => metadataFieldsByCtrlNbr[ctrlNbr])
                        .OrderBy(f => f.Label, StringComparer.OrdinalIgnoreCase)
                        .ToList()
                    : []
            })
            .OrderBy(t => t.Name, StringComparer.OrdinalIgnoreCase));
    }

    private async Task CreateWorkflow()
    {
        if (!HasRailroad || SelectedRailroadCtrlNbr is null)
            return;

        var created = await WorkflowTemplatesClient.CreateAsync(
            SelectedRailroadCtrlNbr.Value,
            $"New Workflow {workflows.Count + 1}",
            canStartFromTrigger: true,
            triggerTypeCtrlNbr: 0,
            isEnabled: true);

        await LoadDataAsync();
        await OpenWorkflowDetails(created.CtrlNbr);
    }

    private async Task DeleteWorkflow(Guid workflowId)
    {
        var workflow = workflows.FirstOrDefault(w => w.Id == workflowId);
        if (workflow is null)
            return;

        await WorkflowTemplatesClient.DeleteAsync(workflow.CtrlNbr);

        if (activeWorkflow?.Id == workflowId)
            CloseWorkflowDetails();

        await LoadDataAsync();
    }

    private async Task ToggleWorkflowEnabled(Guid workflowId)
    {
        var workflow = workflows.FirstOrDefault(w => w.Id == workflowId);
        if (workflow is null)
            return;

        workflow.IsEnabled = !workflow.IsEnabled;
        await WorkflowTemplatesClient.SetEnabledAsync(workflow.CtrlNbr, workflow.IsEnabled);
        await LoadDataAsync();
    }

    private void ToggleActiveWorkflowEnabled()
    {
        if (activeWorkflow is null)
            return;

        activeWorkflow.IsEnabled = !activeWorkflow.IsEnabled;
        MarkActiveWorkflowAsDraft();
    }

    private async Task OpenWorkflowDetails(Guid workflowId)
    {
        var workflow = workflows.FirstOrDefault(w => w.Id == workflowId);
        if (workflow is null)
            return;

        await OpenWorkflowDetails(workflow.CtrlNbr);
    }

    private async Task OpenWorkflowHistory(Guid workflowId)
    {
        var workflow = workflows.FirstOrDefault(w => w.Id == workflowId);
        if (workflow is null)
            return;

        historyWorkflow = workflow;
        historyModalTitle = $"Workflow History — {workflow.Name}";
        showWorkflowHistoryModal = true;
        isHistoryLoading = true;
        workflowHistoryEntries = [];

        try
        {
            var response = await WorkflowTemplatesClient.GetExecutionHistoryAsync(workflow.CtrlNbr, take: 200);
            workflowHistoryEntries = response.Entries
                .Select(e => new WorkflowExecutionHistoryItem
                {
                    Status = e.Status,
                    TriggerType = ResolveTriggerTypeName(e.TriggerTypeCtrlNbr),
                    WorkflowVersionNumber = e.WorkflowVersionNumber,
                    StartedAtDisplay = FormatDisplayLocal(e.StartedAtUtc),
                    AggregateDisplay = string.IsNullOrWhiteSpace(e.AggregateDisplay)
                        ? (e.AggregateCtrlNbr > 0 ? e.AggregateCtrlNbr.ToString() : "—")
                        : e.AggregateDisplay,
                    DetailsSummary = BuildHistoryDetailsSummary(
                        !string.IsNullOrWhiteSpace(e.DetailsDisplayJson)
                            ? e.DetailsDisplayJson
                            : e.DetailsJson)
                })
                .ToList();
        }
        finally
        {
            isHistoryLoading = false;
        }
    }

    private async Task OpenWorkflowDetails(long ctrlNbr)
    {
        var detail = await WorkflowTemplatesClient.GetByCtrlNbrAsync(ctrlNbr);
        activeWorkflow = MapDetail(detail);
        if (activeWorkflow is null)
            return;

        CollapseAllSteps(activeWorkflow);

        detailsModalTitle = $"Workflow Details — {activeWorkflow.Name}";
        showWorkflowDetailsModal = true;
        versionNotes = string.Empty;
        statusMessage = null;
    }

    private void CloseWorkflowDetails()
    {
        showWorkflowDetailsModal = false;
        activeWorkflow = null;
        statusMessage = null;
        versionNotes = string.Empty;
        detailsModalTitle = "Workflow Details";
    }

    private void CloseWorkflowHistory()
    {
        showWorkflowHistoryModal = false;
        isHistoryLoading = false;
        historyWorkflow = null;
        workflowHistoryEntries = [];
        historyModalTitle = "Workflow History";
    }

    private void AddStepToActiveWorkflow()
    {
        if (activeWorkflow is null)
            return;

        activeWorkflow.Steps.Add(CreateDefaultStep(activeWorkflow.Steps.Count + 1));

        MarkActiveWorkflowAsDraft();
        statusMessage = "Added a new workflow step.";
        ReorderSteps(activeWorkflow.Steps);
        ReorderEffects(activeWorkflow.Steps[^1]);
    }

    private void RemoveStep(Guid id)
    {
        if (activeWorkflow is null)
            return;

        var removed = activeWorkflow.Steps.RemoveAll(s => s.Id == id);
        if (removed > 0)
        {
            MarkActiveWorkflowAsDraft();
            statusMessage = "Removed workflow step.";
            ReorderSteps(activeWorkflow.Steps);
        }
    }

    private void MoveStepUp(int index)
    {
        if (activeWorkflow is null || index <= 0 || index >= activeWorkflow.Steps.Count)
            return;

        (activeWorkflow.Steps[index - 1], activeWorkflow.Steps[index]) = (activeWorkflow.Steps[index], activeWorkflow.Steps[index - 1]);
        MarkActiveWorkflowAsDraft();
        statusMessage = "Reordered workflow steps.";
        ReorderSteps(activeWorkflow.Steps);
    }

    private void ToggleStepEnabled(WorkflowStepDraft step)
    {
        step.IsEnabled = !step.IsEnabled;
        MarkActiveWorkflowAsDraft();
    }

    private void ToggleEffectEnabled(WorkflowEffectDraft effect)
    {
        effect.IsEnabled = !effect.IsEnabled;
        MarkActiveWorkflowAsDraft();
    }

    private static void ToggleStepExpanded(WorkflowStepDraft step)
    {
        step.IsExpanded = !step.IsExpanded;
    }

    private static string GetStepConditionSummary(WorkflowStepDraft step)
    {
        if (step.Conditions.Count == 0)
            return "Runs when reached";

        return $"{step.ConditionGroupOperator} {step.Conditions.Count} filter{(step.Conditions.Count == 1 ? string.Empty : "s")}";
    }

    private static string GetStepEffectSummary(WorkflowStepDraft step)
    {
        var enabledEffectCount = step.Effects.Count(e => e.IsEnabled);
        if (enabledEffectCount == 0)
            return "No enabled effects";

        return $"{enabledEffectCount} enabled effect{(enabledEffectCount == 1 ? string.Empty : "s")}";
    }

    private void MoveStepDown(int index)
    {
        if (activeWorkflow is null || index < 0 || index >= activeWorkflow.Steps.Count - 1)
            return;

        (activeWorkflow.Steps[index + 1], activeWorkflow.Steps[index]) = (activeWorkflow.Steps[index], activeWorkflow.Steps[index + 1]);
        MarkActiveWorkflowAsDraft();
        statusMessage = "Reordered workflow steps.";
        ReorderSteps(activeWorkflow.Steps);
    }

    private void AddEffect(WorkflowStepDraft step)
    {
        if (activeWorkflow is null)
            return;

        step.Effects.Add(CreateDefaultEffect(activeWorkflow, step.Effects.Count + 1));
        ReorderEffects(step);
        MarkActiveWorkflowAsDraft();
    }

    private void AddCondition(WorkflowStepDraft step)
    {
        if (activeWorkflow is null)
            return;

        if (!HasMetadataFieldsForActiveWorkflow())
            return;

        var condition = CreateDefaultCondition();
        if (condition is null)
            return;

        step.Conditions.Add(condition);
        MarkActiveWorkflowAsDraft();
    }

    private void RemoveEffect(WorkflowStepDraft step, Guid effectId)
    {
        if (step.Effects.Count <= 1)
            return;

        var removed = step.Effects.RemoveAll(e => e.Id == effectId);
        if (removed > 0)
        {
            ReorderEffects(step);
            MarkActiveWorkflowAsDraft();
        }
    }

    private void MoveEffectUp(WorkflowStepDraft step, int index)
    {
        if (index <= 0 || index >= step.Effects.Count)
            return;

        (step.Effects[index - 1], step.Effects[index]) = (step.Effects[index], step.Effects[index - 1]);
        ReorderEffects(step);
        MarkActiveWorkflowAsDraft();
    }

    private void MoveEffectDown(WorkflowStepDraft step, int index)
    {
        if (index < 0 || index >= step.Effects.Count - 1)
            return;

        (step.Effects[index + 1], step.Effects[index]) = (step.Effects[index], step.Effects[index + 1]);
        ReorderEffects(step);
        MarkActiveWorkflowAsDraft();
    }

    private void OnEffectChanged(WorkflowStepDraft step, WorkflowEffectDraft effect)
    {
        _ = step;

        MarkActiveWorkflowAsDraft();
    }

    private void OnActiveWorkflowTriggerChanged()
    {
        if (activeWorkflow is null)
            return;

        MarkActiveWorkflowAsDraft();
    }

    private void ToggleActiveWorkflowTriggerStart()
    {
        if (activeWorkflow is null)
            return;

        activeWorkflow.CanStartFromTrigger = !activeWorkflow.CanStartFromTrigger;
        OnTriggerToggleChanged();
    }

    private void OnTriggerToggleChanged()
    {
        if (activeWorkflow is null)
            return;

        if (!activeWorkflow.CanStartFromTrigger)
            activeWorkflow.TriggerTypeCtrlNbr = 0;

        activeWorkflow.TriggerTypeName = ResolveTriggerTypeName(activeWorkflow.TriggerTypeCtrlNbr);
        MarkActiveWorkflowAsDraft();
    }

    private void AddTriggerCondition()
    {
        if (activeWorkflow is null)
            return;

        if (!activeWorkflow.CanStartFromTrigger)
            return;

        if (!HasMetadataFieldsForActiveWorkflow())
            return;

        var condition = CreateDefaultCondition();
        if (condition is null)
            return;

        activeWorkflow.TriggerConditions.Add(condition);
        MarkActiveWorkflowAsDraft();
    }

    private void RemoveTriggerCondition(Guid conditionId)
    {
        if (activeWorkflow is null)
            return;

        var removed = activeWorkflow.TriggerConditions.RemoveAll(c => c.Id == conditionId);
        if (removed > 0)
            MarkActiveWorkflowAsDraft();
    }

    private void RemoveCondition(WorkflowStepDraft step, Guid conditionId)
    {
        var removed = step.Conditions.RemoveAll(c => c.Id == conditionId);
        if (removed > 0)
            MarkActiveWorkflowAsDraft();
    }

    private void OnTriggerConditionFieldChanged(WorkflowConditionDraft condition)
    {
        if (activeWorkflow is null)
            return;

        MarkActiveWorkflowAsDraft();
    }

    private void OnConditionFieldChanged(WorkflowStepDraft step, WorkflowConditionDraft condition)
    {
        if (activeWorkflow is null)
            return;

        MarkActiveWorkflowAsDraft();
    }

    private IEnumerable<TriggerMetadataFieldDefinition> GetMetadataFieldsForActiveWorkflow()
    {
        if (activeWorkflow is null)
            return [];

        return GetMetadataFieldsForTrigger(activeWorkflow.TriggerTypeCtrlNbr)
            .Where(field => GetAllowedValuesForField(field).Count > 0);
    }

    private bool HasMetadataFieldsForActiveWorkflow()
    {
        return activeWorkflow is not null && GetMetadataFieldsForActiveWorkflow().Any();
    }

    private IEnumerable<string> GetCallableWorkflowNames(Guid callerWorkflowId)
    {
        return workflows
            .Where(w => w.Id != callerWorkflowId)
            .Select(w => w.Name)
            .OrderBy(name => name, StringComparer.OrdinalIgnoreCase);
    }

    private IEnumerable<WorkflowOperatorOption> GetOperatorsForCondition(WorkflowConditionDraft condition)
    {
        if (activeWorkflow is null)
            return [];

        var field = GetMetadataFieldsForTrigger(activeWorkflow.TriggerTypeCtrlNbr)
            .FirstOrDefault(f => f.CtrlNbr == condition.FieldTypeCtrlNbr);

        return field?.AllowedOperators ?? [];
    }

    private IEnumerable<string> GetAllowedValuesForCondition(WorkflowConditionDraft condition)
    {
        if (activeWorkflow is null)
            return [];

        var field = GetMetadataFieldsForTrigger(activeWorkflow.TriggerTypeCtrlNbr)
            .FirstOrDefault(f => f.CtrlNbr == condition.FieldTypeCtrlNbr);

        if (field is null)
            return [];

        return GetAllowedValuesForField(field);
    }

    private IReadOnlyList<string> GetAllowedValuesForField(TriggerMetadataFieldDefinition field)
    {
        if (triggerFilterValueOptionsByFieldCtrlNbr.TryGetValue(field.CtrlNbr, out var dynamicValues)
            && dynamicValues.Count > 0)
        {
            return dynamicValues;
        }

        return field.AllowedValues;
    }

    private WorkflowStepDraft CreateDefaultStep(int order)
    {
        return new WorkflowStepDraft
        {
            Order = order,
            Name = $"Step {order}",
            IsEnabled = true,
            ConditionGroupOperator = "ALL",
            Conditions = [],
            Effects =
            [
                new WorkflowEffectDraft
                {
                    Order = 1,
                    EffectTypeCtrlNbr = 0,
                    EffectOption = string.Empty
                }
            ],
            FailurePolicy = "StopWorkflow"
        };
    }

    private WorkflowEffectDraft CreateDefaultEffect(WorkflowTemplateDraft callerWorkflow, int order)
    {
        _ = callerWorkflow;

        return new WorkflowEffectDraft
        {
            Order = order,
            EffectTypeCtrlNbr = 0,
            EffectOption = string.Empty,
            EmailSource = string.Empty,
            IsEnabled = true
        };
    }

    private static WorkflowConditionDraft CreateDefaultCondition()
    {
        return new WorkflowConditionDraft
        {
            FieldTypeCtrlNbr = 0,
            OperatorTypeCtrlNbr = 0,
            Value = string.Empty
        };
    }

    private IEnumerable<TriggerMetadataFieldDefinition> GetMetadataFieldsForTrigger(long triggerTypeCtrlNbr)
    {
        if (triggerTypeCtrlNbr <= 0)
            return [];

        var trigger = triggerDefinitions.FirstOrDefault(t => t.CtrlNbr == triggerTypeCtrlNbr);
        return trigger?.MetadataFields ?? [];
    }

    private void MarkActiveWorkflowAsDraft()
    {
        if (activeWorkflow is null)
            return;

        activeWorkflow.Status = "Draft";
    }

    private async Task SaveDraftVersionForActive()
    {
        if (activeWorkflow is null)
            return;

        await SaveWorkflowAsync(activeWorkflow, publish: false);
    }

    private async Task PublishVersionForActive()
    {
        if (activeWorkflow is null)
            return;

        await SaveWorkflowAsync(activeWorkflow, publish: true);
    }

    private async Task RestoreVersionForActive(int versionNumber)
    {
        if (activeWorkflow is null)
            return;

        var detail = await WorkflowTemplatesClient.RestoreAsDraftAsync(
            activeWorkflow.CtrlNbr,
            versionNumber,
            string.IsNullOrWhiteSpace(versionNotes)
                ? $"Restored from v{versionNumber}"
                : versionNotes.Trim());

        activeWorkflow = MapDetail(detail);
        if (activeWorkflow is not null)
            CollapseAllSteps(activeWorkflow);

        statusMessage = $"Loaded version v{versionNumber} as a draft. Save or publish to create a new version.";
        await LoadDataAsync();
        versionNotes = string.Empty;
    }

    private async Task SaveWorkflowAsync(WorkflowTemplateDraft workflow, bool publish, string? notesOverride = null)
    {
        var payload = BuildUpsertPayload(workflow, notesOverride);
        var detail = publish
            ? await WorkflowTemplatesClient.PublishAsync(workflow.CtrlNbr, payload)
            : await WorkflowTemplatesClient.SaveDraftAsync(workflow.CtrlNbr, payload);

        var mapped = MapDetail(detail);
        if (mapped is not null)
        {
            activeWorkflow = mapped;
            workflows.RemoveAll(w => w.CtrlNbr == mapped.CtrlNbr);
            workflows.Add(new WorkflowTemplateDraft
            {
                CtrlNbr = detail.CtrlNbr,
                Name = detail.Name,
                CanStartFromTrigger = detail.CanStartFromTrigger,
                TriggerTypeCtrlNbr = detail.TriggerTypeCtrlNbr,
                TriggerTypeName = ResolveTriggerTypeName(detail.TriggerTypeCtrlNbr),
                IsEnabled = detail.IsEnabled,
                Status = detail.Status,
                CurrentVersionNumber = detail.CurrentVersionNumber,
                StepCount = detail.Steps.Count
            });
        }

        statusMessage = publish
            ? $"Published version v{detail.CurrentVersionNumber}."
            : $"Saved draft version v{detail.CurrentVersionNumber}.";
        versionNotes = string.Empty;
    }

    private WorkflowTemplateUpsertPayload BuildUpsertPayload(WorkflowTemplateDraft workflow, string? notesOverride)
    {
        var payload = new WorkflowTemplateUpsertPayload
        {
            Name = workflow.Name,
            CanStartFromTrigger = workflow.CanStartFromTrigger,
            TriggerTypeCtrlNbr = workflow.CanStartFromTrigger ? workflow.TriggerTypeCtrlNbr : 0,
            IsEnabled = workflow.IsEnabled,
            TriggerConditionGroupOperator = workflow.TriggerConditionGroupOperator,
            VersionNotes = string.IsNullOrWhiteSpace(notesOverride)
                ? versionNotes.Trim()
                : notesOverride.Trim()
        };

        foreach (var triggerCondition in workflow.TriggerConditions)
        {
            payload.TriggerConditions.Add(new WorkflowConditionPayload
            {
                CtrlNbr = triggerCondition.CtrlNbr,
                FieldTypeCtrlNbr = triggerCondition.FieldTypeCtrlNbr,
                OperatorTypeCtrlNbr = triggerCondition.OperatorTypeCtrlNbr,
                Value = triggerCondition.Value
            });
        }

        foreach (var step in workflow.Steps.OrderBy(s => s.Order))
        {
            var stepPayload = new WorkflowStepUpsertPayload
            {
                CtrlNbr = step.CtrlNbr,
                Order = step.Order,
                Name = step.Name,
                IsEnabled = step.IsEnabled,
                FailurePolicy = step.FailurePolicy,
                ConditionGroupOperator = step.ConditionGroupOperator
            };

            foreach (var condition in step.Conditions)
            {
                stepPayload.Conditions.Add(new WorkflowConditionPayload
                {
                    CtrlNbr = condition.CtrlNbr,
                    FieldTypeCtrlNbr = condition.FieldTypeCtrlNbr,
                    OperatorTypeCtrlNbr = condition.OperatorTypeCtrlNbr,
                    Value = condition.Value
                });
            }

            foreach (var effect in step.Effects.OrderBy(e => e.Order))
            {
                var effectPayload = new WorkflowEffectPayload
                {
                    CtrlNbr = effect.CtrlNbr,
                    Order = effect.Order,
                    IsEnabled = effect.IsEnabled,
                    EffectTypeCtrlNbr = effect.EffectTypeCtrlNbr,
                    EffectOption = effect.EffectOption ?? string.Empty
                };

                if (IsEffectType(effect, sendInvitationEffectTypeCtrlNbr) && !string.IsNullOrWhiteSpace(effect.EffectOption))
                {
                    effectPayload.Options.Add(new WorkflowEffectOptionPayload { Key = "roleCtrlNbr", Value = effect.EffectOption });

                    effectPayload.Options.Add(new WorkflowEffectOptionPayload
                    {
                        Key = "expirationDays",
                        Value = effect.ExpirationDays.ToString()
                    });

                    effectPayload.Options.Add(new WorkflowEffectOptionPayload
                    {
                        Key = "usePrimaryEmail",
                        Value = string.Equals(effect.EmailSource, "primary", StringComparison.OrdinalIgnoreCase) ? "true" : "false"
                    });
                }

                stepPayload.Effects.Add(effectPayload);
            }

            payload.Steps.Add(stepPayload);
        }

        return payload;
    }

    private WorkflowTemplateDraft MapSummary(WorkflowTemplateSummaryResponse source)
    {
        return new WorkflowTemplateDraft
        {
            CtrlNbr = source.CtrlNbr,
            Name = source.Name,
            CanStartFromTrigger = source.CanStartFromTrigger,
            TriggerTypeCtrlNbr = source.TriggerTypeCtrlNbr,
            TriggerTypeName = ResolveTriggerTypeName(source.TriggerTypeCtrlNbr),
            IsEnabled = source.IsEnabled,
            Status = source.Status,
            CurrentVersionNumber = source.CurrentVersionNumber,
            StepCount = source.StepCount,
            Steps = []
        };
    }

    private WorkflowTemplateDraft MapDetail(WorkflowTemplateDetailResponse source)
    {
        var draft = new WorkflowTemplateDraft
        {
            CtrlNbr = source.CtrlNbr,
            Name = source.Name,
            CanStartFromTrigger = source.CanStartFromTrigger,
            TriggerTypeCtrlNbr = source.TriggerTypeCtrlNbr,
            TriggerTypeName = ResolveTriggerTypeName(source.TriggerTypeCtrlNbr),
            IsEnabled = source.IsEnabled,
            Status = source.Status,
            CurrentVersionNumber = source.CurrentVersionNumber,
            StepCount = source.Steps.Count
        };

        draft.TriggerConditionGroupOperator = string.IsNullOrWhiteSpace(source.TriggerConditionGroupOperator)
            ? "ALL"
            : source.TriggerConditionGroupOperator;

        draft.TriggerConditions = source.TriggerConditions.Select(c => new WorkflowConditionDraft
        {
            CtrlNbr = c.CtrlNbr,
            FieldTypeCtrlNbr = c.FieldTypeCtrlNbr,
            OperatorTypeCtrlNbr = c.OperatorTypeCtrlNbr,
            Value = c.Value
        }).ToList();

        draft.Steps.AddRange(source.Steps.Select(step => new WorkflowStepDraft
        {
            CtrlNbr = step.CtrlNbr,
            Order = step.Order,
            Name = step.Name,
            IsEnabled = step.IsEnabled,
            FailurePolicy = string.IsNullOrWhiteSpace(step.FailurePolicy) ? "StopWorkflow" : step.FailurePolicy,
            ConditionGroupOperator = string.IsNullOrWhiteSpace(step.ConditionGroupOperator) ? "ALL" : step.ConditionGroupOperator,
            Conditions = step.Conditions.Select(c => new WorkflowConditionDraft
            {
                CtrlNbr = c.CtrlNbr,
                FieldTypeCtrlNbr = c.FieldTypeCtrlNbr,
                OperatorTypeCtrlNbr = c.OperatorTypeCtrlNbr,
                Value = c.Value
            }).ToList(),
            Effects = step.Effects.Select(effect => new WorkflowEffectDraft
            {
                CtrlNbr = effect.CtrlNbr,
                Order = effect.Order,
                EffectTypeCtrlNbr = effect.EffectTypeCtrlNbr,
                EffectOption = effect.EffectOption,
                ExpirationDays = ResolveExpirationDays(effect),
                EmailSource = ResolveEmailSource(effect),
                IsEnabled = effect.IsEnabled
            }).ToList()
        }));

        draft.Versions.AddRange(source.Versions.Select(v => new WorkflowTemplateVersion
        {
            VersionNumber = v.VersionNumber,
            Status = v.Status,
            SavedAtUtc = DateTime.TryParse(v.SavedAtUtc, out var savedAtUtc) ? savedAtUtc : DateTime.UtcNow,
            Notes = v.Notes,
            StepCount = v.StepCount,
            WorkflowEnabled = draft.IsEnabled,
            Steps = []
        }));

        return draft;
    }

    private string ResolveTriggerTypeName(long triggerTypeCtrlNbr)
    {
        if (triggerTypeCtrlNbr <= 0)
            return string.Empty;

        return triggerTypeNameByCtrlNbr.TryGetValue(triggerTypeCtrlNbr, out var triggerTypeName)
            ? triggerTypeName
            : triggerTypeCtrlNbr.ToString();
    }

    private static bool IsEffectType(WorkflowEffectDraft effect, long effectTypeCtrlNbr)
        => effectTypeCtrlNbr > 0 && effect.EffectTypeCtrlNbr == effectTypeCtrlNbr;

    private static int ResolveExpirationDays(WorkflowEffectPayload effect)
    {
        if (effect.Options.Any(o => o.Key == "expirationDays"))
        {
            var expirationDaysValue = effect.Options.FirstOrDefault(o => o.Key == "expirationDays")?.Value;
            if (int.TryParse(expirationDaysValue, out var expirationDays) && expirationDays > 0)
                return Math.Min(expirationDays, 90);
        }

        return 7;
    }

    private static string ResolveEmailSource(WorkflowEffectPayload effect)
    {
        if (effect.Options.Any(o => o.Key == "usePrimaryEmail"))
        {
            var usePrimaryEmailValue = effect.Options.FirstOrDefault(o => o.Key == "usePrimaryEmail")?.Value;
            if (bool.TryParse(usePrimaryEmailValue, out var usePrimaryEmail))
                return usePrimaryEmail ? "primary" : "trigger";
        }

        return "primary";
    }

    private static void ReorderSteps(List<WorkflowStepDraft> workflowSteps)
    {
        for (var i = 0; i < workflowSteps.Count; i++)
            workflowSteps[i].Order = i + 1;
    }

    private static void CollapseAllSteps(WorkflowTemplateDraft workflow)
    {
        foreach (var step in workflow.Steps)
            step.IsExpanded = false;
    }

    private static void ReorderEffects(WorkflowStepDraft step)
    {
        for (var i = 0; i < step.Effects.Count; i++)
            step.Effects[i].Order = i + 1;
    }

    private static string GetHistoryStatusBadgeClass(string status)
    {
        return status switch
        {
            "Succeeded" => "bg-success",
            "Failed" => "bg-danger",
            "Skipped" => "bg-secondary",
            "Running" => "bg-info text-dark",
            _ => "bg-secondary"
        };
    }

    private static string BuildHistoryDetailsSummary(string detailsJson)
    {
        if (string.IsNullOrWhiteSpace(detailsJson))
            return "—";

        if (detailsJson.Length <= 220)
            return detailsJson;

        return $"{detailsJson[..220]}...";
    }

