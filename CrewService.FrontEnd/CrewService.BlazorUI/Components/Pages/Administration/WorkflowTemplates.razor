@page "/admin/workflow-templates"
@rendermode InteractiveServer

@using CrewService.BlazorUI.Clients
@using CrewService.Presentation
@using Microsoft.AspNetCore.Authorization

@inherits AppComponentBase

@attribute [Authorize]

@inject AuthorizationClient AuthorizationClient
@inject WorkflowTemplatesClient WorkflowTemplatesClient
@inject DepartmentClient DepartmentClient
@inject CraftClient CraftClient
@inject SeniorityStateClient SeniorityStateClient

<PageTitle>Workflow Templates — Crew Service</PageTitle>

<h1>Workflow Templates</h1>

@if (ShowSelectRailroadBanner)
{
    <div class="alert alert-warning">
        <span class="bi bi-exclamation-triangle"></span>
        Please select a railroad in the context switcher to build and manage workflow templates.
    </div>
}
else if (HasRailroad)
{
    @if (isPageLoading)
    {
        <LoadingMessage ContainerClass="d-flex align-items-center gap-2 mt-3" />
    }
    else
    {
        <p class="text-muted mb-3">Build and manage workflow templates for <strong>@SelectedRailroadName</strong>.</p>

        <div class="d-flex justify-content-start align-items-center mb-3">
            <button class="btn btn-primary" @onclick="CreateWorkflow">
                <span class="bi bi-plus-circle me-1"></span>Create Workflow
            </button>
        </div>

        <div class="card mb-3">
            <div class="card-header fw-semibold">Workflow Templates</div>
            <div class="card-body">
                @if (workflows.Count == 0)
                {
                    <div class="text-muted">No workflows created yet.</div>
                }
                else
                {
                    <DataTable TItem="WorkflowTemplateDraft"
                               Items="workflows"
                               Columns="workflowColumns"
                               SearchFilter="@WorkflowSearchFilter"
                               SearchPlaceholder="Search workflow templates..."
                               EmptyMessage="No workflows created yet."
                               DefaultSortColumn="Name">
                        <RowContent Context="workflow">
                            <td>@workflow.Name</td>
                            <td>@(workflow.CanStartFromTrigger ? "Enabled" : "Disabled")</td>
                            <td>@(workflow.CanStartFromTrigger && !string.IsNullOrWhiteSpace(workflow.TriggerTypeName) ? workflow.TriggerTypeName : "—")</td>
                            <td>
                                <span class="badge @(workflow.Status == "Published" ? "bg-success" : "bg-warning text-dark")"
                                      style="display:inline-block; min-width:96px; text-align:center;">@workflow.Status</span>
                            </td>
                            <td>
                                <div class="form-check form-switch d-flex justify-content-center mb-0">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           role="switch"
                                           checked="@workflow.IsEnabled"
                                           @onchange="() => ToggleWorkflowEnabled(workflow.Id)" />
                                    <label class="form-check-label ms-2">@(workflow.IsEnabled ? "Enabled" : "Disabled")</label>
                                </div>
                            </td>
                            <td>@(workflow.CurrentVersionNumber > 0 ? $"v{workflow.CurrentVersionNumber}" : "Draft")</td>
                            <td>@workflow.StepCount</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-primary" @onclick="() => OpenWorkflowDetails(workflow.Id)">
                                        <span class="bi bi-pencil-square me-1"></span>Open
                                    </button>
                                    <button class="btn btn-outline-secondary" @onclick="() => OpenWorkflowHistory(workflow.Id)">
                                        <span class="bi bi-clock-history me-1"></span>History
                                    </button>
                                    <button class="btn btn-outline-danger" @onclick="() => DeleteWorkflow(workflow.Id)">
                                        <span class="bi bi-trash"></span>
                                    </button>
                                </div>
                            </td>
                        </RowContent>
                    </DataTable>
                }
            </div>
        </div>
    }

    <Modal Visible="showWorkflowDetailsModal"
           Title="@detailsModalTitle"
           Icon="bi bi-diagram-3"
           OnClose="CloseWorkflowDetails"
           Size="xl"
           Scrollable="true">
        <BodyContent>
            @if (activeWorkflow is null)
            {
                <p class="mb-0">No workflow selected.</p>
            }
            else
            {
                <div class="card mb-3">
                    <div class="card-header fw-semibold">Template</div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Template Name</label>
                                <input class="form-control" @bind="activeWorkflow.Name" @bind:after="MarkActiveWorkflowAsDraft" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Can Start From Trigger</label>
                                <div class="form-check form-switch mb-0">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           role="switch"
                                           checked="@activeWorkflow.CanStartFromTrigger"
                                           @onchange="ToggleActiveWorkflowTriggerStart" />
                                    <label class="form-check-label ms-2">@(activeWorkflow.CanStartFromTrigger ? "Enabled" : "Disabled")</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Trigger</label>
                                <select class="form-select" @bind="activeWorkflow.TriggerTypeCtrlNbr" @bind:after="OnActiveWorkflowTriggerChanged" disabled="@(!activeWorkflow.CanStartFromTrigger)">
                                    @foreach (var trigger in triggerDefinitions)
                                    {
                                        <option value="@trigger.CtrlNbr">@trigger.Name</option>
                                    }
                                </select>
                                @if (!activeWorkflow.CanStartFromTrigger)
                                {
                                    <div class="form-text">Composable workflow — executes only when called by another workflow.</div>
                                }
                            </div>
                            <div class="col-12">
                                <div class="border rounded p-2 bg-body-tertiary">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <span class="small text-muted">Trigger filters</span>
                                        <select class="form-select form-select-sm w-auto" @bind="activeWorkflow.TriggerConditionGroupOperator" @bind:after="MarkActiveWorkflowAsDraft" disabled="@(!activeWorkflow.CanStartFromTrigger)">
                                            <option value="ALL">All of</option>
                                            <option value="ANY">Any of</option>
                                        </select>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary ms-auto"
                                                @onclick="AddTriggerCondition"
                                                disabled="@(!activeWorkflow.CanStartFromTrigger || !HasMetadataFieldsForActiveWorkflow())">
                                            <span class="bi bi-plus-circle me-1"></span>Add Filter
                                        </button>
                                    </div>

                                    @if (!activeWorkflow.CanStartFromTrigger)
                                    {
                                        <div class="small text-muted">Trigger filters are disabled when trigger start is disabled.</div>
                                    }
                                    else if (!HasMetadataFieldsForActiveWorkflow())
                                    {
                                        <div class="small text-muted">No trigger metadata filters are available for this trigger.</div>
                                    }
                                    else
                                    {
                                        @if (activeWorkflow.TriggerConditions.Count == 0)
                                        {
                                            <div class="small text-muted">No filters defined. Use <span class="fw-semibold">Add Filter</span> to add one.</div>
                                        }
                                        else
                                        {
                                            @for (var conditionIndex = 0; conditionIndex < activeWorkflow.TriggerConditions.Count; conditionIndex++)
                                            {
                                                var condition = activeWorkflow.TriggerConditions[conditionIndex];
                                                <div class="d-flex align-items-center gap-2 mb-2">
                                                    <select class="form-select form-select-sm" @bind="condition.FieldTypeCtrlNbr" @bind:after="() => OnTriggerConditionFieldChanged(condition)">
                                                        <option value="">Select value...</option>
                                                        @foreach (var field in GetMetadataFieldsForActiveWorkflow())
                                                        {
                                                            <option value="@field.CtrlNbr">@field.Label</option>
                                                        }
                                                    </select>
                                                    <select class="form-select form-select-sm" @bind="condition.OperatorTypeCtrlNbr" @bind:after="MarkActiveWorkflowAsDraft">
                                                        <option value="">Select value...</option>
                                                        @foreach (var op in GetOperatorsForCondition(condition))
                                                        {
                                                            <option value="@op.CtrlNbr">@op.Name</option>
                                                        }
                                                    </select>
                                                    <select class="form-select form-select-sm" @bind="condition.Value" @bind:after="MarkActiveWorkflowAsDraft">
                                                        <option value="">Select value...</option>
                                                        @foreach (var valueOption in GetAllowedValuesForCondition(condition))
                                                        {
                                                            <option value="@valueOption">@valueOption</option>
                                                        }
                                                    </select>
                                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveTriggerCondition(condition.Id)">
                                                        <span class="bi bi-dash-circle"></span>
                                                    </button>
                                                </div>
                                            }
                                        }
                                    }
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="border rounded p-2 bg-body-tertiary">
                                    <div class="row g-2 align-items-end">
                                        <div class="col-md-3">
                                            <label class="form-label fw-semibold mb-1">Workflow Enabled</label>
                                            <div class="form-check form-switch mb-0">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       role="switch"
                                                       checked="@activeWorkflow.IsEnabled"
                                                       @onchange="ToggleActiveWorkflowEnabled" />
                                                <label class="form-check-label ms-2">@(activeWorkflow.IsEnabled ? "Enabled" : "Disabled")</label>
                                            </div>
                                        </div>
                                        <div class="col-md-5">
                                            <label class="form-label fw-semibold mb-1">Execution Mode</label>
                                            <input class="form-control form-control-sm" value="Sequential (Stop on First Failure)" disabled />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label fw-semibold mb-1">Status</label>
                                            <input class="form-control form-control-sm" style="max-width: 120px;" value="@activeWorkflow.Status" disabled />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label fw-semibold mb-1">Version</label>
                                            <input class="form-control form-control-sm" style="max-width: 120px;" value="@(activeWorkflow.CurrentVersionNumber > 0 ? $"v{activeWorkflow.CurrentVersionNumber}" : "Draft")" disabled />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span class="fw-semibold">Workflow Steps</span>
                        <button class="btn btn-sm btn-outline-primary" @onclick="AddStepToActiveWorkflow">
                            <span class="bi bi-plus-circle me-1"></span>Add Step
                        </button>
                    </div>
                    <div class="card-body p-0">
                        @if (activeWorkflow.Steps.Count == 0)
                        {
                            <div class="p-3 text-muted">No steps defined.</div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th style="width:80px;">Order</th>
                                            <th>Step Definition</th>
                                            <th style="width:120px;">Enabled</th>
                                            <th style="width:150px;">Failure Policy</th>
                                            <th class="text-end" style="width:120px;">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (var i = 0; i < activeWorkflow.Steps.Count; i++)
                                        {
                                            var step = activeWorkflow.Steps[i];
                                            <tr>
                                                <td>#@step.Order</td>
                                                <td>
                                                    <div class="border rounded p-2">
                                                        <div class="d-flex align-items-start justify-content-between mb-2">
                                                            <div>
                                                                <div class="fw-semibold">@step.Name</div>
                                                                <div class="small text-muted">@GetStepConditionSummary(step) · @GetStepEffectSummary(step)</div>
                                                            </div>
                                                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleStepExpanded(step)">
                                                                <span class="bi @(step.IsExpanded ? "bi-chevron-up" : "bi-chevron-down") me-1"></span>
                                                                @(step.IsExpanded ? "Collapse" : "Expand")
                                                            </button>
                                                        </div>

                                                        @if (step.IsExpanded)
                                                        {
                                                            <div class="mb-2">
                                                                <label class="form-label fw-semibold small mb-1">Step Name</label>
                                                                <input class="form-control form-control-sm" @bind="step.Name" @bind:after="MarkActiveWorkflowAsDraft" />
                                                            </div>

                                                            <div class="border rounded p-2 bg-body-tertiary mb-2">
                                                                <div class="d-flex align-items-center gap-2 mb-2">
                                                                    <span class="small text-muted">Step filters</span>
                                                                    <select class="form-select form-select-sm w-auto" @bind="step.ConditionGroupOperator" @bind:after="MarkActiveWorkflowAsDraft">
                                                                        <option value="ALL">All of</option>
                                                                        <option value="ANY">Any of</option>
                                                                    </select>
                                                                    <button type="button" class="btn btn-sm btn-outline-primary ms-auto" @onclick="() => AddCondition(step)" disabled="@(!HasMetadataFieldsForActiveWorkflow())">
                                                                        <span class="bi bi-plus-circle me-1"></span>Add Filter
                                                                    </button>
                                                                </div>

                                                                @if (!HasMetadataFieldsForActiveWorkflow())
                                                                {
                                                                    <div class="small text-muted">No trigger metadata filters are available. This step will run when reached.</div>
                                                                }
                                                                else
                                                                {
                                                                    @if (step.Conditions.Count == 0)
                                                                    {
                                                                        <div class="small text-muted">No filters defined. Use <span class="fw-semibold">Add Filter</span> to add one.</div>
                                                                    }
                                                                    else
                                                                    {
                                                                        @for (var conditionIndex = 0; conditionIndex < step.Conditions.Count; conditionIndex++)
                                                                        {
                                                                            var condition = step.Conditions[conditionIndex];
                                                                            <div class="d-flex align-items-center gap-2 mb-2">
                                                                                <select class="form-select form-select-sm" @bind="condition.FieldTypeCtrlNbr" @bind:after="() => OnConditionFieldChanged(step, condition)">
                                                                                    <option value="">Select value...</option>
                                                                                    @foreach (var field in GetMetadataFieldsForActiveWorkflow())
                                                                                    {
                                                                                        <option value="@field.CtrlNbr">@field.Label</option>
                                                                                    }
                                                                                </select>
                                                                                <select class="form-select form-select-sm" @bind="condition.OperatorTypeCtrlNbr" @bind:after="MarkActiveWorkflowAsDraft">
                                                                                    <option value="">Select value...</option>
                                                                                    @foreach (var op in GetOperatorsForCondition(condition))
                                                                                    {
                                                                                        <option value="@op.CtrlNbr">@op.Name</option>
                                                                                    }
                                                                                </select>
                                                                                <select class="form-select form-select-sm" @bind="condition.Value" @bind:after="MarkActiveWorkflowAsDraft">
                                                                                    <option value="">Select value...</option>
                                                                                    @foreach (var valueOption in GetAllowedValuesForCondition(condition))
                                                                                    {
                                                                                        <option value="@valueOption">@valueOption</option>
                                                                                    }
                                                                                </select>

                                                                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveCondition(step, condition.Id)">
                                                                                    <span class="bi bi-dash-circle"></span>
                                                                                </button>
                                                                            </div>
                                                                        }
                                                                    }
                                                                }
                                                            </div>

                                                            <div class="border rounded p-2 bg-body-tertiary">
                                                                <div class="d-flex align-items-center justify-content-between mb-2">
                                                                    <span class="small text-muted">Effects</span>
                                                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => AddEffect(step)">
                                                                        <span class="bi bi-plus-circle me-1"></span>Add Effect
                                                                    </button>
                                                                </div>

                                                                @for (var effectIndex = 0; effectIndex < step.Effects.Count; effectIndex++)
                                                                {
                                                                    var effect = step.Effects[effectIndex];
                                                                    <div class="d-flex align-items-start gap-2 mb-2">
                                                                        <span class="small text-muted" style="min-width:24px;">#@effect.Order</span>
                                                                        <div class="d-flex flex-column gap-2 flex-grow-1">
                                                                            <select class="form-select form-select-sm" @bind="effect.EffectTypeCtrlNbr" @bind:after="() => OnEffectChanged(step, effect)">
                                                                                <option value="">Select value...</option>
                                                                                @foreach (var effectOption in effectTypeOptions)
                                                                                {
                                                                                    <option value="@effectOption.CtrlNbr">@effectOption.Name</option>
                                                                                }
                                                                            </select>

                                                                            @if (IsEffectType(effect, addToRosterBoardEffectTypeCtrlNbr))
                                                                            {
                                                                                <div class="input-group input-group-sm" style="max-width: 360px;">
                                                                                    <span class="input-group-text">Board</span>
                                                                                    <select class="form-select" @bind="effect.EffectOption" @bind:after="MarkActiveWorkflowAsDraft">
                                                                                        <option value="">Select value...</option>
                                                                                        @foreach (var boardType in boardTypeOptions)
                                                                                        {
                                                                                            <option value="@boardType">@boardType</option>
                                                                                        }
                                                                                    </select>
                                                                                </div>
                                                                            }
                                                                            else if (IsEffectType(effect, sendInvitationEffectTypeCtrlNbr))
                                                                            {
                                                                                <div class="border rounded p-2 bg-body-tertiary">
                                                                                    <div class="d-flex flex-column gap-2">
                                                                                        <div class="input-group input-group-sm" style="max-width: 420px;">
                                                                                            <span class="input-group-text" style="width: 90px;">Role</span>
                                                                                            <select class="form-select" @bind="effect.EffectOption" @bind:after="MarkActiveWorkflowAsDraft">
                                                                                                <option value="">Select value...</option>
                                                                                                @foreach (var role in roleOptions)
                                                                                                {
                                                                                                    <option value="@role.CtrlNbr">@role.Name</option>
                                                                                                }
                                                                                            </select>
                                                                                        </div>
                                                                                        <div class="input-group input-group-sm" style="max-width: 220px;">
                                                                                            <span class="input-group-text" style="width: 90px;">Days</span>
                                                                                            <input type="number"
                                                                                                   min="1"
                                                                                                   max="90"
                                                                                                   class="form-control"
                                                                                                   @bind="effect.ExpirationDays"
                                                                                                   @bind:after="MarkActiveWorkflowAsDraft" />
                                                                                        </div>
                                                                                        <div class="input-group input-group-sm" style="max-width: 320px;">
                                                                                            <span class="input-group-text" style="width: 90px;">Email</span>
                                                                                            <select class="form-select" @bind="effect.EmailSource" @bind:after="MarkActiveWorkflowAsDraft">
                                                                                                <option value="">Select value...</option>
                                                                                                @foreach (var emailSource in invitationEmailSourceOptions)
                                                                                                {
                                                                                                    <option value="@emailSource.Value">@emailSource.Label</option>
                                                                                                }
                                                                                            </select>
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                            }
                                                                            else if (IsEffectType(effect, callWorkflowEffectTypeCtrlNbr))
                                                                            {
                                                                                var callableTargets = GetCallableWorkflowNames(activeWorkflow.Id).ToList();
                                                                                if (callableTargets.Count > 0)
                                                                                {
                                                                                    <div class="input-group input-group-sm" style="max-width: 420px;">
                                                                                        <span class="input-group-text">Workflow</span>
                                                                                        <select class="form-select" @bind="effect.EffectOption" @bind:after="MarkActiveWorkflowAsDraft">
                                                                                            <option value="">Select value...</option>
                                                                                            @foreach (var workflowName in callableTargets)
                                                                                            {
                                                                                                <option value="@workflowName">@workflowName</option>
                                                                                            }
                                                                                        </select>
                                                                                    </div>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <input class="form-control form-control-sm" value="No callable workflows available" disabled style="max-width: 420px;" />
                                                                                }
                                                                            }
                                                                        </div>

                                                                        <div class="form-check form-switch mb-0">
                                                                            <input class="form-check-input"
                                                                                   type="checkbox"
                                                                                   role="switch"
                                                                                   checked="@effect.IsEnabled"
                                                                                   @onchange="() => ToggleEffectEnabled(effect)" />
                                                                            <label class="form-check-label ms-2">@(effect.IsEnabled ? "Enabled" : "Disabled")</label>
                                                                        </div>

                                                                        <div class="btn-group btn-group-sm">
                                                                            <button type="button" class="btn btn-outline-secondary" @onclick="() => MoveEffectUp(step, effectIndex)" disabled="@(effectIndex == 0)">
                                                                                <span class="bi bi-arrow-up"></span>
                                                                            </button>
                                                                            <button type="button" class="btn btn-outline-secondary" @onclick="() => MoveEffectDown(step, effectIndex)" disabled="@(effectIndex == step.Effects.Count - 1)">
                                                                                <span class="bi bi-arrow-down"></span>
                                                                            </button>
                                                                            <button type="button" class="btn btn-outline-danger" @onclick="() => RemoveEffect(step, effect.Id)" disabled="@(step.Effects.Count == 1)">
                                                                                <span class="bi bi-trash"></span>
                                                                            </button>
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="form-check form-switch d-flex justify-content-center mb-0">
                                                        <input class="form-check-input"
                                                               type="checkbox"
                                                               role="switch"
                                                               checked="@step.IsEnabled"
                                                               @onchange="() => ToggleStepEnabled(step)" />
                                                        <label class="form-check-label ms-2">@(step.IsEnabled ? "Enabled" : "Disabled")</label>
                                                    </div>
                                                </td>
                                                <td class="text-end">
                                                    <select class="form-select form-select-sm d-inline-block" style="min-width: 130px; width: 130px;" @bind="step.FailurePolicy" @bind:after="MarkActiveWorkflowAsDraft">
                                                        <option value="StopWorkflow">Stop Workflow</option>
                                                    </select>
                                                </td>
                                                <td class="text-end">
                                                    <div class="btn-group btn-group-sm">
                                                        <button class="btn btn-outline-secondary" @onclick="() => MoveStepUp(i)" disabled="@(i == 0)">
                                                            <span class="bi bi-arrow-up"></span>
                                                        </button>
                                                        <button class="btn btn-outline-secondary" @onclick="() => MoveStepDown(i)" disabled="@(i == activeWorkflow.Steps.Count - 1)">
                                                            <span class="bi bi-arrow-down"></span>
                                                        </button>
                                                        <button class="btn btn-outline-danger" @onclick="() => RemoveStep(step.Id)">
                                                            <span class="bi bi-trash"></span>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header fw-semibold">Versioning</div>
                    <div class="card-body">
                        <div class="row g-3 align-items-end">
                            <div class="col-md-8">
                                <label class="form-label fw-semibold">Change Notes</label>
                                <input class="form-control" placeholder="Describe what changed in this version..." @bind="versionNotes" />
                            </div>
                            <div class="col-md-4 d-flex gap-2">
                                <button class="btn btn-outline-primary flex-fill" @onclick="SaveDraftVersionForActive">
                                    <span class="bi bi-save me-1"></span>Save Draft
                                </button>
                                <button class="btn btn-success flex-fill" @onclick="PublishVersionForActive">
                                    <span class="bi bi-upload me-1"></span>Publish
                                </button>
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(statusMessage))
                        {
                            <div class="alert alert-info mt-3 mb-0">@statusMessage</div>
                        }
                    </div>
                </div>

                <div class="card">
                    <div class="card-header fw-semibold">Template Version History</div>
                    <div class="card-body p-0">
                        @if (activeWorkflow.Versions.Count == 0)
                        {
                            <div class="p-3 text-muted">No versions created yet.</div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th style="width:90px;">Version</th>
                                            <th style="width:180px;">Status</th>
                                            <th style="width:200px;">Saved (UTC)</th>
                                            <th>Notes</th>
                                            <th style="width:120px;">Steps</th>
                                            <th class="text-end" style="width:180px;">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var version in activeWorkflow.Versions.OrderByDescending(v => v.VersionNumber))
                                        {
                                            <tr>
                                                <td><span class="badge bg-secondary">@($"v{version.VersionNumber}")</span></td>
                                                <td>
                                                    <span class="badge @(version.Status == "Published" ? "bg-success" : "bg-warning text-dark")">@version.Status</span>
                                                </td>
                                                <td>@version.SavedAtUtc.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")</td>
                                                <td>@version.Notes</td>
                                                <td>@version.StepCount</td>
                                                <td class="text-end">
                                                    @if (version.StepCount > 0)
                                                    {
                                                        <button class="btn btn-sm btn-outline-warning" @onclick="() => RestoreVersionForActive(version.VersionNumber)">
                                                            <span class="bi bi-arrow-counterclockwise me-1"></span>Restore as Draft
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">—</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            }
        </BodyContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="CloseWorkflowDetails">Close</button>
        </Footer>
    </Modal>

    <Modal Visible="showWorkflowHistoryModal"
           Title="@historyModalTitle"
           Icon="bi bi-clock-history"
           OnClose="CloseWorkflowHistory"
           Size="xl"
           Scrollable="true">
        <BodyContent>
            @if (historyWorkflow is null)
            {
                <p class="mb-0">No workflow selected.</p>
            }
            else if (isHistoryLoading)
            {
                <LoadingMessage ContainerClass="d-flex align-items-center gap-2 mt-1" />
            }
            else
            {
                <DataTable TItem="WorkflowExecutionHistoryItem"
                           Items="workflowHistoryEntries"
                           Columns="workflowHistoryColumns"
                           SearchFilter="@WorkflowHistorySearchFilter"
                           SearchPlaceholder="Search workflow history..."
                           EmptyMessage="No workflow execution history found."
                           DefaultSortColumn="Started (Local)">
                    <RowContent Context="entry">
                        <td>@entry.StartedAtDisplay</td>
                        <td>
                            <span class="badge @GetHistoryStatusBadgeClass(entry.Status)">@entry.Status</span>
                        </td>
                        <td>@($"v{entry.WorkflowVersionNumber}")</td>
                        <td>@entry.TriggerType</td>
                        <td>@entry.AggregateDisplay</td>
                        <td class="small text-break">@entry.DetailsSummary</td>
                    </RowContent>
                </DataTable>
            }
        </BodyContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="CloseWorkflowHistory">Close</button>
        </Footer>
    </Modal>
}

@code {
