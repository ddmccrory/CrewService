@page "/admin/seniority-vacancy-configs"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using CrewService.BlazorUI.Clients
@using CrewService.Presentation

@inherits AppComponentBase

@attribute [Authorize]

@inject SeniorityVacancyConfigClient VacancyConfigClient
@inject SeniorityStateClient StateClient

<PageTitle>Seniority State Vacancy Actions — Crew Service</PageTitle>

<h1>Seniority State Vacancy Actions</h1>
<p class="text-muted">
    Configure what happens to an employee's current position when their seniority state changes.
    Settings apply at the railroad level. Each state can independently vacate the position,
    open a bulletin, or move the employee to a configured board.
</p>

@if (IsInitializing)
{
    <div class="d-flex align-items-center gap-2 mt-3">
        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
        <span>Loading...</span>
    </div>
}
else if (!IsContextFullySelected)
{
    <div class="alert alert-warning">
        <span class="bi bi-exclamation-triangle"></span>
        Please select a parent and railroad in the context switcher to manage vacancy action configuration.
    </div>
}
else
{
    @* ── Edit Modal ── *@
    <Modal Visible="showSaveModal"
           Title="Configure Vacancy Action"
           Icon="bi bi-gear"
           OnClose="CloseSaveModal">
        <BodyContent>
            <EditForm Model="saveModel" OnValidSubmit="OnSave" id="save-vacancy-config-form">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label fw-semibold">Seniority State</label>
                    <p class="form-control-plaintext fw-bold">@saveModel.StateDescription</p>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Vacancy Action</label>
                    <SelectInput TItem="VacancyActionOption" TValue="string"
                                 @bind-Value="saveModel.VacancyAction"
                                 Items="vacancyActionOptions"
                                 TextSelector="o => o.Label"
                                 ValueSelector="o => o.Value"
                                 Placeholder="— Select action —"
                                 class="form-select" />
                    <ValidationMessage For="() => saveModel.VacancyAction" class="text-danger" />
                </div>
                @if (saveModel.VacancyAction == "MoveToBoard")
                {
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Board Type</label>
                        <SelectInput TItem="VacancyActionOption" TValue="string"
                                     @bind-Value="saveModel.TargetBoardType"
                                     Items="boardTypeOptions"
                                     TextSelector="o => o.Label"
                                     ValueSelector="o => o.Value"
                                     Placeholder="— Select board type —"
                                     class="form-select" />
                        <ValidationMessage For="() => saveModel.TargetBoardType" class="text-danger" />
                    </div>
                }
            </EditForm>
        </BodyContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="CloseSaveModal">Cancel</button>
            <button type="submit" form="save-vacancy-config-form" class="btn btn-primary" disabled="@isSaving">
                <span class="bi bi-check-circle me-1"></span> Save
            </button>
        </Footer>
    </Modal>

    @* ── Delete Modal ── *@
    <Modal Visible="showDeleteModal"
           Title="Remove Configuration"
           Icon="bi bi-trash"
           OnClose="CloseDeleteModal">
        <BodyContent>
            <p>Remove the vacancy action configuration for <strong>@deleteStateName</strong>? The state will revert to <em>No Action</em>.</p>
        </BodyContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="CloseDeleteModal">Cancel</button>
            <button type="button" class="btn btn-danger" @onclick="ConfirmDelete" disabled="@isDeleting">
                <span class="bi bi-trash me-1"></span> Remove
            </button>
        </Footer>
    </Modal>

    @if (isLoading)
    {
        <div class="text-center py-5"><div class="spinner-border" /></div>
    }
    else if (rows.Count == 0)
    {
        <div class="alert alert-info">No seniority states found for this railroad. All states default to <em>No Action</em>.</div>
    }
    else
    {
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>State</th>
                    <th>State Type</th>
                    <th>Vacancy Action</th>
                    <th>Board Type</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in rows)
                {
                    <tr>
                        <td>@row.StateDescription</td>
                        <td>@row.StateType</td>
                        <td>
                            @if (row.Config is not null)
                            {
                                <span class="badge @ActionBadgeClass(row.Config.VacancyAction)">@FormatAction(row.Config.VacancyAction)</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">No Action</span>
                            }
                        </td>
                        <td>@(row.Config?.VacancyAction == "MoveToBoard" && !string.IsNullOrEmpty(row.Config?.TargetBoardType) ? FormatBoardType(row.Config.TargetBoardType) : "—")</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary px-3 me-1" @onclick="() => OpenEditModal(row)">
                                @(row.Config is not null ? "Edit" : "Configure")
                            </button>
                            @if (row.Config is not null)
                            {
                                <button class="btn btn-sm btn-outline-danger px-3" @onclick="() => OpenDeleteModal(row)">Remove</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private record VacancyActionOption(string Value, string Label);

    private class StateConfigRow
    {
        public long StateCtrlNbr { get; init; }
        public string StateDescription { get; init; } = string.Empty;
        public string StateType { get; init; } = string.Empty;
        public VacancyConfigResponse? Config { get; set; }
    }

    private class SaveModel
    {
        public long StateCtrlNbr { get; set; }
        public string StateDescription { get; set; } = string.Empty;
        [Required] public string VacancyAction { get; set; } = "None";
        public string TargetBoardType { get; set; } = string.Empty;
    }

    private bool isLoading = true;
    private bool isDeleting = false;
    private bool showSaveModal = false;
    private bool showDeleteModal = false;

    private List<StateConfigRow> rows = [];
    private List<VacancyActionOption> vacancyActionOptions = [];
    private List<VacancyActionOption> boardTypeOptions = [];

    private SaveModel saveModel = new();
    private long? editConfigCtrlNbr;
    private long deleteConfigCtrlNbr;
    private string deleteStateName = string.Empty;

    protected override async Task OnAppContextChangedAsync()
    {
        await LoadDataAsync();
        StateHasChanged();
    }

    protected override async Task LoadDataAsync()
    {
        if (!IsContextFullySelected || SelectedParentCtrlNbr is null || SelectedRailroadCtrlNbr is null) return;

        isLoading = true;
        StateHasChanged();

        try
        {
            vacancyActionOptions =
            [
                new("None", "No Action"),
                new("VacateAndBulletin", "Vacate Position & Open Bulletin"),
                new("MoveToBoard", "Move to Board")
            ];

            boardTypeOptions =
            [
                new("ExtraBoard", "Extra Board"),
                new("Hangout", "Hangout"),
                new("ExtendedAbsence", "Extended Absence"),
                new("Training", "Training"),
                new("NewHire", "New Hires")
            ];

            var statesTask = StateClient.GetAllAsync(SelectedParentCtrlNbr.Value);
            var configsTask = VacancyConfigClient.GetByRailroadAsync(SelectedRailroadCtrlNbr.Value);

            await Task.WhenAll(statesTask, configsTask);

            var statesResp = await statesTask;
            var configsResp = await configsTask;

            var configMap = configsResp.Configs.ToDictionary(c => c.SeniorityStateCtrlNbr);

            rows = statesResp.States
                .OrderBy(s => s.StateDescription)
                .Select(s => new StateConfigRow
                {
                    StateCtrlNbr = s.CtrlNbr,
                    StateDescription = s.StateDescription,
                    StateType = s.StateType,
                    Config = configMap.GetValueOrDefault(s.CtrlNbr)
                })
                .ToList();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenEditModal(StateConfigRow row)
    {
        saveModel = new SaveModel
        {
            StateCtrlNbr = row.StateCtrlNbr,
            StateDescription = row.StateDescription,
            VacancyAction = row.Config?.VacancyAction ?? "None",
            TargetBoardType = row.Config?.TargetBoardType ?? string.Empty
        };
        editConfigCtrlNbr = row.Config?.CtrlNbr;
        showSaveModal = true;
    }

    private void CloseSaveModal() => showSaveModal = false;

    private async Task OnSave()
    {
        if (saveModel.StateCtrlNbr == 0)
        {
            // must have a state selected from table row — no free-form create
            return;
        }

        isSaving = true;
        try
        {
            await VacancyConfigClient.UpsertAsync(new UpsertVacancyConfigRequest
            {
                ParentCtrlNbr = SelectedParentCtrlNbr!.Value,
                RailroadCtrlNbr = SelectedRailroadCtrlNbr!.Value,
                SeniorityStateCtrlNbr = saveModel.StateCtrlNbr,
                VacancyAction = saveModel.VacancyAction,
                TargetBoardType = saveModel.VacancyAction == "MoveToBoard" ? saveModel.TargetBoardType : string.Empty
            });
            showSaveModal = false;
            await LoadDataAsync();
        }
        finally
        {
            isSaving = false;
        }
    }

    private void OpenDeleteModal(StateConfigRow row)
    {
        deleteConfigCtrlNbr = row.Config!.CtrlNbr;
        deleteStateName = row.StateDescription;
        showDeleteModal = true;
    }

    private void CloseDeleteModal() => showDeleteModal = false;

    private async Task ConfirmDelete()
    {
        isDeleting = true;
        try
        {
            await VacancyConfigClient.DeleteAsync(deleteConfigCtrlNbr);
            showDeleteModal = false;
            await LoadDataAsync();
        }
        finally
        {
            isDeleting = false;
        }
    }

    private static string FormatBoardType(string boardType) => boardType switch
    {
        "ExtraBoard" => "Extra Board",
        "Hangout" => "Hangout",
        "ExtendedAbsence" => "Extended Absence",
        "Training" => "Training",
        "NewHire" => "New Hires",
        _ => boardType
    };

    private static string FormatAction(string action) => action switch
    {
        "VacateAndBulletin" => "Vacate & Bulletin",
        "MoveToBoard" => "Move to Board",
        "None" => "No Action",
        _ => action
    };

    private static string ActionBadgeClass(string action) => action switch
    {
        "VacateAndBulletin" => "bg-danger",
        "MoveToBoard" => "bg-warning text-dark",
        _ => "bg-secondary"
    };
}
