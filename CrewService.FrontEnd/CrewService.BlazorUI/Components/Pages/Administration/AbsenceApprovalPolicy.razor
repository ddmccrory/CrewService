@page "/admin/absence-approval-policy"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using CrewService.BlazorUI.Clients

@inherits AppComponentBase

@attribute [Authorize]

@inject PoliciesClient PoliciesClient
@inject DepartmentClient DepartmentClient
@inject CraftClient CraftClient

<PageTitle>Absence Approval Policy — Crew Service</PageTitle>

<h1>Absence Approval Policy</h1>
<p class="text-muted">
    Configure how absence requests are approved for the selected railroad.
</p>

@if (IsInitializing)
{
    <div class="d-flex align-items-center gap-2 mt-3">
        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
        <span>Loading...</span>
    </div>
}
else if (ShowSelectRailroadBanner)
{
    <div class="alert alert-warning">
        <span class="bi bi-exclamation-triangle"></span>
        Please select a railroad in the context switcher to manage the absence approval policy.
    </div>
}
else
{
    <Modal Visible="showDepartmentCapModal"
           Title="@(isCreateDepartmentCapMode ? "Create Request Window Cap" : "Configure Request Window Cap")"
           Icon="bi bi-calendar-range"
           OnClose="CloseDepartmentCapModal">
        <BodyContent>
            <EditForm Model="departmentCapEditModel" OnValidSubmit="OnSaveDepartmentCap" id="department-cap-policy-form">
                <DataAnnotationsValidator />

                @if (isCreateDepartmentCapMode)
                {
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="departmentCapDepartment">Department</label>
                        <select id="departmentCapDepartment" class="form-select" @bind="departmentCapEditModel.DepartmentCtrlNbr" @bind:after="OnDepartmentCapDepartmentChanged">
                            <option value="0">-- Select Department --</option>
                            @foreach (var row in departmentCapRows.Where(r => !r.RequestWindowCapDays.HasValue).OrderBy(r => r.DepartmentName))
                            {
                                <option value="@row.DepartmentCtrlNbr">@row.DepartmentName</option>
                            }
                        </select>
                    </div>
                }
                else
                {
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Department</label>
                        <p class="form-control-plaintext fw-bold">@departmentCapEditModel.DepartmentName</p>
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label fw-semibold" for="requestWindowCapDays">Request Window Cap (days)</label>
                    <input class="form-control" type="number" id="requestWindowCapDays" min="1" max="365" @bind="departmentCapEditModel.RequestWindowCapDays" />
                    <ValidationMessage For="() => departmentCapEditModel.RequestWindowCapDays" class="text-danger" />
                </div>
            </EditForm>
        </BodyContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="CloseDepartmentCapModal">Cancel</button>
            <button type="submit" form="department-cap-policy-form" class="btn btn-primary" disabled="@isSaving">
                <span class="bi bi-check-circle me-1"></span> Save
            </button>
        </Footer>
    </Modal>

    <Modal Visible="showCraftWaitListModal"
           Title="@(isCreateCraftWaitListMode ? "Create Waitlist Configuration" : "Configure Waitlist Configuration")"
           Icon="bi bi-list-check"
           OnClose="CloseCraftWaitListModal">
        <BodyContent>
            <EditForm Model="craftWaitListEditModel" OnValidSubmit="OnSaveCraftWaitList" id="craft-waitlist-policy-form">
                <DataAnnotationsValidator />

                @if (isCreateCraftWaitListMode)
                {
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="craftWaitListCraft">Craft</label>
                        <select id="craftWaitListCraft" class="form-select" @bind="craftWaitListEditModel.CraftCtrlNbr" @bind:after="OnCraftWaitListCraftChanged">
                            <option value="0">-- Select Craft --</option>
                            @foreach (var row in craftWaitListRows.Where(r => !r.WaitListConfigured).OrderBy(r => r.CraftName))
                            {
                                <option value="@row.CraftCtrlNbr">@row.CraftName</option>
                            }
                        </select>
                    </div>
                }
                else
                {
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Craft</label>
                        <p class="form-control-plaintext fw-bold">@craftWaitListEditModel.CraftName</p>
                    </div>
                }

                <div class="mb-3">
                    <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="craftWaitListEnabled" @bind="craftWaitListEditModel.IsEnabled" />
                            <label class="form-check-label" for="craftWaitListEnabled">Waitlist reassignment enabled</label>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold" for="compensableDayMaxAssignments">Compensable Day Max Assignments</label>
                    <input class="form-control" type="number" id="compensableDayMaxAssignments" min="0" max="365" @bind="craftWaitListEditModel.CompensableDayMaxAssignments" />
                    <ValidationMessage For="() => craftWaitListEditModel.CompensableDayMaxAssignments" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold" for="vacationWeekMaxAssignments">Vacation Week Max Assignments</label>
                    <input class="form-control" type="number" id="vacationWeekMaxAssignments" min="0" max="365" @bind="craftWaitListEditModel.VacationWeekMaxAssignments" />
                    <ValidationMessage For="() => craftWaitListEditModel.VacationWeekMaxAssignments" class="text-danger" />
                </div>
            </EditForm>
        </BodyContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="CloseCraftWaitListModal">Cancel</button>
            <button type="submit" form="craft-waitlist-policy-form" class="btn btn-primary" disabled="@isSaving">
                <span class="bi bi-check-circle me-1"></span> Save
            </button>
        </Footer>
    </Modal>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible mt-2" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <SuccessAlert @bind-Message="successMessage" Class="mt-2" />

    @if (isLoading)
    {
        <div class="text-center py-5"><div class="spinner-border" /></div>
    }
    else
    {
        <div class="card mt-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="card-title mb-1">@SelectedRailroadName</h5>
                        <div class="text-muted small">
                            @(hasConfiguredPolicy ? "Configured policy loaded." : "No policy configured yet. Defaults are shown.")
                        </div>
                    </div>
                    <span class="badge @(editModel.IsEnabled ? "bg-success" : "bg-secondary")">
                        @(editModel.IsEnabled ? "Enabled" : "Disabled")
                    </span>
                </div>

                <EditForm Model="editModel" OnValidSubmit="OnSave" id="absence-approval-policy-form">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Approval Level</label>
                        <select class="form-select" @bind="editModel.ApprovalLevel">
                            @foreach (var option in levelOptions)
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                        </select>
                        <ValidationMessage For="() => editModel.ApprovalLevel" class="text-danger" />
                        <div class="form-text mt-2">@GetSelectedLevelDescription()</div>
                    </div>

                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="absenceApprovalPolicyEnabled" @bind="editModel.IsEnabled" />
                            <label class="form-check-label" for="absenceApprovalPolicyEnabled">Policy enabled</label>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="autoMarkOffIfWithinHoursEnabled" @bind="editModel.AutoMarkOffIfWithinHoursEnabled" />
                            <label class="form-check-label" for="autoMarkOffIfWithinHoursEnabled">Auto mark-off if scheduled start is within threshold</label>
                        </div>
                        <div class="form-text">When enabled, approved mark-off requests can be processed before scheduled start if they fall within the configured hours.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="autoMarkOffIfWithinHours">Auto mark-off threshold (hours)</label>
                        <input class="form-control"
                               type="number"
                               id="autoMarkOffIfWithinHours"
                               min="0"
                               max="720"
                               @bind="editModel.AutoMarkOffIfWithinHours"
                               disabled="@(!editModel.AutoMarkOffIfWithinHoursEnabled)" />
                        <ValidationMessage For="() => editModel.AutoMarkOffIfWithinHours" class="text-danger" />
                        <div class="form-text">Set to 0 to process only at scheduled time (never early).</div>
                    </div>

                    @if (!IsFeatureReadOnly)
                    {
                        <button type="submit" class="btn btn-primary" disabled="@isSaving">
                            <span class="bi bi-check-circle me-1"></span> Save
                        </button>
                    }
                </EditForm>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="card-title mb-1">Department Request Window Caps</h5>
                        <div class="text-muted small">Configure max absence request window days per department.</div>
                    </div>
                    @if (!IsFeatureReadOnly)
                    {
                        <button class="btn btn-primary" @onclick="OpenCreateDepartmentCapModal">
                            <span class="bi bi-plus-circle"></span> Create
                        </button>
                    }
                </div>

                @if (isLoadingDepartmentCaps)
                {
                    <div class="text-center py-4"><div class="spinner-border" /></div>
                }
                else if (departmentCapRows.Count == 0)
                {
                    <div class="text-muted">No departments found for the selected railroad.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th>Department</th>
                                    <th class="text-end">Cap (Days)</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in departmentCapRows)
                                {
                                    <tr>
                                        <td class="fw-semibold">@row.DepartmentName</td>
                                        <td class="text-end">@(row.RequestWindowCapDays?.ToString() ?? "—")</td>
                                        <td class="text-end">
                                            @if (!IsFeatureReadOnly)
                                            {
                                                <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenDepartmentCapModal(row)">
                                                    @(row.RequestWindowCapDays.HasValue ? "Edit" : "Configure")
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="card-title mb-1">Craft Waitlist Configuration</h5>
                        <div class="text-muted small">Configure waitlist reassignment caps per craft.</div>
                    </div>
                    @if (!IsFeatureReadOnly)
                    {
                        <button class="btn btn-primary" @onclick="OpenCreateCraftWaitListModal">
                            <span class="bi bi-plus-circle"></span> Create
                        </button>
                    }
                </div>

                @if (isLoadingCraftWaitLists)
                {
                    <div class="text-center py-4"><div class="spinner-border" /></div>
                }
                else if (craftWaitListRows.Count == 0)
                {
                    <div class="text-muted">No crafts found for the selected railroad.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th>Craft</th>
                                    <th class="text-end">Comp Day Max</th>
                                    <th class="text-end">Vacation Week Max</th>
                                    <th class="text-end">Enabled</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in craftWaitListRows)
                                {
                                    <tr>
                                        <td class="fw-semibold">@row.CraftName</td>
                                        <td class="text-end">@(row.WaitListCompensableDayMaxAssignments?.ToString() ?? "—")</td>
                                        <td class="text-end">@(row.WaitListVacationWeekMaxAssignments?.ToString() ?? "—")</td>
                                        <td class="text-end">
                                            @if (!row.WaitListConfigured)
                                            {
                                                <span>—</span>
                                            }
                                            else
                                            {
                                                <span class="badge @(row.WaitListIsEnabled ? "bg-success" : "bg-secondary")">
                                                    @(row.WaitListIsEnabled ? "Yes" : "No")
                                                </span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (!IsFeatureReadOnly)
                                            {
                                                <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenCraftWaitListModal(row)">
                                                    @(row.WaitListConfigured ? "Edit" : "Configure")
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    protected override string? FeatureKey => "admin/absence-approval-policy";

    private sealed class ApprovalLevelOption
    {
        public string Value { get; init; } = string.Empty;
        public string Label { get; init; } = string.Empty;
        public string Description { get; init; } = string.Empty;
    }

    private sealed class EditModel
    {
        [Required]
        public string ApprovalLevel { get; set; } = CallerManagerLevel;

        public bool IsEnabled { get; set; } = true;

        public bool AutoMarkOffIfWithinHoursEnabled { get; set; }

        [Range(0, 720, ErrorMessage = "Hours must be between 0 and 720.")]
        public int AutoMarkOffIfWithinHours { get; set; }
    }

    private sealed class DepartmentCapRow
    {
        public long DepartmentCtrlNbr { get; init; }
        public string DepartmentName { get; init; } = string.Empty;
        public int? RequestWindowCapDays { get; set; }
    }

    private sealed class CraftWaitListRow
    {
        public long CraftCtrlNbr { get; init; }
        public string CraftName { get; init; } = string.Empty;
        public int? WaitListCompensableDayMaxAssignments { get; set; }
        public int? WaitListVacationWeekMaxAssignments { get; set; }
        public bool WaitListIsEnabled { get; set; }
        public bool WaitListConfigured { get; set; }
    }

    private sealed class DepartmentCapEditModel
    {
        public long DepartmentCtrlNbr { get; set; }
        public string DepartmentName { get; set; } = string.Empty;

        [Range(1, 365, ErrorMessage = "Cap days must be between 1 and 365.")]
        public int RequestWindowCapDays { get; set; } = 45;
    }

    private sealed class CraftWaitListEditModel
    {
        public long CraftCtrlNbr { get; set; }
        public string CraftName { get; set; } = string.Empty;

        [Range(0, 365, ErrorMessage = "Compensable day max assignments must be between 0 and 365.")]
        public int CompensableDayMaxAssignments { get; set; } = 3;

        [Range(0, 365, ErrorMessage = "Vacation week max assignments must be between 0 and 365.")]
        public int VacationWeekMaxAssignments { get; set; } = 3;

        public bool IsEnabled { get; set; } = true;
    }

    private const string AutomaticLevel = "Automatic";
    private const string CallerManagerLevel = "CallerManager";
    private const string ManagerOnlyLevel = "ManagerOnly";

    private readonly IReadOnlyList<ApprovalLevelOption> levelOptions =
    [
        new() { Value = AutomaticLevel, Label = "Automatic", Description = "Level 1 — requests are automatically approved by the system." },
        new() { Value = CallerManagerLevel, Label = "Caller or Manager", Description = "Level 2 — approval may be completed by a caller or a manager." },
        new() { Value = ManagerOnlyLevel, Label = "Manager Only", Description = "Level 3 — only manager approvers can approve requests." }
    ];

    private bool isLoading = true;
    private bool isLoadingDepartmentCaps;
    private bool isLoadingCraftWaitLists;
    private bool hasConfiguredPolicy;
    private bool showDepartmentCapModal;
    private bool showCraftWaitListModal;
    private bool isCreateDepartmentCapMode;
    private bool isCreateCraftWaitListMode;
    private EditModel editModel = new();
    private DepartmentCapEditModel departmentCapEditModel = new();
    private CraftWaitListEditModel craftWaitListEditModel = new();
    private List<DepartmentCapRow> departmentCapRows = [];
    private List<CraftWaitListRow> craftWaitListRows = [];

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        RequireFeatureAccess();
    }

    protected override async Task OnAppContextChangedAsync()
    {
        await LoadDataAsync();
        StateHasChanged();
    }

    protected override async Task LoadDataAsync()
    {
        if (!IsContextFullySelected || SelectedRailroadCtrlNbr is null)
            return;

        isLoading = true;
        isLoadingDepartmentCaps = true;
        isLoadingCraftWaitLists = true;
        errorMessage = null;

        try
        {
            var policy = await PoliciesClient.GetAbsenceApprovalPolicyAsync(SelectedRailroadCtrlNbr.Value);
            hasConfiguredPolicy = policy is not null;

            editModel = new EditModel
            {
                ApprovalLevel = NormalizeLevel(policy?.ApprovalLevel),
                IsEnabled = policy?.IsEnabled ?? true,
                AutoMarkOffIfWithinHoursEnabled = policy?.AutoMarkOffIfWithinHoursEnabled ?? false,
                AutoMarkOffIfWithinHours = policy?.AutoMarkOffIfWithinHours ?? 0
            };

            if (SelectedParentCtrlNbr is > 0)
            {
                var departments = await DepartmentClient.GetAllAsync(SelectedParentCtrlNbr.Value, SelectedRailroadCtrlNbr.Value);
                var rows = new List<DepartmentCapRow>();
                foreach (var department in departments.Departments.OrderBy(d => d.Name))
                {
                    var departmentPolicy = await PoliciesClient.GetDepartmentAbsenceRequestWindowPolicyAsync(department.CtrlNbr);
                    rows.Add(new DepartmentCapRow
                    {
                        DepartmentCtrlNbr = department.CtrlNbr,
                        DepartmentName = department.Name,
                        RequestWindowCapDays = departmentPolicy?.RequestWindowCapDays
                    });
                }

                departmentCapRows = rows;

                var crafts = await CraftClient.GetAllCraftsAsync(SelectedParentCtrlNbr.Value, SelectedRailroadCtrlNbr.Value);
                var craftRows = new List<CraftWaitListRow>();
                foreach (var craft in crafts.Crafts.OrderBy(c => c.CraftName))
                {
                    var waitListPolicy = await PoliciesClient.GetCraftAbsenceWaitListPolicyAsync(craft.CtrlNbr);
                    craftRows.Add(new CraftWaitListRow
                    {
                        CraftCtrlNbr = craft.CtrlNbr,
                        CraftName = craft.CraftName,
                        WaitListCompensableDayMaxAssignments = waitListPolicy?.CompensableDayMaxAssignments,
                        WaitListVacationWeekMaxAssignments = waitListPolicy?.VacationWeekMaxAssignments,
                        WaitListIsEnabled = waitListPolicy?.IsEnabled ?? false,
                        WaitListConfigured = waitListPolicy is not null
                    });
                }

                craftWaitListRows = craftRows;
            }
            else
            {
                departmentCapRows = [];
                craftWaitListRows = [];
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load absence approval policy: {ex.Message}";
            hasConfiguredPolicy = false;
            editModel = new EditModel();
            departmentCapRows = [];
            craftWaitListRows = [];
        }
        finally
        {
            isLoading = false;
            isLoadingDepartmentCaps = false;
            isLoadingCraftWaitLists = false;
        }
    }

    private async Task OnSave()
    {
        if (SelectedRailroadCtrlNbr is not { } railroadCtrlNbr)
            return;

        isSaving = true;
        errorMessage = null;

        try
        {
            var saved = await PoliciesClient.UpsertAbsenceApprovalPolicyAsync(
                railroadCtrlNbr,
                NormalizeLevel(editModel.ApprovalLevel),
                editModel.IsEnabled,
                editModel.AutoMarkOffIfWithinHoursEnabled,
                editModel.AutoMarkOffIfWithinHours);

            editModel.ApprovalLevel = NormalizeLevel(saved.ApprovalLevel);
            editModel.IsEnabled = saved.IsEnabled;
            editModel.AutoMarkOffIfWithinHoursEnabled = saved.AutoMarkOffIfWithinHoursEnabled;
            editModel.AutoMarkOffIfWithinHours = saved.AutoMarkOffIfWithinHours;
            hasConfiguredPolicy = true;
            successMessage = "Absence approval policy saved.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save absence approval policy: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void OpenDepartmentCapModal(DepartmentCapRow row)
    {
        isCreateDepartmentCapMode = false;
        departmentCapEditModel = new DepartmentCapEditModel
        {
            DepartmentCtrlNbr = row.DepartmentCtrlNbr,
            DepartmentName = row.DepartmentName,
            RequestWindowCapDays = row.RequestWindowCapDays ?? 45
        };

        showDepartmentCapModal = true;
    }

    private void OpenCreateDepartmentCapModal()
    {
        var candidate = departmentCapRows.FirstOrDefault(r => !r.RequestWindowCapDays.HasValue);
        if (candidate is null)
        {
            errorMessage = "All departments already have request window caps configured.";
            return;
        }

        errorMessage = null;
        isCreateDepartmentCapMode = true;
        departmentCapEditModel = new DepartmentCapEditModel
        {
            DepartmentCtrlNbr = 0,
            DepartmentName = string.Empty,
            RequestWindowCapDays = 45
        };
        showDepartmentCapModal = true;
    }

    private void CloseDepartmentCapModal()
    {
        showDepartmentCapModal = false;
        isCreateDepartmentCapMode = false;
    }

    private Task OnDepartmentCapDepartmentChanged()
    {
        var selected = departmentCapRows.FirstOrDefault(r => r.DepartmentCtrlNbr == departmentCapEditModel.DepartmentCtrlNbr);
        departmentCapEditModel.DepartmentName = selected?.DepartmentName ?? string.Empty;
        return Task.CompletedTask;
    }

    private void OpenCraftWaitListModal(CraftWaitListRow row)
    {
        isCreateCraftWaitListMode = false;
        craftWaitListEditModel = new CraftWaitListEditModel
        {
            CraftCtrlNbr = row.CraftCtrlNbr,
            CraftName = row.CraftName,
            CompensableDayMaxAssignments = row.WaitListCompensableDayMaxAssignments ?? 3,
            VacationWeekMaxAssignments = row.WaitListVacationWeekMaxAssignments ?? 3,
            IsEnabled = row.WaitListConfigured ? row.WaitListIsEnabled : true
        };

        showCraftWaitListModal = true;
    }

    private void OpenCreateCraftWaitListModal()
    {
        var candidate = craftWaitListRows.FirstOrDefault(r => !r.WaitListConfigured);
        if (candidate is null)
        {
            errorMessage = "All crafts already have waitlist configuration.";
            return;
        }

        errorMessage = null;
        isCreateCraftWaitListMode = true;
        craftWaitListEditModel = new CraftWaitListEditModel
        {
            CraftCtrlNbr = 0,
            CraftName = string.Empty,
            CompensableDayMaxAssignments = 3,
            VacationWeekMaxAssignments = 3,
            IsEnabled = true
        };
        showCraftWaitListModal = true;
    }

    private void CloseCraftWaitListModal()
    {
        showCraftWaitListModal = false;
        isCreateCraftWaitListMode = false;
    }

    private Task OnCraftWaitListCraftChanged()
    {
        var selected = craftWaitListRows.FirstOrDefault(r => r.CraftCtrlNbr == craftWaitListEditModel.CraftCtrlNbr);
        craftWaitListEditModel.CraftName = selected?.CraftName ?? string.Empty;
        return Task.CompletedTask;
    }

    private async Task OnSaveDepartmentCap()
    {
        if (departmentCapEditModel.DepartmentCtrlNbr <= 0)
        {
            errorMessage = "Department is required.";
            return;
        }

        isSaving = true;
        errorMessage = null;

        try
        {
            var saved = await PoliciesClient.UpsertDepartmentAbsenceRequestWindowPolicyAsync(
                departmentCapEditModel.DepartmentCtrlNbr,
                departmentCapEditModel.RequestWindowCapDays);

            var row = departmentCapRows.FirstOrDefault(r => r.DepartmentCtrlNbr == saved.DepartmentCtrlNbr);
            if (row is not null)
                row.RequestWindowCapDays = saved.RequestWindowCapDays;

            successMessage = $"Request window cap saved for {departmentCapEditModel.DepartmentName}.";
            showDepartmentCapModal = false;
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save department request window cap: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task OnSaveCraftWaitList()
    {
        if (craftWaitListEditModel.CraftCtrlNbr <= 0)
        {
            errorMessage = "Craft is required.";
            return;
        }

        isSaving = true;
        errorMessage = null;

        try
        {
            var saved = await PoliciesClient.UpsertCraftAbsenceWaitListPolicyAsync(
                craftWaitListEditModel.CraftCtrlNbr,
                craftWaitListEditModel.CompensableDayMaxAssignments,
                craftWaitListEditModel.VacationWeekMaxAssignments,
                craftWaitListEditModel.IsEnabled);

            var row = craftWaitListRows.FirstOrDefault(r => r.CraftCtrlNbr == saved.CraftCtrlNbr);
            if (row is not null)
            {
                row.WaitListCompensableDayMaxAssignments = saved.CompensableDayMaxAssignments;
                row.WaitListVacationWeekMaxAssignments = saved.VacationWeekMaxAssignments;
                row.WaitListIsEnabled = saved.IsEnabled;
                row.WaitListConfigured = true;
            }

            successMessage = $"Waitlist configuration saved for {craftWaitListEditModel.CraftName}.";
            showCraftWaitListModal = false;
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save craft waitlist configuration: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private string GetSelectedLevelDescription()
        => levelOptions.FirstOrDefault(o => string.Equals(o.Value, editModel.ApprovalLevel, StringComparison.OrdinalIgnoreCase))?.Description
            ?? levelOptions[1].Description;

    private static string NormalizeLevel(string? value)
    {
        if (string.Equals(value, AutomaticLevel, StringComparison.OrdinalIgnoreCase))
            return AutomaticLevel;

        if (string.Equals(value, ManagerOnlyLevel, StringComparison.OrdinalIgnoreCase))
            return ManagerOnlyLevel;

        return CallerManagerLevel;
    }
}
