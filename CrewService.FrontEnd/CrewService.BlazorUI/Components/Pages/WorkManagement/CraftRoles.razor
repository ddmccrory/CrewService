@page "/work-management/craft-roles"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using CrewService.BlazorUI.Clients
@using CrewService.Presentation

@inherits AppComponentBase

@attribute [Authorize]

@inject WorkManagementClient WorkManagementClient
@inject CraftClient CraftClient
@inject QualificationsClient QualificationsClient

<PageTitle>Craft Roles</PageTitle>

<h1>Craft Roles</h1>

@if (!HasRailroad)
{
    <div class="alert alert-warning">
        <span class="bi bi-exclamation-triangle"></span>
        Please select a railroad in the context switcher to manage craft roles.
    </div>
}
else
{
    <p class="text-muted mb-3">Managing craft roles for <strong>@SelectedRailroadName</strong></p>

    <div class="mb-3">
        <label class="form-label fw-semibold">Craft</label>
        <FilterSelect TItem="CraftResponse" TValue="long"
                      @bind-Value="selectedCraftCtrlNbr"
                      @bind-Value:after="OnCraftSelected"
                      Items="crafts"
                      ValueSelector="@(c => c.CtrlNbr)"
                      TextSelector="@(c => c.CraftName)"
                      Placeholder="-- Select Craft --"
                      class="form-select" style="max-width: 350px;" />
    </div>

    @if (selectedCraftCtrlNbr > 0)
    {
        <Modal Visible="showSaveModal"
               Title="@(editCtrlNbr > 0 ? "Edit Craft Role" : "Create Craft Role")"
               Icon="@(editCtrlNbr > 0 ? "bi bi-pencil" : "bi bi-plus-circle")"
               OnClose="CloseSaveModal">
            <BodyContent>
                <EditForm Model="saveModel" OnValidSubmit="OnSave" id="save-role-form">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Code</label>
                        <InputText @bind-Value="saveModel.Code" class="form-control" placeholder="e.g. COND (optional)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Name</label>
                        <InputText @bind-Value="saveModel.Name" class="form-control" placeholder="e.g. Conductor/Foreman" />
                        <ValidationMessage For="() => saveModel.Name" class="text-danger" />
                    </div>
                    <div class="mb-0">
                        <label class="form-label fw-semibold">Alternate Name</label>
                        <InputText @bind-Value="saveModel.AlternateName" class="form-control" placeholder="e.g. Conductor (optional)" />
                        <div class="form-text">Optional alternate display name for this role.</div>
                    </div>
                </EditForm>
            </BodyContent>
            <Footer>
                <button type="button" class="btn btn-outline-secondary" @onclick="CloseSaveModal">Cancel</button>
                <button type="submit" form="save-role-form" class="btn btn-primary" disabled="@isSaving">
                    <span class="bi bi-check-circle me-1"></span> @(editCtrlNbr > 0 ? "Update" : "Create")
                </button>
            </Footer>
        </Modal>

        <Modal Visible="showDeleteModal" Title="Confirm Delete" Icon="bi bi-exclamation-triangle"
               OnClose="() => showDeleteModal = false" Size="sm">
            <BodyContent>
                <p>Are you sure you want to delete <strong>@deleteName</strong>?</p>
            </BodyContent>
            <Footer>
                <button type="button" class="btn btn-outline-secondary" @onclick="() => showDeleteModal = false">Cancel</button>
                <button type="button" class="btn btn-danger" disabled="@isSaving" @onclick="ConfirmDelete">
                    <span class="bi bi-trash me-1"></span> Delete
                </button>
            </Footer>
        </Modal>

        <Modal Visible="showQualsModal"
               Title="@($"Required Qualifications — {qualsRoleName}")"
               Icon="bi bi-patch-check"
               OnClose="CloseQualsModal"
               Size="lg">
            <BodyContent>
                @if (qualsError is not null)
                {
                    <div class="alert alert-danger alert-dismissible">
                        @qualsError
                        <button type="button" class="btn-close" @onclick="() => qualsError = null"></button>
                    </div>
                }
                @if (roleQualifications is null)
                {
                    <p class="text-muted">Loading...</p>
                }
                else
                {
                    @if (roleQualifications.Count == 0)
                    {
                        <p class="text-muted fst-italic">No required qualifications defined for this role.</p>
                    }
                    else
                    {
                        <table class="table table-sm table-hover mb-3">
                            <thead><tr><th>Code</th><th>Name</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var rq in roleQualifications)
                                {
                                    var qt = qualTypes.FirstOrDefault(q => q.CtrlNbr == rq.QualificationTypeCtrlNbr);
                                    <tr>
                                        <td>@(qt?.Code.ToUpperInvariant() ?? "—")</td>
                                        <td>@(qt?.Name ?? "Unknown")</td>
                                        <td class="text-end">
                                            @if (!IsFeatureReadOnly)
                                            {
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveRoleQualification(rq.CtrlNbr)" disabled="@isSaving">
                                                    <span class="bi bi-trash"></span>
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    @if (!IsFeatureReadOnly)
                    {
                        <div class="d-flex gap-2 align-items-end">
                            <div class="flex-grow-1">
                                <label class="form-label fw-semibold mb-1">Add Qualification</label>
                                <FilterSelect TItem="QualificationTypeResponse" TValue="long"
                                              @bind-Value="addQualTypeCtrlNbr"
                                              Items="availableQualTypes"
                                              ValueSelector="@(q => q.CtrlNbr)"
                                              TextSelector="@(q => $"{q.Code.ToUpperInvariant()} — {q.Name}")"
                                              Placeholder="-- Select Qualification --"
                                              AlwaysShowPlaceholder="true"
                                              class="form-select" />
                            </div>
                            <button class="btn btn-primary" @onclick="AddRoleQualification" disabled="@(addQualTypeCtrlNbr == 0 || isSaving)">
                                <span class="bi bi-plus-circle me-1"></span> Add
                            </button>
                        </div>
                    }
                }
            </BodyContent>
            <Footer>
                <button type="button" class="btn btn-outline-secondary" @onclick="CloseQualsModal">Close</button>
            </Footer>
        </Modal>

        <SuccessAlert @bind-Message="successMessage" />

        @if (errorMessage is not null)
        {
            <div class="alert alert-danger alert-dismissible" role="alert">
                @errorMessage
                <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
            </div>
        }

        <DataTable TItem="CraftRoleResponse" Items="roles" Columns="columns"
                   SearchFilter="@((r, term) => r.Name.Contains(term, StringComparison.OrdinalIgnoreCase) || r.Code.Contains(term, StringComparison.OrdinalIgnoreCase) || r.AlternateName.Contains(term, StringComparison.OrdinalIgnoreCase))"
                   SearchPlaceholder="Search by code, name, or alternate name..."
                   EmptyMessage="No craft roles found for this craft."
                   DefaultSortColumn="Code">
            <ToolbarContent>
                @if (!IsFeatureReadOnly)
                {
                    <button class="btn btn-primary" @onclick="OpenCreateModal">
                        <span class="bi bi-plus-circle"></span> Create Craft Role
                    </button>
                }
            </ToolbarContent>
            <RowContent Context="role">
                <td>@(string.IsNullOrEmpty(role.Code) ? "—" : role.Code.ToUpperInvariant())</td>
                <td>@role.Name</td>
                <td>@(string.IsNullOrEmpty(role.AlternateName) ? "—" : role.AlternateName)</td>
                <td>
                    @if (!IsFeatureReadOnly)
                    {
                        <div class="d-flex gap-1">
                            <button class="btn btn-sm btn-outline-info flex-fill" @onclick="() => OpenQualsModal(role)">
                                <span class="bi bi-patch-check"></span> Qualifications
                            </button>
                            <button class="btn btn-sm btn-outline-primary flex-fill" @onclick="() => OpenEditModal(role)">
                                <span class="bi bi-pencil"></span> Edit
                            </button>
                            <button class="btn btn-sm btn-outline-danger flex-fill" @onclick="() => OpenDeleteModal(role)">
                                <span class="bi bi-trash"></span> Delete
                            </button>
                        </div>
                    }
                </td>
            </RowContent>
        </DataTable>
    }
}

@code {
    protected override string? FeatureKey => "work-management/craft-roles";

    private IReadOnlyList<CraftResponse>? crafts;
    private IReadOnlyList<CraftRoleResponse>? roles;
    private long selectedCraftCtrlNbr;

    private static readonly IReadOnlyList<DataTableColumn<CraftRoleResponse>> columns =
    [
        new("Code", r => r.Code),
        new("Name", r => r.Name),
        new("Alternate Name", r => r.AlternateName),
        DataTableColumn<CraftRoleResponse>.Actions()
    ];

    private bool showSaveModal;
    private long editCtrlNbr;
    private RoleInputModel saveModel = new();

    private bool showDeleteModal;
    private long deleteCtrlNbr;
    private string deleteName = "";

    protected override async Task LoadDataAsync()
    {
        if (HasRailroad)
            await LoadCrafts();
    }

    protected override async Task OnAppContextChangedAsync()
    {
        selectedCraftCtrlNbr = 0;
        roles = null;

        if (HasRailroad)
            await LoadCrafts();
        else
            crafts = null;
    }

    private async Task OnCraftSelected()
    {
        roles = null;

        if (selectedCraftCtrlNbr > 0)
            await LoadRoles();
    }

    private async Task LoadCrafts()
    {
        try
        {
            var response = await CraftClient.GetAllCraftsAsync(SelectedParentCtrlNbr!.Value, SelectedRailroadCtrlNbr!.Value);
            crafts = response.Crafts;

            if (crafts.Count == 1)
            {
                selectedCraftCtrlNbr = crafts[0].CtrlNbr;
                await LoadRoles();
            }
        }
        catch
        {
            crafts = [];
        }
    }

    private async Task LoadRoles()
    {
        try
        {
            errorMessage = null;
            var response = await WorkManagementClient.GetCraftRolesAsync(selectedCraftCtrlNbr);
            roles = response.Roles;
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load craft roles: {ex.Message}";
        }
    }

    private void OpenCreateModal()
    {
        editCtrlNbr = 0;
        saveModel = new();
        showSaveModal = true;
    }

    private void OpenEditModal(CraftRoleResponse role)
    {
        editCtrlNbr = role.CtrlNbr;
        saveModel = new()
        {
            Code = string.IsNullOrEmpty(role.Code) ? null : role.Code,
            Name = role.Name,
            AlternateName = string.IsNullOrEmpty(role.AlternateName) ? null : role.AlternateName
        };
        showSaveModal = true;
    }

    private void CloseSaveModal()
    {
        showSaveModal = false;
        editCtrlNbr = 0;
        saveModel = new();
    }

    private void OpenDeleteModal(CraftRoleResponse role)
    {
        deleteCtrlNbr = role.CtrlNbr;
        deleteName = role.Name;
        showDeleteModal = true;
    }

    private async Task OnSave()
    {
        try
        {
            isSaving = true;
            errorMessage = null;
            successMessage = null;

            if (editCtrlNbr > 0)
            {
                await WorkManagementClient.UpdateCraftRoleAsync(editCtrlNbr, saveModel.Code, saveModel.Name!, saveModel.AlternateName);
                successMessage = "Craft role updated.";
            }
            else
            {
                await WorkManagementClient.CreateCraftRoleAsync(selectedCraftCtrlNbr, saveModel.Code, saveModel.Name!, saveModel.AlternateName);
                successMessage = "Craft role created.";
            }

            CloseSaveModal();
            await LoadRoles();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save craft role: {ex.Message}";
        }
        finally { isSaving = false; }
    }

    private async Task ConfirmDelete()
    {
        try
        {
            isSaving = true;
            errorMessage = null;
            successMessage = null;

            await WorkManagementClient.DeleteCraftRoleAsync(deleteCtrlNbr);
            successMessage = "Craft role deleted.";
            showDeleteModal = false;
            await LoadRoles();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to delete craft role: {ex.Message}";
            showDeleteModal = false;
        }
        finally { isSaving = false; }
    }
    // ── Qualifications Modal ──

    private bool showQualsModal;
    private long qualsRoleCtrlNbr;
    private string qualsRoleName = string.Empty;
    private IReadOnlyList<CraftRoleQualificationResponse>? roleQualifications;
    private IReadOnlyList<QualificationTypeResponse> qualTypes = [];
    private IReadOnlyList<QualificationTypeResponse> availableQualTypes = [];
    private long addQualTypeCtrlNbr;
    private string? qualsError;

    private async Task OpenQualsModal(CraftRoleResponse role)
    {
        qualsRoleCtrlNbr = role.CtrlNbr;
        qualsRoleName = role.Name;
        qualsError = null;
        addQualTypeCtrlNbr = 0;
        roleQualifications = null;
        showQualsModal = true;
        await LoadRoleQualifications();
    }

    private void CloseQualsModal()
    {
        showQualsModal = false;
        roleQualifications = null;
    }

    private async Task LoadRoleQualifications()
    {
        try
        {
            // Load all qual types for this parent (filtered to current craft)
            var typesResponse = await QualificationsClient.GetQualificationTypesAsync(SelectedParentCtrlNbr!.Value, activeOnly: true);
            qualTypes = [.. typesResponse.QualificationTypes.OrderBy(q => q.Code, StringComparer.OrdinalIgnoreCase)];

            var qualsResponse = await WorkManagementClient.GetCraftRoleQualificationsAsync(qualsRoleCtrlNbr);
            roleQualifications = [.. qualsResponse.Qualifications];

            var assignedCtrlNbrs = roleQualifications.Select(q => q.QualificationTypeCtrlNbr).ToHashSet();
            availableQualTypes = [.. qualTypes
                .Where(q => !assignedCtrlNbrs.Contains(q.CtrlNbr) && (q.CraftCtrlNbr == 0 || q.CraftCtrlNbr == selectedCraftCtrlNbr))];
        }
        catch (Exception ex) { qualsError = $"Failed to load qualifications: {ex.Message}"; }
    }

    private async Task AddRoleQualification()
    {
        if (addQualTypeCtrlNbr == 0) return;
        try
        {
            isSaving = true; qualsError = null;
            await WorkManagementClient.AddCraftRoleQualificationAsync(qualsRoleCtrlNbr, addQualTypeCtrlNbr);
            addQualTypeCtrlNbr = 0;
            await LoadRoleQualifications();
        }
        catch (Exception ex) { qualsError = $"Failed to add qualification: {ex.Message}"; }
        finally { isSaving = false; }
    }

    private async Task RemoveRoleQualification(long ctrlNbr)
    {
        try
        {
            isSaving = true; qualsError = null;
            await WorkManagementClient.RemoveCraftRoleQualificationAsync(ctrlNbr);
            await LoadRoleQualifications();
        }
        catch (Exception ex) { qualsError = $"Failed to remove qualification: {ex.Message}"; }
        finally { isSaving = false; }
    }


    private sealed class RoleInputModel
    {
        private string? _code;

        [StringLength(30)]
        public string? Code
        {
            get => _code;
            set => _code = value?.ToUpperInvariant();
        }

        [Required(ErrorMessage = "Name is required.")]
        [StringLength(100, MinimumLength = 1)]
        public string? Name { get; set; }

        [StringLength(100)]
        public string? AlternateName { get; set; }
    }
}
