    private sealed class BulletinRuleInputModel
    {
        [Range(1, 8760, ErrorMessage = "Bid window hours must be between 1 and 8760.")]
        public int BidWindowHours { get; set; } = 24;

        [Required(ErrorMessage = "Opens At time is required.")]
        public string BidWindowStartTime { get; set; } = "04:00";

        [Required(ErrorMessage = "Closes At time is required.")]
        public string BidWindowCloseTime { get; set; } = "04:00";

        [Range(0, 365, ErrorMessage = "Effective offset days must be between 0 and 365.")]
        public int EffectiveOffsetDays { get; set; } = 0;

        [Required(ErrorMessage = "Effective time is required.")]
        public string EffectiveTime { get; set; } = "04:00";

        // Optional: the domain treats a null/blank cutoff as "no cutoff" (bulletins always post today).
        public string BulletinCutoffTime { get; set; } = "";

        [Range(0, 8760, ErrorMessage = "Force assign hours must be between 0 and 8760.")]
        public int ForceAssignHours { get; set; } = 0;

