@page "/work-management/crafts"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using CrewService.BlazorUI.Clients
@using CrewService.Presentation

@inherits AppComponentBase

@attribute [Authorize]

@inject CraftClient CraftClient
@inject DepartmentClient DepartmentClient
@inject TenantConfigClient TenantConfigClient
@inject BulletinsClient BulletinsClient

<PageTitle>Crafts</PageTitle>

<h1>Crafts</h1>

@if (ShowSelectRailroadBanner)
{
    <div class="alert alert-warning">
        <span class="bi bi-exclamation-triangle"></span>
        Please select a railroad in the context switcher to manage crafts.
    </div>
}
else if (HasRailroad)
{
    <p class="text-muted mb-3">Managing crafts for <strong>@SelectedRailroadName</strong></p>

    <Modal Visible="showSaveModal"
           Title="@(editCtrlNbr > 0 ? "Edit Craft" : "Create Craft")"
           Icon="@(editCtrlNbr > 0 ? "bi bi-pencil" : "bi bi-plus-circle")"
           OnClose="CloseSaveModal"
           Size="lg">
        <BodyContent>
            <EditForm Model="saveModel" OnValidSubmit="OnSave" id="save-craft-form">
                <DataAnnotationsValidator />
                @if (editCtrlNbr == 0)
                {
                <div class="mb-3">
                    <label class="form-label fw-semibold">Owner</label>
                    <InputSelect @bind-Value="saveModel.OwnerCtrlNbr" class="form-select">
                        <option value="0">All Railroads (Parent Level)</option>
                        @if (railroads is not null)
                        {
                            @foreach (var rr in railroads)
                            {
                                <option value="@rr.CtrlNbr">@rr.Name</option>
                            }
                        }
                    </InputSelect>
                    <div class="form-text">Parent-level crafts are inherited by all railroads.</div>
                </div>
                }
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Name</label>
                        <InputText @bind-Value="saveModel.CraftName" class="form-control" placeholder="e.g. Engineer" />
                        <ValidationMessage For="() => saveModel.CraftName" class="text-danger" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Plural Name</label>
                        <InputText @bind-Value="saveModel.CraftPluralName" class="form-control" placeholder="e.g. Engineers" />
                        <ValidationMessage For="() => saveModel.CraftPluralName" class="text-danger" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Craft Number</label>
                        <InputNumber @bind-Value="saveModel.CraftNumber" class="form-control" />
                        <ValidationMessage For="() => saveModel.CraftNumber" class="text-danger" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Vacation Assignment Type</label>
                        <InputNumber @bind-Value="saveModel.VacationAssignmentType" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Max Vacation Day Time</label>
                        <InputNumber @bind-Value="saveModel.MaximumVacationDayTime" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Department</label>
                        <SelectInput TItem="DepartmentResponse" TValue="long"
                                     @bind-Value="saveModel.DepartmentCtrlNbr"
                                     Items="departments"
                                     ValueSelector="@(d => d.CtrlNbr)"
                                     TextSelector="@(d => d.Name)"
                                     Placeholder="— None —"
                                     class="form-select" />
                    </div>
                </div>

                <hr class="my-3" />
                <h6 class="text-muted mb-3">Hours &amp; Time Settings</h6>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Mark-Off Hours</label>
                        <InputNumber @bind-Value="saveModel.MarkOffHours" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Mark-Up Hours</label>
                        <InputNumber @bind-Value="saveModel.MarkUpHours" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Required Rest Hours</label>
                        <InputNumber @bind-Value="saveModel.RequiredRestHours" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Unpaid Meal (min)</label>
                        <InputNumber @bind-Value="saveModel.UnpaidMealPeriodMinutes" class="form-control" />
                    </div>
                </div>

                <hr class="my-3" />
                <h6 class="text-muted mb-3">Options</h6>
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="form-check form-switch">
                            <InputCheckbox @bind-Value="saveModel.AutoMarkUp" class="form-check-input" id="chkAutoMarkUp" />
                            <label class="form-check-label" for="chkAutoMarkUp">Auto Mark-Up</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check form-switch">
                            <InputCheckbox @bind-Value="saveModel.ApproveAllMarkOffs" class="form-check-input" id="chkApproveMarkOffs" />
                            <label class="form-check-label" for="chkApproveMarkOffs">Approve All Mark-Offs</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check form-switch">
                            <InputCheckbox @bind-Value="saveModel.HoursOfService" class="form-check-input" id="chkHoS" />
                            <label class="form-check-label" for="chkHoS">Hours of Service</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check form-switch">
                            <InputCheckbox @bind-Value="saveModel.ProcessPayroll" class="form-check-input" id="chkPayroll" />
                            <label class="form-check-label" for="chkPayroll">Process Payroll</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check form-switch">
                            <InputCheckbox @bind-Value="saveModel.ShowNotifications" class="form-check-input" id="chkNotify" />
                            <label class="form-check-label" for="chkNotify">Show Notifications</label>
                        </div>
                    </div>
                </div>

                @if (editCtrlNbr == 0)
                {
                    <hr class="my-3" />
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h6 class="text-muted mb-0">Initial Roster/Board Setup</h6>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ApplyProvisioningDefaults">
                            Use Craft Defaults
                        </button>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <InputCheckbox @bind-Value="saveModel.CreateStandardRoster" class="form-check-input" id="chkCreateStandardRoster" />
                                <label class="form-check-label" for="chkCreateStandardRoster">Create Standard Roster</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <InputCheckbox @bind-Value="saveModel.CreateTrainingRoster" class="form-check-input" id="chkCreateTrainingRoster" />
                                <label class="form-check-label" for="chkCreateTrainingRoster">Create Training Roster</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Standard Roster Name</label>
                            <InputText @bind-Value="saveModel.StandardRosterName" class="form-control" disabled="@(!saveModel.CreateStandardRoster)" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Standard Roster Plural Name</label>
                            <InputText @bind-Value="saveModel.StandardRosterPluralName" class="form-control" disabled="@(!saveModel.CreateStandardRoster)" />
                        </div>
                        <div class="col-md-4">
                            <div class="form-check form-switch">
                                <InputCheckbox @bind-Value="saveModel.CreateExtraBoard" class="form-check-input" id="chkCreateExtraBoard" disabled="@(!saveModel.CreateStandardRoster)" />
                                <label class="form-check-label" for="chkCreateExtraBoard">Extra Board</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check form-switch">
                                <InputCheckbox @bind-Value="saveModel.CreateHangoutBoard" class="form-check-input" id="chkCreateHangoutBoard" disabled="@(!saveModel.CreateStandardRoster)" />
                                <label class="form-check-label" for="chkCreateHangoutBoard">Hangout</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check form-switch">
                                <InputCheckbox @bind-Value="saveModel.CreateExtendedAbsenceBoard" class="form-check-input" id="chkCreateExtendedAbsenceBoard" disabled="@(!saveModel.CreateStandardRoster)" />
                                <label class="form-check-label" for="chkCreateExtendedAbsenceBoard">Extended Absence</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Extra Board Name</label>
                            <InputText @bind-Value="saveModel.ExtraBoardName" class="form-control" disabled="@(!saveModel.CreateStandardRoster || !saveModel.CreateExtraBoard)" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Hangout Name</label>
                            <InputText @bind-Value="saveModel.HangoutBoardName" class="form-control" disabled="@(!saveModel.CreateStandardRoster || !saveModel.CreateHangoutBoard)" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Extended Absence Name</label>
                            <InputText @bind-Value="saveModel.ExtendedAbsenceBoardName" class="form-control" disabled="@(!saveModel.CreateStandardRoster || !saveModel.CreateExtendedAbsenceBoard)" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Training Roster Name</label>
                            <InputText @bind-Value="saveModel.TrainingRosterName" class="form-control" disabled="@(!saveModel.CreateTrainingRoster)" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Training Roster Plural Name</label>
                            <InputText @bind-Value="saveModel.TrainingRosterPluralName" class="form-control" disabled="@(!saveModel.CreateTrainingRoster)" />
                        </div>
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <InputCheckbox @bind-Value="saveModel.CreateNewHiresBoard" class="form-check-input" id="chkCreateNewHiresBoard" disabled="@(!saveModel.CreateTrainingRoster)" />
                                <label class="form-check-label" for="chkCreateNewHiresBoard">New Hires Board</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">New Hires Name</label>
                            <InputText @bind-Value="saveModel.NewHiresBoardName" class="form-control" disabled="@(!saveModel.CreateTrainingRoster || !saveModel.CreateNewHiresBoard)" />
                        </div>
                    </div>
                }
            </EditForm>
        </BodyContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="CloseSaveModal">Cancel</button>
            <button type="submit" form="save-craft-form" class="btn btn-primary" disabled="@(!CanSubmitSave())">
                <span class="bi bi-check-circle me-1"></span> @(editCtrlNbr > 0 ? "Update" : "Create")
            </button>
        </Footer>
    </Modal>

    <Modal Visible="showDeleteModal" Title="Confirm Delete" Icon="bi bi-exclamation-triangle"
           OnClose="() => showDeleteModal = false" Size="sm">
        <BodyContent>
            <p>Are you sure you want to delete <strong>@deleteName</strong>?</p>
        </BodyContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="() => showDeleteModal = false">Cancel</button>
            <button type="button" class="btn btn-danger" disabled="@isSaving" @onclick="ConfirmDelete">
                <span class="bi bi-trash me-1"></span> Delete
            </button>
        </Footer>
    </Modal>

    <Modal Visible="showBulletinRuleModal" Title="@($"Bulletin Rules — {bulletinRuleCraftName}")"
           Icon="bi bi-clock-history" OnClose="CloseBulletinRuleModal" Size="xl" Scrollable="true">
        <BodyContent>
            <EditForm Model="bulletinRuleModel" OnValidSubmit="OnSaveBulletinRule" id="bulletin-rule-form">
                <DataAnnotationsValidator />
                <div class="row g-4">
                    <div class="col-lg-6">
                        <h6 class="text-muted mb-3">Bid Window</h6>
                        <div class="row g-3 mb-3">
                            <div class="col-sm-4">
                                <label class="form-label fw-semibold">Window Hours</label>
                                <InputNumber @bind-Value="bulletinRuleModel.BidWindowHours" class="form-control" />
                                <div class="form-text">Total hours the bid window stays open.</div>
                                <ValidationMessage For="() => bulletinRuleModel.BidWindowHours" class="text-danger" />
                            </div>
                            <div class="col-sm-4">
                                <label class="form-label fw-semibold">Opens At (HH:mm)</label>
                                <InputText @bind-Value="bulletinRuleModel.BidWindowStartTime" class="form-control" placeholder="04:00" />
                                <ValidationMessage For="() => bulletinRuleModel.BidWindowStartTime" class="text-danger" />
                            </div>
                            <div class="col-sm-4">
                                <label class="form-label fw-semibold">Closes At (HH:mm)</label>
                                <InputText @bind-Value="bulletinRuleModel.BidWindowCloseTime" class="form-control" placeholder="04:00" />
                                <ValidationMessage For="() => bulletinRuleModel.BidWindowCloseTime" class="text-danger" />
                            </div>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-sm-6">
                                <label class="form-label fw-semibold">Bulletin Cutoff Time (HH:mm, optional)</label>
                                <InputText @bind-Value="bulletinRuleModel.BulletinCutoffTime" class="form-control" placeholder="HH:mm" />
                                <div class="form-text">Daily time of day after which a new bulletin posts for the next day instead of today. Leave blank for no cutoff (bulletins always post today).</div>
                                <ValidationMessage For="() => bulletinRuleModel.BulletinCutoffTime" class="text-danger" />
                            </div>
                        </div>
                        <hr class="my-3" />
                        <h6 class="text-muted mb-3">Effective Date</h6>
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label class="form-label fw-semibold">Offset Days After Close</label>
                                <InputNumber @bind-Value="bulletinRuleModel.EffectiveOffsetDays" class="form-control" />
                                <div class="form-text">Calendar days after bid close before position becomes effective.</div>
                                <ValidationMessage For="() => bulletinRuleModel.EffectiveOffsetDays" class="text-danger" />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label fw-semibold">Effective Time (HH:mm)</label>
                                <InputText @bind-Value="bulletinRuleModel.EffectiveTime" class="form-control" placeholder="04:00" />
                                <ValidationMessage For="() => bulletinRuleModel.EffectiveTime" class="text-danger" />
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <h6 class="text-muted mb-3">Force Assign</h6>
                        <div class="row g-3 mb-3">
                            <div class="col-12">
                                <label class="form-label fw-semibold">Effective Time Mode</label>
                                <SelectInput TItem="(string Value, string Label)" TValue="string"
                                             @bind-Value="bulletinRuleModel.EffectiveTimeMode"
                                             Items="effectiveTimeModes"
                                             ValueSelector="@(m => m.Value)"
                                             TextSelector="@(m => m.Label)"
                                             class="form-select" />
                                <div class="form-text">How the effective on-duty time is computed when force-assigning a no-bid position. "Effective time, unless off day" matches legacy Engineer behavior: 04:00 on work days, otherwise force-assign hours before the first work day's on-duty time.</div>
                            </div>
                        </div>
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label class="form-label fw-semibold">Force Assign Hours</label>
                                <InputNumber @bind-Value="bulletinRuleModel.ForceAssignHours" class="form-control" />
                                <div class="form-text">Hours before effective on-duty time to force-assign a no-bid position.</div>
                                <ValidationMessage For="() => bulletinRuleModel.ForceAssignHours" class="text-danger" />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label fw-semibold">Candidate Pool</label>
                                <SelectInput TItem="(string Value, string Label)" TValue="string"
                                             @bind-Value="bulletinRuleModel.ForceAssignSelectionMode"
                                             Items="forceAssignModes"
                                             ValueSelector="@(m => m.Value)"
                                             TextSelector="@(m => m.Label)"
                                             class="form-select" />
                                <div class="form-text">How to select the forced-assigned employee when no bids are received. "Extra Board only" always draws the junior-most eligible extra-board member. "Extra Board or promote from lower rank" adapts to the vacancy: a lowest-rank vacancy (e.g. Helper) draws the junior-most extra-board member, while a higher-rank vacancy (e.g. Foreman) can also be filled by promoting the junior-most qualified employee currently working a lower-rank position.</div>
                            </div>
                        </div>
                    </div>
                </div>
            </EditForm>
        </BodyContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="CloseBulletinRuleModal">Cancel</button>
            <button type="submit" form="bulletin-rule-form" class="btn btn-primary" disabled="@isSaving">
                <span class="bi bi-floppy me-1"></span> Save
            </button>
        </Footer>
    </Modal>

    <SuccessAlert @bind-Message="successMessage" />

    @if (errorMessage is not null)
    {
        <div class="alert alert-danger alert-dismissible" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <DataTable TItem="CraftResponse" Items="crafts" Columns="columns"
               SearchFilter="@((c, term) => c.CraftName.Contains(term, StringComparison.OrdinalIgnoreCase) || c.CraftPluralName.Contains(term, StringComparison.OrdinalIgnoreCase))"
               SearchPlaceholder="Search crafts..."
               EmptyMessage="No crafts found."
               DefaultSortColumn="Name">
        <ToolbarContent>
            @if (!IsFeatureReadOnly)
            {
                <button class="btn btn-primary" @onclick="OpenCreateModal">
                    <span class="bi bi-plus-circle"></span> Create Craft
                </button>
            }
        </ToolbarContent>
        <RowContent Context="craft">
            <td>@craft.CraftName</td>
            <td>@craft.CraftPluralName</td>
            <td>@craft.CraftNumber</td>
            <td>@(craft.HoursofService ? "Yes" : "No")</td>
            <td>@(craft.ProcessPayroll ? "Yes" : "No")</td>
            <td>@GetDepartmentName(craft.DepartmentCtrlNbr)</td>
            <td>
                @if (IsOwnedByRailroad(craft))
                {
                    <span class="badge bg-primary">Railroad</span>
                }
                else
                {
                    <span class="badge bg-secondary">Parent (inherited)</span>
                }
            </td>
            <td>
                @if (!IsFeatureReadOnly && IsOwnedByRailroad(craft))
                {
                    <div class="d-flex gap-1">
                        <button class="btn btn-sm btn-outline-info flex-fill" @onclick="() => OpenBulletinRuleModal(craft)">
                            <span class="bi bi-clock-history"></span> Bulletin Rules
                        </button>
                        <button class="btn btn-sm btn-outline-primary flex-fill" @onclick="() => OpenEditModal(craft)">
                            <span class="bi bi-pencil"></span> Edit
                        </button>
                        <button class="btn btn-sm btn-outline-danger flex-fill" @onclick="() => OpenDeleteModal(craft)">
                            <span class="bi bi-trash"></span> Delete
                        </button>
                    </div>
                }
            </td>
        </RowContent>
    </DataTable>
}

@code {
    protected override string? FeatureKey => "work-management/crafts";

    private IReadOnlyList<CraftResponse>? crafts;
    private IReadOnlyList<DepartmentResponse>? departments;
    private IReadOnlyList<GroupResponse>? railroads;

    private static readonly IReadOnlyList<DataTableColumn<CraftResponse>> columns =
    [
        new("Name", c => c.CraftName),
        new("Plural Name", c => c.CraftPluralName),
        new("Number", c => c.CraftNumber, width: "100px"),
        new("HoS", c => c.HoursofService, width: "80px"),
        new("Payroll", c => c.ProcessPayroll, width: "80px"),
        new("Department", c => c.DepartmentCtrlNbr > 0 ? "Assigned" : "—"),
        new("Owner", c => c.DynamicGroupCtrlNbr > 0 ? "Railroad" : "Parent", width: "120px"),
        DataTableColumn<CraftResponse>.Actions()
    ];

    private bool showSaveModal;
    private long editCtrlNbr;
    private CraftInputModel saveModel = new();

    private bool showDeleteModal;
    private long deleteCtrlNbr;
    private string deleteName = "";

    private bool showBulletinRuleModal;
    private long bulletinRuleCraftCtrlNbr;
    private string bulletinRuleCraftName = "";
    private BulletinRuleInputModel bulletinRuleModel = new();

    private static readonly List<(string Value, string Label)> forceAssignModes =
    [
        ("JuniorExtraBoard",          "Junior — Extra Board only"),
        ("JuniorHelperOrExtraBoard",  "Junior — Extra Board or promote from lower rank")
    ];

    private static readonly List<(string Value, string Label)> effectiveTimeModes =
    [
        ("FixedEffectiveTime",        "Fixed — always use the effective time"),
        ("EffectiveTimeUnlessOffDay", "Effective time, unless off day (on-duty minus force hours)"),
        ("OnDutyMinusForceHours",     "On-duty time minus force-assign hours"),
        ("BidWindowCloseTime",        "Bid window close time")
    ];

    protected override async Task LoadDataAsync()
    {
        if (HasRailroad)
        {
            await LoadRailroads();
            await LoadDepartments();
            await LoadCrafts();
        }
    }

    protected override async Task OnAppContextChangedAsync()
    {
        if (HasRailroad)
        {
            await LoadRailroads();
            await LoadDepartments();
            await LoadCrafts();
        }
        else
        {
            crafts = null;
            departments = null;
            railroads = null;
        }
    }

    private async Task LoadRailroads()
    {
        try
        {
            var response = await TenantConfigClient.GetGroupsByTypeNameAsync("Railroad", SelectedParentCtrlNbr!.Value);
            railroads = response.Groups;
        }
        catch
        {
            railroads = [];
        }
    }

    private async Task LoadDepartments()
    {
        try
        {
            var response = await DepartmentClient.GetAllAsync(SelectedParentCtrlNbr!.Value, SelectedRailroadCtrlNbr!.Value);
            departments = response.Departments;
        }
        catch
        {
            departments = [];
        }
    }

    private async Task LoadCrafts()
    {
        try
        {
            errorMessage = null;
            var response = await CraftClient.GetAllCraftsAsync(SelectedParentCtrlNbr!.Value, SelectedRailroadCtrlNbr!.Value);
            crafts = response.Crafts;
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load crafts: {ex.Message}";
        }
    }

    private void OpenCreateModal()
    {
        editCtrlNbr = 0;
        saveModel = new() { OwnerCtrlNbr = SelectedRailroadCtrlNbr!.Value };
        ApplyProvisioningDefaults();
        showSaveModal = true;
    }

    private void ApplyProvisioningDefaults()
    {
        var craftName = string.IsNullOrWhiteSpace(saveModel.CraftName) ? "Craft" : saveModel.CraftName.Trim();
        var craftPluralName = string.IsNullOrWhiteSpace(saveModel.CraftPluralName)
            ? (craftName.EndsWith("s", StringComparison.OrdinalIgnoreCase) ? craftName : $"{craftName}s")
            : saveModel.CraftPluralName.Trim();

        saveModel.StandardRosterName = craftName;
        saveModel.StandardRosterPluralName = craftPluralName;
        saveModel.TrainingRosterName = $"{craftName} Trainees";
        saveModel.TrainingRosterPluralName = $"{craftPluralName} Trainees";
        saveModel.ExtraBoardName = $"{craftName} Extra Board";
        saveModel.HangoutBoardName = $"{craftName} Hangout";
        saveModel.ExtendedAbsenceBoardName = $"{craftName} Extended Absence";
        saveModel.NewHiresBoardName = $"{craftName} New Hires";
    }

    private void OpenEditModal(CraftResponse craft)
    {
        editCtrlNbr = craft.CtrlNbr;
        saveModel = new()
        {
            CraftName = craft.CraftName,
            CraftPluralName = craft.CraftPluralName,
            CraftNumber = craft.CraftNumber,
            AutoMarkUp = craft.AutoMarkUp,
            ApproveAllMarkOffs = craft.ApproveAllMarkOffs,
            MarkOffHours = craft.MarkOffHours,
            MarkUpHours = craft.MarkUpHours,
            RequiredRestHours = craft.RequiredRestHours,
            MaximumVacationDayTime = craft.MaximumVacationDayTime,
            UnpaidMealPeriodMinutes = craft.UnpaidMealPeriodMinutes,
            HoursOfService = craft.HoursofService,
            ProcessPayroll = craft.ProcessPayroll,
            ShowNotifications = craft.ShowNotifications,
            VacationAssignmentType = craft.VacationAssignmentType,
            DepartmentCtrlNbr = craft.DepartmentCtrlNbr
        };
        showSaveModal = true;
    }

    private void CloseSaveModal()
    {
        showSaveModal = false;
        editCtrlNbr = 0;
        saveModel = new();
    }

    private void OpenDeleteModal(CraftResponse craft)
    {
        deleteCtrlNbr = craft.CtrlNbr;
        deleteName = craft.CraftName;
        showDeleteModal = true;
    }

    private async Task OnSave()
    {
        if (isSaving || !CanSubmitSave()) return;
        try
        {
            isSaving = true;
            errorMessage = null;
            successMessage = null;

            if (editCtrlNbr > 0)
            {
                await CraftClient.UpdateAsync(new UpdateCraftRequest
                {
                    CtrlNbr = editCtrlNbr,
                    CraftName = saveModel.CraftName!,
                    CraftPluralName = saveModel.CraftPluralName!,
                    CraftNumber = saveModel.CraftNumber,
                    AutoMarkUp = saveModel.AutoMarkUp,
                    ApproveAllMarkOffs = saveModel.ApproveAllMarkOffs,
                    MarkOffHours = saveModel.MarkOffHours,
                    MarkUpHours = saveModel.MarkUpHours,
                    RequiredRestHours = saveModel.RequiredRestHours,
                    MaximumVacationDayTime = saveModel.MaximumVacationDayTime,
                    UnpaidMealPeriodMinutes = saveModel.UnpaidMealPeriodMinutes,
                    HoursofService = saveModel.HoursOfService,
                    ProcessPayroll = saveModel.ProcessPayroll,
                    ShowNotifications = saveModel.ShowNotifications,
                    VacationAssignmentType = saveModel.VacationAssignmentType,
                    DepartmentCtrlNbr = saveModel.DepartmentCtrlNbr
                });
                successMessage = "Craft updated.";
            }
            else
            {
                await CraftClient.CreateAsync(new CreateCraftRequest
                {
                    ParentCtrlNbr = SelectedParentCtrlNbr!.Value,
                    DynamicGroupCtrlNbr = saveModel.OwnerCtrlNbr,
                    CraftName = saveModel.CraftName!,
                    CraftPluralName = saveModel.CraftPluralName!,
                    CraftNumber = saveModel.CraftNumber,
                    AutoMarkUp = saveModel.AutoMarkUp,
                    ApproveAllMarkOffs = saveModel.ApproveAllMarkOffs,
                    MarkOffHours = saveModel.MarkOffHours,
                    MarkUpHours = saveModel.MarkUpHours,
                    RequiredRestHours = saveModel.RequiredRestHours,
                    MaximumVacationDayTime = saveModel.MaximumVacationDayTime,
                    UnpaidMealPeriodMinutes = saveModel.UnpaidMealPeriodMinutes,
                    HoursofService = saveModel.HoursOfService,
                    ProcessPayroll = saveModel.ProcessPayroll,
                    ShowNotifications = saveModel.ShowNotifications,
                    VacationAssignmentType = saveModel.VacationAssignmentType,
                    DepartmentCtrlNbr = saveModel.DepartmentCtrlNbr,
                    CreateStandardRoster = saveModel.CreateStandardRoster,
                    CreateExtraBoard = saveModel.CreateExtraBoard,
                    CreateHangoutBoard = saveModel.CreateHangoutBoard,
                    CreateExtendedAbsenceBoard = saveModel.CreateExtendedAbsenceBoard,
                    CreateTrainingRoster = saveModel.CreateTrainingRoster,
                    CreateNewHiresBoard = saveModel.CreateNewHiresBoard,
                    StandardRosterName = saveModel.StandardRosterName ?? string.Empty,
                    StandardRosterPluralName = saveModel.StandardRosterPluralName ?? string.Empty,
                    TrainingRosterName = saveModel.TrainingRosterName ?? string.Empty,
                    TrainingRosterPluralName = saveModel.TrainingRosterPluralName ?? string.Empty,
                    ExtraBoardName = saveModel.ExtraBoardName ?? string.Empty,
                    HangoutBoardName = saveModel.HangoutBoardName ?? string.Empty,
                    ExtendedAbsenceBoardName = saveModel.ExtendedAbsenceBoardName ?? string.Empty,
                    NewHiresBoardName = saveModel.NewHiresBoardName ?? string.Empty
                });
                successMessage = "Craft created.";
            }

            CloseSaveModal();
            await LoadCrafts();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save craft: {ex.Message}";
        }
        finally { isSaving = false; }
    }

    private bool CanSubmitSave()
    {
        if (isSaving)
            return false;

        if (string.IsNullOrWhiteSpace(saveModel.CraftName) || string.IsNullOrWhiteSpace(saveModel.CraftPluralName))
            return false;

        if (editCtrlNbr > 0)
            return true;

        if (!saveModel.CreateStandardRoster && (saveModel.CreateExtraBoard || saveModel.CreateHangoutBoard || saveModel.CreateExtendedAbsenceBoard))
            return false;

        if (!saveModel.CreateTrainingRoster && saveModel.CreateNewHiresBoard)
            return false;

        if (saveModel.CreateStandardRoster && (string.IsNullOrWhiteSpace(saveModel.StandardRosterName) || string.IsNullOrWhiteSpace(saveModel.StandardRosterPluralName)))
            return false;

        if (saveModel.CreateStandardRoster && saveModel.CreateExtraBoard && string.IsNullOrWhiteSpace(saveModel.ExtraBoardName))
            return false;

        if (saveModel.CreateStandardRoster && saveModel.CreateHangoutBoard && string.IsNullOrWhiteSpace(saveModel.HangoutBoardName))
            return false;

        if (saveModel.CreateStandardRoster && saveModel.CreateExtendedAbsenceBoard && string.IsNullOrWhiteSpace(saveModel.ExtendedAbsenceBoardName))
            return false;

        if (saveModel.CreateTrainingRoster && (string.IsNullOrWhiteSpace(saveModel.TrainingRosterName) || string.IsNullOrWhiteSpace(saveModel.TrainingRosterPluralName)))
            return false;

        if (saveModel.CreateTrainingRoster && saveModel.CreateNewHiresBoard && string.IsNullOrWhiteSpace(saveModel.NewHiresBoardName))
            return false;

        return true;
    }

    private async Task ConfirmDelete()
    {
        if (isSaving) return;
        try
        {
            isSaving = true;
            errorMessage = null;
            successMessage = null;
            await CraftClient.DeleteAsync(deleteCtrlNbr);
            showDeleteModal = false;
            successMessage = "Craft deleted.";
            await LoadCrafts();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to delete craft: {ex.Message}";
        }
        finally { isSaving = false; }
    }

    private string GetDepartmentName(long departmentCtrlNbr)
    {
        if (departmentCtrlNbr == 0 || departments is null) return "—";
        return departments.FirstOrDefault(d => d.CtrlNbr == departmentCtrlNbr)?.Name ?? "—";
    }

    private bool IsOwnedByRailroad(CraftResponse craft) =>
        craft.DynamicGroupCtrlNbr > 0 && craft.DynamicGroupCtrlNbr == SelectedRailroadCtrlNbr;

    // Strips seconds from a HH:mm:ss or HH:mm string → HH:mm
    private static string StripSeconds(string time) =>
        TimeSpan.TryParse(time, out var ts) ? $"{(int)ts.TotalHours:D2}:{ts.Minutes:D2}" : time;

    // Expands HH:mm to HH:mm:ss for the backend TimeSpan.Parse.
    // Blank input is preserved as blank (optional times such as the bulletin cutoff map to null server-side).
    private static string ExpandTime(string time) =>
        string.IsNullOrWhiteSpace(time) ? string.Empty
        : time.Count(c => c == ':') == 1 ? time + ":00" : time;

    private async Task OpenBulletinRuleModal(CraftResponse craft)
    {
        bulletinRuleCraftCtrlNbr = craft.CtrlNbr;
        bulletinRuleCraftName = craft.CraftName;
        var existing = await BulletinsClient.GetBulletinRuleAsync(craft.CtrlNbr);
        bulletinRuleModel = existing is not null
            ? new BulletinRuleInputModel
            {
                BidWindowHours = existing.BidWindowHours,
                BidWindowStartTime = StripSeconds(existing.BidWindowStartTime),
                BidWindowCloseTime = StripSeconds(existing.BidWindowCloseTime),
                EffectiveOffsetDays = existing.EffectiveOffsetDays,
                EffectiveTime = StripSeconds(existing.EffectiveTime),
                BulletinCutoffTime = StripSeconds(existing.BulletinCutoffTime),
                ForceAssignHours = existing.ForceAssignHours,
                ForceAssignSelectionMode = string.IsNullOrWhiteSpace(existing.ForceAssignSelectionMode)
                    ? "JuniorExtraBoard"
                    : existing.ForceAssignSelectionMode,
                EffectiveTimeMode = string.IsNullOrWhiteSpace(existing.EffectiveTimeMode)
                    ? "FixedEffectiveTime"
                    : existing.EffectiveTimeMode
            }
            : new BulletinRuleInputModel();
        showBulletinRuleModal = true;
    }

    private void CloseBulletinRuleModal()
    {
        showBulletinRuleModal = false;
        bulletinRuleCraftCtrlNbr = 0;
        bulletinRuleCraftName = "";
        bulletinRuleModel = new();
    }

    private async Task OnSaveBulletinRule()
    {
        if (isSaving) return;
        try
        {
            isSaving = true;
            errorMessage = null;
            successMessage = null;
            await BulletinsClient.SaveBulletinRuleAsync(new SaveBulletinRuleRequest
            {
                CraftCtrlNbr = bulletinRuleCraftCtrlNbr,
                BidWindowHours = bulletinRuleModel.BidWindowHours,
                BidWindowStartTime = ExpandTime(bulletinRuleModel.BidWindowStartTime),
                BidWindowCloseTime = ExpandTime(bulletinRuleModel.BidWindowCloseTime),
                EffectiveOffsetDays = bulletinRuleModel.EffectiveOffsetDays,
                EffectiveTime = ExpandTime(bulletinRuleModel.EffectiveTime),
                BulletinCutoffTime = ExpandTime(bulletinRuleModel.BulletinCutoffTime),
                ForceAssignHours = bulletinRuleModel.ForceAssignHours,
                ForceAssignSelectionMode = bulletinRuleModel.ForceAssignSelectionMode,
                EffectiveTimeMode = bulletinRuleModel.EffectiveTimeMode
            });
            successMessage = $"Bulletin rules saved for {bulletinRuleCraftName}.";
            CloseBulletinRuleModal();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save bulletin rules: {ex.Message}";
        }
        finally { isSaving = false; }
    }

