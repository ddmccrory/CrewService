@page "/work-management/qualification-types"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using CrewService.BlazorUI.Clients
@using CrewService.Presentation

@inherits AppComponentBase

@attribute [Authorize]

@inject QualificationsClient QualificationsClient
@inject CraftClient CraftClient
@inject NavigationManager Nav

<PageTitle>Qualification Types</PageTitle>

<h1>Qualification Types</h1>

@if (ShowSelectParentBanner)
{
    <div class="alert alert-warning">
        <span class="bi bi-exclamation-triangle"></span>
        Please select a parent in the context switcher to manage qualification types.
    </div>
}
else
{
    <p class="text-muted mb-3">Managing qualification types for <strong>@SelectedParentName</strong></p>

    <Modal Visible="showSaveModal"
           Title="@(editCtrlNbr > 0 ? "Edit Qualification Type" : "Create Qualification Type")"
           Icon="@(editCtrlNbr > 0 ? "bi bi-pencil" : "bi bi-plus-circle")"
           OnClose="CloseSaveModal"
           Size="lg">
        <BodyContent>
            <EditForm Model="saveModel" OnValidSubmit="OnSave" id="save-qual-type-form">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Code</label>
                        <InputText @bind-Value="saveModel.Code" class="form-control" placeholder="e.g. YARD-FOREMAN" disabled="@(editCtrlNbr > 0)" />
                        @if (editCtrlNbr > 0)
                        {
                            <div class="form-text text-muted">Code cannot be changed.</div>
                        }
                    </div>
                    <div class="col-md-8">
                        <label class="form-label fw-semibold">Name</label>
                        <InputText @bind-Value="saveModel.Name" class="form-control" placeholder="e.g. Yard Foreman Qualification" />
                    </div>
                    <div class="col-md-12">
                        <label class="form-label fw-semibold">Description</label>
                        <InputText @bind-Value="saveModel.Description" class="form-control" placeholder="Optional description" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Restrict to Craft <span class="text-muted fw-normal">(optional)</span></label>
                        <FilterSelect TItem="CraftResponse" TValue="long"
                                      @bind-Value="saveModel.CraftCtrlNbr"
                                      Items="crafts"
                                      ValueSelector="@(c => c.CtrlNbr)"
                                      TextSelector="@(c => c.CraftName)"
                                      Placeholder="-- All Crafts --"
                                      class="form-select" />
                        <div class="form-text">Narrows this qualification to a specific craft.</div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Evaluation Strategy</label>
                        <SelectInput TItem="string" TValue="string"
                                     @bind-Value="saveModel.EvaluationStrategy"
                                     Items="userDefinedStrategies"
                                     ValueSelector="@(s => s)"
                                     TextSelector="@(s => evaluationStrategyLabels.GetValueOrDefault(s, s))"
                                     Placeholder="-- Select Strategy --"
                                     class="form-select" />
                    </div>
                    @if (string.Equals(saveModel.EvaluationStrategy, EvaluationStrategies.FraCertification, StringComparison.Ordinal) && editCtrlNbr == 0)
                    {
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">FRA Regulatory Qualification</label>
                            <SelectInput TItem="RegulatoryQualificationCatalogItem" TValue="long"
                                         @bind-Value="saveModel.RegulatoryQualificationCtrlNbr"
                                         Items="regulatoryQualifications"
                                         ValueSelector="@(r => r.CtrlNbr)"
                                         TextSelector="@(r => $"{r.Code.ToUpperInvariant()} - {r.Description}")"
                                         Placeholder="-- Select FRA Qualification --"
                                         class="form-select" />
                        </div>
                    }
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Expiration Months</label>
                        <InputNumber @bind-Value="saveModel.ExpirationMonths" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Grace Days</label>
                        <InputNumber @bind-Value="saveModel.GraceDays" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Renewal Lead Days</label>
                        <InputNumber @bind-Value="saveModel.RenewalLeadDays" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <div class="form-check form-switch mt-4">
                            <InputCheckbox @bind-Value="saveModel.CalendarYearExpiry" class="form-check-input" />
                            <label class="form-check-label">Calendar Year Expiry</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check form-switch mt-4">
                            <InputCheckbox @bind-Value="saveModel.IsBlocking" class="form-check-input" />
                            <label class="form-check-label">Blocking Qualification</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">Restriction Label <span class="text-muted fw-normal">(optional)</span></label>
                        <InputText @bind-Value="saveModel.RestrictionLabel" class="form-control" placeholder="e.g. Helper Only" />
                        <div class="form-text">If set, employees without this qualification will be badged with this label on seniority and board displays.</div>
                    </div>
                </div>
            </EditForm>
        </BodyContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="CloseSaveModal">Cancel</button>
            <button type="submit" form="save-qual-type-form" class="btn btn-primary" disabled="@isSaving">
                <span class="bi bi-check2-circle me-1"></span> @(editCtrlNbr > 0 ? "Update" : "Save")
            </button>
        </Footer>
    </Modal>

    <Modal Visible="showDeleteModal" Title="Confirm Delete" Icon="bi bi-exclamation-triangle"
           OnClose="() => showDeleteModal = false" Size="sm">
        <BodyContent>
            <p>Are you sure you want to delete <strong>@deleteQualTypeName</strong>?</p>
        </BodyContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="() => showDeleteModal = false">Cancel</button>
            <button type="button" class="btn btn-danger" disabled="@isSaving" @onclick="ConfirmDelete">
                <span class="bi bi-trash me-1"></span> Delete
            </button>
        </Footer>
    </Modal>

    <SuccessAlert @bind-Message="successMessage" />

    @if (errorMessage is not null)
    {
        <div class="alert alert-danger alert-dismissible" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <DataTable TItem="QualificationTypeResponse"
               Items="qualificationTypes"
               Columns="columns"
               SearchFilter="@((q, term) => q.Code.Contains(term, StringComparison.OrdinalIgnoreCase) || q.Name.Contains(term, StringComparison.OrdinalIgnoreCase))"
               SearchPlaceholder="Search by code or name..."
               EmptyMessage="No qualification types defined."
               DefaultSortColumn="Code">
        <ToolbarContent>
            <div class="d-flex gap-2">
                @if (!IsFeatureReadOnly)
                {
                    <button class="btn btn-primary" @onclick="OpenCreateModal">
                        <span class="bi bi-plus-circle"></span> Create Type
                    </button>
                }
            </div>
        </ToolbarContent>
        <RowContent Context="q">
            <td>
                @q.Code.ToUpperInvariant()
                @if (string.Equals(q.EvaluationStrategy, EvaluationStrategies.FraCertification, StringComparison.Ordinal))
                {
                    <span class="badge bg-info ms-2">FRA</span>
                }
            </td>
            <td>@q.Name</td>
            <td>@(q.CraftCtrlNbr > 0 ? (crafts.FirstOrDefault(c => c.CtrlNbr == q.CraftCtrlNbr)?.CraftName ?? "—") : "—")</td>
            <td>@evaluationStrategyLabels.GetValueOrDefault(q.EvaluationStrategy, q.EvaluationStrategy)</td>
            <td>@(q.IsBlocking ? "Yes" : "No")</td>
            <td>@(q.IsActive ? "Active" : "Inactive")</td>
            <td>
                <div class="d-flex gap-1">
                    <button class="btn btn-sm btn-outline-primary" @onclick="() => NavigateToDetail(q)">
                        <span class="bi bi-list-check"></span> Requirements
                    </button>
                    @if (!string.Equals(q.EvaluationStrategy, EvaluationStrategies.FraCertification, StringComparison.Ordinal) && !q.IsSystemSeeded && !IsFeatureReadOnly)
                    {
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenEditModal(q)">
                            <span class="bi bi-pencil"></span> Edit
                        </button>
                        <button class="btn btn-sm @(q.IsActive ? "btn-outline-warning" : "btn-outline-success")"
                                @onclick="() => ToggleActive(q)">
                            <span class="bi @(q.IsActive ? "bi-pause-circle" : "bi-play-circle")"></span>
                            @(q.IsActive ? "Deactivate" : "Activate")
                        </button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => OpenDeleteModal(q)">
                            <span class="bi bi-trash"></span> Delete
                        </button>
                    }
                    else if (string.Equals(q.EvaluationStrategy, EvaluationStrategies.FraCertification, StringComparison.Ordinal))
                    {
                        <span class="text-muted small align-self-center ms-2">FRA Managed</span>
                    }
                </div>
            </td>
        </RowContent>
    </DataTable>
}

@code {
    protected override string? FeatureKey => "work-management/qualification-types";

    private static readonly IReadOnlyList<string> userDefinedStrategies =
        [EvaluationStrategies.Manual, EvaluationStrategies.TimeFromEvent, EvaluationStrategies.ActivityCount, EvaluationStrategies.TimeInRole, EvaluationStrategies.QualificationHeld, EvaluationStrategies.FraCertification];

    private static readonly Dictionary<string, string> evaluationStrategyLabels = new()
    {
        [EvaluationStrategies.Manual] = "Manual",
        [EvaluationStrategies.TimeFromEvent] = "Time from Event",
        [EvaluationStrategies.ActivityCount] = "Activity Count",
        [EvaluationStrategies.TimeInRole] = "Time in Role",
        [EvaluationStrategies.QualificationHeld] = "Certification Held",
        [EvaluationStrategies.FraCertification] = "FRA Certification"
    };

    private static readonly IReadOnlyList<DataTableColumn<QualificationTypeResponse>> columns =
    [
        new("Code", q => q.Code.ToUpperInvariant()),
        new("Name", q => q.Name),
        new("Craft", q => string.Empty),
        new("Strategy", q => evaluationStrategyLabels.GetValueOrDefault(q.EvaluationStrategy, q.EvaluationStrategy)),
        new("Blocking", q => q.IsBlocking ? "Yes" : "No"),
        new("Status", q => q.IsActive ? "Active" : "Inactive"),
        DataTableColumn<QualificationTypeResponse>.Actions()
    ];

    private IReadOnlyList<QualificationTypeResponse> qualificationTypes = [];
    private IReadOnlyList<RegulatoryQualificationCatalogItem> regulatoryQualifications = [];
    private IReadOnlyList<CraftResponse> crafts = [];
    private bool showSaveModal;
    private bool showDeleteModal;
    private long editCtrlNbr;
    private long deleteCtrlNbr;
    private string deleteQualTypeName = string.Empty;
    private SaveQualificationTypeModel saveModel = new();

    protected override async Task LoadDataAsync()
    {
        if (!HasParent) return;
        await LoadRegulatoryQualifications();
        await LoadCrafts();
        await LoadQualificationTypes();
    }

    protected override async Task OnAppContextChangedAsync()
    {
        if (!HasParent) { qualificationTypes = []; regulatoryQualifications = []; crafts = []; return; }
        await LoadRegulatoryQualifications();
        await LoadCrafts();
        await LoadQualificationTypes();
    }

    private async Task LoadCrafts()
    {
        try
        {
            var response = await CraftClient.GetAllCraftsAsync(SelectedParentCtrlNbr!.Value, SelectedRailroadCtrlNbr ?? 0);
            crafts = [.. response.Crafts.OrderBy(c => c.CraftName, StringComparer.OrdinalIgnoreCase)];
        }
        catch { crafts = []; }
    }

    private async Task LoadRegulatoryQualifications()
    {
        var response = await QualificationsClient.GetRegulatoryQualificationsAsync();
        regulatoryQualifications = [.. response.Qualifications.OrderBy(r => r.Code, StringComparer.OrdinalIgnoreCase)];
    }

    private async Task LoadQualificationTypes()
    {
        var response = await QualificationsClient.GetQualificationTypesAsync(SelectedParentCtrlNbr!.Value);
        qualificationTypes = [.. response.QualificationTypes.OrderBy(q => q.Code, StringComparer.OrdinalIgnoreCase)];
    }

    private void OpenCreateModal()
    {
        editCtrlNbr = 0;
        saveModel = new SaveQualificationTypeModel { EvaluationStrategy = EvaluationStrategies.Manual };
        showSaveModal = true;
    }

    private void OpenEditModal(QualificationTypeResponse q)
    {
        editCtrlNbr = q.CtrlNbr;
        saveModel = new SaveQualificationTypeModel
        {
            Code = q.Code,
            Name = q.Name,
            Description = q.Description,
            EvaluationStrategy = q.EvaluationStrategy,
            ExpirationMonths = q.ExpirationMonths > 0 ? q.ExpirationMonths : null,
            CalendarYearExpiry = q.CalendarYearExpiry,
            GraceDays = q.GraceDays,
            RenewalLeadDays = q.RenewalLeadDays,
            IsBlocking = q.IsBlocking,
            RestrictionLabel = string.IsNullOrEmpty(q.RestrictionLabel) ? null : q.RestrictionLabel,
            ScopeGroupCtrlNbr = q.ScopeGroupCtrlNbr,
            CraftCtrlNbr = q.CraftCtrlNbr
        };
        showSaveModal = true;
    }

    private void CloseSaveModal() => showSaveModal = false;

    private void OpenDeleteModal(QualificationTypeResponse q)
    {
        deleteCtrlNbr = q.CtrlNbr;
        deleteQualTypeName = q.Name;
        showDeleteModal = true;
    }

    private async Task OnSave()
    {
        try
        {
            isSaving = true; errorMessage = null;

            if (editCtrlNbr > 0)
            {
                await QualificationsClient.UpdateQualificationTypeAsync(new UpdateQualificationTypeRequest
                {
                    QualificationTypeCtrlNbr = editCtrlNbr,
                    Name = saveModel.Name ?? string.Empty,
                    Description = saveModel.Description ?? string.Empty,
                    EvaluationStrategy = saveModel.EvaluationStrategy ?? string.Empty,
                    ScopeGroupCtrlNbr = saveModel.ScopeGroupCtrlNbr,
                    CraftCtrlNbr = saveModel.CraftCtrlNbr,
                    ExpirationMonths = saveModel.ExpirationMonths ?? 0,
                    CalendarYearExpiry = saveModel.CalendarYearExpiry,
                    GraceDays = saveModel.GraceDays,
                    RenewalLeadDays = saveModel.RenewalLeadDays,
                    IsBlocking = saveModel.IsBlocking,
                    RestrictionLabel = saveModel.RestrictionLabel ?? string.Empty
                });
            }
            else
            {
                if (string.Equals(saveModel.EvaluationStrategy, EvaluationStrategies.FraCertification, StringComparison.Ordinal)
                    && saveModel.RegulatoryQualificationCtrlNbr <= 0)
                {
                    errorMessage = "FRA Regulatory Qualification is required for FraCertification strategy.";
                    return;
                }

                await QualificationsClient.CreateQualificationTypeAsync(new CreateQualificationTypeRequest
                {
                    ParentCtrlNbr = SelectedParentCtrlNbr!.Value,
                    Code = (saveModel.Code ?? string.Empty).ToUpperInvariant(),
                    Name = saveModel.Name ?? string.Empty,
                    Description = saveModel.Description ?? string.Empty,
                    EvaluationStrategy = saveModel.EvaluationStrategy ?? EvaluationStrategies.Manual,
                    ExpirationMonths = saveModel.ExpirationMonths ?? 0,
                    CalendarYearExpiry = saveModel.CalendarYearExpiry,
                    GraceDays = saveModel.GraceDays,
                    RenewalLeadDays = saveModel.RenewalLeadDays,
                    IsBlocking = saveModel.IsBlocking,
                    RestrictionLabel = saveModel.RestrictionLabel ?? string.Empty,
                    RegulatoryQualificationCtrlNbr = saveModel.RegulatoryQualificationCtrlNbr > 0
                        ? saveModel.RegulatoryQualificationCtrlNbr
                        : default
                });
                successMessage = "Qualification type created.";
            }

            showSaveModal = false;
            await LoadQualificationTypes();
        }
        catch (Exception ex) { errorMessage = $"Failed to save qualification type: {ex.Message}"; }
        finally { isSaving = false; }
    }

    private async Task ConfirmDelete()
    {
        try
        {
            isSaving = true; errorMessage = null;
            await QualificationsClient.DeleteQualificationTypeAsync(deleteCtrlNbr);
            showDeleteModal = false;
            successMessage = "Qualification type deleted.";
            await LoadQualificationTypes();
        }
        catch (Exception ex) { errorMessage = $"Failed to delete qualification type: {ex.Message}"; }
        finally { isSaving = false; }
    }

    private async Task ToggleActive(QualificationTypeResponse q)
    {
        try
        {
            errorMessage = null;
            await QualificationsClient.SetQualificationTypeActiveAsync(q.CtrlNbr, !q.IsActive);
            successMessage = q.IsActive ? "Qualification type deactivated." : "Qualification type activated.";
            await LoadQualificationTypes();
        }
        catch (Exception ex) { errorMessage = $"Failed to update qualification type: {ex.Message}"; }
    }

    private void NavigateToDetail(QualificationTypeResponse q)
        => Nav.NavigateTo($"/work-management/qualification-types/{q.CtrlNbr}");

    private sealed class SaveQualificationTypeModel
    {
        public string? Code { get; set; }
        public string? Name { get; set; }
        public string? Description { get; set; }
        public string? EvaluationStrategy { get; set; }
        public int? ExpirationMonths { get; set; }
        public bool CalendarYearExpiry { get; set; }
        public int GraceDays { get; set; }
        public int RenewalLeadDays { get; set; }
        public bool IsBlocking { get; set; }
        public string? RestrictionLabel { get; set; }
        public long RegulatoryQualificationCtrlNbr { get; set; }
        public long ScopeGroupCtrlNbr { get; set; }
        public long CraftCtrlNbr { get; set; }
    }
}

