@page "/daily/call-board"
@page "/daily/vacancy-resolution"
@page "/employees/prior-service"
@page "/payroll"
@page "/payroll/rates"
@page "/payroll/earning-codes"
@page "/payroll/holidays"
@page "/payroll/export"
@page "/compliance/safety"
@page "/info/railroad"
@page "/info/reports"
@page "/admin/users"

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@rendermode InteractiveServer
@inherits AppComponentBase

<PageTitle>@pageName — Crew Service</PageTitle>

<h3>@pageName</h3>

@if (IsContextFullySelected)
{
    <p class="text-muted">
        <span class="bi bi-diagram-3 me-1" aria-hidden="true"></span>@SelectedParentName
        <span class="mx-1">→</span>
        <span class="bi bi-train-front me-1" aria-hidden="true"></span>@SelectedRailroadName
    </p>
    <p class="text-muted">This page is under construction and will be available in a future release.</p>
}
else
{
    <div class="alert alert-warning d-flex align-items-center" role="alert">
        <span class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></span>
        Please select a Parent and Railroad from the top bar to continue.
    </div>
}

@code {
    private string? featureKey;
    protected override string? FeatureKey => featureKey;

    private string pageName = "Placeholder";

    // Routes whose path differs from their feature key
    private static readonly Dictionary<string, string> RouteToFeatureKey = new(StringComparer.OrdinalIgnoreCase)
    {
        ["payroll"] = "payroll/dashboard"
    };

    protected override void OnInitialized()
    {
        base.OnInitialized();
        NavigationManager.LocationChanged += OnLocationChanged;
        UpdatePageName();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdatePageName();
        InvokeAsync(StateHasChanged);
    }

    private void UpdatePageName()
    {
        var relative = NavigationManager.ToBaseRelativePath(NavigationManager.Uri)
            .Split('?', '#')[0]
            .TrimStart('/');

        // Feature key matches the relative URL path, with overrides for mismatches
        featureKey = string.IsNullOrEmpty(relative) ? null
            : RouteToFeatureKey.TryGetValue(relative, out var mappedKey) ? mappedKey
            : relative;

        pageName = relative
            .Split('/')
            .Where(s => !string.IsNullOrEmpty(s))
            .Select(s => System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(s.Replace("-", " ")))
            .LastOrDefault() ?? "Placeholder";
    }

    public override void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        base.Dispose();
    }
}
