@page "/compliance/drug-alcohol"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using CrewService.BlazorUI.Clients
@using CrewService.Presentation

@inherits AppComponentBase

@attribute [Authorize]

@inject FraComplianceClient FraComplianceClient
@inject EmployeeClient EmployeeClient

<PageTitle>Drug & Alcohol</PageTitle>

<h1>Drug & Alcohol</h1>

@if (!HasParent)
{
    <div class="alert alert-warning">
        <span class="bi bi-exclamation-triangle"></span>
        Please select a parent in the context switcher to manage Drug &amp; Alcohol.
    </div>
}
else
{
    <p class="text-muted mb-3">Managing Drug &amp; Alcohol for <strong>@SelectedParentName</strong></p>

    <Modal Visible="showRecordTestModal"
           Title="Record Drug/Alcohol Test"
           Icon="bi bi-shield-check"
           OnClose="CloseRecordTestModal">
        <BodyContent>
            <EditForm Model="recordTestModel" OnValidSubmit="RecordDrugAlcoholTest" id="record-test-form">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-md-12">
                        <label class="form-label fw-semibold">Employee</label>
                        <FilterSelect TItem="EmployeeSummary" TValue="long"
                                      Value="selectedEmployeeCtrlNbr"
                                      ValueChanged="OnSelectedEmployeeChanged"
                                      Items="allEmployees"
                                      ValueSelector="@(e => e.CtrlNbr)"
                                      TextSelector="@(e => $"{e.Code} - {e.Name}")"
                                      Searchable="true"
                                      AlwaysShowPlaceholder="true"
                                      Placeholder="-- Select Employee --"
                                      class="form-select" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Test Type</label>
                        <SelectInput TItem="string" TValue="string"
                                     @bind-Value="recordTestModel.TestType"
                                     Items="testTypes"
                                     ValueSelector="@(s => s)"
                                     TextSelector="@(s => s)"
                                     class="form-select" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Test Date</label>
                        <InputDate @bind-Value="recordTestModel.TestDate" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Alcohol Result</label>
                        <InputNumber @bind-Value="recordTestModel.AlcoholResult" class="form-control" step="0.001" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Drug Result</label>
                        <SelectInput TItem="string" TValue="string"
                                     @bind-Value="recordTestModel.DrugResult"
                                     Items="drugResults"
                                     ValueSelector="@(s => s)"
                                     TextSelector="@(s => s)"
                                     class="form-select" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Substances Detected</label>
                        <InputText @bind-Value="recordTestModel.SubstancesDetected" class="form-control" placeholder="Optional" />
                    </div>
                    <div class="col-md-6">
                        <div class="form-check form-switch mt-4">
                            <InputCheckbox @bind-Value="recordTestModel.FederalAuthority" class="form-check-input" />
                            <label class="form-check-label">Federal Authority</label>
                        </div>
                    </div>
                </div>
            </EditForm>
        </BodyContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="CloseRecordTestModal">Cancel</button>
            <button type="submit" form="record-test-form" class="btn btn-primary" disabled="@(isSaving || selectedEmployeeCtrlNbr <= 0)">
                <span class="bi bi-check-circle me-1"></span> Save
            </button>
        </Footer>
    </Modal>

    <Modal Visible="showAddReferralModal"
           Title="Add Voluntary Referral"
           Icon="bi bi-person-plus"
           OnClose="CloseAddReferralModal">
        <BodyContent>
            <EditForm Model="addReferralModel" OnValidSubmit="CreateVoluntaryReferral" id="add-referral-form">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-md-12">
                        <label class="form-label fw-semibold">Employee</label>
                        <FilterSelect TItem="EmployeeSummary" TValue="long"
                                      Value="addReferralModel.EmployeeCtrlNbr"
                                      ValueChanged="OnAddReferralEmployeeChanged"
                                      Items="allEmployees"
                                      ValueSelector="@(e => e.CtrlNbr)"
                                      TextSelector="@(e => $"{e.Code} - {e.Name}")"
                                      Searchable="true"
                                      AlwaysShowPlaceholder="true"
                                      Placeholder="-- Select Employee --"
                                      class="form-select" />
                    </div>
                </div>
            </EditForm>
        </BodyContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="CloseAddReferralModal">Cancel</button>
            <button type="submit" form="add-referral-form" class="btn btn-primary" disabled="@(isSaving || addReferralModel.EmployeeCtrlNbr <= 0)">
                <span class="bi bi-check-circle me-1"></span> Save
            </button>
        </Footer>
    </Modal>

    <SuccessAlert @bind-Message="successMessage" />

    @if (errorMessage is not null)
    {
        <div class="alert alert-danger alert-dismissible" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <div class="d-flex gap-2 mb-3">
        @if (!IsFeatureReadOnly)
        {
            <button class="btn btn-primary" @onclick="OpenRecordTestModal">
                <span class="bi bi-plus-circle"></span> Record Test
            </button>
            <button class="btn btn-outline-secondary" @onclick="OpenAddReferralModal">
                <span class="bi bi-plus-circle"></span> Add Referral
            </button>
        }
    </div>

    <DataTable TItem="EmployeeSummary" Items="employees" Columns="columns"
               SearchFilter="@((e, term) => e.Code.Contains(term, StringComparison.OrdinalIgnoreCase) || e.Name.Contains(term, StringComparison.OrdinalIgnoreCase))"
               SearchPlaceholder="Search employees with records..."
               EmptyMessage="No employees with drug/alcohol records found."
               DefaultSortColumn="Code">
        <RowContent Context="e">
            <td>@e.Code.ToUpperInvariant()</td>
            <td>@e.Name</td>
            <td>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenDetails(e.CtrlNbr)">Details</button>
            </td>
        </RowContent>
    </DataTable>
}

@code {
    protected override string? FeatureKey => "compliance/drug-alcohol";

    private IReadOnlyList<EmployeeSummary> employees = [];
    private IReadOnlyList<EmployeeSummary> allEmployees = [];
    private long selectedEmployeeCtrlNbr;
    private bool showRecordTestModal;
    private bool showAddReferralModal;

    private readonly IReadOnlyList<string> testTypes = ["PostAccident", "ReasonableSuspicion", "ReasonableCause", "Random", "PreEmployment", "ReturnToDuty", "FollowUp"];
    private readonly IReadOnlyList<string> drugResults = ["Negative", "Positive", "Refused"];

    private RecordTestModel recordTestModel = new();
    private AddReferralModel addReferralModel = new();

    private static readonly IReadOnlyList<DataTableColumn<EmployeeSummary>> columns =
    [
        new("Code", e => e.Code.ToUpperInvariant()),
        new("Employee", e => e.Name),
        DataTableColumn<EmployeeSummary>.Actions()
    ];

    protected override async Task LoadDataAsync()
    {
        if (!HasParent)
            return;

        await LoadEmployees();
    }

    protected override async Task OnAppContextChangedAsync()
    {
        if (!HasParent)
        {
            employees = [];
            return;
        }

        await LoadEmployeesWithRecords();
    }

    private async Task LoadEmployees()
        => await LoadEmployeesWithRecords();

    private async Task LoadEmployeesWithRecords()
    {
        var employeeResponse = await EmployeeClient.GetAllAsync(SelectedParentCtrlNbr!.Value);
        var employeeSummaries = employeeResponse.Employees
            .Select(e => new EmployeeSummary(e.CtrlNbr, e.EmployeeNumber, e.FullNameLnf))
            .OrderBy(e => e.Code)
            .ToList();

        allEmployees = employeeSummaries;

        var candidates = await Task.WhenAll(employeeSummaries.Select(async employee =>
        {
            var testsTask = FraComplianceClient.GetDrugAlcoholTestsAsync(employee.CtrlNbr);
            var actionsTask = FraComplianceClient.GetDrugAlcoholActionsAsync(employee.CtrlNbr);
            var referralsTask = FraComplianceClient.GetVoluntaryReferralsAsync(employee.CtrlNbr);

            await Task.WhenAll(testsTask, actionsTask, referralsTask);

            var hasRecord = testsTask.Result.Tests.Count > 0
                || actionsTask.Result.Actions.Count > 0
                || referralsTask.Result.Referrals.Count > 0;

            return hasRecord ? employee : null;
        }));

        employees = candidates.Where(c => c is not null).Select(c => c!).ToList();
    }

    private void OpenDetails(long employeeCtrlNbr)
        => NavigationManager.NavigateTo($"/compliance/drug-alcohol/{employeeCtrlNbr}");

    private Task OnSelectedEmployeeChanged(long employeeCtrlNbr)
    {
        selectedEmployeeCtrlNbr = employeeCtrlNbr;
        return Task.CompletedTask;
    }

    private void OpenRecordTestModal()
    {
        selectedEmployeeCtrlNbr = 0;
        recordTestModel = new RecordTestModel
        {
            TestDate = DateTime.UtcNow.Date,
            FederalAuthority = true
        };
        showRecordTestModal = true;
    }

    private void CloseRecordTestModal() => showRecordTestModal = false;

    private void OpenAddReferralModal()
    {
        addReferralModel = new AddReferralModel();
        showAddReferralModal = true;
    }

    private void CloseAddReferralModal() => showAddReferralModal = false;

    private Task OnAddReferralEmployeeChanged(long employeeCtrlNbr)
    {
        addReferralModel.EmployeeCtrlNbr = employeeCtrlNbr;
        return Task.CompletedTask;
    }

    private async Task RecordDrugAlcoholTest()
    {
        try
        {
            if (selectedEmployeeCtrlNbr <= 0)
                return;

            isSaving = true;
            errorMessage = null;

            var request = new RecordDrugAlcoholTestRequest
            {
                EmployeeCtrlNbr = selectedEmployeeCtrlNbr,
                TestType = recordTestModel.TestType ?? string.Empty,
                TestDate = Google.Protobuf.WellKnownTypes.Timestamp.FromDateTime(DateTime.SpecifyKind(recordTestModel.TestDate, DateTimeKind.Utc)),
                DrugResult = recordTestModel.DrugResult ?? string.Empty,
                SubstancesDetected = recordTestModel.SubstancesDetected ?? string.Empty,
                FederalAuthority = recordTestModel.FederalAuthority
            };

            if (recordTestModel.AlcoholResult.HasValue)
                request.AlcoholResult = recordTestModel.AlcoholResult.Value;

            await FraComplianceClient.RecordDrugAlcoholTestAsync(request);
            showRecordTestModal = false;
            successMessage = "Test recorded.";
            await LoadEmployeesWithRecords();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to record test: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task CreateVoluntaryReferral()
    {
        try
        {
            if (addReferralModel.EmployeeCtrlNbr <= 0)
                return;

            isSaving = true;
            errorMessage = null;

            await FraComplianceClient.CreateVoluntaryReferralAsync(addReferralModel.EmployeeCtrlNbr);
            showAddReferralModal = false;
            successMessage = "Voluntary referral created.";
            await LoadEmployeesWithRecords();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to create referral: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private sealed record EmployeeSummary(long CtrlNbr, string Code, string Name);

    private sealed class RecordTestModel
    {
        public string? TestType { get; set; }
        public DateTime TestDate { get; set; }
        public double? AlcoholResult { get; set; }
        public string? DrugResult { get; set; }
        public string? SubstancesDetected { get; set; }
        public bool FederalAuthority { get; set; }
    }

    private sealed class AddReferralModel
    {
        public long EmployeeCtrlNbr { get; set; }
    }
}
