@page "/parents/{CtrlNbr:long}"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using CrewService.BlazorUI.Clients
@using CrewService.Presentation

@inherits AppComponentBase

@attribute [Authorize]


@inject ParentsClient ParentsClient
@inject TenantConfigClient ConfigClient

<PageTitle>Parent Detail</PageTitle>

@if (parent is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <BackNavButton Text="Parents" OnClick="NavigateBack" />

    <h1>@parent.Name</h1>

    <hr />

    <h3>Railroads</h3>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <button class="btn btn-primary" @onclick="OpenAddModal">
            <span class="bi bi-plus-circle"></span> Add Railroad
        </button>
    </div>

    <Modal Visible="showSaveModal" Title="@(editCtrlNbr > 0 ? "Edit Railroad" : "Add Railroad")"
           Icon="@(editCtrlNbr > 0 ? "bi bi-pencil" : "bi bi-plus-circle")"
           OnClose="CloseSaveModal">
        <BodyContent>
            <EditForm Model="saveModel" OnValidSubmit="OnSaveRailroad" id="save-railroad-form">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label fw-semibold">RR Mark</label>
                    <InputText @bind-Value="saveModel.RrMark" class="form-control" placeholder="RR Mark" style="text-transform: uppercase" />
                    <ValidationMessage For="() => saveModel.RrMark" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Name</label>
                    <InputText @bind-Value="saveModel.Name" class="form-control" placeholder="Railroad Name" />
                    <ValidationMessage For="() => saveModel.Name" class="text-danger" />
                </div>
            </EditForm>
        </BodyContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="CloseSaveModal">Cancel</button>
            <button type="submit" form="save-railroad-form" class="btn btn-primary">
                <span class="bi bi-check-circle me-1"></span> @(editCtrlNbr > 0 ? "Update" : "Add")
            </button>
        </Footer>
    </Modal>

    <Modal Visible="showDeleteModal" Title="Confirm Delete" Icon="bi bi-exclamation-triangle"
           OnClose="() => showDeleteModal = false" Size="sm">
        <BodyContent>
            <p>Are you sure you want to delete <strong>@deleteRailroadName</strong>?</p>
        </BodyContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="() => showDeleteModal = false">Cancel</button>
            <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">
                <span class="bi bi-trash me-1"></span> Delete
            </button>
        </Footer>
    </Modal>

    @if (successMessage is not null)
    {
        <div class="alert alert-success alert-dismissible" role="alert">
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    @if (errorMessage is not null)
    {
        <div class="alert alert-danger alert-dismissible" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (railroads is null || railroads.Count == 0)
    {
        <p class="text-muted">No railroads for this parent.</p>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>RR Mark</th>
                    <th>Name</th>
                    <th style="width: 180px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var rr in railroads)
                {
                    <tr>
                        <td><strong>@rr.Code</strong></td>
                        <td>@rr.Name</td>
                        <td>
                            <div class="d-flex gap-1">
                                <button class="btn btn-sm btn-outline-primary flex-fill" @onclick="() => OpenEditModal(rr)">
                                    <span class="bi bi-pencil"></span> Edit
                                </button>
                                <button class="btn btn-sm btn-outline-danger flex-fill" @onclick="() => OpenDeleteModal(rr)">
                                    <span class="bi bi-trash"></span> Delete
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    protected override string? FeatureKey => "parents";

    [Parameter]
    public long CtrlNbr { get; set; }

    private GetParentResponse? parent;
    private IReadOnlyList<GroupResponse>? railroads;
    private long railroadGroupTypeCtrlNbr;

    private void NavigateBack() => NavigationManager.NavigateTo("/parents");

    private bool showSaveModal;
    private long editCtrlNbr;
    private RailroadInputModel saveModel = new();

    private bool showDeleteModal;
    private long deleteCtrlNbr;
    private string deleteRailroadName = "";

    protected override async Task LoadDataAsync()
    {
        await LoadParent();
        await LoadRailroads();
    }

    protected override Task OnAppContextChangedAsync()
    {
        if (SelectedParentCtrlNbr is long selected && selected != CtrlNbr)
        {
            NavigationManager.NavigateTo("/parents");
        }

        return Task.CompletedTask;
    }

    private async Task LoadParent()
    {
        try
        {
            parent = await ParentsClient.GetByCtrlNbrAsync(CtrlNbr);
        }
        catch
        {
        }
    }

    private async Task LoadRailroads()
    {
        try
        {
            var response = await ConfigClient.GetGroupsByTypeNameAsync("Railroad", CtrlNbr);
            railroads = response.Groups;

            // Resolve the Railroad GroupType CtrlNbr for creating new railroads
            if (railroads.Count > 0)
            {
                railroadGroupTypeCtrlNbr = railroads[0].GroupTypeCtrlNbr;
            }
            else
            {
                var allTypes = await ConfigClient.GetAllGroupTypesAsync();
                var rrType = allTypes.GroupTypes.FirstOrDefault(gt => gt.Name == "Railroad" && gt.ParentCtrlNbr == CtrlNbr);
                railroadGroupTypeCtrlNbr = rrType?.CtrlNbr ?? 0;
            }
        }
        catch
        {
            railroads = [];
        }
    }

    private void OpenAddModal()
    {
        editCtrlNbr = 0;
        saveModel = new();
        showSaveModal = true;
    }

    private void OpenEditModal(GroupResponse rr)
    {
        editCtrlNbr = rr.CtrlNbr;
        saveModel = new() { RrMark = rr.Code, Name = rr.Name };
        showSaveModal = true;
    }

    private void CloseSaveModal()
    {
        showSaveModal = false;
        editCtrlNbr = 0;
        saveModel = new();
    }

    private void OpenDeleteModal(GroupResponse rr)
    {
        deleteCtrlNbr = rr.CtrlNbr;
        deleteRailroadName = $"{rr.Code} — {rr.Name}";
        showDeleteModal = true;
    }

    private async Task OnSaveRailroad()
    {
        try
        {
            errorMessage = null;
            successMessage = null;

            if (editCtrlNbr > 0)
            {
                await ConfigClient.UpdateGroupAsync(editCtrlNbr, saveModel.Name ?? string.Empty, code: saveModel.RrMark ?? string.Empty);
                successMessage = "Railroad updated.";
            }
            else
            {
                await ConfigClient.CreateGroupAsync(railroadGroupTypeCtrlNbr, saveModel.Name ?? string.Empty, code: saveModel.RrMark ?? string.Empty);
                successMessage = "Railroad added.";
            }

            CloseSaveModal();
            await LoadParent();
            await LoadRailroads();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save railroad: {ex.Message}";
        }
    }

    private async Task ConfirmDelete()
    {
        try
        {
            errorMessage = null;
            successMessage = null;

            await ConfigClient.DeleteGroupAsync(deleteCtrlNbr);
            successMessage = "Railroad deleted.";
            showDeleteModal = false;
            await LoadParent();
            await LoadRailroads();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to delete railroad: {ex.Message}";
            showDeleteModal = false;
        }
    }

    private sealed class RailroadInputModel
    {
        private string? _rrMark;

        [Required(ErrorMessage = "RR Mark is required.")]
        [StringLength(10, MinimumLength = 1)]
        public string? RrMark
        {
            get => _rrMark;
            set => _rrMark = value?.ToUpperInvariant();
        }

        [Required(ErrorMessage = "Name is required.")]
        [StringLength(100, MinimumLength = 1)]
        public string? Name { get; set; }
    }
}
