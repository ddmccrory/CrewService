@page "/parents/{CtrlNbr:long}"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using CrewService.BlazorUI.Clients
@using CrewService.Presentation

@attribute [Authorize]

@inject ParentsClient ParentsClient
@inject RailroadsClient RailroadsClient

<PageTitle>Parent Detail</PageTitle>

@if (parent is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/parents">Parents</a></li>
            <li class="breadcrumb-item active" aria-current="page">@parent.Name</li>
        </ol>
    </nav>

    <h1>@parent.Name</h1>

    <hr />

    <h3>Railroads</h3>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <button class="btn btn-primary" @onclick="OpenAddModal">
            <span class="bi bi-plus-circle"></span> Add Railroad
        </button>
    </div>

    <Modal Visible="showSaveModal" Title="@(editCtrlNbr > 0 ? "Edit Railroad" : "Add Railroad")"
           Icon="@(editCtrlNbr > 0 ? "bi bi-pencil" : "bi bi-plus-circle")"
           OnClose="CloseSaveModal">
        <BodyContent>
            <EditForm Model="saveModel" OnValidSubmit="OnSaveRailroad" id="save-railroad-form">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label fw-semibold">RR Mark</label>
                    <InputText @bind-Value="saveModel.RrMark" class="form-control" placeholder="RR Mark" />
                    <ValidationMessage For="() => saveModel.RrMark" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Name</label>
                    <InputText @bind-Value="saveModel.Name" class="form-control" placeholder="Railroad Name" />
                    <ValidationMessage For="() => saveModel.Name" class="text-danger" />
                </div>
            </EditForm>
        </BodyContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="CloseSaveModal">Cancel</button>
            <button type="submit" form="save-railroad-form" class="btn btn-primary">
                <span class="bi bi-check-circle me-1"></span> @(editCtrlNbr > 0 ? "Update" : "Add")
            </button>
        </Footer>
    </Modal>

    <Modal Visible="showDeleteModal" Title="Confirm Delete" Icon="bi bi-exclamation-triangle"
           OnClose="() => showDeleteModal = false" Size="sm">
        <BodyContent>
            <p>Are you sure you want to delete <strong>@deleteRailroadName</strong>?</p>
        </BodyContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="() => showDeleteModal = false">Cancel</button>
            <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">
                <span class="bi bi-trash me-1"></span> Delete
            </button>
        </Footer>
    </Modal>

    @if (successMessage is not null)
    {
        <div class="alert alert-success alert-dismissible" role="alert">
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    @if (errorMessage is not null)
    {
        <div class="alert alert-danger alert-dismissible" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (parent.Railroads.Count == 0)
    {
        <p class="text-muted">No railroads for this parent.</p>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>RR Mark</th>
                    <th>Name</th>
                    <th style="width: 180px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var rr in parent.Railroads)
                {
                    <tr>
                        <td><strong>@rr.RrMark</strong></td>
                        <td>@rr.Name</td>
                        <td>
                            <div class="d-flex gap-1">
                                <button class="btn btn-sm btn-outline-primary flex-fill" @onclick="() => OpenEditModal(rr)">
                                    <span class="bi bi-pencil"></span> Edit
                                </button>
                                <button class="btn btn-sm btn-outline-danger flex-fill" @onclick="() => OpenDeleteModal(rr)">
                                    <span class="bi bi-trash"></span> Delete
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    [Parameter]
    public long CtrlNbr { get; set; }

    private GetParentResponse? parent;
    private string? successMessage;
    private string? errorMessage;

    private bool showSaveModal;
    private long editCtrlNbr;
    private RailroadInputModel saveModel = new();

    private bool showDeleteModal;
    private long deleteCtrlNbr;
    private string deleteRailroadName = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadParent();
    }

    private async Task LoadParent()
    {
        try
        {
            parent = await ParentsClient.GetByCtrlNbrAsync(CtrlNbr);
        }
        catch
        {
        }
    }

    private void OpenAddModal()
    {
        editCtrlNbr = 0;
        saveModel = new();
        showSaveModal = true;
    }

    private void OpenEditModal(GetRailroadResponse rr)
    {
        editCtrlNbr = rr.CtrlNbr;
        saveModel = new() { RrMark = rr.RrMark, Name = rr.Name };
        showSaveModal = true;
    }

    private void CloseSaveModal()
    {
        showSaveModal = false;
        editCtrlNbr = 0;
        saveModel = new();
    }

    private void OpenDeleteModal(GetRailroadResponse rr)
    {
        deleteCtrlNbr = rr.CtrlNbr;
        deleteRailroadName = $"{rr.RrMark} — {rr.Name}";
        showDeleteModal = true;
    }

    private async Task OnSaveRailroad()
    {
        try
        {
            errorMessage = null;
            successMessage = null;

            if (editCtrlNbr > 0)
            {
                await RailroadsClient.UpdateAsync(editCtrlNbr, CtrlNbr, saveModel.RrMark ?? string.Empty, saveModel.Name ?? string.Empty);
                successMessage = "Railroad updated.";
            }
            else
            {
                await RailroadsClient.CreateAsync(CtrlNbr, saveModel.RrMark ?? string.Empty, saveModel.Name ?? string.Empty);
                successMessage = "Railroad added.";
            }

            CloseSaveModal();
            await LoadParent();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save railroad: {ex.Message}";
        }
    }

    private async Task ConfirmDelete()
    {
        try
        {
            errorMessage = null;
            successMessage = null;

            await RailroadsClient.DeleteAsync(deleteCtrlNbr);
            successMessage = "Railroad deleted.";
            showDeleteModal = false;
            await LoadParent();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to delete railroad: {ex.Message}";
            showDeleteModal = false;
        }
    }

    private sealed class RailroadInputModel
    {
        [Required(ErrorMessage = "RR Mark is required.")]
        [StringLength(10, MinimumLength = 1)]
        public string? RrMark { get; set; }

        [Required(ErrorMessage = "Name is required.")]
        [StringLength(100, MinimumLength = 1)]
        public string? Name { get; set; }
    }
}
