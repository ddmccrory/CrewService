@using CrewService.BlazorUI.Clients
@using CrewService.BlazorUI.Models.Auth
@using CrewService.BlazorUI.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using System.Security.Claims

@inject ParentsClient ParentsClient
@inject AppContextService AppContext
@inject ProtectedSessionStorage SessionStorage
@inject AuthenticationStateProvider AuthStateProvider

<div class="context-switcher d-flex align-items-center gap-2">
    <select class="form-select form-select-sm" @onchange="OnParentChanged" value="@selectedParentCtrlNbrString" disabled="@(parentOptions.Count <= 1)">
        <option value="">Select a Parent</option>
        @foreach (var parent in parentOptions)
        {
            <option value="@parent.CtrlNbr">@parent.Name</option>
        }
    </select>

    <select class="form-select form-select-sm" @onchange="OnRailroadChanged" value="@selectedRailroadCtrlNbrString" disabled="@(!selectedParentCtrlNbr.HasValue || railroadOptions.Count <= 1)">
        <option value="">Select a Railroad</option>
        @foreach (var railroad in railroadOptions)
        {
            <option value="@railroad.CtrlNbr">@railroad.DisplayName</option>
        }
    </select>
</div>

@code {
    private const string StorageKeyParent = "ctx_parent";
    private const string StorageKeyRailroad = "ctx_railroad";
    private const string StorageKeyLoginId = "ctx_login_id";

    private readonly List<ParentOption> parentOptions = [];
    private readonly List<RailroadOption> railroadOptions = [];

    private long? selectedParentCtrlNbr;
    private long? selectedRailroadCtrlNbr;

    private bool _dataLoaded;
    private bool _restored;
    private string? _currentLoginId;

    private string selectedParentCtrlNbrString => selectedParentCtrlNbr?.ToString() ?? string.Empty;
    private string selectedRailroadCtrlNbrString => selectedRailroadCtrlNbr?.ToString() ?? string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var response = await ParentsClient.GetAllAsync();
        var allParents = response.Parent
            .Select(p => new ParentOption(
                p.CtrlNbr,
                p.Name,
                p.Railroads
                    .Select(r => new RailroadOption(r.CtrlNbr, r.Name, string.IsNullOrWhiteSpace(r.RrMark) ? r.Name : $"{r.RrMark} — {r.Name}"))
                    .OrderBy(r => r.DisplayName)
                    .ToList()))
            .OrderBy(p => p.Name)
            .ToList();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        _currentLoginId = user.FindFirst(CustomClaimTypes.LoginId)?.Value;

        if (!user.IsInRole(Roles.SystemAdmin))
        {
            // Parse parent_role claims: "{parent}:{role}" or "{parent}:{role}:{railroad}"
            var claimParts = user.Claims
                .Where(c => c.Type == CustomClaimTypes.ParentRole)
                .Select(c => c.Value.Split(':'))
                .Where(parts => parts.Length >= 2 && long.TryParse(parts[0], out _))
                .ToList();

            var userParentCtrlNbrs = claimParts
                .Select(parts => long.Parse(parts[0]))
                .Distinct()
                .ToHashSet();

            // Collect the railroad CtrlNbrs the user is assigned to, per parent
            var userRailroadCtrlNbrs = claimParts
                .Where(parts => parts.Length >= 3 && long.TryParse(parts[2], out _))
                .Select(parts => long.Parse(parts[2]))
                .Distinct()
                .ToHashSet();

            if (userParentCtrlNbrs.Count > 0)
            {
                allParents = allParents
                    .Where(p => userParentCtrlNbrs.Contains(p.CtrlNbr))
                    .Select(p => userRailroadCtrlNbrs.Count > 0
                        ? p with { Railroads = p.Railroads.Where(r => userRailroadCtrlNbrs.Contains(r.CtrlNbr)).ToList() }
                        : p)
                    .ToList();
            }
        }

        parentOptions.Clear();
        parentOptions.AddRange(allParents);
        _dataLoaded = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_restored || !_dataLoaded) return;
        _restored = true;

        var restoredFromSession = await TryRestoreFromSessionAsync();

        if (!restoredFromSession)
        {
            AutoSelectSingleOptions();
        }

        if (selectedParentCtrlNbr.HasValue)
        {
            await PersistToSessionAsync();
        }

        StateHasChanged();
    }

    private async Task<bool> TryRestoreFromSessionAsync()
    {
        try
        {
            // If login_id changed since context was stored, skip restoration
            var loginIdResult = await SessionStorage.GetAsync<string>(StorageKeyLoginId);
            if (!loginIdResult.Success || loginIdResult.Value != _currentLoginId)
                return false;

            var parentResult = await SessionStorage.GetAsync<StoredContext>(StorageKeyParent);
            if (!parentResult.Success || parentResult.Value is null) return false;

            var storedParent = parentResult.Value;
            var parent = parentOptions.FirstOrDefault(p => p.CtrlNbr == storedParent.CtrlNbr);
            if (parent is null) return false;

            selectedParentCtrlNbr = parent.CtrlNbr;
            railroadOptions.Clear();
            railroadOptions.AddRange(parent.Railroads);

            // Resolve the railroad (if any) before notifying, so we fire a single
            // OnContextChanged instead of two separate events.
            long? restoredRailroadCtrlNbr = null;
            string? restoredRailroadName = null;

            var railroadResult = await SessionStorage.GetAsync<StoredContext>(StorageKeyRailroad);
            if (railroadResult.Success && railroadResult.Value is not null)
            {
                var storedRailroad = railroadResult.Value;
                var railroad = railroadOptions.FirstOrDefault(r => r.CtrlNbr == storedRailroad.CtrlNbr);
                if (railroad is not null)
                {
                    selectedRailroadCtrlNbr = railroad.CtrlNbr;
                    restoredRailroadCtrlNbr = railroad.CtrlNbr;
                    restoredRailroadName = railroad.Name;
                }
            }

            // Single notification — parent + railroad in one batch
            AppContext.SetContext(parent.CtrlNbr, parent.Name, restoredRailroadCtrlNbr, restoredRailroadName);
            return true;
        }
        catch
        {
            return false;
        }
    }

    private void AutoSelectSingleOptions()
    {
        if (parentOptions.Count == 1)
        {
            var onlyParent = parentOptions[0];
            selectedParentCtrlNbr = onlyParent.CtrlNbr;
            railroadOptions.Clear();
            railroadOptions.AddRange(onlyParent.Railroads);

            long? autoRailroadCtrlNbr = null;
            string? autoRailroadName = null;

            if (railroadOptions.Count == 1)
            {
                var onlyRailroad = railroadOptions[0];
                selectedRailroadCtrlNbr = onlyRailroad.CtrlNbr;
                autoRailroadCtrlNbr = onlyRailroad.CtrlNbr;
                autoRailroadName = onlyRailroad.Name;
            }

            // Single notification — parent + railroad in one batch
            AppContext.SetContext(onlyParent.CtrlNbr, onlyParent.Name, autoRailroadCtrlNbr, autoRailroadName);
        }
    }

    private async Task PersistToSessionAsync()
    {
        if (_currentLoginId is not null)
            await SessionStorage.SetAsync(StorageKeyLoginId, _currentLoginId);

        if (selectedParentCtrlNbr.HasValue)
        {
            var parentName = parentOptions.FirstOrDefault(p => p.CtrlNbr == selectedParentCtrlNbr)?.Name ?? string.Empty;
            await SessionStorage.SetAsync(StorageKeyParent, new StoredContext(selectedParentCtrlNbr.Value, parentName));
        }
        else
        {
            await SessionStorage.DeleteAsync(StorageKeyParent);
        }

        if (selectedRailroadCtrlNbr.HasValue)
        {
            var railroadName = railroadOptions.FirstOrDefault(r => r.CtrlNbr == selectedRailroadCtrlNbr)?.Name ?? string.Empty;
            await SessionStorage.SetAsync(StorageKeyRailroad, new StoredContext(selectedRailroadCtrlNbr.Value, railroadName));
        }
        else
        {
            await SessionStorage.DeleteAsync(StorageKeyRailroad);
        }
    }

    private async Task OnParentChanged(ChangeEventArgs e)
    {
        if (!long.TryParse(e.Value?.ToString(), out var parentCtrlNbr))
        {
            selectedParentCtrlNbr = null;
            selectedRailroadCtrlNbr = null;
            railroadOptions.Clear();
            AppContext.Clear();
            await PersistToSessionAsync();
            return;
        }

        var selectedParent = parentOptions.FirstOrDefault(p => p.CtrlNbr == parentCtrlNbr);
        if (selectedParent is null) return;

        selectedParentCtrlNbr = selectedParent.CtrlNbr;
        selectedRailroadCtrlNbr = null;

        railroadOptions.Clear();
        railroadOptions.AddRange(selectedParent.Railroads);

        AppContext.SetParent(selectedParent.CtrlNbr, selectedParent.Name);

        if (railroadOptions.Count == 1)
        {
            var onlyRailroad = railroadOptions[0];
            selectedRailroadCtrlNbr = onlyRailroad.CtrlNbr;
            AppContext.SetRailroad(onlyRailroad.CtrlNbr, onlyRailroad.Name);
        }

        await PersistToSessionAsync();
    }

    private async Task OnRailroadChanged(ChangeEventArgs e)
    {
        if (!long.TryParse(e.Value?.ToString(), out var railroadCtrlNbr))
        {
            selectedRailroadCtrlNbr = null;
            AppContext.ClearRailroad();
            await PersistToSessionAsync();
            return;
        }

        var selectedRailroad = railroadOptions.FirstOrDefault(r => r.CtrlNbr == railroadCtrlNbr);
        if (selectedRailroad is null) return;

        selectedRailroadCtrlNbr = selectedRailroad.CtrlNbr;
        AppContext.SetRailroad(selectedRailroad.CtrlNbr, selectedRailroad.Name);

        await PersistToSessionAsync();
    }

    private sealed record ParentOption(long CtrlNbr, string Name, List<RailroadOption> Railroads);
    private sealed record RailroadOption(long CtrlNbr, string Name, string DisplayName);
    private sealed record StoredContext(long CtrlNbr, string Name);
}
