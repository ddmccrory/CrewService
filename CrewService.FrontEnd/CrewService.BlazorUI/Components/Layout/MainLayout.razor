@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu @rendermode="InteractiveServer" />
    </div>

    <main>
        <nav class="navbar navbar-expand-lg bg-primary sticky-top">
            <div class="container-fluid">
                <h4 class="text-light mb-0">Crew Service Management</h4>
                <div class="d-flex align-items-center ms-auto gap-2">
                    <AuthorizeView>
                        <Authorized>
                            <div class="topbar-auth d-flex align-items-center gap-2">
                                <CrewService.BlazorUI.Components.Layout.ContextSwitcher @rendermode="new InteractiveServerRenderMode(prerender: false)" />
                                <CrewService.BlazorUI.Components.Layout.NotificationMenu @rendermode="new InteractiveServerRenderMode(prerender: false)" />
                                <div class="nav-item px-1">
                                    <CrewService.BlazorUI.Components.Layout.UserNameButton @rendermode="new InteractiveServerRenderMode(prerender: false)" />
                                </div>
                            </div>
                        </Authorized>
                    </AuthorizeView>
                    <CrewService.BlazorUI.Components.Layout.ApiStatusIndicator @rendermode="new InteractiveServerRenderMode(prerender: false)" />
                </div>
            </div>
        </nav>

        <article class="content px-4">
            <CrewService.BlazorUI.Components.Layout.ApiConnectivityGate @rendermode="new InteractiveServerRenderMode(prerender: false)" />
            @Body
        </article>
    </main>
</div>

<AuthorizeView>
    <Authorized>
        <CrewService.BlazorUI.Components.Layout.NotificationGate @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    </Authorized>
</AuthorizeView>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
