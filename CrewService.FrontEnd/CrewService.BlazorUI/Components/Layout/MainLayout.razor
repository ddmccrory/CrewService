@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu @rendermode="InteractiveServer" />
    </div>

    <main>
        <nav class="navbar navbar-expand-lg bg-primary sticky-top">
            <div class="container-fluid">
                <h4 class="text-light mb-0">Crew Service Management</h4>
                <AuthorizeView>
                    <Authorized>
                        <div class="topbar-auth d-flex align-items-center ms-auto gap-2">
                            <CrewService.BlazorUI.Components.Layout.ContextSwitcher @rendermode="new InteractiveServerRenderMode(prerender: false)" />
                            <div class="nav-item px-1">
                                <NavLink class="nav-link p-0" href="Account/Manage">
                                    <div class="btn btn-outline-light" aria-hidden="true">@context.User.Identity?.Name</div>
                                </NavLink>
                            </div>
                        </div>
                    </Authorized>
                </AuthorizeView>
            </div>
        </nav>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
