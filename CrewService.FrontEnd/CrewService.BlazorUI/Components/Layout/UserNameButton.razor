@implements IDisposable

@inject CrewService.BlazorUI.Services.AppContextService AppContext
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject CrewService.BlazorUI.Services.CurrentUserService CurrentUser

<NavLink class="nav-link p-0" href="@profileHref">
    <div class="btn btn-outline-light" aria-hidden="true">@displayName</div>
</NavLink>

@code {
    private string? displayName;
    private string profileHref = "Account/Manage";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        await CurrentUser.InitializeAsync(authState.User);

        if (CurrentUser.IsEmployee && CurrentUser.Employee is not null)
        {
            profileHref = $"/employees/{CurrentUser.Employee.CtrlNbr}";
        }

        displayName = authState.User.Identity?.Name;

        if (!string.IsNullOrEmpty(displayName) && string.IsNullOrEmpty(AppContext.DisplayName))
        {
            AppContext.DisplayName = displayName;
        }
        else if (!string.IsNullOrEmpty(AppContext.DisplayName))
        {
            displayName = AppContext.DisplayName;
        }

        AppContext.OnContextChanged += OnContextChanged;
    }

    private void OnContextChanged()
    {
        if (!string.IsNullOrEmpty(AppContext.DisplayName))
        {
            displayName = AppContext.DisplayName;
        }

        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AppContext.OnContextChanged -= OnContextChanged;
    }
}
